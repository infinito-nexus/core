{
  "gateway": {
    "mode": "local",
    "trustedProxies": {{ OPENCLAW_TRUSTED_PROXY_SOURCES | to_json }},
{% if OPENCLAW_TRUSTED_PROXY_ENABLED | bool %}
    "auth": {
      "mode": "trusted-proxy",
      "trustedProxy": {
        "userHeader": {{ OPENCLAW_TRUSTED_PROXY_USER_HEADER | to_json }},
        "requiredHeaders": {{ OPENCLAW_TRUSTED_PROXY_REQUIRED_HEADERS | to_json }},
        "allowUsers": []
      }
    },
{% endif %}
    "controlUi": {
      "allowedOrigins": {{ OPENCLAW_CONTROL_UI_ORIGINS | to_json }}
    }
  }{% if OPENCLAW_LITELLM_ENABLED | bool %},
  "agents": {
    "defaults": {
      "model": {"primary": {{ (OPENCLAW_LITELLM_PROVIDER ~ '/' ~ OPENCLAW_LITELLM_MODEL) | to_json }}}
    }
  },
  "models": {
    "providers": {
      {{ OPENCLAW_LITELLM_PROVIDER | to_json }}: {
        "baseUrl": {{ OPENCLAW_LITELLM_BASE_URL | to_json }},
        "apiKey": {{ OPENCLAW_LITELLM_API_KEY | to_json }},
        "api": "openai-completions",
        "models": [{"id": {{ OPENCLAW_LITELLM_MODEL | to_json }}, "name": {{ OPENCLAW_LITELLM_MODEL | to_json }}}]
      }
    }
  }
{% endif %}{% set renderable = OPENCLAW_MCP_SERVERS | mcp_renderable_servers %}{% if renderable | length > 0 %},
  "mcp": {
    "servers": {
{% for server in renderable %}{% set callable_tools = server.tools | reject('in', server.mutating | default([])) | list %}
      {{ server.id | to_json }}: {
        "url": {{ server.url | to_json }},
        "transport": {{ server.transport | to_json }},
        "headers": {"Authorization": {{ server | mcp_authorization | to_json }}},
        "toolFilter": {"include": {{ callable_tools | to_json }}}
      }{{ "," if not loop.last }}
{% endfor %}
    }
  }
{% endif %}
}
