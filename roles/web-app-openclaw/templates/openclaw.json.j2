{
  "gateway": {
    "mode": "local",
    "controlUi": {
      "allowedOrigins": [{{ OPENCLAW_URL | to_json }}]
    }
  }{% if OPENCLAW_MCP_SERVERS | length > 0 %},
  "mcp": {
    "servers": {
{% for server in OPENCLAW_MCP_SERVERS %}
      {{ server.id | to_json }}: {
        "url": {{ server.url | to_json }},
        "transport": {{ server.transport | to_json }},
        "headers": {"Authorization": {{ ("Bearer " ~ server.token) | to_json }}}
      }{{ "," if not loop.last }}
{% endfor %}
    }
  }
{% endif %}
}
