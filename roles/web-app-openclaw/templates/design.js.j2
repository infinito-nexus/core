{% set design = lookup('design', application_id) %}
(function () {
  var root = document.documentElement;
  var theme = {{ OPENCLAW_DESIGN_THEME | to_json }};
  var settingsKey =
    "openclaw.control.settings.v1:" + (window.location.protocol === "https:" ? "wss" : "ws") + "://" + window.location.host;
  var offeredKey = "infinito.design.theme";
  var styleId = "openclaw-custom-theme";
  var prefersLight = window.matchMedia("(prefers-color-scheme: light)");
  function systemMode() {
    return prefersLight.matches ? "light" : "dark";
  }
{% if design.title is string %}
  document.title = {{ design.title | to_json }};
{% endif %}
  function offered() {
    try {
      var storage = window.localStorage;
      var settings = JSON.parse(storage.getItem(settingsKey) || "{}");
      if (settings.customTheme && settings.customTheme.themeId !== theme.themeId) {
        return null;
      }
      settings.customTheme = theme;
      if (storage.getItem(offeredKey) !== theme.themeId) {
        if (!settings.theme || settings.theme === "claw") {
          settings.theme = "custom";
        }
        storage.setItem(offeredKey, theme.themeId);
      }
      storage.setItem(settingsKey, JSON.stringify(settings));
      return settings;
    } catch (error) {
      return null;
    }
  }
  function declarations(tokens) {
    return Object.keys(tokens)
      .map(function (name) {
        return "  --" + name + ": " + tokens[name] + ";";
      })
      .join("\n");
  }
  function paint(settings) {
    if (!settings || settings.theme !== "custom") {
      return;
    }
    var mode = settings.themeMode;
    if (mode !== "light" && mode !== "dark") {
      mode = systemMode();
    }
    var style = document.createElement("style");
    style.id = styleId;
    style.textContent =
      ':root[data-theme="custom"] {\n' +
      declarations(theme.dark) +
      '\n}\n:root[data-theme="custom-light"] {\n' +
      declarations(theme.light) +
      "\n}";
    document.head.appendChild(style);
    root.setAttribute("data-theme", mode === "light" ? "custom-light" : "custom");
    root.setAttribute("data-theme-mode", mode);
  }
  function mirror() {
    var mode = root.getAttribute("data-theme-mode");
    var style = document.getElementById(styleId);
    if ((mode === "light" || mode === "dark") && mode !== systemMode()) {
      root.setAttribute("data-design-theme", mode);
    } else {
      root.removeAttribute("data-design-theme");
    }
    root.toggleAttribute(
      "data-design-corporate",
      /^custom/.test(root.getAttribute("data-theme") || "") && !!style && style.textContent.indexOf("var(--design-") !== -1
    );
  }
  paint(offered());
  new MutationObserver(mirror).observe(root, { attributes: true, attributeFilter: ["data-theme", "data-theme-mode"] });
  prefersLight.addEventListener("change", mirror);
  mirror();
})();
