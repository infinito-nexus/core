{% set design = lookup('design', application_id) %}
(function () {
  var root = document.documentElement;
  var prefersDark = window.matchMedia("(prefers-color-scheme: dark)");
{% if design.title is string %}
  var title = {{ design.title | to_json }};
  var product = "Home Assistant";
  function brandTitle() {
    if (document.title.indexOf(title) === -1 && document.title.indexOf(product) !== -1) {
      document.title = document.title.split(product).join(title);
    }
  }
  function watchTitle() {
    var element = document.querySelector("title");
    if (!element) {
      return false;
    }
    new MutationObserver(brandTitle).observe(element, { childList: true, characterData: true, subtree: true });
    brandTitle();
    return true;
  }
  if (!watchTitle()) {
    document.addEventListener("DOMContentLoaded", watchTitle);
  }
{% endif %}
{% if design.logo is string %}
  function brandIcons() {
    var icon = document.querySelector("link[rel='icon']") || document.head.appendChild(document.createElement("link"));
    icon.rel = "icon";
    icon.type = "image/x-icon";
    icon.href = {{ design.urls.favicon_ico | to_json }};
    var touch = document.querySelector("link[rel='apple-touch-icon']");
    if (touch) {
      touch.href = {{ design.urls['apple-touch-icon'].png | to_json }};
    }
  }
  brandIcons();
  document.addEventListener("DOMContentLoaded", brandIcons);
{% endif %}
  var visitor = /^\/(onboarding\.html|auth\/)/.test(window.location.pathname);
  function storedMode() {
    if (visitor) {
      return undefined;
    }
    try {
      var selected = JSON.parse(window.localStorage.getItem("selectedTheme"));
      return selected ? selected.dark : undefined;
    } catch (error) {
      return undefined;
    }
  }
  function applyMode(dark) {
    if (typeof dark === "boolean" && dark !== prefersDark.matches) {
      root.setAttribute("data-design-theme", dark ? "dark" : "light");
    } else {
      root.removeAttribute("data-design-theme");
    }
  }
  function mirrorMode() {
    var app = document.querySelector("home-assistant");
    var themes = app && app.hass && app.hass.themes;
    applyMode(themes && typeof themes.darkMode === "boolean" ? themes.darkMode : storedMode());
  }
  window.addEventListener(
    "settheme",
    function (event) {
      if (event.detail && "dark" in event.detail) {
        applyMode(event.detail.dark);
      }
    },
    true
  );
  prefersDark.addEventListener("change", function () {
    applyMode(storedMode());
  });
  new MutationObserver(mirrorMode).observe(root, { attributes: true, attributeFilter: ["style"] });
  mirrorMode();
})();
