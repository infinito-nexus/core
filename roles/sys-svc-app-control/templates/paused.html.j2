{% set texts = paused_entry.value %}
{% set labels = APP_CONTROL_CONTACT_BRANDS | combine({'email': texts.channel_email, 'phone': texts.channel_phone, 'newsletter': texts.channel_newsletter}) %}
<!DOCTYPE html>
<html lang="{{ paused_entry.key | e }}" dir="{{ texts.dir | e }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ texts.title | e }}</title>
<style>{{ APP_CONTROL_PAUSED_STYLE }}</style>
</head>
<body>
<main>
<svg class="scene" viewBox="0 0 320 240" role="img" aria-labelledby="scene-title" xmlns="http://www.w3.org/2000/svg">
<title id="scene-title">{{ texts.illustration | e }}</title>
<ellipse cx="170" cy="220" rx="140" ry="10" fill="#000" fill-opacity=".08"/>
<g class="beaver">
<ellipse cx="282" cy="204" rx="34" ry="13" fill="#5b3a21"/>
<path d="M258 198l46 10M262 210l40-14M270 194l8 22M288 192l4 24" stroke="#7a5034" stroke-width="2" fill="none"/>
<ellipse cx="210" cy="180" rx="72" ry="40" fill="#8b5a2b"/>
<ellipse cx="212" cy="194" rx="42" ry="18" fill="#b07a45"/>
<circle cx="130" cy="130" r="10" fill="#7a4b22"/>
<circle cx="172" cy="126" r="10" fill="#7a4b22"/>
<circle cx="130" cy="130" r="5" fill="#5b3a21"/>
<circle cx="172" cy="126" r="5" fill="#5b3a21"/>
<circle cx="152" cy="160" r="36" fill="#9a6532"/>
<ellipse cx="153" cy="175" rx="17" ry="12" fill="#c8935e"/>
<path d="M134 156q7 6 14 0M158 156q7 6 14 0" stroke="#3b2414" stroke-width="3" stroke-linecap="round" fill="none"/>
<circle cx="130" cy="170" r="5" fill="#e89a8a" fill-opacity=".6"/>
<circle cx="176" cy="170" r="5" fill="#e89a8a" fill-opacity=".6"/>
<ellipse cx="153" cy="168" rx="6" ry="4" fill="#3b2414"/>
<rect x="148.5" y="178" width="4.5" height="7" rx="1" fill="#fffaf0"/>
<rect x="153.5" y="178" width="4.5" height="7" rx="1" fill="#fffaf0"/>
<ellipse cx="142" cy="198" rx="11" ry="7" fill="#7a4b22"/>
<ellipse cx="168" cy="198" rx="11" ry="7" fill="#7a4b22"/>
</g>
<path class="z z1" d="M180 112h10l-10 12h10"/>
<path class="z z2" d="M196 88h14l-14 16h14"/>
<path class="z z3" d="M216 58h18l-18 21h18"/>
<rect x="94" y="130" width="12" height="90" rx="3" fill="#7d6a55"/>
<circle cx="100" cy="112" r="44" fill="#e8a33d" stroke="#b8741f" stroke-width="5"/>
<rect x="82" y="88" width="12" height="48" rx="3" fill="#fffaf0"/>
<rect x="106" y="88" width="12" height="48" rx="3" fill="#fffaf0"/>
</svg>
<h1>{{ texts.heading | e }}</h1>
<p>{{ texts.notice | e }}</p>
<h2>{{ texts.contact | e }}</h2>
<dl>
{% for channel, raw in service_provider.contact.items() if raw | trim %}
{% set address = raw | trim %}
<dt>{{ (labels[channel] if channel in labels else channel) | e }}</dt>
{% if channel == 'email' %}
<dd><a href="mailto:{{ address | e }}">{{ address | e }}</a></dd>
{% elif channel == 'phone' %}
<dd><a href="tel:{{ address | replace(' ', '') | e }}">{{ address | e }}</a></dd>
{% elif address is match('https?://') %}
<dd><a href="{{ address | e }}">{{ address | e }}</a></dd>
{% else %}
<dd>{{ address | e }}</dd>
{% endif %}
{% endfor %}
</dl>
</main>
</body>
</html>
