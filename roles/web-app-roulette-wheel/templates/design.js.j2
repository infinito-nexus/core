{% set design = lookup('design', application_id) %}
(function () {
  var root = document.documentElement;
  var dark = window.matchMedia("(prefers-color-scheme: dark)");
  var BUSY = "rgb(192, 192, 192)";
  function effective() {
    var chosen = root.getAttribute("data-design-theme");
    if (chosen === "light" || chosen === "dark") {
      return chosen;
    }
    return dark.matches ? "dark" : "light";
  }
  function icon() {
    var image = document.querySelector(".light-dark-mode img.moon-sun");
    var wanted = effective() === "light" ? "static/sun.png" : "static/moon.png";
    if (image && image.getAttribute("src") !== wanted) {
      image.setAttribute("src", wanted);
    }
  }
  function clean() {
    var body = document.body;
    if (body && (body.style.backgroundColor || body.style.color)) {
      body.style.removeProperty("background-color");
      body.style.removeProperty("color");
    }
    var buttons = document.querySelectorAll(".add-item-button, .remove-all-items-button");
    for (var index = 0; index < buttons.length; index += 1) {
      var button = buttons[index];
      var fill = button.style.getPropertyValue("background-color");
      if (!fill) {
        continue;
      }
      if (fill === BUSY) {
        button.setAttribute("data-design-busy", "true");
      } else {
        button.removeAttribute("data-design-busy");
      }
      button.style.removeProperty("background");
    }
  }
{% if design.title is string or design.logo is string %}
  function brand() {
{% if design.title is string %}
    document.title = {{ design.title | to_json }};
{% endif %}
{% if design.logo is string %}
    var href = {{ design.urls.favicon.png | to_json }};
    var links = document.querySelectorAll("link[rel~='icon']");
    for (var index = 0; index < links.length; index += 1) {
      if (links[index].getAttribute("href") !== href) {
        links[index].setAttribute("type", "image/png");
        links[index].setAttribute("href", href);
      }
    }
{% endif %}
  }
{% endif %}
  document.addEventListener("click", function (event) {
    if (!event.target.closest || !event.target.closest(".light-dark-mode")) {
      return;
    }
    root.setAttribute("data-design-theme", effective() === "dark" ? "light" : "dark");
    clean();
    icon();
  });
  document.addEventListener("DOMContentLoaded", function () {
{% if design.title is string or design.logo is string %}
    brand();
{% endif %}
    clean();
    icon();
    new MutationObserver(clean).observe(document.body, {
      attributes: true,
      attributeFilter: ["style"],
      subtree: true,
    });
  });
  dark.addEventListener("change", icon);
})();
