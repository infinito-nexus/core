{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}
  {% for dashboard_instance in DASHBOARD_INSTANCES %}
  {% set service_name = 'dashboard' | labelled(dashboard_instance.label, '-') %}
  {{ service_name }}:
    {% include 'roles/sys-svc-container/templates/deploy.yml.j2' %}
    {{ lookup('template', 'roles/sys-svc-container/templates/build.yml.j2') | indent(4) }}
      args:
        DASHBOARD_IMAGE: "{{ DASHBOARD_IMAGE }}"
        DASHBOARD_VERSION: "{{ DASHBOARD_VERSION }}"
    {{ lookup('container_image', application_id, 'dashboard') }}
    {{ lookup('compose_only', 'container_name', DASHBOARD_CONTAINER | labelled(dashboard_instance.label, '-')) }}
    {{ lookup('container_ports', ['dashboard', 'http' | labelled(dashboard_instance.label, '_'), DOCKER_BIND_HOST]) | indent(4) }}
    {{ lookup('container_volumes', service_name) | indent(4) }}
    {{ lookup('compose_restart') }}
    {{ lookup('container_networks') | indent(4) }}
    {{ lookup('container_healthcheck', 'dashboard') | indent(4) }}

  {% endfor %}
{{ lookup('compose_volumes') }}

{{ lookup('compose_networks') }}
