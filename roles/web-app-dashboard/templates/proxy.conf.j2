{% set domain = front_proxy_domain | default(domain) %}
{% set _dashboard_label = (DASHBOARD_INSTANCES | selectattr('network', 'equalto', domain | network_of) | first).label %}
{% set http_port = lookup('config', application_id, 'services.dashboard.ports.local.' ~ ('http' | labelled(_dashboard_label, '_'))) %}
{% set proxy_service_key = 'dashboard' | labelled(_dashboard_label, '-') %}
{% include 'roles/sys-svc-proxy/templates/vhost/basic.conf.j2' %}
