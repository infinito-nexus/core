{# The Linebreak here are intentional due to tab bugs #}
---
cards:
{{ portfolio_menu_data.cards | map('dict2items') | map('rejectattr', 'key', 'equalto', 'allowed_groups') | map('items2dict') | list | to_nice_yaml(indent=2) }}

dashboard:
{% if DASHBOARD_FOLDERS_ENABLED | bool %}
  folders:
{{ portfolio_menu_data.folders | to_nice_yaml(indent=2) | indent(4, true) }}
{% endif %}
  new_days: {{ DASHBOARD_NEW_DAYS | int }}

{% include 'menu/applications.yml.j2' %}
{% include 'menu/followus.yml.j2' %}
{% include 'menu/contact.yml.j2' %}
{% include 'menu/support.yml.j2' %}

platform:
  titel:    {{ DASHBOARD_PLATFORM_TITLE | to_json }}
  subtitel: {{ service_provider.platform.subtitel | to_json }}
  logo:
    source: {{ DASHBOARD_PLATFORM_LOGO_URL }}
  favicon:
    source: {{ DASHBOARD_PLATFORM_FAVICON_URL }}
company:
  titel: {{ service_provider.company.titel | to_json }}
  subtitel: {{ service_provider.company.slogan | to_json }}
  logo:
    source: {{ DASHBOARD_COMPANY_LOGO_URL }}
  address:
{{ service_provider.company.address | to_nice_yaml(indent=4) | indent(4, true) }}
  imprint_url: {{ service_provider.legal.imprint }}
navigation:

{% include 'menu/header.yml.j2' %}

{% include 'menu/footer.yml.j2' %}
