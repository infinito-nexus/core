const KC_CONFIG = {
  url: "{{ OIDC.URL }}",
  realm: "{{ OIDC.CLIENT.REALM }}",
  clientId: "{{ DASHBOARD_OIDC_CLIENT_ID }}",
  redirectUri: "{{ DASHBOARD_APP_BASE_URL }}",
  silentCheckSsoRedirectUri: "{{ lookup('tls', DASHBOARD_APPLICATION_ID, 'url.origin') ~ DASHBOARD_LOCATION_SILENT_CHECK }}"
};

{% if (lookup('config', application_id, 'services.tor.enabled', False) | bool) and (domain | network_of) == 'tor' %}
const KC_MIRROR_BASE = "{{ lookup('tls', 'web-svc-mirror', 'url.origin') }}";
{% else %}
const KC_MIRROR_BASE = null;
{% endif %}
const KC_JS_ASSET_URL = "{{ lookup('asset', application_id, 'keycloak-js', 'lib/keycloak.js') }}";

const DEBUG = {{ lookup('debug') | string | lower }};
const KEYCLOAK_IFRAME_POLLING_ENABLED = false;

const ACCOUNT_API = `${KC_CONFIG.url}/realms/${encodeURIComponent(KC_CONFIG.realm)}/account`;
const ACCOUNT_REQUEST_TIMEOUT_MS = 10000;
const LOGOUT_EVERYWHERE_MARKER = {{ DASHBOARD_LOGOUT_EVERYWHERE_MARKER | to_json }};
const LOGOUT_EVERYWHERE_CLASS = {{ DASHBOARD_LOGOUT_EVERYWHERE_CLASS | to_json }};
const LOGOUT_PENDING_KEY = "infinito-logout-pending";
const LOGOUT_RESULT_PARAM = "logout-result";
const LOGOUT_RESULTS = ["everywhere", "partial"];
const LOGOUT_RESULT_ID = "infinito-logout-result";
const LOGOUT_I18N = {
{% for code, entry in DASHBOARD_LOGOUT_I18N.items() %}
  {{ code | to_json }}: {{ {'everywhere_done': entry.everywhere_done, 'everywhere_partial': entry.everywhere_partial, 'dir': entry.dir} | to_json }}{{ '' if loop.last else ',' }}
{% endfor %}
};

function findMenuItemByText(label) {
  const wanted = (label || "").trim().toLowerCase();
  if (!wanted) return null;

  const nodes = document.querySelectorAll(
    "nav a, nav button, nav .nav-link, nav .dropdown-toggle, nav .dropdown-item, .navbar a, .navbar button"
  );

  for (const el of nodes) {
    const text = (el.getAttribute?.("data-label") || el.ariaLabel || el.title || el.textContent || "")
      .replace(/\s+/g, " ").trim().toLowerCase();
    if (text !== wanted) continue;

    const container =
      el.closest("li, .nav-item, .dropdown, .btn-group, .menu-item") ||
      el.closest(".navbar-nav > *") ||
      el.parentElement ||
      el;
    return container;
  }
  return null;
}

function setItemVisible(el, visible) {
  if (!el) return;
  el.style.display = visible ? "" : "none";
  if (el.toggleAttribute) el.toggleAttribute("hidden", !visible);
  el.setAttribute?.("aria-hidden", visible ? "false" : "true");
}

async function loadKeycloakAdapter(src) {
  const mod = await import(src);
  if (typeof mod.default !== "function") {
    throw new Error("keycloak.js exposed no default export at " + src);
  }
  return mod.default;
}

let keycloak = null;
let authenticated = false;

function applyAuthMenuVisibility(authenticated) {
  try {
    const accountItem = findMenuItemByText("Account");
    const loginItem   = findMenuItemByText("Login");
    setItemVisible(accountItem, !!authenticated);
    setItemVisible(loginItem,   !authenticated);
    if (DEBUG) console.log("[oidc] applyAuthMenuVisibility:", { authenticated, accountItem, loginItem });
  } catch (e) {
    console.warn("[oidc] applyAuthMenuVisibility failed:", e);
  }
}

function syncAuthMenuVisibility(nextAuthenticated) {
  authenticated = !!nextAuthenticated;
  applyAuthMenuVisibility(authenticated);
}

function remember(key, value) {
  try {
    sessionStorage.setItem(key, value);
  } catch (e) {
    console.warn("[oidc] session storage refused " + key + ":", e);
  }
}

function recall(key) {
  try {
    const value = sessionStorage.getItem(key);
    sessionStorage.removeItem(key);
    return value;
  } catch (e) {
    console.warn("[oidc] session storage refused " + key + ":", e);
    return null;
  }
}

function logoutMessages() {
  const tags = [document.documentElement.lang, navigator.language];
  for (const raw of tags) {
    const tag = String(raw || "").toLowerCase();
    if (LOGOUT_I18N[tag]) return LOGOUT_I18N[tag];
    const base = tag.split("-")[0];
    if (LOGOUT_I18N[base]) return LOGOUT_I18N[base];
  }
  return LOGOUT_I18N.en;
}

function logoutResultUri(result) {
  const target = new URL(KC_CONFIG.redirectUri);
  target.searchParams.set(LOGOUT_RESULT_PARAM, result);
  return target.toString();
}

function takeLogoutResult() {
  const params = new URLSearchParams(window.location.search);
  if (!params.has(LOGOUT_RESULT_PARAM)) return null;
  const result = params.get(LOGOUT_RESULT_PARAM);
  params.delete(LOGOUT_RESULT_PARAM);
  const query = params.toString();
  history.replaceState(null, "", window.location.pathname + (query ? "?" + query : "") + window.location.hash);
  return result;
}

function showLogoutResult() {
  const result = takeLogoutResult();
  if (!LOGOUT_RESULTS.includes(result)) return;
  const messages = logoutMessages();
  const box = document.createElement("div");
  box.id = LOGOUT_RESULT_ID;
  box.className = "alert m-2 " + (result === "everywhere" ? "alert-success" : "alert-warning");
  box.setAttribute("role", result === "everywhere" ? "status" : "alert");
  box.setAttribute("dir", messages.dir);
  box.textContent = result === "everywhere" ? messages.everywhere_done : messages.everywhere_partial;
  document.body.prepend(box);
}

async function accountRequest(method, path) {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), ACCOUNT_REQUEST_TIMEOUT_MS);
  try {
    const response = await fetch(ACCOUNT_API + path, {
      method,
      credentials: "omit",
      headers: { Accept: "application/json", Authorization: "Bearer " + keycloak.token },
      signal: controller.signal
    });
    if (!response.ok) {
      throw new Error(method + " " + path + " answered " + response.status);
    }
    return method === "GET" ? response.json() : null;
  } finally {
    clearTimeout(timer);
  }
}

async function endEveryOtherSession() {
  await keycloak.updateToken(30);
  const applications = await accountRequest("GET", "/applications");
  for (const application of applications.filter((entry) => entry.offlineAccess === true)) {
    await accountRequest("DELETE", "/applications/" + encodeURIComponent(application.clientId) + "/consent");
  }
  await accountRequest("DELETE", "/sessions");
}

async function logoutEverywhere() {
  let result = "partial";
  try {
    await endEveryOtherSession();
    result = "everywhere";
  } catch (e) {
    console.warn("[oidc] logout everywhere left sessions behind:", e);
  } finally {
    keycloak.logout({ redirectUri: logoutResultUri(result) });
  }
}

function requestLogoutEverywhere() {
  if (authenticated) {
    logoutEverywhere();
    return;
  }
  remember(LOGOUT_PENDING_KEY, "everywhere");
  keycloak.login({ redirectUri: KC_CONFIG.redirectUri });
}

function takeLogoutEverywhereMarker() {
  if (window.location.hash !== LOGOUT_EVERYWHERE_MARKER) return false;
  history.replaceState(null, "", window.location.pathname + window.location.search);
  return true;
}

function choosesLogoutEverywhere(link) {
  return !!link?.querySelector("." + LOGOUT_EVERYWHERE_CLASS);
}

function onLogoutEverywhere(ev) {
  if (!keycloak || !choosesLogoutEverywhere(ev.target?.closest?.("a"))) return;
  ev.preventDefault();
  ev.stopPropagation();
  requestLogoutEverywhere();
}

function wireLoginLogoutClicks() {
  const loginItem  = findMenuItemByText("Login");
  const loginA     = loginItem?.querySelector("a,button");

  loginA?.addEventListener("click", (ev) => {
    try {
      if (keycloak) {
        ev.preventDefault();
        keycloak.login({ redirectUri: KC_CONFIG.redirectUri });
        if (DEBUG) console.log("[oidc] login clicked → keycloak.login()");
      }
    } catch (e) {
      console.warn("[oidc] login handler error:", e);
    }
  }, { capture: true });

  document.addEventListener(LOGIN_EVENT, () => {
    if (keycloak) keycloak.login({ redirectUri: KC_CONFIG.redirectUri });
  });
  window.addEventListener("click", onLogoutEverywhere, { capture: true });
  window.addEventListener("hashchange", () => {
    if (keycloak && takeLogoutEverywhereMarker()) requestLogoutEverywhere();
  });
}

const IDENTITY_EVENT = "dashboard:identity";
const LOGIN_EVENT = "dashboard:login";
const GROUPS_CLAIM = {{ RBAC.GROUP.CLAIM | to_json }};

function shareGroups() {
  const claim = keycloak?.tokenParsed?.[GROUPS_CLAIM];
  const groups = keycloak?.authenticated
    ? (Array.isArray(claim) ? claim.filter((group) => typeof group === "string") : [])
    : null;
  document.dispatchEvent(new CustomEvent(IDENTITY_EVENT, { detail: { groups } }));
}

function forgetGroups() {
  document.dispatchEvent(new CustomEvent(IDENTITY_EVENT, { detail: { groups: null } }));
}

async function initAuthUI() {
  syncAuthMenuVisibility(false);
  showLogoutResult();
  const wantsLogoutEverywhere = takeLogoutEverywhereMarker() || recall(LOGOUT_PENDING_KEY) === "everywhere";

  const kcJsUrl = (KC_MIRROR_BASE && KC_JS_ASSET_URL.startsWith("https://"))
    ? KC_MIRROR_BASE + "/" + KC_JS_ASSET_URL.replace(/^https:\/\//, "")
    : KC_JS_ASSET_URL;
  let Keycloak;
  try {
    Keycloak = await loadKeycloakAdapter(kcJsUrl);
  } catch (e) {
    console.error("[oidc] Failed to load adapter:", e);
    return;
  }

  try {
    keycloak = new Keycloak({ url: KC_CONFIG.url, realm: KC_CONFIG.realm, clientId: KC_CONFIG.clientId });
    keycloak.onReady = (nextAuthenticated) => syncAuthMenuVisibility(nextAuthenticated);
    keycloak.onAuthSuccess = () => syncAuthMenuVisibility(true);
    keycloak.onAuthLogout = () => { syncAuthMenuVisibility(false); forgetGroups(); };
    keycloak.onAuthRefreshSuccess = () => syncAuthMenuVisibility(true);
    keycloak.onAuthRefreshError = () => { syncAuthMenuVisibility(false); forgetGroups(); };

    const hasAuthCode = /\bcode=/.test(window.location.search);
    const onLoadMode = hasAuthCode ? "login-required" : "check-sso";

    authenticated = await keycloak.init({
      onLoad: onLoadMode,
      pkceMethod: "S256",
      silentCheckSsoRedirectUri: KC_CONFIG.silentCheckSsoRedirectUri,
      checkLoginIframe: KEYCLOAK_IFRAME_POLLING_ENABLED,
      tokenMinValid: 30
    });
  } catch (e) {
    console.error("[oidc] Keycloak init failed:", e);
  }

  syncAuthMenuVisibility(authenticated);
  shareGroups();
  wireLoginLogoutClicks();
  window.__oidcLoginReady = true;

  if (wantsLogoutEverywhere && keycloak) {
    requestLogoutEverywhere();
    return;
  }

  async function scheduleRefresh() {
    if (!keycloak?.tokenParsed?.exp) return;
    const now = Math.floor(Date.now() / 1000);
    const exp = keycloak.tokenParsed.exp;
    const refreshInMs = Math.max((exp - now - 30), 1) * 1000;

    setTimeout(async () => {
      try {
        const ok = await keycloak.updateToken(60);
        syncAuthMenuVisibility(!!ok || !!keycloak?.authenticated);
        shareGroups();
        if (DEBUG) console.log("[oidc] token refresh → ok:", ok);
      } catch (e) {
        console.warn("[oidc] token refresh failed:", e);
        syncAuthMenuVisibility(false);
        forgetGroups();
      }
      scheduleRefresh();
    }, refreshInMs);
  }
  if (authenticated) scheduleRefresh();

  const navbar = document.querySelector("nav.navbar") || document.querySelector(".navbar") || document.querySelector("nav");
  if (navbar && "MutationObserver" in window) {
    new MutationObserver(() => syncAuthMenuVisibility(!!keycloak?.authenticated || authenticated))
      .observe(navbar, { childList: true, subtree: true });
  }

  if (DEBUG) {
    console.log("[oidc] init done", {
      authenticated,
      kcJsUrl,
      checkLoginIframe: KEYCLOAK_IFRAME_POLLING_ENABLED,
      silentCheckSsoRedirectUri: KC_CONFIG.silentCheckSsoRedirectUri
    });
  }
}

if (document.readyState === "loading") {
  document.addEventListener("DOMContentLoaded", initAuthUI, { once: true });
} else {
  initAuthUI();
}
