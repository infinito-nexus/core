  header:
    children:
    - link: applications
    - name: Toggle
      description: Enter or exit fullscreen mode
      icon:
        class: fa-solid fa-expand-arrows-alt
      onclick: "toggleFullscreen()"
    - name: Tab
      description: Open the currently embedded iframe URL in a fresh browser tab
      icon:
        class: fa-solid fa-up-right-from-square
      onclick: openIframeInNewTab()
    - name: Reload
      target: "_top"
      onclick: location.reload(true)
      description: Reload the application
      icon:
        class: fa-solid fa-rotate-right
      url:   "{{ lookup('tls', 'web-app-dashboard', 'url.base') }}"

{% if DASHBOARD_OIDC_ENABLED | bool %}

    - name: Account
      description: Manage your Account
      icon:
        class: fa-solid fa-user
      children:
        - name: Profile
          description: Manage your profile
          icon:
            class: fa-solid fa-id-card
          url: {{ OIDC.CLIENT.ACCOUNT.PROFILE_URL }}
          iframe: {{ DASHBOARD_KEYCLOAK_IFRAME_ENABLED }}
        - name: Security
          description: Manage your security settings
          icon:
            class: fa-solid fa-user-gear
          url: {{ OIDC.CLIENT.ACCOUNT.SECURITY_URL }}
          iframe: {{ DASHBOARD_KEYCLOAK_IFRAME_ENABLED }}
        - name: "{{ DASHBOARD_LOGOUT_I18N.en.choice_device }}"
          description: "Log out of {{ ORGANIZATION }} on {{ DOMAIN_PRIMARY }} in this browser"
          target: "_top"
          icon:
            class: fa-solid fa-right-from-bracket
          url: {{ OIDC.CLIENT.LOGOUT_URL }}
          iframe: false
        - name: "{{ DASHBOARD_LOGOUT_I18N.en.choice_everywhere }}"
          description: "Log out of {{ ORGANIZATION }} on {{ DOMAIN_PRIMARY }} on every device"
          target: "_top"
          icon:
            class: "fa-solid fa-users-slash {{ DASHBOARD_LOGOUT_EVERYWHERE_CLASS }}"
          url: "{{ DASHBOARD_APP_BASE_URL ~ DASHBOARD_LOGOUT_EVERYWHERE_MARKER }}"
          iframe: false
    - name: Login
      description: "Login to {{ ORGANIZATION }} on {{ DOMAIN_PRIMARY }}"
      target: "_top"
      icon:
        class: fa-solid fa-right-to-bracket
      url: {{ DASHBOARD_KEYCLOAK_LOGIN_URL }}
      iframe: false # Neccesary to refresh dashboard page after login
{% endif %}
