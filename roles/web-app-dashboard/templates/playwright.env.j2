# nocheck: persona-block-rationale — the dashboard is port-ui, a tile launcher whose whole Keycloak integration is the browser-side `oidc.js` bundle; vars/main.yml `DASHBOARD_JS_FILES` ships that file only when `services.sso.enabled` is true, so with SSO off the page renders neither a Login link nor a logout control. port-ui has no admin tier either — meta/services.yml declares `sso.flavor: oidc` and nothing role-scoped.
PERSONA_ADMINISTRATOR_BLOCKED={{ (not (lookup('config', application_id, 'services.sso.enabled') | bool)) | string | lower }}

# nocheck: persona-block-rationale — see PERSONA_ADMINISTRATOR_BLOCKED above: with SSO off `oidc.js` is not rendered, so the dashboard shows no Login link and the persona helpers have no auth surface to drive.
PERSONA_BIBER_BLOCKED={{ (not (lookup('config', application_id, 'services.sso.enabled') | bool)) | string | lower }}

PLATFORM_FAVICON_URL={{ DASHBOARD_PLATFORM_FAVICON_URL | dotenv_quote }}

PLATFORM_LOGO_URL={{ DASHBOARD_PLATFORM_LOGO_URL | dotenv_quote }}

SIMPLEICONS_SERVICE_ENABLED={{ lookup('config', application_id, 'services.simpleicons.enabled') | string | lower }}

