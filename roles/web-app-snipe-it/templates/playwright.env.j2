NODE_TLS_REJECT_UNAUTHORIZED=0

OIDC_ISSUER_URL={{ OIDC.CLIENT.ISSUER_URL | dotenv_quote }}

# nocheck: persona-block-rationale — not blocked: tasks/03_admin.yml:20-30 provisions a Snipe-IT account under lookup('users','administrator').username, which is exactly the column the trusted-header bridge matches (files/php/apply/sso_config.php:10), so the administrator journey is runnable.
PERSONA_ADMINISTRATOR_BLOCKED=false

# nocheck: persona-block-rationale — snipe-it's oauth2-proxy declares no allowed_groups (meta/services.yml:76-87), so biber passes the gate, but LoginController::loginViaRemoteUser() signs in only an existing users.username (files/php/apply/sso_config.php:10) and the role provisions the administrator row alone (tasks/03_admin.yml:20-30); biber ends up back on the native login form.
PERSONA_BIBER_BLOCKED=true

SNIPE_IT_BASE_URL={{ lookup('tls', application_id, 'url.base') | dotenv_quote }}

SSO_SERVICE_ENABLED={{ lookup('config', application_id, 'services.sso.enabled') | string | lower }}
