{% set design = lookup('design', application_id) %}
{% if design.logo is string or design.title is string %}
(function () {
{% if design.title is string %}
  var title = {{ design.title | to_json }};
  function brandTitle() {
    var current = document.title;
    if (current === title || current.endsWith(" | " + title)) {
      return;
    }
    var next = current === "Baserow" ? title : current.replace(/ \| Baserow$/, function () {
      return " | " + title;
    });
    if (next !== current) {
      document.title = next;
    }
  }
{% endif %}
  function brand() {
{% if design.logo is string %}
    var icons = document.querySelectorAll("link[rel~='icon']");
    for (var index = 0; index < icons.length; index += 1) {
      if (icons[index].getAttribute("href") !== INFINITO_DESIGN.urls.favicon_ico) {
        icons[index].setAttribute("type", "image/x-icon");
        icons[index].setAttribute("href", INFINITO_DESIGN.urls.favicon_ico);
      }
    }
{% endif %}
{% if design.title is string %}
    brandTitle();
{% endif %}
  }
  new MutationObserver(brand).observe(document.head, { childList: true, subtree: true, characterData: true, attributes: true, attributeFilter: ["href"] });
  brand();
  document.addEventListener("DOMContentLoaded", brand);
})();
{% endif %}
