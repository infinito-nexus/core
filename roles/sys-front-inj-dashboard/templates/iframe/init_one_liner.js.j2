{% set _network_base = DOMAIN_PRIMARY | network_sibling(domain | network_of, DOMAIN_PRIMARY, lookup('config', 'svc-net-tor', 'services.tor.node', '')) %}
document.addEventListener('DOMContentLoaded', function () {
  initIframeHandler(
    '{{ _network_base or DOMAIN_PRIMARY }}',
    '{{ domain }}',
    '{{ lookup("tls", "web-app-dashboard", "url.base") }}'
  );
});
