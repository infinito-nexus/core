CANONICAL_DOMAIN={{ lookup('domain', application_id) | dotenv_quote }}

LITELLM_UI_BASE_URL={{ lookup('tls', application_id, 'url.base') | dotenv_quote }}

# nocheck: persona-block-rationale: the LiteLLM admin UI has no platform-user concept. It authenticates with the UI_USERNAME/UI_PASSWORD pair svc-ai-litellm provisions, and meta/services.yml pins sso.enabled false, so the administrator persona holds no credential the UI accepts (see TODO.md).
PERSONA_ADMINISTRATOR_BLOCKED=true

# nocheck: persona-block-rationale: the LiteLLM admin UI knows only the single UI_USERNAME account svc-ai-litellm provisions, and meta/services.yml pins sso.enabled false, so no auth path exists that would admit biber (see TODO.md).
PERSONA_BIBER_BLOCKED=true
