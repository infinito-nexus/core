{% set design = lookup('design', application_id) %}
(function () {
  var root = document.documentElement;
{% if design.title is string or design.logo is string %}
  function brand() {
{% if design.title is string %}
    if (document.title !== {{ design.title | to_json }}) {
      document.title = {{ design.title | to_json }};
    }
{% endif %}
{% if design.logo is string %}
    var icons = document.querySelectorAll("link[rel~='icon']");
    if (icons.length === 0) {
      var icon = document.createElement("link");
      icon.rel = "icon";
      icon.type = "image/x-icon";
      icon.href = INFINITO_DESIGN.urls.favicon_ico;
      document.head.appendChild(icon);
    }
    for (var index = 0; index < icons.length; index += 1) {
      if (icons[index].getAttribute("href") !== INFINITO_DESIGN.urls.favicon_ico) {
        icons[index].setAttribute("href", INFINITO_DESIGN.urls.favicon_ico);
      }
    }
{% endif %}
  }
  new MutationObserver(brand).observe(document.head, { childList: true, subtree: true, characterData: true });
  brand();
  document.addEventListener("DOMContentLoaded", brand);
{% endif %}
  function chosenTheme() {
    try {
      return window.localStorage.getItem("theme");
    } catch (error) {
      return null;
    }
  }
  function handSystemChoice() {
    try {
      if (window.localStorage.getItem("theme") === null) {
        window.localStorage.setItem("theme", "system");
      }
    } catch (error) {
      return;
    }
  }
  function mirrorTheme() {
    var theme = chosenTheme();
    if (theme !== "dark" && theme !== "light") {
      if (root.hasAttribute("data-design-theme")) root.removeAttribute("data-design-theme");
    } else if (root.getAttribute("data-design-theme") !== theme) {
      root.setAttribute("data-design-theme", theme);
    }
  }
  new MutationObserver(mirrorTheme).observe(root, { attributes: true, attributeFilter: ["class"] });
  window.addEventListener("storage", mirrorTheme);
  handSystemChoice();
  mirrorTheme();
})();
