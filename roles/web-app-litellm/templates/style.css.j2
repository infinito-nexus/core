{{ code_block }},
{{ code_block }} > code {
  color: var(--design-text) !important;
  text-shadow: none !important;
}
{{ code_block }} .token {
  background: none !important;
  color: inherit !important;
}
{% for rgb, token in code_tokens %}
{{ code_block }} .token[style*="rgb({{ rgb }})"] {
  color: var(--design-{{ token }}) !important;
}
{% endfor %}
:root:has({{ sign_in }}) body {
  background-color: var(--design-surface-1);
  color: var(--design-text);
}
{{ sign_in }} {
  background-color: var(--design-surface-2);
  box-shadow: var(--design-shadow-3);
}
{{ sign_in }} :is(.logo, h2, label, .info-box p) {
  color: var(--design-text);
}
{{ sign_in }} :is(.subtitle, .help-text) {
  color: var(--design-text-muted);
}
{{ sign_in }} .info-box {
  background-color: var(--design-info-subtle);
  border-left-color: var(--design-info);
}
{{ sign_in }} .info-header {
  color: var(--design-info);
}
{{ sign_in }} .required {
  color: var(--design-danger);
}
{{ sign_in }} :is(input[type="text"], input[type="password"]) {
  border-color: var(--design-border-strong);
  background-color: var(--design-surface-2);
  color: var(--design-text);
}
{{ sign_in }} :is(input[type="text"], input[type="password"]):focus {
  border-color: var(--design-link);
  box-shadow: var(--design-focus-ring);
}
{{ sign_in }} input[type="submit"] {
  background-color: var(--design-primary);
  color: var(--design-on-primary);
}
{{ sign_in }} input[type="submit"]:hover {
  background-color: var(--design-primary-hover);
}
{{ sign_in }} input[type="submit"]:active {
  background-color: var(--design-primary-active);
}
{{ sign_in }} a {
  color: var(--design-link);
}
{{ sign_in }} code {
  background-color: var(--design-surface-3);
  color: var(--design-text);
}
{% if design.logo is string %}
img[alt="LiteLLM Brand"] {
  content: url("{{ design.urls.logo.svg }}");
}
{{ sign_in }} .logo {
  height: 3rem;
  font-size: 0;
  background: url("{{ design.urls.logo.svg }}") center / contain no-repeat;
}
{% endif %}
