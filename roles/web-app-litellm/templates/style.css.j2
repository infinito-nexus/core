{% set design = lookup('design', application_id) %}
{% set neutral = ['gray', 'slate', 'zinc', 'neutral', 'stone'] %}
{% set neutral_tokens = [(50, 'surface-3'), (100, 'surface-hover'), (200, 'border'), (300, 'border-strong'), (400, 'text-muted'), (500, 'text-muted'), (600, 'text-muted'), (700, 'text'), (800, 'text'), (900, 'text'), (950, 'text')] %}
{% set brand = ['blue', 'indigo', 'sky'] %}
{% set brand_tokens = [(50, 'primary-50'), (100, 'primary-100'), (200, 'primary-200'), (300, 'primary-400'), (400, 'primary-400'), (500, 'link'), (600, 'link'), (700, 'link'), (800, 'link'), (900, 'link'), (950, 'link')] %}
{% set status = [('red', 'danger'), ('rose', 'danger'), ('green', 'success'), ('emerald', 'success'), ('yellow', 'warning'), ('amber', 'warning'), ('orange', 'warning'), ('teal', 'info'), ('cyan', 'info'), ('purple', 'info')] %}
{% set status_tokens = [(50, '-subtle'), (100, '-subtle'), (200, '-border'), (300, ''), (400, ''), (500, ''), (600, ''), (700, ''), (800, ''), (900, ''), (950, '')] %}
{% set island_status_tokens = [(50, ''), (100, ''), (200, ''), (300, '-border'), (400, '-border'), (500, '-border'), (600, '-border'), (700, '-border'), (800, '-border'), (900, '-subtle'), (950, '-subtle')] %}
{% set island = '.text-white, [class*="bg-[#1e1e1e]"]' %}
{% set semantic_fills = [('info', 'info'), ('success', 'success'), ('warning', 'warning'), ('destructive', 'danger')] %}
{% set filled = [500, 600, 700] %}
{% set code_tokens = [
  ('112, 128, 144', 'text-muted'),
  ('153, 153, 153', 'text-muted'),
  ('153, 0, 85', 'danger'),
  ('102, 153, 0', 'success'),
  ('154, 110, 58', 'warning'),
  ('0, 119, 170', 'info'),
  ('221, 74, 104', 'danger'),
  ('238, 153, 0', 'warning'),
] %}
{% set families = [] %}
{% for name in neutral %}
{% set _ = families.append((name, neutral_tokens, '')) %}
{% endfor %}
{% for name in brand %}
{% set _ = families.append((name, brand_tokens, '')) %}
{% endfor %}
{% for name, token in status %}
{% set _ = families.append((name, status_tokens, token)) %}
{% endfor %}
{% set dark_utilities = ['bg', 'text', 'border', 'from', 'via', 'to', 'fill', 'stroke', 'ring', 'hover:bg', 'hover:text', 'hover:border', 'group-hover:bg', 'group-hover:text', 'focus:text'] %}
{% macro steps(name, tokens, prefix, mirror) %}
{% for step, token in tokens %}
  --color-{{ name }}-{{ step }}: var(--design-{{ prefix }}{{ tokens[loop.revindex0][1] if mirror else token }});
{% endfor %}
{% endmacro %}
:root:root {
  --background: var(--design-surface-1);
  --foreground: var(--design-text);
  --card: var(--design-surface-2);
  --card-foreground: var(--design-text);
  --popover: var(--design-surface-2);
  --popover-foreground: var(--design-text);
  --primary: var(--design-primary);
  --primary-foreground: var(--design-on-primary);
  --secondary: var(--design-surface-3);
  --secondary-foreground: var(--design-text);
  --muted: var(--design-surface-3);
  --muted-foreground: var(--design-text-muted);
  --accent: var(--design-surface-hover);
  --accent-foreground: var(--design-text);
  --destructive: var(--design-danger);
  --destructive-foreground: var(--design-on-danger);
  --success: var(--design-success);
  --success-foreground: var(--design-on-success);
  --warning: var(--design-warning);
  --warning-foreground: var(--design-on-warning);
  --info: var(--design-info);
  --info-foreground: var(--design-on-info);
  --border: var(--design-border);
  --input: var(--design-border-strong);
  --ring: var(--design-link);
  --sidebar: var(--design-surface-2);
  --sidebar-foreground: var(--design-text);
  --sidebar-primary: var(--design-primary);
  --sidebar-primary-foreground: var(--design-on-primary);
  --sidebar-accent: var(--design-surface-hover);
  --sidebar-accent-foreground: var(--design-text);
  --sidebar-border: var(--design-border);
  --sidebar-ring: var(--design-link);
  --neutral-border: var(--design-border);
  --logo-surface: var(--design-surface-2);
  --trace-text: var(--design-text);
  --trace-text-2: var(--design-text-muted);
  --trace-text-secondary: var(--design-text-muted);
  --trace-duration: var(--design-text-muted);
  --trace-key: var(--design-text-muted);
  --trace-placeholder: var(--design-text-muted);
  --trace-surface: var(--design-surface-2);
  --trace-chip: var(--design-surface-3);
  --trace-row-hover: var(--design-surface-hover);
  --trace-row-selected: var(--design-surface-active);
  --trace-brand: var(--design-link);
  --trace-border: var(--design-border);
  --trace-line: var(--design-border);
  --trace-card-border: var(--design-border);
  --trace-tab-active: var(--design-surface-active);
  --trace-tab-hover: var(--design-surface-hover);
  --trace-tag: var(--design-surface-3);
{% for name, tokens, prefix in families %}
{{ steps(name, tokens, prefix, false) }}
{% endfor %}
}
{% for name, tokens, prefix in families %}
{% set marked = [] %}
{% for utility in dark_utilities %}
{% set _ = marked.append('[class*="dark:' ~ utility ~ '-' ~ name ~ '-"]') %}
{% endfor %}
.dark :is({{ marked | join(', ') }}) {
{{ steps(name, tokens, prefix, true) }}
}
.dark :is({{ marked | join(', ') }}) > :not({{ marked | join(', ') }}, {{ island }}) {
{{ steps(name, tokens, prefix, false) }}
}
{% endfor %}
.dark :is({{ island }}) {
{% for name, tokens, prefix in families %}
{% if prefix %}
{{ steps(name, island_status_tokens, prefix, false) }}
{% else %}
{{ steps(name, tokens, prefix, true) }}
{% endif %}
{% endfor %}
}
.dark :is({{ island }}) > :not({{ island }}) {
{% for name, tokens, prefix in families if prefix %}
{{ steps(name, tokens, prefix, true) }}
{% endfor %}
}
:root:not(.dark) [class*="bg-[#1e1e1e]"] {
  --muted-foreground: var(--design-border-strong);
}
:is([data-slot="input"], [data-slot="textarea"], [data-slot="select-trigger"], [data-slot="input-group"]) {
  background-color: var(--design-surface-2);
}
:is([data-slot="card"], [data-slot="dialog-content"], [data-slot="select-content"], [data-slot="popover-content"], [data-slot="dropdown-menu-content"], [data-slot="combobox-content"]) {
  --tw-ring-color: var(--design-border);
}
[data-slot="table-head"] {
  background-color: var(--design-surface-3);
}
[data-slot="button"].bg-primary:not(:disabled):hover {
  background-color: var(--design-primary-hover);
}
[data-slot="button"].bg-primary:not(:disabled):active {
  background-color: var(--design-primary-active);
}
header:has(> [data-slot="breadcrumb"]) {
  background-color: var(--design-surface-2);
}
[data-slot="sidebar-menu-item"] > :is(a, button) {
  color: var(--design-text);
}
[data-slot="sidebar-menu-item"] > :is(a, button):hover {
  background-color: var(--design-surface-hover);
}
[data-slot="sidebar-menu-item"] > :is(a, button)[data-active] {
  background-color: var(--design-surface-active);
  color: var(--design-link);
}
.bg-white {
  background-color: var(--design-surface-2);
}
.text-black {
  color: var(--design-text);
}
{% set brand_fills = [] %}
{% for family in brand %}
{% for step in filled %}
{% set _ = brand_fills.append('.bg-' ~ family ~ '-' ~ step) %}
{% endfor %}
{% endfor %}
{{ brand_fills | join(', ') }} {
  background-color: var(--design-primary);
  color: var(--design-on-primary);
}
{% for family in brand %}
.hover\:bg-{{ family }}-700:hover{{ ',' if not loop.last else ' {' }}
{% endfor %}
  background-color: var(--design-primary-hover);
}
{% for family, token in status %}
{% for step in filled %}
.bg-{{ family }}-{{ step }}:not(.text-white){{ ',' if not loop.last else ' {' }}
{% endfor %}
  color: var(--design-on-{{ token }});
}
{% endfor %}
{% for fill, token in semantic_fills %}
.text-white.bg-{{ fill }} {
  color: var(--design-on-{{ token }});
}
{% endfor %}
pre:has(> code[class*="language-"]) {
  background: var(--design-surface-3) !important;
}
pre:has(> code[class*="language-"]),
pre:has(> code[class*="language-"]) > code {
  color: var(--design-text) !important;
  text-shadow: none !important;
}
pre:has(> code[class*="language-"]) > code {
  background: none !important;
}
pre:has(> code[class*="language-"]) .token {
  background: none !important;
  color: inherit !important;
}
{% for rgb, token in code_tokens %}
pre:has(> code[class*="language-"]) .token[style*="rgb({{ rgb }})"] {
  color: var(--design-{{ token }}) !important;
}
{% endfor %}
:root:has(form[action$="/login"]) body {
  background-color: var(--design-surface-1);
  color: var(--design-text);
}
form[action$="/login"] {
  background-color: var(--design-surface-2);
  box-shadow: var(--design-shadow-3);
}
form[action$="/login"] :is(.logo, h2, label, .info-box p) {
  color: var(--design-text);
}
form[action$="/login"] :is(.subtitle, .help-text) {
  color: var(--design-text-muted);
}
form[action$="/login"] .info-box {
  background-color: var(--design-info-subtle);
  border-left-color: var(--design-info);
}
form[action$="/login"] .info-header {
  color: var(--design-info);
}
form[action$="/login"] .deprecation-banner {
  background-color: var(--design-danger-subtle);
  border-color: var(--design-danger-border);
}
form[action$="/login"] :is(.required, .deprecation-banner, .deprecation-banner a) {
  color: var(--design-danger);
}
form[action$="/login"] :is(input[type="text"], input[type="password"]) {
  border-color: var(--design-border-strong);
  background-color: var(--design-surface-2);
  color: var(--design-text);
}
form[action$="/login"] :is(input[type="text"], input[type="password"]):focus {
  border-color: var(--design-link);
  box-shadow: var(--design-focus-ring);
}
form[action$="/login"] input[type="submit"] {
  background-color: var(--design-primary);
  color: var(--design-on-primary);
}
form[action$="/login"] input[type="submit"]:hover {
  background-color: var(--design-primary-hover);
}
form[action$="/login"] input[type="submit"]:active {
  background-color: var(--design-primary-active);
}
form[action$="/login"] a {
  color: var(--design-link);
}
form[action$="/login"] code {
  background-color: var(--design-surface-3);
  color: var(--design-text);
}
{% if design.logo is string %}
form[action$="/login"] .logo {
  height: 3rem;
  font-size: 0;
  background: url("{{ design.urls.logo.svg }}") center / contain no-repeat;
}
{% endif %}
