{% set design = lookup('design', application_id) %}
{% set sign_in = 'form[action$="/login"]' %}
{% set neutral = ['gray', 'slate'] %}
{% set brand = ['blue', 'indigo'] %}
{% set status = [('red', 'danger'), ('green', 'success'), ('emerald', 'success'), ('yellow', 'warning'), ('amber', 'warning'), ('orange', 'warning'), ('teal', 'info')] %}
{% set code_block = 'pre:has(> code[class*="language-"])' %}
{% set code_tokens = [
  ('112, 128, 144', 'text-muted'),
  ('153, 153, 153', 'text-muted'),
  ('153, 0, 85', 'danger'),
  ('102, 153, 0', 'success'),
  ('154, 110, 58', 'warning'),
  ('0, 119, 170', 'info'),
  ('221, 74, 104', 'danger'),
  ('238, 153, 0', 'warning'),
] %}
{% set opacity = {
  'bg': ('background-color', '--tw-bg-opacity'),
  'text': ('color', '--tw-text-opacity'),
  'border': ('border-color', '--tw-border-opacity'),
  'ring': ('--tw-ring-color', '--tw-ring-opacity'),
} %}
{% macro selector(cls) -%}
{%- set escaped = '.' ~ (cls | replace(':', '\\:') | replace('/', '\\/')) -%}
{%- set variant = cls.split(':') | first if ':' in cls else '' -%}
{%- if variant in ['hover', 'focus', 'disabled'] -%}{{ escaped }}:{{ variant }}
{%- elif variant == 'placeholder' -%}{{ escaped }}::placeholder
{%- elif variant == 'group-hover' -%}.group:hover {{ escaped }}
{%- elif variant == 'aria-selected' -%}{{ escaped }}[aria-selected="true"]
{%- elif variant in ['ui-selected', 'ui-active'] -%}
{%- set state = variant | replace('ui-', '') -%}
{{ escaped }}[data-headlessui-state~="{{ state }}"], :where([data-headlessui-state~="{{ state }}"]) {{ escaped }}
{%- else -%}{{ escaped }}
{%- endif -%}
{%- endmacro %}
{% macro paint(token, classes) %}
{% set kind = ((classes | first).split(':') | last).split('-') | first %}
{% for cls in classes %}
{{ selector(cls) }}{{ ',' if not loop.last else ' {' }}
{% endfor %}
{% if kind in opacity %}
  {{ opacity[kind][0] }}: rgba(var(--design-{{ token }}-rgb), var({{ opacity[kind][1] }}, 1));
{% else %}
  {{ kind }}: var(--design-{{ token }});
{% endif %}
}
{% endmacro %}
{% macro shades(token, kind, families, steps) %}
{% set classes = [] %}
{% for family in families %}
{% for step in steps %}
{% set _ = classes.append(kind ~ '-' ~ family ~ '-' ~ step) %}
{% endfor %}
{% endfor %}
{{ paint(token, classes) }}
{% endmacro %}
:root {
