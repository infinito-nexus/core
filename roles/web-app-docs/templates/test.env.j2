{# nocheck: swarm-loopback-port open  the host-side test reaches the docs app on this published local port, which swarm drops; 074 :27 tracks it #}
DOCS_TEST_BASE_URL={{ DOCS_LOCAL_BASE_URL }}
DOCS_TEST_COUNTRY=Germany
DOCS_TEST_DISC_SPACE_PERCENT={{ SIZE_PERCENT_CLEANUP_DISC_SPACE }}
DOCS_TEST_DNS={{ networks.internet.dns }}
DOCS_TEST_DOMAIN={{ DOMAIN_PRIMARY }}
DOCS_TEST_HLTH_RUNTIME_SEVERITY={{ lookup('config', 'sys-ctl-hlth-runtime', 'services.runtime.severity') | to_json | quote }}
DOCS_TEST_ROLE={{ lookup('guide_role', application_id) }}
DOCS_TEST_SRC_DIR={{ DOCS_TEST_SRC_DIR }}
DOCS_TEST_STACK_HOST={{ IS_STACK_HOST | bool | lower }}
DOCS_TEST_TIMEOUT={{ lookup('timeout', 5400) | int }}
GITHUB_REPOSITORY={{ lookup('env', 'GITHUB_REPOSITORY') }}
GITHUB_REPOSITORY_OWNER={{ lookup('env', 'GITHUB_REPOSITORY_OWNER') }}
INFINITO_PULL_POLICY={{ INFINITO_PULL_POLICY | default('') }}
