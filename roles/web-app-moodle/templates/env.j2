{% include 'roles/sys-svc-container/templates/env.j2' %}

MOODLE_WWWROOT={{ lookup('tls', application_id, 'url.base') | regex_replace('/$', '') }}
MOODLE_INTERNAL_HOST={{ MOODLE_MCP_SERVICE_KEY }}
MOODLE_DATAROOT={{ MOODLE_DATA_DIR }}
MOODLE_LOCALCACHEDIR={{ MOODLE_LOCAL_CACHE_DIR }}

MOODLE_DB_TYPE=mariadb
MOODLE_DB_HOST={{ lookup('database', application_id, 'host') }}
MOODLE_DB_PORT={{ lookup('database', application_id, 'port') }}
MOODLE_DB_NAME={{ lookup('database', application_id, 'name') }}
MOODLE_DB_USER={{ lookup('database', application_id, 'username') }}
MOODLE_DB_PASS={{ lookup('database', application_id, 'password') | dotenv_quote }}
MOODLE_DB_PREFIX=mdl_

MOODLE_REVERSEPROXY=false
MOODLE_SSLPROXY={{ lookup('tls', application_id, 'enabled') | string | lower }}

MOODLE_DEBUG={{ MODE_DEBUG | bool }}

MOODLE_SITE_NAME={{ MOODLE_SITE_TITLE | dotenv_quote }}
MOODLE_ADMIN_EMAIL={{ lookup('config', application_id, 'users.administrator.email') }}

MOODLE_OBJECTFS_ENABLED={{ MOODLE_OBJECTFS_ENABLED | bool | string | lower }}
{% if MOODLE_OBJECTFS_ENABLED | bool %}
MOODLE_OBJECTFS_READY_FILE={{ MOODLE_OBJECTFS_READY_FILE }}
MOODLE_OBJECTFS_S3_BUCKET={{ lookup('objstore', application_id, 'bucket') }}
MOODLE_OBJECTFS_S3_KEY={{ lookup('objstore', application_id, 'access_key') }}
MOODLE_OBJECTFS_S3_SECRET={{ lookup('objstore', application_id, 'secret_key') | dotenv_quote }}
MOODLE_OBJECTFS_S3_REGION={{ lookup('objstore', application_id, 'region') }}
MOODLE_OBJECTFS_S3_BASE_URL={{ lookup('objstore', application_id, 'url') }}
{% endif %}
