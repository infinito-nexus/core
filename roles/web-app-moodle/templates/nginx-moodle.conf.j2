# Moodle nginx vhost. Mounted into the nginx sidecar at
# /etc/nginx/conf.d/default.conf. Implements Moodle's official
# nginx recipe (https://docs.moodle.org/en/Nginx).

server {
    listen {{ MOODLE_NGINX_PORT }};
    listen [::]:{{ MOODLE_NGINX_PORT }};

    server_name _;
    root {{ MOODLE_WEBROOT_DIR }};
    index index.php;

    client_max_body_size 256M;

    {{ NETWORK_DOCKER_DNS_NGINX_DIRECTIVE }}
    set $moodle_upstream {{ MOODLE_CONTAINER }};

    location / {
        try_files $uri $uri/ /r.php$is_args$args;
    }

    location ~ [^/]\.php(/|$) {
        fastcgi_split_path_info  ^(.+\.php)(/.*)?$;
        set $path_info           $fastcgi_path_info;
        try_files                $fastcgi_script_name $fastcgi_script_name/ /r.php$is_args$args;
        fastcgi_index            index.php;
        fastcgi_pass             $moodle_upstream:{{ MOODLE_FPM_PORT }};
        include                  fastcgi_params;
        fastcgi_param SCRIPT_FILENAME   $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT     $realpath_root;
        fastcgi_param PATH_INFO         $path_info;
        fastcgi_param HTTP_PROXY        "";
        fastcgi_read_timeout            300;
    }

    location ^~ /moodledata/ {
        deny all;
        return 404;
    }

    location ~* \.(css|js|gif|jpe?g|png|webp|svg|ico|woff2?|ttf)$ {
        expires 1d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }
}
