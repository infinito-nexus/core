{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}

  {% set service_name = 'mattermost' %}
  {{ service_name }}:
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_image', application_id, 'mattermost') }}
    {{ lookup('compose_only', 'container_name', MATTERMOST_CONTAINER) }}
    {{ lookup('container_ports', ['mattermost', 'http', DOCKER_BIND_HOST]) | indent(4) }}
    {{ lookup('container_volumes', service_name) | indent(4) }}
    command: ["/mattermost/bin/mattermost", "server"]
    healthcheck:
      test: ["CMD", "/mattermost/bin/mmctl", "--local", "system", "status"]
      interval: 1m
      timeout: 10s
      retries: 3
      start_period: 30s

    {{ lookup('container_networks') | indent(4) }}
    {{ lookup('container_depends_on', application_id) | indent(4) }}

  {% if MATTERMOST_MCP_ENABLED | bool %}
  {% set service_name = 'mattermostmcp' %}
  {% set docker_compose_env = [MATTERMOST_MCP_INSTANCE_DIR, 'upstream.env'] | path_join %}
  {{ service_name }}:
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_image', application_id, 'mattermostmcp') }}
    build:
      context: {{ MATTERMOST_MCP_INSTANCE_DIR }}
      dockerfile: Dockerfile
      args:
        MCP_ADAPTER_BASE_IMAGE: {{ lookup('config', application_id, 'services.mattermostmcp.image') }}
        MCP_ADAPTER_BASE_VERSION: "{{ lookup('config', application_id, 'services.mattermostmcp.version') }}"
    {{ lookup('compose_only', 'container_name', MATTERMOST_MCP_CONTAINER) }}
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    environment:
      ADAPTER_CONTRACT: {{ MATTERMOST_MCP_CONTRACT | to_json | to_json | replace('$', '$$') }}
      ADAPTER_BEARER: {{ MATTERMOST_MCP_BEARER | to_json }}
      ADAPTER_PORT: "{{ MATTERMOST_MCP_PORT }}"
    expose:
      - "{{ MATTERMOST_MCP_PORT }}"
    {{ lookup('container_networks', own_network_only=True, provider_self_alias=False) | indent(4) }}
  {% endif %}

{{ lookup('compose_volumes') }}
{{ lookup('compose_networks') }}
