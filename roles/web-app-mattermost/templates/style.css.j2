{% set design = lookup('design', application_id) %}
{% set scope = 'html:not([data-design-app-theme="custom"])' %}
{% set colors = {
  'center-channel-bg': 'surface-1',
  'center-channel-color': 'text',
  'link-color': 'link',
  'button-bg': 'link',
  'button-color': 'surface-1',
  'error-text': 'danger',
  'sidebar-bg': 'frame',
  'sidebar-header-bg': 'frame',
  'sidebar-teambar-bg': 'frame',
  'sidebar-text': 'on-frame',
  'sidebar-unread-text': 'on-frame',
  'sidebar-header-text-color': 'on-frame',
  'sidebar-text-active-color': 'on-frame',
  'sidebar-text-active-border': 'on-frame',
  'sidebar-text-hover-bg': 'frame-hover',
  'mention-bg': 'on-frame',
  'mention-color': 'frame',
  'mention-highlight-bg': 'warning-subtle',
  'mention-highlight-link': 'link',
  'new-message-separator': 'warning',
  'online-indicator': 'success',
  'away-indicator': 'warning',
  'dnd-indicator': 'danger'
} %}
{% set triplet_names = {'error-text': 'error-text-color'} %}
{% set unprefixed_only = ['sidebar-teambar-bg'] %}
{% set steps = {
  'sidebar-text': ['08', '16', '30', '40', '50', '60', '72', '80'],
  'sidebar-header-text-color': ['80'],
  'center-channel-bg': ['88', '80', '64', '56', '40', '30', '20', '16', '08'],
  'center-channel-color': ['88', '80', '72', '64', '56', '48', '40', '32', '24', '20', '16', '08', '04'],
  'link-color': ['08'],
  'button-bg': ['88', '80', '72', '64', '56', '48', '40', '30', '24', '16', '08', '04'],
  'button-color': ['88', '80', '72', '64', '56', '48', '40', '32', '24', '16', '08', '04'],
  'error-text': ['08', '12']
} %}
{% set opacity_exceptions = {'button-bg-30': '32'} %}
{% set fills = {'button-bg': 'primary', 'button-color': 'on-primary'} %}
{{ scope }} body {
{% for name, token in colors.items() %}
  --{{ name }}: var(--design-{{ token }});
  --{{ triplet_names.get(name, name) }}-rgb: var(--design-{{ token }}-rgb);
{% if name not in unprefixed_only %}
  --sys-{{ name }}: var(--design-{{ token }});
  --sys-{{ triplet_names.get(name, name) }}-rgb: var(--design-{{ token }}-rgb);
{% endif %}
{% endfor %}
{% for name, list in steps.items() %}
{% for step in list %}
  --{{ name }}-{{ step }}: rgba(var(--design-{{ colors[name] }}-rgb), 0.{{ opacity_exceptions.get(name ~ '-' ~ step, step) }});
{% endfor %}
{% endfor %}
  --sys-color-sidebar-text-rgb: var(--design-text-rgb);
  --sys-sidebar-text-60: rgba(var(--design-on-frame-rgb), 0.6);
  --sys-sidebar-text-80: rgba(var(--design-on-frame-rgb), 0.8);
  --sys-away-indicator-dark: var(--design-warning);
  --sys-away-indicator-dark-rgb: var(--design-warning-rgb);
  --sys-denim-button-bg: var(--design-link);
  --sys-denim-button-bg-rgb: var(--design-link-rgb);
  --sys-denim-center-channel-text: var(--design-text);
  --sys-denim-center-channel-text-rgb: var(--design-text-rgb);
  --denim-button-bg: var(--design-link);
  --denim-button-bg-rgb: var(--design-link-rgb);
  --secondary-blue: var(--design-text);
  --secondary-blue-rgb: var(--design-text-rgb);
  --title-color-indigo-500: var(--design-text);
  --title-color-indigo-500-rgb: var(--design-text-rgb);
  --indigo-400: var(--design-text);
  --neutral-0: var(--design-surface-1);
  --neutral-900: var(--design-text);
  --neutral-1200: var(--design-text);
  --yellow-400: var(--design-warning);
  --away-indicator-dark: var(--design-warning);
  --warning-text: var(--design-warning);
  --offline-indicator: var(--design-text-muted);
  --error-box-background: var(--design-danger-rgb);
  --sidebar-team-background: var(--design-frame);
  --sidebar-team-background-rgb: var(--design-frame-rgb);
  --mention-highlight-bg-mixed-rgb: var(--design-warning-subtle-rgb);
  --pinned-highlight-bg-mixed-rgb: var(--design-warning-subtle-rgb);
  --own-highlight-bg-rgb: var(--design-warning-subtle-rgb);
  --calls-bg: var(--design-frame);
  --calls-bg-rgb: var(--design-frame-rgb);
  --calls-badge-bg: var(--design-frame-hover);
  --border-default: solid 1px var(--design-border);
  --border-light: solid 1px var(--design-border);
  --border-dark: solid 1px var(--design-border-strong);
  --global-header-background: var(--design-frame);
  --global-header-background-rgb: var(--design-frame-rgb);
  --global-header-text: var(--design-on-frame);
  --global-header-text-rgb: var(--design-on-frame-rgb);
  --semantic-color-general: var(--design-text-rgb);
  --semantic-color-info: var(--design-info-rgb);
  --semantic-color-success: var(--design-success-rgb);
  --semantic-color-warning: var(--design-warning-rgb);
  --semantic-color-danger: var(--design-danger-rgb);
  --center-channel-text: var(--design-text);
  --center-channel-text-rgb: var(--design-text-rgb);
  --elevation-1: var(--design-shadow-1);
  --elevation-2: var(--design-shadow-1);
  --elevation-3: var(--design-shadow-2);
  --elevation-4: var(--design-shadow-2);
  --elevation-5: var(--design-shadow-3);
  --elevation-6: var(--design-shadow-3);
}

{{ scope }} body .btn-primary,
{{ scope }} body .SendMessageButton {
{% for name, token in fills.items() %}
  --{{ name }}: var(--design-{{ token }});
  --{{ name }}-rgb: var(--design-{{ token }}-rgb);
  --sys-{{ name }}: var(--design-{{ token }});
  --sys-{{ name }}-rgb: var(--design-{{ token }}-rgb);
{% for step in steps[name] %}
  --{{ name }}-{{ step }}: rgba(var(--design-{{ token }}-rgb), 0.{{ opacity_exceptions.get(name ~ '-' ~ step, step) }});
{% endfor %}
{% endfor %}
  --denim-button-bg: var(--design-primary);
  --denim-button-bg-rgb: var(--design-primary-rgb);
  --sys-denim-button-bg: var(--design-primary);
  --sys-denim-button-bg-rgb: var(--design-primary-rgb);
}

