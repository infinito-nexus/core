{{ scope }} body #global-header,
{{ scope }} body #SidebarContainer,
{{ scope }} body #navbar,
{{ scope }} body .admin-sidebar {
  --design-focus: var(--design-on-frame);
  --border-default: solid 1px var(--design-frame-active);
  --border-light: solid 1px var(--design-frame-active);
  --border-dark: solid 1px var(--design-frame-active);
}

{{ scope }} body #global-header .Menu__content,
{{ scope }} body #global-header .dropdown-menu,
{{ scope }} body #SidebarContainer .Menu__content,
{{ scope }} body #SidebarContainer .dropdown-menu {
  --design-focus: var(--design-link);
  --border-default: solid 1px var(--design-border);
  --border-light: solid 1px var(--design-border);
  --border-dark: solid 1px var(--design-border-strong);
}

{{ scope }} body #root .main-wrapper {
  border-color: var(--design-frame-active);
}

{{ scope }} body #global-header .a11y--focused,
{{ scope }} body #SidebarContainer .a11y--focused,
{{ scope }} body #navbar .a11y--focused {
  box-shadow: 0 0 1px 3px rgba(var(--design-on-frame-rgb), 0.5), 0 0 0 1px var(--design-on-frame);
}

{{ scope }} body #SidebarContainer .SidebarChannel.active .SidebarLink {
  background-color: var(--design-frame-active);
}

{{ scope }} body .header-footer-route .header-footer-route-container {
  background-image: none;
}
{% if design.logo is string %}

{{ scope }} body #global-header [aria-controls="product-switcher-menu"] > span > svg {
  width: {{ (24 * design.slots['logo-frame'].width / design.slots['logo-frame'].height) | round | int }}px;
  height: 24px;
  background: url("{{ design.urls['logo-frame'].svg }}") left center / contain no-repeat;
}

body .hfroute-header .header-main .header-logo-link > svg {
  width: {{ (30 * design.slots.logo.width / design.slots.logo.height) | round | int }}px;
  height: 30px;
  background: url("{{ design.urls.logo.svg }}") left center / contain no-repeat;
}

{{ scope }} body #global-header [aria-controls="product-switcher-menu"] > span > svg > *,
body .hfroute-header .header-logo-link > svg > * {
  visibility: hidden;
}

body .get-app__header .get-app__logo {
  content: url("{{ design.urls.logo.svg }}");
}
{% endif %}
