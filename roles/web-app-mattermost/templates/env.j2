{% include 'roles/sys-svc-container/templates/env.j2' %}

{% for setting, value in MATTERMOST_SETTINGS.items() %}
{{ setting | upper }}={{ value | dotenv_quote }}
{% endfor %}
MM_SERVICESETTINGS_LISTENADDRESS=:{{ container_port }}
MM_SERVICESETTINGS_ENABLELOCALMODE=true
MM_EMAILSETTINGS_ENABLESIGNUPWITHEMAIL={{ MATTERMOST_LOGIN_REGISTRATION | string | lower }}
MM_SERVICESETTINGS_ENABLEUSERACCESSTOKENS={{ (lookup('config', application_id, 'services.mattermost.user_access_token_enabled') | bool) or (MATTERMOST_MCP_ENABLED | bool) }}
MM_EXPERIMENTALSETTINGS_DISABLELANDINGPAGE=true

MM_LOGSETTINGS_ENABLEFILE=false

MM_SQLSETTINGS_DRIVERNAME=postgres
MM_SQLSETTINGS_DATASOURCE={{ MATTERMOST_DATABASE_DSN }}
MM_SQLSETTINGS_MAXOPENCONNS=20
MM_SQLSETTINGS_MAXIDLECONNS=10

MM_CONFIG={{ MATTERMOST_DATABASE_DSN }}

{% if lookup('objstore', application_id, 'enabled') | bool %}
MM_FILESETTINGS_DRIVERNAME=amazons3
MM_FILESETTINGS_AMAZONS3ACCESSKEYID={{ lookup('objstore', application_id, 'access_key') }}
MM_FILESETTINGS_AMAZONS3SECRETACCESSKEY={{ lookup('objstore', application_id, 'secret_key') }}
MM_FILESETTINGS_AMAZONS3SSL=false
{% else %}
MM_FILESETTINGS_DRIVERNAME=local
MM_FILESETTINGS_DIRECTORY=/mattermost/data/
{% endif %}

{% set email = lookup('email', application_id) %}
{% if email.enabled | bool %}
MM_EMAILSETTINGS_ENABLESMTPAUTH=true
MM_EMAILSETTINGS_SMTPPASSWORD={{ email.password | dotenv_quote }}
MM_EMAILSETTINGS_CONNECTIONSECURITY=TLS
MM_EMAILSETTINGS_SENDEMAILNOTIFICATIONS=true
{% endif %}

{% if MATTERMOST_OIDC_ENABLED | bool %}
MM_GITLABSETTINGS_SECRET={{ OIDC.CLIENT.SECRET }}
MM_GITLABSETTINGS_TOKENENDPOINT={{ OIDC.CLIENT.TOKEN_URL }}
{% endif %}
