window.addEventListener("DOMContentLoaded", function () {
{% if MATTERMOST_OIDC_ENABLED | bool %}
    var SSO_ENTRY = "a[href*='/oauth/gitlab/']";
    var NATIVE_FORM = [
        ".login-body-card-form > .Input_container",
        ".login-body-card-form > .login-body-card-form-link",
        ".login-body-card-form > #saveSetting",
    ].join(", ");

    function run() {
        document.querySelectorAll(SSO_ENTRY).forEach(function (el) {
            if (el.textContent.trim() === "GitLab") {
                el.textContent = "SSO with {{ SOFTWARE_NAME }}";
            }
        });

        var btn = document.getElementById("saveSetting");
        if (document.getElementById("input_loginId") && btn && !document.querySelector(SSO_ENTRY)) {
            var a = document.createElement("a");
            a.href = "/oauth/gitlab/login";
            a.textContent = "SSO with {{ SOFTWARE_NAME }}";
            a.className = "btn btn-primary login-body-card-form-button-submit large";
            a.style.cssText = "display:flex;align-items:center;justify-content:center;width:100%;box-sizing:border-box;margin:20px 0 0 0;";
            btn.parentNode.insertBefore(a, btn.nextSibling);
        }

        document.querySelectorAll(NATIVE_FORM).forEach(function (el) {
            el.style.setProperty("display", "none", "important");
        });
    }

    run();
    new MutationObserver(run).observe(document.body, { childList: true, subtree: true });
{% endif %}
});
