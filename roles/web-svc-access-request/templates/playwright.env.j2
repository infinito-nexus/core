{% set _targets = [] %}
{% for _app_id, _entry in ACCESS_REQUEST_CATALOGUE.items() %}
{% if lookup('sso', _app_id, 'is_proxy_gated') and lookup('sso', _app_id, 'oauth2_allowed_groups') and (_entry.roles | rejectattr('tenant') | list | length) >= 2 %}
{% set _ = _targets.append(_app_id) %}
{% endif %}
{% endfor %}
{% set _target = _targets | first if _targets else '' %}
{% set _target_roles = (ACCESS_REQUEST_CATALOGUE[_target].roles | rejectattr('tenant') | list) if _target else [] %}
{% set _other = (ACCESS_REQUEST_CATALOGUE | dict2items | rejectattr('key', 'equalto', _target) | map(attribute='value.roles') | flatten | rejectattr('administrator') | rejectattr('tenant') | map(attribute='path') | first) if _target else '' %}
ACCESS_REQUEST_ADMIN_GROUP={{ ((_target_roles | selectattr('role', 'equalto', 'administrator') | map(attribute='path') | first) if _target else '') | dotenv_quote }}

ACCESS_REQUEST_FOUR_EYES={{ ACCESS_REQUEST_FOUR_EYES | string | lower }}

ACCESS_REQUEST_KEPT_ROLE_JSON={{ ((_target_roles | rejectattr('administrator') | first) if _target else {}) | to_json | dotenv_quote }}

ACCESS_REQUEST_DROPPED_ROLE_JSON={{ ((_target_roles | selectattr('administrator') | first) if _target else {}) | to_json | dotenv_quote }}

ACCESS_REQUEST_OTHER_APP_GROUP={{ _other | dotenv_quote }}

ACCESS_REQUEST_TARGET_APP={{ _target | dotenv_quote }}

ACCESS_REQUEST_TARGET_URL={{ (lookup('tls', _target, 'url.base') if _target else '') | dotenv_quote }}

ADMIN_EMAIL={{ lookup('users', 'platform_administrator').email | dotenv_quote }}

ADMIN_PASSWORD={{ lookup('users', 'platform_administrator').password | dotenv_quote }}

ADMIN_USERNAME={{ lookup('users', 'platform_administrator').username | dotenv_quote }}

APP_BASE_URL={{ lookup('tls', application_id, 'url.base') | dotenv_quote }}

BIBER_PASSWORD={{ lookup('users', 'biber').password | dotenv_quote }}

BIBER_USERNAME={{ lookup('users', 'biber').username | dotenv_quote }}

CANONICAL_DOMAIN={{ lookup('domain', application_id) | dotenv_quote }}

# nocheck: playwright-service-gate  approver and requester mails leave through the platform relay, which the persona surface cannot read
EMAIL_SERVICE_ENABLED={{ lookup('config', application_id, 'services.email.enabled') | string | lower }}

KEYCLOAK_BASE_URL={{ lookup('landing_url', 'web-app-keycloak') | dotenv_quote }}

KEYCLOAK_REALM_NAME={{ OIDC.CLIENT.REALM | dotenv_quote }}

LOGOUT_SERVICE_ENABLED={{ lookup('config', application_id, 'services.logout.enabled') | string | lower }}

MAPACHE_USERNAME={{ lookup('users', 'mapache').username | dotenv_quote }}

PROMETHEUS_INTEGRATION_ACTIVE={{ lookup('prometheus_integration_active', application_id) | string | lower }}

SSO_SERVICE_ENABLED={{ lookup('config', application_id, 'services.sso.enabled') | string | lower }}

SUPER_ADMIN_PASSWORD={{ (OIDC.ADMIN.PASSWORD | dotenv_quote) if (lookup('service', 'sso').required) else '""' }}

SUPER_ADMIN_USERNAME={{ (OIDC.ADMIN.USERNAME | dotenv_quote) if (lookup('service', 'sso').required) else '""' }}
