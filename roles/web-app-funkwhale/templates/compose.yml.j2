{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}
  {% set service_name = 'celeryworker' %}
  {{ service_name }}:
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_image', application_id, 'api') }}
    command: celery -A funkwhale_api.taskapp worker -l INFO --concurrency={{FUNKWHALE_CELERYD_CONCURRENCY}}
    environment: # nocheck: compose-environment-from-env-file celeryworker-only key; no service here overrides docker_compose_env, so the role's single env.j2 is loaded by celerybeat, api, front, typesense and migrate too, none of which has C_FORCE_ROOT today
      - C_FORCE_ROOT=true
    {{ lookup('container_volumes', service_name) | indent(4) }}
    {{ lookup('container_depends_on', application_id, extra={
  'migrate': {'condition': 'service_completed_successfully'},
}) | indent(4) }}
    {{ lookup('container_networks') | indent(4) }}

  {% set service_name = 'celerybeat' %}
  {{ service_name }}:
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_image', application_id, 'api') }}
    command: celery -A funkwhale_api.taskapp beat --pidfile= -l INFO
    {{ lookup('container_volumes', service_name) | indent(4) }}
    {{ lookup('container_depends_on', application_id, extra={
  'migrate': {'condition': 'service_completed_successfully'},
}) | indent(4) }}
    {{ lookup('container_networks') | indent(4) }}

  {% set service_name = 'api' %}
  {{ service_name }}:
    {{ lookup('container_healthcheck', service_name) | indent(4) }}
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_image', application_id, 'api') }}
    command: gunicorn
    {{ lookup('container_volumes', service_name) | indent(4) }}
    {{ lookup('container_ports',
              {'service': 'api', 'protocol': 'http',
               'publish': 'ephemeral'}) | indent(4) }}
    {{ lookup('container_depends_on', application_id, extra={
  'migrate': {'condition': 'service_completed_successfully'},
}) | indent(4) }}
    {{ lookup('container_networks') | indent(4) }}

  {% set service_name = 'front' %}
  {{ service_name }}:
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_image', application_id, 'funkwhale') }}
    {{ lookup('container_healthcheck', 'funkwhale') | indent(4) }}
    {{ lookup('depends_on', ['api']) }}
    environment: # nocheck: compose-environment-from-env-file front-only key read by the funkwhale image's nginx entrypoint; the role's single env.j2 also feeds celeryworker, celerybeat, api, typesense and migrate, none of which has NGINX_MAX_BODY_SIZE today
      - "NGINX_MAX_BODY_SIZE=100M"
    {{ lookup('container_volumes', service_name) | indent(4) }}
    {{ lookup('container_ports', ['funkwhale', 'http', DOCKER_BIND_HOST]) | indent(4) }}
    {{ lookup('container_networks') | indent(4) }}

  {% set service_name = 'typesense' %}
  {{ service_name }}:
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_image', application_id, 'typesense') }}
    {{ lookup('container_volumes', service_name) | indent(4) }}
    command: --data-dir /data --enable-cors --api-key {{ FUNKWHALE_TYPESENSE_API_KEY }}
    {% if IS_COMPOSE_MODE %}
    profiles:
      - typesense
    {% endif %}

  {% set service_name = 'migrate' %}
  {% set docker_restart_policy = 'on-failure' %}
  {{ service_name }}:
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_image', application_id, 'api') }}
    command: migrate
    {{ lookup('container_depends_on', application_id) | indent(4) }}
    {{ lookup('container_networks') | indent(4) }}

{{ lookup('compose_volumes') }}
{{ lookup('compose_networks') }}
