server_names_hash_bucket_size 128;

server {
    listen 80;
    server_name {{ SEAWEEDFS_FILER_DOMAIN }};
    client_max_body_size 0;

    location / {
        proxy_pass http://{{ SEAWEEDFS_ENGINE_HOST }}:{{ SEAWEEDFS_ENGINE_FILER_PORT }};
        {% include 'roles/sys-svc-proxy/templates/headers/forwarded_base.conf.j2' %}
    }
}

server {
    listen 80;
    server_name {{ SEAWEEDFS_MASTER_DOMAIN }};

    location / {
        proxy_pass http://{{ SEAWEEDFS_ENGINE_HOST }}:{{ SEAWEEDFS_ENGINE_MASTER_PORT }};
        {% include 'roles/sys-svc-proxy/templates/headers/forwarded_base.conf.j2' %}
    }
}

server {
    listen 80 default_server;
    server_name _;

    location = /{{ SEAWEEDFS_CONSOLE_HEALTH_PATH }} {
        return 200 "ok\n";
    }

    location / {
        return 404;
    }
}
