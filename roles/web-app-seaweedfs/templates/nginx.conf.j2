server {
    listen 80;
    server_name {{ SEAWEEDFS_FILER_DOMAIN }};
    client_max_body_size 0;

    location / {
        proxy_pass http://seaweedfs:{{ SEAWEEDFS_FILER_PORT_INTERNAL }};
        {% include 'roles/sys-svc-proxy/templates/headers/forwarded_base.conf.j2' %}
    }
}

server {
    listen 80;
    server_name {{ SEAWEEDFS_MASTER_DOMAIN }};

    location / {
        proxy_pass http://seaweedfs:{{ SEAWEEDFS_MASTER_PORT_INTERNAL }};
        {% include 'roles/sys-svc-proxy/templates/headers/forwarded_base.conf.j2' %}
    }
}

server {
    listen 80 default_server;
    server_name _;
    return 404;
}
