{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}

  {% set service_name = 's1' %}
  {{ service_name }}:
    {{ lookup('container_healthcheck', service_name) | indent(4) }}
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_image', application_id, 's1') }}
    {{ lookup('compose_only', 'pull_policy', 'never') }}
    build:
      context: {{ S1_BUILD_DIR }}
      dockerfile: Dockerfile
      args:
        S1_BASE_IMAGE: {{ S1_IMAGE }}
        S1_BASE_VERSION: "{{ S1_VERSION }}"
        S1_FLAVOR: "{{ S1_FLAVOR }}"
        S1_GPU: "{{ S1_GPU | bool | lower }}"
        S1_LAYA_CHECKPOINTS: "{{ S1_LAYA_REPOS }}"
        S1_JEFF_REPOSITORY: "{{ S1_JEFF_REPOSITORY }}"
        S1_JEFF_REF: "{{ S1_JEFF_REF }}"
        S1_JEFF_MODEL_REPO: "{{ S1_JEFF_MODEL_REPO }}"
        S1_JEFF_MODEL_PATH: "{{ S1_JEFF_MODEL_PATH }}"
    {{ lookup('compose_only', 'container_name', S1_CONTAINER) }}
    expose:
      - "{{ S1_PORT }}"
    {{ lookup('container_networks') | indent(4) }}

{{ lookup('compose_networks') }}

{{ lookup('compose_volumes') }}
