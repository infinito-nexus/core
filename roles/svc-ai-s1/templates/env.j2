{% include 'roles/sys-svc-container/templates/env.j2' %}

S1_PORT={{ S1_PORT }}
S1_MODEL_ALIAS={{ S1_MODEL_ALIAS }}
S1_API_KEY={{ S1_API_KEY | dotenv_quote }}

{% if S1_FLAVOR == 'laya' %}
LAYA_HOST=0.0.0.0
LAYA_PORT={{ S1_PORT }}
LAYA_DEVICE={{ S1_LAYA_DEVICE }}
LAYA_PRELOAD=1
LAYA_MODELS={{ S1_LAYA_CHECKPOINTS | map(attribute='name') | join(',') }}
LAYA_API_KEY={{ S1_API_KEY | dotenv_quote }}
{% else %}
JEFF_HOST=0.0.0.0
JEFF_PORT={{ S1_PORT }}
JEFF_MODEL={{ S1_JEFF_MODEL_PATH }}
JEFF_MODEL_ALIASES={{ S1_MODEL_ALIAS }}
JEFF_BACKEND={{ S1_FLAVOR }}
{% if S1_FLAVOR == 'onnx' %}
JEFF_QUANT=int8
{% endif %}
JEFF_API_KEYS={{ S1_API_KEY | dotenv_quote }}
{% endif %}
