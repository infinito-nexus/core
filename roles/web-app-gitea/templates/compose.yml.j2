{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}

  {% set service_name = 'gitea' %}
  {{ service_name }}:
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_image', application_id, 'gitea') }}
    {{ lookup('compose_only', 'container_name', GITEA_CONTAINER) }}
    {{ lookup('container_ports',
              ['gitea', 'http', DOCKER_BIND_HOST],
              ['gitea', 'ssh']) | indent(4) }}
    {{ lookup('container_volumes', application_id, 'gitea') | indent(4) }}
    {% include 'roles/sys-svc-container/templates/healthcheck/curl.yml.j2' %}
    {{ lookup('container_networks') | indent(4) }}
    {{ lookup('container_depends_on', application_id) | indent(4) }}

  {% if GITEA_MCP_ENABLED | bool %}
  {% set service_name = GITEA_MCP_SERVICE_KEY %}
  {{ service_name }}:
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_image', application_id, 'giteamcp') }}
    {{ lookup('compose_only', 'container_name', GITEA_MCP_CONTAINER) }}
    command: {{ GITEA_MCP_COMMAND | to_json }}
    environment:
      GITEA_HOST: "{{ GITEA_MCP_UPSTREAM_URL }}"
      GITEA_SCOPES: "{{ GITEA_MCP_TOOL_SCOPES }}"
      GITEA_READONLY: "true"
    {{ lookup('container_networks') | indent(4) }}
    {{ lookup('depends_on', {'gitea': 'service_healthy'}) }}
  {% endif %}

{{ lookup('compose_volumes', application_id) }}
{{ lookup('compose_networks') }}
