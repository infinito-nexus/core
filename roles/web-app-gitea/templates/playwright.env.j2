# nocheck: persona-block-rationale — Gitea turns self-registration off as soon as any IAM source is wired (GITEA__service__DISABLE_REGISTRATION in templates/env.j2, driven by GITEA_IAM_ENABLED in vars/main.yml), and tasks/setup/oidc.yml registers only the auth source, never a Gitea user. A Keycloak identity with no pre-linked Gitea account is therefore bounced back to /user/login instead of a signed-in surface (see README "Persona contract opt-outs").
PERSONA_ADMINISTRATOR_BLOCKED=true

# nocheck: persona-block-rationale — see PERSONA_ADMINISTRATOR_BLOCKED above.
PERSONA_BIBER_BLOCKED=true

SSO_SERVICE_ENABLED={{ lookup('config', application_id, 'services.sso.enabled') | string | lower }}

