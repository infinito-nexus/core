  "get_repository_tree": {
    "description": "Get the file tree of a repository at a given ref (SHA, branch, or tag), optionally recursively.",
    "input_schema": {
      "properties": {
        "owner": {
          "description": "repo owner",
          "type": "string"
        },
        "page": {
          "default": 1,
          "description": "page",
          "type": "number"
        },
        "per_page": {
          "default": 30,
          "description": "results per page",
          "type": "number"
        },
        "recursive": {
          "type": "boolean"
        },
        "repo": {
          "description": "repo name",
          "type": "string"
        },
        "tree_sha": {
          "description": "SHA, branch, or tag",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "repo",
        "tree_sha"
      ],
      "type": "object"
    },
    "mutating": false
  },
