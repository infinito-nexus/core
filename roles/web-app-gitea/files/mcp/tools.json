  "pull_request_read": {
    "description": "Read pull request: details, diff, changed files, head commit status, reviews, review comments.",
    "input_schema": {
      "properties": {
        "binary": {
          "description": "include binary diff",
          "type": "boolean"
        },
        "method": {
          "enum": [
            "get",
            "get_diff",
            "get_files",
            "get_status",
            "get_reviews",
            "get_review",
            "get_review_comments"
          ],
          "type": "string"
        },
        "owner": {
          "description": "repo owner",
          "type": "string"
        },
        "page": {
          "default": 1,
          "description": "page",
          "type": "number"
        },
        "per_page": {
          "default": 30,
          "description": "results per page",
          "type": "number"
        },
        "pull_number": {
          "type": "number"
        },
        "repo": {
          "description": "repo name",
          "type": "string"
        },
        "review_id": {
          "description": "for 'get_review'; optional for 'get_review_comments', omit to list all",
          "type": "number"
        }
      },
      "required": [
        "method",
        "owner",
        "repo",
        "pull_number"
      ],
      "type": "object"
    },
    "mutating": false
  },
  "search_issues": {
