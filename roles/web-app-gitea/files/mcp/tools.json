          "type": "string"
        },
        "repo": {
          "description": "repo name",
          "type": "string"
        },
        "withLines": {
          "description": "return numbered lines",
          "type": "boolean"
        }
      },
      "required": [
        "owner",
        "repo",
        "ref",
        "path"
      ],
      "type": "object"
    },
    "mutating": false
  },
