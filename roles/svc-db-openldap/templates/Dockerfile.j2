{% set OPENLDAP_DATA_TARGET = lookup('volume', application_id, 'data').target %}
{% set OPENLDAP_CONFIG_TARGET = lookup('volume', application_id, 'config').target %}
ARG OPENLDAP_IMAGE
ARG OPENLDAP_VERSION
FROM ${OPENLDAP_IMAGE}:${OPENLDAP_VERSION}

ENV DEBIAN_FRONTEND=noninteractive

RUN rm -rf /var/lib/apt/lists/* \
 && apt-get -o Acquire::Retries=3 update \
 && apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
    slapd slapd-contrib ldap-utils ca-certificates tini \
{% if OPENLDAP_HA | bool %}
    python3 \
{% endif %}
 && rm -rf /var/lib/apt/lists/* \
 && rm -rf {{ OPENLDAP_CONFIG_TARGET }}/* {{ OPENLDAP_DATA_TARGET }}/* \
 && mkdir -p /run/slapd {{ OPENLDAP_DATA_TARGET }} {{ OPENLDAP_CONFIG_TARGET }} \
 && chown -R openldap:openldap /run/slapd {{ OPENLDAP_DATA_TARGET }} {{ OPENLDAP_CONFIG_TARGET }}

{% if OPENLDAP_HA | bool %}
COPY infinito_elector {{ [DB_ELECTOR_DIR, 'infinito_elector'] | path_join }}
ENV PYTHONPATH={{ DB_ELECTOR_DIR }}

{% endif %}
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

COPY healthcheck.sh /healthcheck.sh
RUN chmod +x /healthcheck.sh

EXPOSE 389

HEALTHCHECK --interval=2m --timeout=5s --start-period=10m --retries=12 --start-interval=5s \
  CMD ["/healthcheck.sh"]

ENTRYPOINT ["/usr/bin/tini","--","/entrypoint.sh"]
