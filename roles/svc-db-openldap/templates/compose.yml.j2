{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}

  {% set service_name = OPENLDAP_SERVICE %}
  {% set _db = lookup('db_instances') %}
  {% for db_instance in (_db.instances if _db.form == 'ha' else [none]) %}
  {# nocheck: compose-structure  HA instance key differs from the meta service name the lookups resolve #}
  {{ db_instance.service if db_instance else service_name }}:
    build:
      context: "."
      dockerfile: Dockerfile
      args:
        OPENLDAP_IMAGE: "{{ OPENLDAP_IMAGE }}"
        OPENLDAP_VERSION: "{{ OPENLDAP_VERSION }}"
    {{ lookup('container_image', application_id, 'openldap') }}
    {{ lookup('compose_only', 'container_name', OPENLDAP_CONTAINER) }}
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
{% if db_instance %}
    environment:
      OPENLDAP_HA: "true"
      OPENLDAP_HA_SEED: "{{ db_instance.legacy | bool | lower }}"
      ELECTOR_HOST_ID: "{{ db_instance.host_id }}"
      ELECTOR_PEERS: "{{ OPENLDAP_HA_HOST_IDS | join(',') }}"
      ELECTOR_PEER_TEMPLATE: "{{ OPENLDAP_HA_PEER_TEMPLATE }}"
      ELECTOR_PORT: "{{ OPENLDAP_HA_WRITER_PORT }}"
      ELECTOR_ETCD_ENDPOINTS: "{{ ETCD_CLIENT_ENDPOINTS }}"
      ELECTOR_ETCD_USER: "{{ OPENLDAP_HA_ETCD_USER }}"
      ELECTOR_KEY: "{{ OPENLDAP_HA_ETCD_KEY }}"
      ELECTOR_LDAP_DATABASE_DN: "{{ OPENLDAP_HA_DATABASE_DN }}"
{% endif %}

    {% if OPENLDAP_NETWORK_EXPOSE_LOCAL | bool and not db_instance %}
    {{ lookup('container_ports', ['openldap', 'ldap', DOCKER_BIND_HOST]) | indent(4) }}
    {% endif %}

    {{ lookup('container_volumes', service_name, instance=db_instance) | indent(4) }}

    {% if db_instance %}
    {{ lookup('container_networks', internal=true, roles_only=['svc-dcs-etcd'], include_default=false) | indent(4) }}
    {% else %}
    {{ lookup('container_networks') | indent(4) }}
    {% endif %}
  {% endfor %}
  {% if _db.form == 'ha' %}
{% include 'roles/sys-svc-compose/templates/db_endpoint.yml.j2' %}
  {% endif %}

{{ lookup('compose_volumes') }}

{{ lookup('compose_networks') }}
