APP_BASE_URL={{ lookup('tls', application_id, 'url.base') | dotenv_quote }}

CANONICAL_DOMAIN={{ lookup('domain', application_id) | dotenv_quote }}

CDN_BASE_URL={{ lookup('landing_url', 'web-svc-cdn') | dotenv_quote }}

DESIGN_BASE_URL={{ lookup('tls', 'web-svc-design', 'url.base') | dotenv_quote }}

{% set design_targets = [] %}
{% for _t in lookup('roles_with_service', 'design', network=domain | network_of) %}
{% set _ = design_targets.append(_t | combine({'is_proxy_gated': lookup('sso', _t.id, 'is_proxy_gated') | bool})) %}
{% endfor %}
DESIGN_TARGET_ROLES_JSON={{ design_targets | to_json | dotenv_quote }}

OIDC_ISSUER_URL={{ OIDC.CLIENT.ISSUER_URL | dotenv_quote }}
