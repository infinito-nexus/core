div#mastodon, div#admin-wrapper {
  --dropdown-border-color: var(--design-primary-800);
  --dropdown-background-color: rgba(var(--design-text-rgb), 0.9);
  --dropdown-shadow: 0 20px 25px -5px rgba(var(--design-text-rgb), 0.25),
                       0 8px 10px -6px rgba(var(--design-text-rgb), 0.25);

  --modal-background-color: rgba(var(--design-text-rgb), 0.7);
  --modal-background-variant-color: rgba(var(--design-text-rgb), 0.7);
  --modal-border-color: var(--design-primary-800);

  --background-border-color: var(--design-primary-300);
  --background-filter: blur(10px) saturate(180%) contrast(75%) brightness(70%);
  --background-color: var(--design-primary-100);
  --background-color-tint: rgba(var(--design-text-rgb), 0.9);

  --surface-background-color: var(--design-primary-200);
  --surface-variant-background-color: var(--design-primary-200);
  --surface-variant-active-background-color: var(--design-primary-800);
  --on-surface-color: rgba(var(--design-text-rgb), 0.5);

  --media-outline-color: rgba(var(--design-surface-2-rgb), 0.15);
  --overlay-icon-shadow: drop-shadow(0 0 8px rgba(var(--design-text-rgb), 0.25));
}

.swal2-popup {
    color: #000;
}

/* Modal Overwrittes */ 
div.modal div.modal-content {
  --bs-modal-color: var(--design-primary-950);
  --bs-modal-bg: var(--design-primary-300);
  --bs-modal-border-color: var(--design-primary-300);
  --bs-modal-header-border-color: var(--design-primary-200);
  --bs-modal-footer-bg: var(--design-primary-200);
  --bs-modal-footer-border-color: var(--design-primary-200);
}
