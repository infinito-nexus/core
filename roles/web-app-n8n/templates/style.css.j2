{% set design = lookup('design', application_id) %}
:root,
body:not([data-theme]),
body[data-theme] {
  --color-primary: var(--design-link);
  --color-primary-shade-1: color-mix(in srgb, var(--design-link) 75%, var(--design-text));
  --color-primary-tint-1: var(--design-primary-300);
  --color-primary-tint-2: var(--design-surface-active);
  --color-primary-tint-3: var(--design-surface-hover);
  --color-secondary: var(--design-info);
  --color-secondary-shade-1: var(--design-info);
  --color-secondary-tint-1: var(--design-info-border);
  --color-secondary-tint-3: var(--design-info-subtle);
{% for status in ['success', 'warning', 'danger'] %}
  --color-{{ status }}: var(--design-{{ status }});
  --color-{{ status }}-shade-1: var(--design-{{ status }}-hover);
  --color-{{ status }}-tint-1: var(--design-{{ status }}-border);
  --color-{{ status }}-tint-2: var(--design-{{ status }}-subtle);
{% endfor %}
{% for status in ['success', 'danger'] %}
  --color-{{ status }}-light: var(--design-{{ status }}-border);
  --color-{{ status }}-light-2: var(--design-{{ status }}-border);
{% endfor %}
  --color-text-dark: var(--design-text);
  --color-text-base: color-mix(in srgb, var(--design-text) 50%, var(--design-text-muted));
  --color-text-light: var(--design-text-muted);
  --color-text-lighter: var(--design-border-strong);
  --color-text-xlight: var(--design-surface-1);
  --color-text-danger: var(--design-danger);
  --color-foreground-xdark: var(--design-text-muted);
  --color-foreground-dark: var(--design-border-strong);
  --color-foreground-base: var(--design-border);
  --color-foreground-light: var(--design-surface-3);
  --color-foreground-xlight: var(--design-surface-2);
  --color-background-dark: var(--design-text);
  --color-background-medium: var(--design-surface-active);
  --color-background-base: var(--design-surface-3);
  --color-background-light-base: var(--design-surface-3);
  --color-background-light: var(--design-surface-1);
  --color-background-xlight: var(--design-surface-2);
  --color-lm-chat-messages-background: var(--design-surface-3);
  --color-lm-chat-bot-background: var(--design-surface-2);
  --color-lm-chat-bot-border: var(--design-border);
  --color-lm-chat-user-background: var(--design-success);
  --color-lm-chat-user-border: var(--design-success);
  --color-lm-chat-user-color: var(--design-on-success);
  --color-canvas-background: var(--design-surface-1);
  --color-canvas-dot: var(--design-border);
  --color-canvas-read-only-line: var(--design-surface-3);
  --color-canvas-selected: var(--design-surface-active);
  --color-canvas-selected-transparent: rgba(var(--design-text-rgb), 0.1);
  --color-canvas-label-background: rgba(var(--design-surface-1-rgb), 0.85);
  --color-node-background: var(--design-surface-2);
  --color-node-executing-background: var(--design-surface-active);
  --color-node-executing-other-background: var(--design-surface-active);
  --color-node-pinned-border: var(--design-info);
  --color-node-running-border: var(--design-primary);
  --node-type-main-color: var(--design-text-muted);
  --color-askAssistant-button-background: var(--design-surface-2);
  --color-askAssistant-button-background-hover: var(--design-surface-hover);
  --color-askAssistant-button-background-active: var(--design-surface-active);
  --color-valid-resolvable-foreground: var(--design-success);
  --color-valid-resolvable-background: var(--design-success-subtle);
  --color-invalid-resolvable-foreground: var(--design-danger);
  --color-invalid-resolvable-background: var(--design-danger-subtle);
  --color-pending-resolvable-foreground: var(--design-text-muted);
  --color-pending-resolvable-background: var(--design-surface-3);
  --color-expression-editor-background: var(--design-surface-2);
  --color-expression-editor-modal-background: var(--design-surface-3);
  --color-expression-syntax-example: var(--design-surface-3);
  --color-autocomplete-item-selected: var(--design-info);
  --color-autocomplete-section-header-border: var(--design-border);
  --color-infobox-background: var(--design-surface-3);
  --color-infobox-examples-border-color: var(--design-border);
{% for tag in ['string', 'regex'] %}
  --color-code-tags-{{ tag }}: var(--design-success);
{% endfor %}
{% for tag in ['primitive', 'variable', 'constant', 'property', 'heading'] %}
  --color-code-tags-{{ tag }}: var(--design-info);
{% endfor %}
{% for tag in ['function', 'type', 'class'] %}
  --color-code-tags-{{ tag }}: var(--design-link);
{% endfor %}
{% for tag in ['keyword', 'invalid'] %}
  --color-code-tags-{{ tag }}: var(--design-danger);
{% endfor %}
  --color-code-tags-parameter: var(--design-text);
  --color-code-tags-comment: var(--design-text-muted);
  --color-json-default: var(--design-info);
  --color-json-null: var(--design-danger);
  --color-json-boolean: var(--design-success);
  --color-json-number: var(--design-success);
  --color-json-string: var(--design-info);
  --color-json-key: var(--design-text);
  --color-json-brackets: var(--design-text-muted);
  --color-json-brackets-hover: var(--design-link);
  --color-json-line: var(--design-border-strong);
  --color-json-highlight: var(--design-surface-active);
  --color-code-background: var(--design-surface-2);
  --color-code-background-readonly: var(--design-surface-3);
  --color-code-lineHighlight: rgba(var(--design-text-rgb), 0.06);
  --color-code-foreground: var(--design-text);
  --color-code-caret: var(--design-text);
  --color-code-selection: rgba(var(--design-link-rgb), 0.25);
  --color-code-selection-highlight: rgba(var(--design-success-rgb), 0.25);
  --color-code-gutter-background: var(--design-surface-2);
  --color-code-gutter-foreground: var(--design-text-muted);
  --color-code-gutter-foreground-active: var(--design-text);
  --color-code-indentation-marker: var(--design-border);
  --color-code-indentation-marker-active: var(--design-border-strong);
  --color-line-break: var(--design-text-muted);
  --color-code-line-break: var(--design-info-border);
  --tag-background-color: var(--design-surface-3);
  --tag-background-hover-color: var(--design-surface-hover);
  --tag-border-color: var(--design-border);
  --tag-border-hover-color: var(--design-border-strong);
  --tag-text-color: var(--design-text);
  --color-variables-usage-font: var(--design-success);
  --color-variables-usage-syntax-bg: var(--design-success-subtle);
  --color-button-primary-font: var(--design-on-primary);
  --color-button-primary-border: var(--design-primary);
  --color-button-primary-background: var(--design-primary);
  --color-button-primary-hover-active-border: var(--design-primary-hover);
  --color-button-primary-hover-active-focus-background: var(--design-primary-hover);
  --color-button-primary-focus-outline: var(--design-link);
  --color-button-primary-disabled-font: var(--design-text-muted);
  --color-button-primary-disabled-border: var(--design-border);
  --color-button-primary-disabled-background: var(--design-surface-3);
  --color-button-secondary-font: var(--design-text);
  --color-button-secondary-border: var(--design-border-strong);
  --color-button-secondary-background: var(--design-surface-2);
  --color-button-secondary-hover-active-focus-font: var(--design-link);
  --color-button-secondary-hover-active-focus-border: var(--design-link);
  --color-button-secondary-hover-background: var(--design-surface-hover);
  --color-button-secondary-active-focus-background: var(--design-surface-active);
  --color-button-secondary-focus-outline: var(--design-link);
  --color-button-secondary-disabled-font: var(--design-text-muted);
  --color-button-secondary-disabled-border: var(--design-border);
{% for status in ['success', 'warning', 'danger'] %}
  --color-button-{{ status }}-font: var(--design-on-{{ status }});
  --color-button-{{ status }}-disabled-font: var(--design-text-muted);
{% endfor %}
  --color-button-danger-border: var(--design-danger);
  --color-button-danger-focus-outline: var(--design-danger-border);
  --color-button-danger-disabled-border: var(--design-border);
  --color-button-danger-disabled-background: var(--design-surface-3);
  --color-text-button-secondary-font: var(--design-text);
  --color-button-node-creator-border-font: var(--design-text-muted);
  --color-button-node-creator-hover-font: var(--design-link);
  --color-button-node-creator-hover-border: var(--design-link);
  --color-button-node-creator-background: var(--design-surface-2);
  --color-table-header-background: var(--design-surface-3);
  --color-table-row-background: var(--design-surface-2);
  --color-table-row-even-background: var(--design-surface-1);
  --color-table-row-hover-background: var(--design-surface-hover);
  --color-table-row-highlight-background: var(--design-warning-subtle);
  --color-notification-background: var(--design-surface-2);
  --execution-card-border-new: var(--design-border-strong);
  --execution-card-border-success: var(--design-success);
  --execution-card-border-error: var(--design-danger);
  --execution-card-border-waiting: var(--design-info);
  --execution-card-border-running: var(--design-warning);
  --execution-card-border-unknown: var(--design-border-strong);
  --execution-card-background: var(--design-surface-2);
  --execution-card-background-hover: var(--design-surface-hover);
  --execution-card-text-waiting: var(--design-info);
  --execution-selector-background: var(--design-surface-active);
  --execution-selector-text: var(--design-text);
  --execution-select-all-text: var(--design-link);
  --color-run-data-background: var(--design-surface-3);
  --color-ndv-droppable-parameter: var(--design-info);
  --color-ndv-droppable-parameter-background: var(--design-info-subtle);
  --color-ndv-droppable-parameter-active-background: var(--design-success-subtle);
  --color-ndv-back-font: var(--design-on-frame);
  --color-notice-warning-border: var(--design-warning-border);
  --color-notice-warning-background: var(--design-warning-subtle);
  --color-notice-font: var(--design-text);
  --color-callout-info-border: var(--design-border);
  --color-callout-info-background: var(--design-surface-2);
  --color-callout-info-font: var(--design-text);
  --color-callout-info-icon: var(--design-text-muted);
{% for status in ['success', 'warning', 'danger'] %}
  --color-callout-{{ status }}-border: var(--design-{{ status }}-border);
  --color-callout-{{ status }}-background: var(--design-{{ status }}-subtle);
  --color-callout-{{ status }}-font: var(--design-{{ status }});
  --color-callout-{{ status }}-icon: var(--design-{{ status }});
{% endfor %}
  --color-callout-secondary-border: var(--design-info-border);
  --color-callout-secondary-background: var(--design-info-subtle);
  --color-callout-secondary-font: var(--design-info);
  --color-callout-secondary-icon: var(--design-info);
  --color-dialog-background: var(--design-surface-2);
  --color-dialog-overlay-background: rgba(var(--design-surface-1-rgb), 0.75);
  --color-dialog-overlay-background-dark: rgba(var(--design-frame-rgb), 0.75);
  --color-block-ui-overlay: var(--design-frame);
  --color-avatar-font: var(--design-on-frame);
  --color-nps-survey-background: var(--design-text);
  --color-nps-survey-font: var(--design-surface-1);
  --color-action-dropdown-item-active-background: var(--design-surface-active);
  --color-switch-background: var(--design-border-strong);
  --color-switch-active-background: var(--design-success);
  --color-switch-border-color: transparent;
  --color-switch-toggle: var(--design-surface-2);
  --color-feature-request-font: var(--design-surface-1);
  --color-background-input-triple: var(--design-surface-1);
  --color-node-error-output-text-color: var(--design-danger);
  --color-mfa-recovery-code-background: var(--design-surface-3);
  --color-mfa-recovery-code-color: var(--design-text-muted);
  --color-mfa-lose-access-text-color: var(--design-danger);
  --color-text-highlight-background: var(--design-warning-subtle);
  --color-info: var(--design-text-muted);
  --color-info-tint-1: var(--design-border-strong);
  --color-info-tint-2: var(--design-surface-3);
  --color-grey: var(--design-border-strong);
  --color-light-grey: var(--design-border);
  --color-neutral: var(--design-text-muted);
  --color-configurable-node-name: var(--design-text);
  --color-secondary-link: var(--design-link);
  --color-secondary-link-hover: color-mix(in srgb, var(--design-link) 75%, var(--design-text));
  --color-icon-base: var(--design-text-muted);
  --color-icon-hover: var(--design-link);
  --color-menu-background: var(--design-surface-2);
  --color-menu-hover-background: var(--design-surface-hover);
  --color-menu-active-background: var(--design-surface-active);
  --input-border-color: var(--design-border-strong);
  --box-shadow-base: var(--design-shadow-2);
  --box-shadow-dark: var(--design-shadow-2);
  --box-shadow-light: var(--design-shadow-2);
}
body {
  background-color: var(--design-surface-1);
}
a:active {
  color: var(--design-link);
}
.n8n-avatar svg g > rect {
  fill: var(--design-frame);
}
.n8n-avatar svg g > path:first-of-type {
  fill: var(--design-frame-hover);
}
.n8n-avatar svg g > path:last-of-type {
  fill: var(--design-frame-active);
}
.el-checkbox__inner,
.el-radio__inner {
  border-color: var(--design-border-strong);
}
.el-loading-mask {
  background-color: rgba(var(--design-surface-1-rgb), 0.9);
}
.el-message-box__btns .btn--confirm,
.el-color-dropdown__btn {
  background-color: var(--design-primary);
  border-color: var(--design-primary);
}
.el-message-box__btns .btn--confirm:hover,
.el-message-box__btns .btn--confirm:focus,
.el-color-dropdown__btn:hover,
.el-color-dropdown__btn:focus {
  background-color: var(--design-primary-hover);
  border-color: var(--design-primary-hover);
}
.el-message-box__btns .btn--confirm:active,
.el-message-box__btns .btn--confirm.is-active,
.el-color-dropdown__btn:active,
.el-color-dropdown__btn.is-active {
  background: var(--design-primary-active);
  border-color: var(--design-primary-active);
}
.el-message-box__btns .btn--cancel,
.el-message-box__btns .btn--cancel:focus,
.el-message-box__btns .btn--cancel:hover,
.el-message-box__btns .btn--cancel:active,
.el-picker-panel__link-btn,
.el-picker-panel__link-btn:focus,
.el-picker-panel__link-btn:hover,
.el-picker-panel__link-btn:active {
  color: var(--design-link);
  border-color: var(--design-link);
}
{% if design.logo is string %}
[data-test-id="n8n-logo"] {
  background: url("{{ design.urls.brand.svg if design.title is string else design.urls.logo.svg }}") left center / auto 125% no-repeat;
}
[data-test-id="n8n-logo"][class*="_authView_"] {
  background-position: center;
}
[data-test-id="n8n-logo"][class*="_sidebarCollapsed_"] {
  background-image: url("{{ design.urls.logo.svg }}");
  background-position: center;
}
[data-test-id="n8n-logo"] > svg {
  visibility: hidden;
}
{% endif %}
