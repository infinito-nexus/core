{% include 'roles/sys-svc-container/templates/env.j2' %}

BROKER_PORT={{ AGENT_BROKER_PORT }}
BROKER_KEY={{ AGENT_BROKER_KEY | dotenv_quote }}
BROKER_ALIAS={{ entity_name }}
ENGINE_SOCKET={{ AGENT_ENGINE_SOCKET }}
ENGINE_MODE={{ DEPLOYMENT_MODE }}
AGENT_RUNTIME={{ AGENT_BROKER_RUNTIME }}
AGENT_CONSTRAINT={{ AGENT_BROKER_CONSTRAINT | dotenv_quote }}
LITELLM_URL={{ LITELLM_BASE_LOCAL_URL }}
LITELLM_KEY={{ AGENT_BROKER_LITELLM_KEY | dotenv_quote }}
AGENT_MODEL={{ LITELLM_CHAT_MODEL | dotenv_quote }}
AGENT_PLATFORMS={{ AGENT_BROKER_PLATFORMS | to_json | dotenv_quote }}
KEYCLOAK_URL={{ lookup('tls', 'web-app-keycloak', 'url.base') }}
KEYCLOAK_REALM={{ OIDC.CLIENT.REALM | dotenv_quote }}
KEYCLOAK_ADMIN_USERNAME={{ lookup('users', 'administrator').username | dotenv_quote }}
KEYCLOAK_ADMIN_PASSWORD={{ lookup('users', 'administrator').password | dotenv_quote }}
ACCESS_CACHE_SECONDS={{ AGENT_BROKER_AGENTS.access_cache_seconds }}
IDLE_STOP={{ AGENT_BROKER_AGENTS.idle_stop | bool | string | lower }}
IDLE_MINUTES={{ AGENT_BROKER_AGENTS.idle_minutes }}
MAX_RUNNING={{ AGENT_BROKER_AGENTS.max_running }}
START_TIMEOUT={{ AGENT_BROKER_AGENTS.start_timeout }}
REQUEST_TIMEOUT={{ AGENT_BROKER_REQUEST_TIMEOUT }}
