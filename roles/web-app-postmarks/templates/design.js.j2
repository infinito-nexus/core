{% set design = lookup('design', application_id) %}
(function () {
{% if design.logo is string %}
  function brandIcon() {
    var icons = document.querySelectorAll("link[rel~='icon'], link[rel='apple-touch-icon']");
    for (var index = 0; index < icons.length; index += 1) {
      var wanted = icons[index].rel === "apple-touch-icon" ? {{ design.urls['apple-touch-icon'].png | to_json }} : {{ design.urls.favicon_ico | to_json }};
      if (icons[index].getAttribute("href") !== wanted) {
        icons[index].setAttribute("href", wanted);
      }
    }
  }
{% endif %}
{% if design.title is string %}
  var title = {{ design.title | to_json }};
  function brandTitle() {
    var parts = document.title.split(" | ");
    if (parts.length > 1 && parts[parts.length - 1] !== title) {
      parts[parts.length - 1] = title;
      document.title = parts.join(" | ");
    }
    var name = document.querySelector(".header .logo a, .header .title h1 a");
    if (name) {
      for (var node = name.firstChild; node; node = node.nextSibling) {
        if (node.nodeType === 3 && node.nodeValue.trim() && node.nodeValue.trim() !== title) {
          node.nodeValue = " " + title + " ";
        }
      }
    }
  }
{% endif %}
  function apply() {
{% if design.logo is string %}
    brandIcon();
{% endif %}
{% if design.title is string %}
    brandTitle();
{% endif %}
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", apply);
  } else {
    apply();
  }
})();
