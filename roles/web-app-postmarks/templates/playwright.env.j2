ADMIN_PASSWORD={{ lookup('users', 'administrator').password | dotenv_quote }}

ADMIN_USERNAME={{ lookup('users', 'administrator').username | dotenv_quote }}

APP_BASE_URL={{ lookup('tls', application_id, 'url.base') }}

BIBER_PASSWORD={{ lookup('users', 'biber').password | dotenv_quote }}

BIBER_USERNAME={{ lookup('users', 'biber').username | dotenv_quote }}

CANONICAL_DOMAIN={{ lookup('domain', application_id) | dotenv_quote }}

# nocheck: playwright-service-gate — covered by sys-svc-mail integration tests, not the persona surface
EMAIL_SERVICE_ENABLED={{ lookup('config', application_id, 'services.email.enabled') | string | lower }}

LOGOUT_SERVICE_ENABLED={{ lookup('config', application_id, 'services.logout.enabled') | string | lower }}

MATOMO_BASE_URL={{ lookup('tls', 'web-app-matomo', 'url.base') | dotenv_quote }}

MATOMO_SERVICE_ENABLED={{ lookup('config', application_id, 'services.matomo.enabled') | string | lower }}

NODE_TLS_REJECT_UNAUTHORIZED=0

OIDC_ISSUER_URL={{ OIDC.CLIENT.ISSUER_URL | dotenv_quote }}

# nocheck: persona-block-rationale — Postmarks has no account system at all: its only native credential is the single shared ADMIN_KEY typed into the /admin password form (templates/env.j2:7, files/sso/header_auth.js:6, README "Single sign-on"), which is not the Keycloak administrator secret the persona types, and only the trusted-header bridge behind the oauth2-proxy mints an owner session — so the sso: false variants leave no admin login to drive (see README "Persona contract opt-outs").
PERSONA_ADMINISTRATOR_BLOCKED={{ 'false' if (lookup('config', application_id, 'services.sso.enabled') | bool) else 'true' }}

# nocheck: persona-block-rationale — the oauth2-proxy admits only the web-app-postmarks administrator RBAC group (meta/services.yml:12-13) and the bridge re-checks X-Forwarded-Groups against it (files/sso/header_auth.js:63-78), so biber is denied before Postmarks is reached; with SSO off the only credential left is the shared ADMIN_KEY (templates/env.j2:7), which belongs to no user account (see README "Persona contract opt-outs").
PERSONA_BIBER_BLOCKED=true

POSTMARKS_BASE_URL={{ lookup('tls', application_id, 'url.base') | dotenv_quote }}

SSO_SERVICE_ENABLED={{ lookup('config', application_id, 'services.sso.enabled') | string | lower }}

