{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}
  {% set service_name = 'postmarks' %}
  {{ service_name }}:
    {{ lookup('template', 'roles/sys-svc-container/templates/build.yml.j2') | indent(4) }}
      args:
        NODE_BASE: "{{ lookup('config', application_id, 'services.postmarks.image') }}:{{ lookup('config', application_id, 'services.postmarks.version') }}"
        POSTMARKS_REPO_URL: "{{ POSTMARKS_REPO_URL }}"
        POSTMARKS_REF: "{{ POSTMARKS_REF }}"
        CONTAINER_PORT: "{{ container_port | string }}"
    {{ lookup('container_image', application_id, 'postmarks') }}
    {{ lookup('compose_only', 'container_name', POSTMARKS_CONTAINER) }}
    hostname: "{{ container_hostname }}"
    {{ lookup('container_ports', ['postmarks', 'http', DOCKER_BIND_HOST]) | indent(4) }}
    {{ lookup('container_healthcheck', service_name) | indent(4) }}
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_networks') | indent(4) }}

{{ lookup('compose_volumes') }}

{{ lookup('compose_networks') }}
