{% set design = lookup('design', application_id) %}
(function () {
  var KEY = "isDarkMode";
  var SEED = "infinito-design-seeded-dark-mode";
  var root = document.documentElement;
  function read(name) {
    try {
      return window.localStorage.getItem(name);
    } catch (error) {
      return null;
    }
  }
  function write(name, value) {
    try {
      if (value === null) {
        window.localStorage.removeItem(name);
      } else {
        window.localStorage.setItem(name, value);
      }
    } catch (error) {
      return;
    }
  }
  function boot() {
    var stored = read(KEY);
    var seeded = read(SEED);
    if (stored === null || stored === seeded) {
      var value = window.matchMedia("(prefers-color-scheme: dark)").matches ? "true" : "false";
      write(KEY, value);
      write(SEED, value);
      root.removeAttribute("data-design-theme");
      return;
    }
    write(SEED, null);
    root.setAttribute("data-design-theme", stored === "true" ? "dark" : "light");
  }
  function picked(event) {
    if (!event.target.closest || !event.target.closest(".MuiAppBar-root .MuiSwitch-root")) {
      return;
    }
    window.setTimeout(function () {
      write(SEED, null);
      root.setAttribute("data-design-theme", read(KEY) === "true" ? "dark" : "light");
    }, 0);
  }
  boot();
  document.addEventListener("change", picked, true);
{% if design.title is string %}
  var title = {{ design.title | to_json }};
  function brandTitle() {
    if (document.title !== title) {
      document.title = title;
    }
  }
  function watchTitle() {
    var element = document.querySelector("title");
    if (!element) {
      return false;
    }
    new MutationObserver(brandTitle).observe(element, { childList: true, characterData: true, subtree: true });
    brandTitle();
    return true;
  }
  if (!watchTitle()) {
    document.addEventListener("DOMContentLoaded", watchTitle);
  }
{% endif %}
{% if design.logo is string %}
  function brandIcon() {
    var icons = document.querySelectorAll("link[rel~='icon']");
    for (var index = 0; index < icons.length; index += 1) {
      if (icons[index].getAttribute("href") !== {{ design.urls.favicon_ico | to_json }}) {
        icons[index].setAttribute("type", "image/x-icon");
        icons[index].setAttribute("href", {{ design.urls.favicon_ico | to_json }});
      }
    }
  }
  new MutationObserver(brandIcon).observe(document.head, { childList: true, subtree: true, attributes: true, attributeFilter: ["href"] });
  brandIcon();
  document.addEventListener("DOMContentLoaded", brandIcon);
{% endif %}
})();
