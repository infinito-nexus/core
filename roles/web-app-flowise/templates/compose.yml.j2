{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}

  {% set service_name = 'flowise' %}
  {{ service_name }}:
    {{ lookup('container_healthcheck', service_name) | indent(4) }}
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_image', application_id, 'flowise', custom=True) }}
    build:
      context: {{ FLOWISE_BUILD_DIR }}
      dockerfile: Dockerfile
      args:
        FLOWISE_BASE_IMAGE: {{ lookup('config', application_id, 'services.flowise.image') }}
        FLOWISE_BASE_TAG: "{{ lookup('config', application_id, 'services.flowise.version') }}"
        FLOWISE_VERSION: "{{ FLOWISE_NPM_VERSION }}"
        FLOWISE_SQLITE_VERSION: "{{ FLOWISE_SQLITE_VERSION }}"
    {{ lookup('compose_only', 'container_name', FLOWISE_CONTAINER) }}
    {{ lookup('container_depends_on', application_id) | indent(4) }}
    {{ lookup('container_ports', ['flowise', 'http', DOCKER_BIND_HOST]) | indent(4) }}
    {{ lookup('container_volumes', service_name) | indent(4) }}
    {{ lookup('container_networks') | indent(4) }}

{{ lookup('compose_networks') }}

{{ lookup('compose_volumes') }}
