(function () {
  var root = document.documentElement;
  var roleTheme = {{ ESPOCRM_DESIGN_THEME | to_json }};
  function mirror() {
    var name = document.body.getAttribute("data-theme-name");
    if (!name || name === roleTheme) {
      root.removeAttribute("data-design-theme");
    } else {
      root.setAttribute("data-design-theme", document.body.getAttribute("data-is-dark") === "true" ? "dark" : "light");
    }
  }
  function watch() {
    mirror();
    new MutationObserver(mirror).observe(document.body, {
      attributes: true,
      attributeFilter: ["data-theme-name", "data-is-dark"],
    });
  }
  if (document.body) {
    watch();
  } else {
    document.addEventListener("DOMContentLoaded", watch);
  }
})();
