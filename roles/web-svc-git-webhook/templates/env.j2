{% include 'roles/sys-svc-container/templates/env.j2' %}

PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
{# Exception: compact separators keep the JSON free of whitespace; in swarm dotenv_quote wraps any value with a space in quotes, and docker stack deploy keeps those quotes literally, so the receiver would decode a str instead of the provider map. #}
WEBHOOK_PROVIDERS={{ GIT_WEBHOOK_PROVIDERS | to_json(separators=(',', ':')) | dotenv_quote }}
WEBHOOK_PORT={{ GIT_WEBHOOK_PORT }}
WEBHOOK_MAX_BYTES={{ GIT_WEBHOOK_MAX_BYTES }}
WEBHOOK_STATE_DB={{ GIT_WEBHOOK_STATE_DB }}
WEBHOOK_REPLAY_DAYS={{ GIT_WEBHOOK_REPLAY_DAYS }}
WEBHOOK_API_TIMEOUT={{ GIT_WEBHOOK_API_TIMEOUT }}
WEBHOOK_PR_ATTEMPTS={{ GIT_WEBHOOK_PR_ATTEMPTS }}
WEBHOOK_PR_DELAY={{ GIT_WEBHOOK_PR_DELAY }}
