API_TIMEOUT={{ GIT_WEBHOOK_API_TIMEOUT }}
DEFAULT_BRANCH=main
ENTITY={{ entity_name }}
MANAGER_LOGS_VOLUME={{ lookup('volume', 'web-app-wazuh', 'manager_logs').docker_name if GIT_WEBHOOK_TEST_WAZUH | bool else '' }}
MAX_BYTES={{ GIT_WEBHOOK_MAX_BYTES }}
PACKAGE_HOST={{ GIT_WEBHOOK_PACKAGE_HOST }}
PACKAGE_TARGET={{ GIT_WEBHOOK_PACKAGE_TARGET }}
RECEIVER_HOST={{ lookup('tls', application_id, 'domain') }}
RECEIVER_IMAGE={{ GIT_WEBHOOK_IMAGE }}
RECEIVER_PATH={{ GIT_WEBHOOK_PATH }}
RECEIVER_PORT={{ GIT_WEBHOOK_PORT }}
RECEIVER_SCRIPT={{ GIT_WEBHOOK_RECEIVER_HOST }}
RECEIVER_TARGET={{ GIT_WEBHOOK_RECEIVER_TARGET }}
RECEIVER_URL=http://127.0.0.1:{{ lookup('config', application_id, 'services.' ~ entity_name ~ '.ports.local.http') }}
RETRIES=60
SETTINGS_DRIFT_RULE={{ GIT_WEBHOOK_SETTINGS_RULE_IDS.drift }}
SETTINGS_FAILED_RULE={{ GIT_WEBHOOK_SETTINGS_RULE_IDS.failed }}
SETTINGS_PRT_RULE={{ GIT_WEBHOOK_SETTINGS_RULE_IDS.pull_request_target }}
SETTINGS_SCRIPT={{ 'sys-ctl-hlth-git-settings' | get_service_script_path('py') }}
SETTINGS_TAG={{ lookup('wazuh_ruleset', scope='host').git_settings.program }}
SETTINGS_UNSUPPORTED_RULE={{ GIT_WEBHOOK_SETTINGS_RULE_IDS.unsupported }}
SLEEP_SECONDS=5
WAZUH_MANAGER_LOCAL={{ GIT_WEBHOOK_TEST_WAZUH | bool | lower }}
WEBHOOK_SECRET={{ GIT_WEBHOOK_SECRET | dotenv_quote }}
