---
_meta:
  type: "rolesmapping"
  config_version: 2

all_access:
  reserved: true
  backend_roles:
    - "{{ WAZUH_SECURITY.admin_group }}"
    - "{{ WAZUH_RBAC_ADMIN_LDAP_CN }}"
    - "admin"

security_analyst:
  reserved: true
  backend_roles:
    - "{{ WAZUH_SECURITY.analyst_group }}"
    - "{{ WAZUH_RBAC_ANALYST_LDAP_CN }}"

readonly_auditor:
  reserved: true
  backend_roles:
    - "{{ WAZUH_SECURITY.readonly_group }}"
    - "{{ WAZUH_RBAC_READONLY_LDAP_CN }}"

kibana_read_only:
  reserved: true
  backend_roles:
    - "{{ WAZUH_SECURITY.readonly_group }}"
    - "{{ WAZUH_RBAC_READONLY_LDAP_CN }}"

kibana_server:
  reserved: true
  users:
    - "{{ WAZUH_DASHBOARD_SERVICE_USERNAME }}"
