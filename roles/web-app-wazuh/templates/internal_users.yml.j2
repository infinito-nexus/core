---
_meta:
  type: "internalusers"
  config_version: 2

"{{ WAZUH_INDEXER_ADMIN_USERNAME }}":
  hash: "{{ WAZUH_INDEXER_ADMIN_HASH }}"
  reserved: true
  backend_roles:
    - "admin"
  description: "Bootstrap/service account used by securityadmin.sh, health checks, and manager/dashboard INDEXER_PASSWORD."

"{{ WAZUH_DASHBOARD_SERVICE_USERNAME }}":
  hash: "{{ WAZUH_DASHBOARD_SERVICE_HASH }}"
  reserved: true
  description: "Service account wazuh.dashboard uses for its own backend calls to wazuh.indexer."
{% if not WAZUH_OIDC_ENABLED %}

"{{ WAZUH_PLATFORM_ADMIN_USERNAME }}":
  hash: "{{ WAZUH_PLATFORM_ADMIN_HASH }}"
  reserved: false
  backend_roles:
    - "admin"
  description: "Platform administrator, signs in with HTTP basic auth while single sign-on is off."
{% endif %}
