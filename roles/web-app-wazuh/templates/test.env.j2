{% set opted = WAZUH_RULESET_ENTITIES | map(attribute='entity') | list %}
{% set app = WAZUH_RULESET_ENTITIES | first %}
{% set ns = namespace(role='') %}
{% for role in lookup('applications') | list | sort %}
{% if not ns.role and (role | get_entity_name) not in opted + ['wazuh'] and not (lookup('config', role, 'services.wazuh.enabled', False) | bool) %}
{% set ns.role = role %}
{% endif %}
{% endfor %}
APP_ENTITY={{ app.entity }}
APP_DECODER={{ app.decoder }}
APP_PARENT_RULE={{ app.rule_block }}
APP_URL=http://{{ WAZUH_APP_CANARY_HOST }}:{{ lookup('config', app.role, 'services.' ~ app.entity ~ '.ports.local.http') }}
APP_HOST={{ lookup('tls', app.role, 'domain') }}
CANARY_MARKER={{ WAZUH_CANARY_MARKER }}
CANARY_RULE={{ WAZUH_CANARY_RULE_ID }}
FOREIGN_ENTITY={{ ns.role | get_entity_name }}
INDEXER_PASSWORD={{ WAZUH_INDEXER_ADMIN_PASSWORD | dotenv_quote }}
INDEXER_URL={{ WAZUH_INDEXER_INTERNAL_API_URL }}
INDEXER_USER={{ WAZUH_INDEXER_ADMIN_USERNAME }}
MANAGER_LOGS_VOLUME={{ lookup('volume', application_id, 'manager_logs').docker_name }}
OPTED_ENTITIES={{ opted | join(' ') | dotenv_quote }}
RETRIES={{ WAZUH_CANARY_WAIT_RETRIES }}
SELFTEST_DECODER={{ WAZUH_RULESET_SELFTEST.decoder }}
SELFTEST_PARENT_RULE={{ WAZUH_SELFTEST_RULE_ID }}
SELFTEST_TAG={{ WAZUH_RULESET_SELFTEST.program }}
SLEEP_SECONDS={{ WAZUH_AGENT_WAIT_DELAY }}
TEST_IMAGE={{ WAZUH_TEST_IMAGE }}
WAZUH_CONTAINERS={{ [WAZUH_MANAGER_CONTAINER, WAZUH_INDEXER_CONTAINER, WAZUH_DASHBOARD_CONTAINER] | join(' ') | dotenv_quote }}
