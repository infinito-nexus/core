ADMIN_EMAIL={{ lookup('users', 'administrator').email | dotenv_quote }}

ADMIN_PASSWORD={{ lookup('users', 'administrator').password | dotenv_quote }}

APP_BASE_URL={{ lookup('tls', application_id, 'url.base') | regex_replace('/+$', '') | dotenv_quote }}

BIBER_EMAIL={{ lookup('users', 'biber').email | dotenv_quote }}

BIBER_PASSWORD={{ lookup('users', 'biber').password | dotenv_quote }}

BIBER_USERNAME={{ lookup('users', 'biber').username | dotenv_quote }}

CANONICAL_DOMAIN={{ lookup('domain', application_id) | dotenv_quote }}

DECIDIM_BASE_URL={{ lookup('tls', application_id, 'url.base') | regex_replace('/+$', '') | dotenv_quote }}

# nocheck: playwright-service-gate — covered by sys-svc-mail integration tests, not the persona surface
EMAIL_SERVICE_ENABLED={{ lookup('config', application_id, 'services.email.enabled') | string | lower }}

LOGOUT_SERVICE_ENABLED={{ lookup('config', application_id, 'services.logout.enabled') | string | lower }}

MATOMO_BASE_URL={{ lookup('tls', 'web-app-matomo', 'url.base') | dotenv_quote }}

MATOMO_SERVICE_ENABLED={{ lookup('config', application_id, 'services.matomo.enabled') | string | lower }}

OIDC_ISSUER_URL={{ DECIDIM_OIDC_ISSUER | dotenv_quote }}


# nocheck: persona-block-rationale — Decidim's admin is a Devise account seeded by files/ruby/ensure_admin_user.rb, and Devise signs in by e-mail; this env therefore renders ADMIN_EMAIL and deliberately no ADMIN_USERNAME, while the shared helper reads `ADMIN_USERNAME` (roles/test-e2e-playwright/files/personas/admin.js) and so has nothing to type. The role's own "admin can log in and out" test drives the e-mail form instead.
PERSONA_ADMINISTRATOR_BLOCKED=true

# nocheck: persona-block-rationale — biber's Keycloak login works (the role's own "biber can log in via OIDC and log out" test proves it), but Decidim's sign-out is a `data-method` link inside the account dropdown that the shared in-app-logout helper cannot drive; files/playwright/playwright.spec.js navigates to `/users/sign_out` directly instead of clicking it.
PERSONA_BIBER_BLOCKED=true

SEAWEEDFS_ADMIN_PASSWORD={{ lookup('users', 'administrator').password | dotenv_quote }}

SEAWEEDFS_ADMIN_USERNAME={{ lookup('users', 'administrator').username | dotenv_quote }}

SEAWEEDFS_APP_BUCKET={{ lookup('objstore', application_id, 'bucket') | dotenv_quote }}

SEAWEEDFS_FILER_URL={{ lookup('canonical_url', 'web-app-seaweedfs', 'filer', consumer=application_id) | dotenv_quote }}

SEAWEEDFS_SERVICE_ENABLED={{ lookup('config', application_id, 'services.seaweedfs.enabled') | string | lower }}

SSO_SERVICE_ENABLED={{ lookup('config', application_id, 'services.sso.enabled') | string | lower }}

