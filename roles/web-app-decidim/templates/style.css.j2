  --tw-ring-shadow: 0 0 transparent;
  --tw-shadow: 0 0 transparent;
  --tw-shadow-colored: 0 0 transparent;
}
input::-moz-placeholder,
textarea::-moz-placeholder,
input::placeholder,
textarea::placeholder {
