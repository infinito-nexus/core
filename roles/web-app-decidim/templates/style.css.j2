:root {
  --primary: var(--design-primary);
  --primary-rgb: from var(--design-primary) r g b;
  --secondary: var(--design-link);
  --secondary-rgb: from var(--design-link) r g b;
  --tertiary: var(--design-info);
  --tertiary-rgb: from var(--design-info) r g b;
  --success: var(--design-success);
  --success-rgb: from var(--design-success) r g b;
  --warning: var(--design-warning);
  --warning-rgb: from var(--design-warning) r g b;
  --alert: var(--design-danger);
  --alert-rgb: from var(--design-danger) r g b;
}

header .menu-bar__container,
header .menu-bar__dropdown-menu,
header .menu-bar__secondary-dropdown__menu,
header .admin-bar__container,
footer .main-footer,
footer .mini-footer,
.home__menu,
.participatory-space__nav-container,
.layout-nav,
.title-bar,
#aside-system {
  --design-focus: var(--design-on-frame);
  background-color: var(--design-frame);
  color: var(--design-on-frame);
}

header .admin-bar__title,
header .admin-bar__button,
header .menu-bar__container .text-white,
footer .main-footer .text-white,
footer .mini-footer .text-white,
.layout-nav .text-white,
.title-bar .text-white,
.process-title .text-white,
.title-bar .button__site,
.title-bar .dropdown__trigger,
#aside-system a {
