.title-bar .dropdown :focus-visible {
  outline-color: var(--design-link);
}

.button__primary,
.button__secondary,
.button__pill--active,
.button__pill--count,
.dropdown__item .dropdown__button:hover,
[data-floating-help]:hover button,
.wc-datepicker__date--selected > *,
