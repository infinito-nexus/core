{% if lookup('objstore', application_id, 'proxy_required') | bool %}
{% set objstore = lookup('objstore', application_id) %}
  location {{ objstore.proxy_prefix }}/{{ objstore.bucket }}/ {
    proxy_pass {{ objstore.upstream_scheme }}://127.0.0.1/{{ objstore.bucket }}/;
    proxy_ssl_server_name on;
    proxy_ssl_name {{ objstore.upstream_domain }};
    proxy_set_header Host {{ objstore.upstream_domain }};
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    {% include 'roles/sys-svc-proxy/templates/headers/upstream_strips.conf.j2' %}
  }
{% endif %}
