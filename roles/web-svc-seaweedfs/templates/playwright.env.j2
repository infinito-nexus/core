OPENBAO_BASE_URL={{ (lookup('landing_url', 'web-app-openbao') if 'web-app-openbao' in group_names else '') | dotenv_quote }}

OPENBAO_PLAYWRIGHT_MOUNT={{ (lookup('config', 'web-app-openbao', 'services.openbao.workspaces.playwright.mount') if 'web-app-openbao' in group_names else '') | dotenv_quote }}

OPENBAO_PLAYWRIGHT_ROLE_ID={{ (lookup('config', 'web-app-openbao', 'secrets.credentials.playwright_approle_role_id') if 'web-app-openbao' in group_names else '') | dotenv_quote }}

OPENBAO_PLAYWRIGHT_SECRET_ID={{ (lookup('config', 'web-app-openbao', 'secrets.credentials.playwright_approle_secret_id') if 'web-app-openbao' in group_names else '') | dotenv_quote }}

OPENBAO_PLAYWRIGHT_SEMAPHORE_PATH={{ (lookup('config', 'web-app-openbao', 'services.openbao.workspaces.playwright.logins.semaphore') if 'web-app-openbao' in group_names else '') | dotenv_quote }}

SEAWEEDFS_ADMIN_ACCESS_KEY={{ SEAWEEDFS_ADMIN_ACCESS_KEY | dotenv_quote }}

SEAWEEDFS_ADMIN_SECRET_KEY={{ SEAWEEDFS_ADMIN_SECRET_KEY | dotenv_quote }}

{% set consumer_buckets = [SEAWEEDFS_EXPORT.bucket] if (SEAWEEDFS_EXPORT.enabled | bool) else [] %}
{% for consumer in lookup('objstore_consumers', 'seaweedfs') %}
{%   set _ = consumer_buckets.append(lookup('objstore', consumer, 'bucket')) %}
{% endfor %}
SEAWEEDFS_CONSUMER_BUCKETS_JSON={{ consumer_buckets | to_json | dotenv_quote }}

SEAWEEDFS_OPENBAO_MOUNT={{ SEAWEEDFS_WORKSPACE_OPENBAO_MOUNT | dotenv_quote }}

SEAWEEDFS_REGION={{ SEAWEEDFS_S3_REGION | dotenv_quote }}

SEAWEEDFS_S3_URL={{ lookup('canonical_url', application_id, 'api') | dotenv_quote }}

SEAWEEDFS_WORKSPACES_ENABLED={{ ('web-app-semaphore' in group_names and 'web-app-openbao' in group_names and (lookup('config', 'web-app-semaphore', 'services.workspaces-runner.enabled') | bool)) | string | lower }}

SEMAPHORE_BASE_URL={{ (lookup('landing_url', 'web-app-semaphore') if 'web-app-semaphore' in group_names else '') | dotenv_quote }}

SEMAPHORE_WORKSPACES_PROJECT={{ (SOFTWARE_NAME ~ ' Workspaces') | dotenv_quote }}
