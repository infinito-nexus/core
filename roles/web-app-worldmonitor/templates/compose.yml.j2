{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}
  {% set service_name = 'worldmonitor' %}
  {{ service_name }}:
    {{ lookup('compose_only', 'pull_policy', 'never') }}
    build:
      context: "{{ compose_repository_path }}"
      dockerfile: "{{ WORLDMONITOR_APP_DOCKERFILE }}"
      additional_contexts:
        "{{ WORLDMONITOR_NODE_FROM }}": "docker-image://{{ WORLDMONITOR_NODE_IMAGE }}"
    {{ lookup('container_image', application_id, service_name, version=WORLDMONITOR_REF) }}
    {{ lookup('compose_only', 'container_name', WORLDMONITOR_CONTAINER) }}
    {{ lookup('container_ports', ['worldmonitor', 'http', DOCKER_BIND_HOST]) | indent(4) }}
    {{ lookup('container_healthcheck', service_name) | indent(4) }}
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_depends_on', application_id, extra={
  'redis-rest': {'condition': 'service_started'},
  'ais-relay': {'condition': 'service_started'},
}) | indent(4) }}
    {{ lookup('container_networks') | indent(4) }}

  {% set service_name = 'ais-relay' %}
  {{ service_name }}:
    {{ lookup('compose_only', 'pull_policy', 'never') }}
    build:
      context: "{{ compose_repository_path }}"
      dockerfile: "{{ WORLDMONITOR_RELAY_DOCKERFILE }}"
      additional_contexts:
        "{{ WORLDMONITOR_NODE_FROM }}": "docker-image://{{ WORLDMONITOR_NODE_IMAGE }}"
    {{ lookup('container_image', application_id, service_name, version=WORLDMONITOR_REF) }}
    {{ lookup('compose_only', 'container_name', WORLDMONITOR_RELAY_CONTAINER) }}
    {{ lookup('container_healthcheck', service_name) | indent(4) }}
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_depends_on', application_id, extra={
  'redis-rest': {'condition': 'service_started'},
}) | indent(4) }}
    {{ lookup('container_networks', own_network_only=True, provider_self_alias=False) | indent(4) }}

  {% set service_name = 'redis-rest' %}
  {{ service_name }}:
    {{ lookup('compose_only', 'pull_policy', 'never') }}
    build:
      context: "{{ WORLDMONITOR_REST_CONTEXT }}"
      dockerfile: "{{ WORLDMONITOR_REST_DOCKERFILE }}"
      additional_contexts:
        "{{ WORLDMONITOR_NODE_FROM }}": "docker-image://{{ WORLDMONITOR_NODE_IMAGE }}"
    {{ lookup('container_image', application_id, service_name, version=WORLDMONITOR_REF) }}
    {{ lookup('compose_only', 'container_name', WORLDMONITOR_REST_CONTAINER) }}
    {{ lookup('container_healthcheck', service_name) | indent(4) }}
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_depends_on', application_id, extra={
  'cache': {'condition': 'service_started'},
}) | indent(4) }}
    {{ lookup('container_networks', own_network_only=True, provider_self_alias=False) | indent(4) }}

  {% set service_name = 'cache' %}
  {{ service_name }}:
    {{ lookup('container_image', 'svc-db-redis', 'redis') }}
    {{ lookup('compose_only', 'container_name', WORLDMONITOR_CACHE_CONTAINER) }}
    command:
      - "sh"
      - "-c"
      - >-
        exec redis-server
        --requirepass "$$REDIS_PASSWORD"
        --maxmemory {{ lookup('service_memory_mb', application_id, service_name, 0.8) }}mb
        --maxmemory-policy allkeys-lru
    {{ lookup('container_healthcheck', service_name) | indent(4) }}
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_volumes', service_name) | indent(4) }}
    {{ lookup('container_networks', own_network_only=True, provider_self_alias=False) | indent(4) }}

  {% set service_name = 'seeder' %}
  {{ service_name }}:
    {{ lookup('compose_only', 'pull_policy', 'never') }}
    build:
      context: "{{ compose_repository_path }}"
      dockerfile: "{{ WORLDMONITOR_APP_DOCKERFILE }}"
      target: "{{ WORLDMONITOR_SEEDER_TARGET }}"
      additional_contexts:
        "{{ WORLDMONITOR_NODE_FROM }}": "docker-image://{{ WORLDMONITOR_NODE_IMAGE }}"
    {{ lookup('container_image', application_id, service_name, version=WORLDMONITOR_REF) }}
    {{ lookup('compose_only', 'container_name', WORLDMONITOR_SEEDER_CONTAINER) }}
    command:
      - "sh"
      - "-c"
      - >-
        while :; do
        sh scripts/run-seeders.sh;
        sleep "$$WORLDMONITOR_SEED_INTERVAL_SECONDS";
        done
    {{ lookup('container_healthcheck', service_name) | indent(4) }}
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_depends_on', application_id, extra={
  'redis-rest': {'condition': 'service_started'},
}) | indent(4) }}
    {{ lookup('container_networks') | indent(4) }}

{{ lookup('compose_volumes') }}

{{ lookup('compose_networks') }}
