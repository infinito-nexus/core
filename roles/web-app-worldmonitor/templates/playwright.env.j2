APP_BASE_URL={{ lookup('tls', application_id, 'url.base') | dotenv_quote }}

BIBER_PASSWORD={{ lookup('users', 'biber').password | dotenv_quote }}

BIBER_USERNAME={{ lookup('users', 'biber').username | dotenv_quote }}

CANONICAL_DOMAIN={{ lookup('domain', application_id) | dotenv_quote }}

# nocheck: playwright-service-gate  web-svc-design injects the shared stylesheet; the persona CSP helper resolves injectors through a computed loop, never a literal gate argument
DESIGN_SERVICE_ENABLED={{ lookup('config', application_id, 'services.design.enabled') | string | lower }}

INTERNAL_TCP_PORTS_JSON={{ [lookup('config', application_id, 'services.cache.ports.internal.redis'), lookup('config', application_id, 'services.ais-relay.ports.internal.http')] | to_json | dotenv_quote }}

LOGOUT_SERVICE_ENABLED={{ lookup('config', application_id, 'services.logout.enabled') | string | lower }}

MATOMO_BASE_URL={{ lookup('landing_url', 'web-app-matomo') | dotenv_quote }}

MATOMO_SERVICE_ENABLED={{ lookup('config', application_id, 'services.matomo.enabled') | string | lower }}

OIDC_ISSUER_URL={{ OIDC.CLIENT.ISSUER_URL | dotenv_quote }}

# nocheck: persona-block-rationale  World Monitor has no account system and no admin surface: the oauth2 gate is its only login and admits every Keycloak user alike, so an administrator journey would repeat the biber one with nothing admin-only left to prove.
PERSONA_ADMINISTRATOR_BLOCKED=true

SSO_SERVICE_ENABLED={{ lookup('config', application_id, 'services.sso.enabled') | string | lower }}
