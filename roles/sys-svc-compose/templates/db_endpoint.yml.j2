{#
  Param: service_name  the engine's service name the write endpoint takes over.
  Param: application_id  the engine role; its meta declares the `haproxy` mounts, sys-svc-compose the image, sizing and replicas.
#}
{% set _db_endpoint_sysctls = lookup('db_endpoint', application_id, field='sysctls') %}
  {# nocheck: compose-structure  the write endpoint carries the engine's service name, its sizing comes from the `haproxy` meta entry #}
  {{ service_name }}:
    {{ lookup('container_image', 'sys-svc-compose', 'haproxy') }}
    {{ lookup('compose_restart', docker_restart_policy | default(DOCKER_RESTART_POLICY)) }}
    logging:
      driver: journald
    user: haproxy
    read_only: true
    cap_drop:
      - ALL
    {% if _db_endpoint_sysctls %}
    sysctls:
    {% for _key, _value in _db_endpoint_sysctls.items() %}
      {{ _key }}: {{ _value }}
    {% endfor %}
    {% endif %}
{% set service_name = 'haproxy' %}
{% set service_sizing_application_id = 'sys-svc-compose' %}
{% set service_replicas_forced = lookup('config', 'sys-svc-compose', 'services.haproxy.replicas') %}
{% set service_max_replicas_per_node = lookup('config', 'sys-svc-compose', 'services.haproxy.max_replicas_per_node') %}
{% set service_db_endpoint = true %}
{% include 'roles/sys-svc-container/templates/deploy.yml.j2' %}
{{ "\n" }}
    {{ lookup('container_volumes', service_name) | indent(4) }}
    {{ lookup('container_networks', internal=true, roles_exclude=[lookup('db_instances', coordination_store=true)]) | indent(4) }}
