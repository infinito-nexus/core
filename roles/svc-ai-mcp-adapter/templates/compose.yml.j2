{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}

  {% set service_name = 'mcp-adapter' %}
  {{ service_name }}:
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_image', application_id, 'mcp-adapter') }}
    build:
      context: {{ MCP_ADAPTER_BUILD_DIR }}
      dockerfile: Dockerfile
      args:
        MCP_ADAPTER_BASE_IMAGE: {{ MCP_ADAPTER_BASE_IMAGE }}
        MCP_ADAPTER_BASE_DIGEST: "{{ MCP_ADAPTER_BASE_DIGEST }}"
    {{ lookup('compose_only', 'container_name', MCP_ADAPTER_CONTAINER) }}
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    expose:
      - "{{ MCP_ADAPTER_PORT }}"
    {{ lookup('container_networks') | indent(4) }}

{{ lookup('compose_networks') }}

{{ lookup('compose_volumes', application_id) }}
