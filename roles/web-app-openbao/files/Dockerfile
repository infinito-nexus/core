ARG OPENBAO_IMAGE
ARG OPENBAO_VERSION
ARG OPENBAO_LDAP_PLUGIN_IMAGE
ARG OPENBAO_LDAP_PLUGIN_VERSION

FROM ${OPENBAO_LDAP_PLUGIN_IMAGE}:${OPENBAO_LDAP_PLUGIN_VERSION} AS ldap-plugin

FROM ${OPENBAO_IMAGE}:${OPENBAO_VERSION} AS plugins

ARG OPENBAO_PLUGIN_DIR
ARG OPENBAO_LDAP_PLUGIN_BINARY

USER root
COPY --from=ldap-plugin /${OPENBAO_LDAP_PLUGIN_BINARY} ${OPENBAO_PLUGIN_DIR}/${OPENBAO_LDAP_PLUGIN_BINARY}
RUN chmod 0555 "${OPENBAO_PLUGIN_DIR}/${OPENBAO_LDAP_PLUGIN_BINARY}"

FROM ${OPENBAO_IMAGE}:${OPENBAO_VERSION}

ARG OPENBAO_PLUGIN_DIR

COPY --from=plugins ${OPENBAO_PLUGIN_DIR} ${OPENBAO_PLUGIN_DIR}
