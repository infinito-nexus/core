path "{{ OPENBAO_TENANT_MOUNT }}/data/+/proxmox" {
  capabilities = ["read"]
}

path "{{ OPENBAO_TENANT_MOUNT }}/data/+/incus" {
  capabilities = ["read"]
}

path "{{ OPENBAO_TENANT_MOUNT }}/data/+/s3" {
  capabilities = ["read"]
