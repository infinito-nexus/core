  --design-focus: var(--design-link);
}
.hds-side-nav__home-link,
.hds-side-nav__icon-button,
.hds-side-nav__list-item-link,
.hds-side-nav__menu-toggle-button {
  --token-focus-ring-action-box-shadow: inset 0 0 0 1px var(--design-on-frame), 0 0 0 3px var(--design-on-frame);
  --token-color-focus-action-internal: var(--design-on-frame);
  --token-color-focus-action-external: var(--design-on-frame);
}
{% if design.logo is string %}
.hds-side-nav__home-link {
  background: url("{{ design.urls.logo.svg }}") center / auto 2rem no-repeat;
}
.brand-icon-large {
  background: url("{{ design.urls.logo.svg }}") center / contain no-repeat;
}
.hds-side-nav__home-link .hs-icon,
.brand-icon-large .hs-icon {
  visibility: hidden;
}
{% endif %}
