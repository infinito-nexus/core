:root,
html.skin-theme-clientpref-day,
html.skin-theme-clientpref-night,
html.skin-theme-clientpref-os {
  --background-color-base: var(--design-surface-1);
  --background-color-base-fixed: var(--design-surface-1);
  --background-color-neutral: var(--design-surface-3);
  --background-color-neutral-subtle: var(--design-surface-2);
  --background-color-interactive: var(--design-surface-3);
  --background-color-interactive--hover: var(--design-surface-hover);
  --background-color-interactive--active: var(--design-surface-active);
  --background-color-interactive-subtle: var(--design-surface-2);
  --background-color-interactive-subtle--hover: var(--design-surface-hover);
  --background-color-interactive-subtle--active: var(--design-surface-active);
  --background-color-button-quiet--hover: var(--design-surface-hover);
  --background-color-button-quiet--active: var(--design-surface-active);
  --background-color-tab-list-item-framed--hover: var(--design-surface-hover);
  --background-color-tab-list-item-framed--active: var(--design-surface-active);
  --background-color-disabled: var(--design-surface-3);
  --background-color-disabled-subtle: var(--design-surface-2);
  --background-color-progressive: var(--design-primary);
  --background-color-progressive--hover: var(--design-primary-hover);
  --background-color-progressive--active: var(--design-primary-active);
  --background-color-progressive--focus: var(--design-primary);
  --background-color-progressive-subtle: var(--design-primary-50);
  --background-color-progressive-subtle--hover: var(--design-surface-hover);
  --background-color-progressive-subtle--active: var(--design-surface-active);
  --background-color-input-binary--checked: var(--design-primary);
  --background-color-destructive: var(--design-danger);
  --background-color-destructive--hover: var(--design-danger-hover);
  --background-color-destructive--active: var(--design-danger-active);
  --background-color-destructive--focus: var(--design-danger);
  --background-color-destructive-subtle: var(--design-danger-subtle);
  --background-color-destructive-subtle--hover: var(--design-surface-hover);
  --background-color-destructive-subtle--active: var(--design-surface-active);
  --background-color-error: var(--design-danger);
  --background-color-error--hover: var(--design-danger-hover);
  --background-color-error--active: var(--design-danger-active);
  --background-color-error-subtle: var(--design-danger-subtle);
  --background-color-error-subtle--hover: var(--design-surface-hover);
  --background-color-error-subtle--active: var(--design-surface-active);
  --background-color-warning-subtle: var(--design-warning-subtle);
  --background-color-success-subtle: var(--design-success-subtle);
  --background-color-notice-subtle: var(--design-info-subtle);
  --background-color-content-added: var(--design-info-subtle);
  --background-color-content-removed: var(--design-warning-subtle);
  --background-color-target-text: var(--design-warning-subtle);

  --color-base: var(--design-text);
  --color-base-fixed: var(--design-text);
  --color-base--hover: var(--design-text);
  --color-emphasized: var(--design-text);
  --color-neutral: var(--design-text-muted);
  --color-subtle: var(--design-text-muted);
  --color-base--subtle: var(--design-text-muted);
  --color-placeholder: var(--design-text-muted);
  --color-disabled: var(--design-text-muted);
  --color-disabled-emphasized: var(--design-text-muted);
  --color-inverted: var(--design-on-primary);
  --color-inverted-fixed: var(--design-on-primary);
  --color-progressive: var(--design-link);
  --color-progressive--hover: var(--design-link);
  --color-progressive--active: var(--design-link);
  --color-progressive--focus: var(--design-link);
  --color-visited: var(--design-link);
  --color-visited--hover: var(--design-link);
  --color-visited--active: var(--design-link);
  --color-destructive: var(--design-danger);
  --color-destructive--hover: var(--design-danger);
  --color-destructive--active: var(--design-danger);
  --color-destructive--focus: var(--design-danger);
  --color-destructive--visited: var(--design-danger);
  --color-destructive--visited--hover: var(--design-danger);
  --color-destructive--visited--active: var(--design-danger);
  --color-error: var(--design-danger);
  --color-error--hover: var(--design-danger);
  --color-error--active: var(--design-danger);
  --color-warning: var(--design-warning);
  --color-success: var(--design-success);
  --color-notice: var(--design-info);
  --color-content-added: var(--design-success);
  --color-content-removed: var(--design-danger);
  --color-icon-error: var(--design-danger);
  --color-icon-warning: var(--design-warning);
  --color-icon-success: var(--design-success);
  --color-icon-notice: var(--design-info);
  --color-icon-progressive: var(--design-link);

  --border-color-base: var(--design-border);
  --border-color-subtle: var(--design-border);
  --border-color-muted: var(--design-border);
  --border-color-divider: var(--design-border);
  --border-color-disabled: var(--design-border);
  --border-color-emphasized: var(--design-border-strong);
  --border-color-interactive: var(--design-border-strong);
  --border-color-interactive--hover: var(--design-text-muted);
  --border-color-interactive--active: var(--design-text-muted);
  --border-color-progressive: var(--design-primary);
  --border-color-progressive--hover: var(--design-primary-hover);
  --border-color-progressive--active: var(--design-primary-active);
  --border-color-progressive--focus: var(--design-focus, var(--design-link));
  --border-color-destructive: var(--design-danger-border);
  --border-color-destructive--hover: var(--design-danger-hover);
  --border-color-destructive--active: var(--design-danger-active);
  --border-color-destructive--focus: var(--design-focus, var(--design-link));
  --border-color-error: var(--design-danger-border);
  --border-color-error--hover: var(--design-danger-hover);
  --border-color-error--active: var(--design-danger-active);
  --border-color-warning: var(--design-warning-border);
  --border-color-warning--hover: var(--design-warning-hover);
  --border-color-warning--active: var(--design-warning-active);
  --border-color-success: var(--design-success-border);
  --border-color-notice: var(--design-info-border);
  --border-color-content-added: var(--design-info-border);
  --border-color-content-removed: var(--design-warning-border);
  --outline-color-progressive--focus: var(--design-focus, var(--design-link));
  --box-shadow-color-progressive--focus: var(--design-focus, var(--design-link));
  --box-shadow-color-destructive--focus: var(--design-focus, var(--design-link));
  --box-shadow-color-progressive--active: var(--design-primary-active);
  --box-shadow-color-progressive-selected: var(--design-primary);
  --box-shadow-color-progressive-selected--hover: var(--design-primary-hover);
  --box-shadow-color-progressive-selected--active: var(--design-primary-active);
  --accent-color-base: var(--design-primary);
}

.cdx-button--action-destructive,
.oo-ui-flaggedElement-destructive {
  --color-inverted: var(--design-on-danger);
  --color-inverted-fixed: var(--design-on-danger);
}

.oo-ui-flaggedElement-primary.oo-ui-flaggedElement-progressive {
  --color-progressive--hover: var(--design-primary-hover);
  --color-progressive--active: var(--design-primary-active);
}

.oo-ui-flaggedElement-primary.oo-ui-flaggedElement-destructive {
  --color-destructive--hover: var(--design-danger-hover);
  --color-destructive--active: var(--design-danger-active);
}

textarea {
  border-color: var(--design-border-strong);
}

fieldset {
  border-color: var(--design-border);
}

.mw-prefs-tabs:not(.mw-prefs-tabs-searching) .oo-ui-fieldsetLayout:target > .oo-ui-fieldsetLayout-header > .oo-ui-labelElement-label {
  outline-color: var(--design-primary-50);
}
