{{ COSMOS_SKY_SELECTOR }},
{{ COSMOS_SKY_SELECTOR }} body,
{{ COSMOS_SKY_SELECTOR }} .mw-page-container,
{{ COSMOS_SKY_SELECTOR }} .mw-header {
  background: transparent;
  color: var(--cosmos-text);
}
{{ COSMOS_SKY_SELECTOR }} .mw-body,
{{ COSMOS_SKY_SELECTOR }} .vector-column-start,
{{ COSMOS_SKY_SELECTOR }} .vector-column-end {
  background-color: var(--design-surface-1);
  color: var(--design-text);
}
{{ COSMOS_SKY_SELECTOR }} .mw-footer :is(li, a) {
  color: inherit;
}
{{ COSMOS_LEGIBLE_TOP_SELECTOR }} .mw-footer-container {
  background-color: var(--design-surface-1);
  color: var(--design-text);
}
