{% set design = lookup('design', application_id) %}
(function () {
  var root = document.documentElement;
  var path = window.location.pathname;
  var surface = "legacy";
  if (/^\/mobile(\/|$)/.test(path)) {
    surface = "mobile";
  } else if (/^\/desktop(\/|$)/.test(path)) {
    surface = "desktop";
  } else if (/^\/help(\/|$)/.test(path)) {
    surface = "help";
  }
  root.setAttribute("data-design-surface", surface);
  var media = window.matchMedia("(prefers-color-scheme: dark)");
  function mirror() {
    var theme = root.getAttribute("data-theme");
    if ((theme === "light" || theme === "dark") && theme !== (media.matches ? "dark" : "light")) {
      root.setAttribute("data-design-theme", theme);
    } else {
      root.removeAttribute("data-design-theme");
    }
  }
  if (surface === "legacy") {
    new MutationObserver(mirror).observe(root, { attributes: true, attributeFilter: ["data-theme"] });
    mirror();
  }
{% if design.logo is string %}
  var favicon = {{ design.urls.favicon_ico | to_json }};
  var touchIcon = {{ design.urls['apple-touch-icon'].png | to_json }};
  var icons = document.querySelectorAll("link[rel~='icon']");
  if (icons.length === 0) {
    var icon = document.createElement("link");
    icon.rel = "icon";
    document.head.appendChild(icon);
    icons = [icon];
  }
  for (var index = 0; index < icons.length; index += 1) {
    icons[index].setAttribute("type", "image/x-icon");
    icons[index].setAttribute("href", favicon);
  }
  var touch = document.querySelectorAll("link[rel='apple-touch-icon']");
  for (var position = 0; position < touch.length; position += 1) {
    touch[position].setAttribute("href", touchIcon);
  }
{% endif %}
})();
