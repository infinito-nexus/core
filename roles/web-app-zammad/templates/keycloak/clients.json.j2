{% set zammad_kc_origin = lookup('tls', 'web-app-zammad', 'url.origin') %}
{% set zammad_kc_origins = lookup('network_urls', zammad_kc_origin) %}
{% set zammad_kc_redirects = zammad_kc_origins | map('regex_replace', '$', '/*') | list %}
{
  "clientId": "{{ lookup('config', 'web-app-zammad', 'services.sso.oidc.clients.web') }}",
  "name": "Zammad",
  "description": "Public Zammad client that signs in with PKCE, since the Zammad OpenID Connect strategy sends no client secret, and whose back-channel logout tokens reach Zammad through the logout gate.",
  "enabled": true,
  "surrogateAuthRequired": false,
  "alwaysDisplayInConsole": false,
  "clientAuthenticatorType": "client-secret",
  "redirectUris": {{ zammad_kc_redirects | to_json }},
  "webOrigins": {{ zammad_kc_origins | to_json }},
  "notBefore": 0,
  "bearerOnly": false,
  "consentRequired": false,
  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "publicClient": true,
  "frontchannelLogout": false,
  "protocol": "openid-connect",
  "attributes": {
    "pkce.code.challenge.method": "S256",
    "post.logout.redirect.uris": "{{ zammad_kc_redirects | join('##') }}",
    "backchannel.logout.url": "{{ lookup('tls', 'web-svc-logout', 'url.origin') ~ '/backchannel/web-app-zammad' }}",
    "backchannel.logout.session.required": "true",
    "backchannel.logout.revoke.offline.tokens": "false",
    "oauth2.device.authorization.grant.enabled": "false",
    "oidc.ciba.grant.enabled": "false",
    "display.on.consent.screen": "false"
  },
  "authenticationFlowBindingOverrides": {},
  "fullScopeAllowed": true,
  "nodeReRegistrationTimeout": -1,
  "defaultClientScopes": [
    "web-origins",
    "acr",
    "roles",
    "profile",
    "basic",
    "email",
    "openid",
    "{{ KEYCLOAK_RBAC_GROUP_CLAIM }}"
  ],
  "optionalClientScopes": [
    "address",
    "phone",
    "organization",
    "offline_access",
    "microprofile-jwt"
  ]
}
