{# The `resolver` + variable form below is required so nginx defers DNS for the
   public upstreams to runtime. Without it `nginx -t` refuses to start, because
   the openresty container cannot resolve those hosts at config-load time.
   social-app renders nothing until its boot-time config fetch settles, so an
   unreachable upstream here has to fail fast instead of running into nginx's
   minute-long defaults. #}
{% for endpoint in BLUESKY_FRONT_PROXY_ENDPOINTS %}
location = {{ endpoint.path }} {
    resolver {{ NETWORK_PUBLIC_DNS_RESOLVERS | join(' ') }} ipv6={{ NETWORK_IPV6_ENABLED | on_off }} valid=300s;
    resolver_timeout {{ BLUESKY_FRONT_PROXY_TIMEOUT }};
    proxy_connect_timeout {{ BLUESKY_FRONT_PROXY_TIMEOUT }};
    proxy_read_timeout {{ BLUESKY_FRONT_PROXY_TIMEOUT }};
    set $up_host "{{ endpoint.upstream | regex_replace('^https?://', '') | regex_replace('/.*$', '') }}";
    set $bluesky_upstream "{{ endpoint.upstream }}";
    proxy_pass $bluesky_upstream;
    {% include 'roles/sys-svc-proxy/templates/headers/upstream_strips.conf.j2' %}
    proxy_set_header Host $up_host;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_ssl_server_name on;

    proxy_hide_header Access-Control-Allow-Origin;
    {% include 'roles/sys-svc-proxy/templates/headers/access_control_allow.conf.j2' %}
}
{% endfor %}

location = /ipcc {
    resolver {{ NETWORK_PUBLIC_DNS_RESOLVERS | join(' ') }} ipv6={{ NETWORK_IPV6_ENABLED | on_off }} valid=300s;
    resolver_timeout {{ BLUESKY_FRONT_PROXY_TIMEOUT }};
    proxy_connect_timeout {{ BLUESKY_FRONT_PROXY_TIMEOUT }};
    proxy_read_timeout {{ BLUESKY_FRONT_PROXY_TIMEOUT }};
    set $up_host "bsky.app";
    set $bluesky_ipcc_upstream "https://bsky.app/ipcc";
    proxy_pass $bluesky_ipcc_upstream;
    {% include 'roles/sys-svc-proxy/templates/headers/upstream_strips.conf.j2' %}
    proxy_set_header Host $up_host;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_ssl_server_name on;
    proxy_hide_header Access-Control-Allow-Origin;
    {% include 'roles/sys-svc-proxy/templates/headers/access_control_allow.conf.j2' %}
}
