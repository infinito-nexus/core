APP_BASE_URL={{ lookup('tls', application_id, 'url.base') | dotenv_quote }}

CANONICAL_DOMAIN={{ lookup('domain', application_id) | dotenv_quote }}

# nocheck: playwright-service-gate — consumed via the shared persona helpers, which the gateway's API specs do not drive
LOGOUT_SERVICE_ENABLED={{ lookup('config', application_id, 'services.logout.enabled') | string | lower }}

# nocheck: persona-block-rationale — the gateway answers the LibreTranslate API over HTTP and declares no browser surface, so there is no login chain for a persona to drive.
PERSONA_ADMINISTRATOR_BLOCKED=true

# nocheck: persona-block-rationale — see PERSONA_ADMINISTRATOR_BLOCKED above.
PERSONA_BIBER_BLOCKED=true

# nocheck: playwright-service-gate — SSO surface; the gateway is reached by applications, not by a browser session
SSO_SERVICE_ENABLED={{ lookup('config', application_id, 'services.sso.enabled') | string | lower }}

TRANSLATE_ENGINES={{ TRANSLATE_ENGINES | map(attribute='name') | join(',') | dotenv_quote }}

TRANSLATE_WEBLATE_ENABLED={{ TRANSLATE_WEBLATE_ENABLED | string | lower }}

{% if TRANSLATE_WEBLATE_ENABLED | bool %}
WEBLATE_BASE_URL={{ lookup('tls', 'web-app-weblate', 'url.base') | dotenv_quote }}

WEBLATE_API_TOKEN={{ TRANSLATE_WEBLATE_TOKEN | dotenv_quote }}

WEBLATE_PROJECT={{ TRANSLATE_WEBLATE_PROJECT }}

WEBLATE_PROJECT_HOMEPAGE={{ SOFTWARE_URL | dotenv_quote }}
{% endif %}
