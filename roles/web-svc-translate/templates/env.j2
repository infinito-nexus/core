{% include 'roles/sys-svc-container/templates/env.j2' %}

TRANSLATE_PORT={{ TRANSLATE_PORT }}
TRANSLATE_ENGINES={{ TRANSLATE_ENGINES | to_json | dotenv_quote }}
TRANSLATE_ENGINE_TIMEOUT={{ TRANSLATE_ENGINE_TIMEOUT }}

TRANSLATE_ROUTER_STRATEGY={{ TRANSLATE_ROUTER.strategy }}
TRANSLATE_ROUTER_QUESTION={{ TRANSLATE_ROUTER.question }}
TRANSLATE_ROUTER_ORDER={{ TRANSLATE_ROUTER.order | join(',') }}
TRANSLATE_SATURATION_MINIMUM={{ TRANSLATE_ROUTER.saturation_minimum }}
TRANSLATE_SATURATION_SHARE={{ TRANSLATE_ROUTER.saturation_share }}
TRANSLATE_SAMPLE_TRIGGER={{ TRANSLATE_ROUTER.sample_trigger }}
TRANSLATE_SAMPLE_INTERVAL={{ TRANSLATE_ROUTER.sample_interval }}
TRANSLATE_FAILURE_THRESHOLD={{ TRANSLATE_ROUTER.failure_threshold }}

TRANSLATE_HISTORY_TABLE={{ TRANSLATE_HISTORY_TABLE }}
TRANSLATE_CACHE_TABLE={{ TRANSLATE_CACHE_TABLE }}
TRANSLATE_FAILURE_TABLE={{ TRANSLATE_FAILURE_TABLE }}

TRANSLATE_DATABASE_HOST={{ TRANSLATE_DATABASE_HOST }}
TRANSLATE_DATABASE_PORT={{ TRANSLATE_DATABASE_PORT }}
TRANSLATE_DATABASE_NAME={{ TRANSLATE_DATABASE_NAME }}
TRANSLATE_DATABASE_USER={{ TRANSLATE_DATABASE_USER }}
TRANSLATE_DATABASE_PASSWORD={{ TRANSLATE_DATABASE_PASSWORD | dotenv_quote }}

{% if TRANSLATE_S1_ENABLED | bool %}
TRANSLATE_S1_URL={{ S1_BASE_LOCAL_URL }}
TRANSLATE_S1_KEY={{ lookup('config', 'svc-ai-s1', 'secrets.credentials.api_key') | dotenv_quote }}
TRANSLATE_S1_MODEL={{ lookup('config', 'svc-ai-s1', 'services.s1.model_alias') }}
TRANSLATE_S1_TIMEOUT={{ lookup('config', 'svc-ai-s1', 'services.s1.request_timeout') }}
TRANSLATE_S1_MAX_STATE_CHARS=4000
{% endif %}

{% if TRANSLATE_WEBLATE_ENABLED | bool %}
TRANSLATE_WEBLATE_URL={{ TRANSLATE_WEBLATE_URL }}
TRANSLATE_WEBLATE_TOKEN={{ TRANSLATE_WEBLATE_TOKEN | dotenv_quote }}
TRANSLATE_WEBLATE_PROJECT={{ TRANSLATE_WEBLATE_PROJECT }}
{% endif %}
