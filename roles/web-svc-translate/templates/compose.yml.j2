{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}
  {% set service_name = TRANSLATE_SERVICE %}
  {{ service_name }}:
    {{ lookup('compose_only', 'container_name', TRANSLATE_CONTAINER) }}
    {{ lookup('template', 'roles/sys-svc-container/templates/build.yml.j2') | indent(4) }}
      args:
        TRANSLATE_BASE_IMAGE: "{{ TRANSLATE_BASE_IMAGE }}"
        TRANSLATE_BASE_VERSION: "{{ TRANSLATE_BASE_VERSION }}"
        TRANSLATE_PORT: "{{ TRANSLATE_PORT }}"
    {{ lookup('container_image', application_id, 'translate') }}
    expose:
      - "{{ TRANSLATE_PORT }}"
    {{ lookup('container_networks') | indent(4) }}
    {{ lookup('container_depends_on', application_id) | indent(4) }}
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_healthcheck', service_name) | indent(4) }}

{{ lookup('compose_volumes') }}

{{ lookup('compose_networks') }}
