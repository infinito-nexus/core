{% include 'roles/sys-svc-container/templates/env.j2' %}

GF_SERVER_HTTP_PORT={{ GRAFANA_INTERNAL_PORT }}
GF_SERVER_ENFORCE_DOMAIN=false
GF_SECURITY_ADMIN_USER={{ GRAFANA_BREAKGLASS_USERNAME | dotenv_quote }}
GF_SECURITY_ADMIN_PASSWORD={{ GRAFANA_BREAKGLASS_PASSWORD | dotenv_quote }}
GF_SECURITY_DISABLE_GRAVATAR=true
{% for setting, value in GRAFANA_SETTINGS.items() %}
{{ setting | upper }}={{ value | dotenv_quote }}
{% endfor %}
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false
GF_NEWS_NEWS_FEED_ENABLED=false
GF_LOG_MODE=console
GF_UNIFIED_ALERTING_ENABLED=true
{% if GRAFANA_OIDC_ENABLED | bool %}

GF_AUTH_GENERIC_OAUTH_ENABLED=true
GF_AUTH_GENERIC_OAUTH_NAME={{ OIDC.BUTTON_TEXT | dotenv_quote }}
GF_AUTH_GENERIC_OAUTH_CLIENT_ID={{ OIDC.CLIENT.ID | dotenv_quote }}
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET={{ OIDC.CLIENT.SECRET | dotenv_quote }}
GF_AUTH_GENERIC_OAUTH_SCOPES={{ 'openid profile email' | dotenv_quote }}
GF_AUTH_GENERIC_OAUTH_AUTH_URL={{ OIDC.CLIENT.AUTHORIZE_URL | dotenv_quote }}
GF_AUTH_GENERIC_OAUTH_TOKEN_URL={{ OIDC.CLIENT.TOKEN_URL | dotenv_quote }}
GF_AUTH_GENERIC_OAUTH_API_URL={{ OIDC.CLIENT.USER_INFO_URL | dotenv_quote }}
GF_AUTH_GENERIC_OAUTH_LOGIN_ATTRIBUTE_PATH={{ OIDC.ATTRIBUTES.USERNAME | dotenv_quote }}
GF_AUTH_GENERIC_OAUTH_EMAIL_ATTRIBUTE_PATH={{ OIDC.ATTRIBUTES.EMAIL | dotenv_quote }}
GF_AUTH_GENERIC_OAUTH_NAME_ATTRIBUTE_PATH={{ OIDC.ATTRIBUTES.NAME | dotenv_quote }}
GF_AUTH_GENERIC_OAUTH_GROUPS_ATTRIBUTE_PATH={{ RBAC.GROUP.CLAIM | dotenv_quote }}
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH={{ GRAFANA_ROLE_ATTRIBUTE_PATH | dotenv_quote }}
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_STRICT=true
GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP=true
GF_AUTH_GENERIC_OAUTH_AUTO_LOGIN=true
GF_AUTH_GENERIC_OAUTH_USE_PKCE=true
GF_AUTH_GENERIC_OAUTH_USE_REFRESH_TOKEN=true
GF_AUTH_OAUTH_ALLOW_INSECURE_EMAIL_LOOKUP=false
{% endif %}
