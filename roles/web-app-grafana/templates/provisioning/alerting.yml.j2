apiVersion: 1
{% if GRAFANA_PROMETHEUS_ENABLED | bool %}
contactPoints:
  - orgId: 1
    name: {{ GRAFANA_ALERTMANAGER_RECEIVER | to_json }}
    receivers:
      - uid: infinito-alertmanager
        type: prometheus-alertmanager
        disableResolveMessage: false
        settings:
          url: {{ GRAFANA_ALERTING.alertmanager_url | to_json }}
policies:
  - orgId: 1
    receiver: {{ GRAFANA_ALERTMANAGER_RECEIVER | to_json }}
    group_by:
      - grafana_folder
      - alertname
{% endif %}
{% if GRAFANA_LOKI_ENABLED | bool %}
groups:
  - orgId: 1
    name: log-content
    folder: {{ GRAFANA_DASHBOARDS.folder | to_json }}
    interval: 1m
    rules:
      - uid: infinito-critical-log-line
        title: {{ GRAFANA_LOG_ALERT_TITLE | to_json }}
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: {{ GRAFANA_LOKI_DATASOURCE_UID | to_json }}
            model:
              refId: A
              datasource:
                type: loki
                uid: {{ GRAFANA_LOKI_DATASOURCE_UID | to_json }}
              expr: {{ GRAFANA_ALERTING.log_alert_expr | to_json }}
              queryType: instant
              instant: true
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              expression: A
              reducer: last
              settings:
                mode: dropNN
              datasource:
                type: __expr__
                uid: __expr__
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    params:
                      - 0
              datasource:
                type: __expr__
                uid: __expr__
        noDataState: OK
        execErrState: Error
        for: 0s
        labels:
          severity: warning
          source: grafana
        annotations:
          summary: {% raw %}"{{ $labels.application }} wrote a critical line on {{ $labels.host }}"{% endraw %}

{% endif %}
