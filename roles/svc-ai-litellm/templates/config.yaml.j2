{% set has_backend = ('svc-ai-ollama' in group_names) or ('svc-ai-lmstudio' in group_names) or LITELLM_OPENROUTER_API_KEY %}
model_list:{{ ' []' if not has_backend else '' }}
{% if 'svc-ai-ollama' in group_names %}
  - model_name: ollama/llama3
    litellm_params:
      model: ollama/llama3
      api_base: {{ OLLAMA_BASE_LOCAL_URL }}
      rpm: 1000
  - model_name: ollama/nomic-embed-text
    litellm_params:
      model: ollama/nomic-embed-text
      api_base: {{ OLLAMA_BASE_LOCAL_URL }}
      rpm: 1000
{% endif %}
{% if 'svc-ai-lmstudio' in group_names %}
  - model_name: lmstudio/default
    litellm_params:
      model: openai/local-model
      api_base: {{ LMSTUDIO_BASE_LOCAL_URL }}/v1
      api_key: lm-studio
      rpm: 1000
{% endif %}
{% if LITELLM_OPENROUTER_API_KEY %}
  - model_name: openrouter/auto
    litellm_params:
      model: openrouter/openrouter/auto
      api_key: os.environ/OPENROUTER_API_KEY
{% endif %}

litellm_settings:
  drop_params: true

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
  database_url: os.environ/DATABASE_URL
