{% set _ollama_models = lookup('config', 'svc-ai-ollama', 'services.ollama.preload_models') if LITELLM_OLLAMA_BACKEND | bool else [] %}
{% set _lmstudio_models = lookup('config', 'svc-ai-lmstudio', 'services.lmstudio.preload_models') if LITELLM_LMSTUDIO_BACKEND | bool else [] %}
{% set _remote_models = LITELLM_REMOTE_MODELS | selectattr('provider', 'in', LITELLM_KEYED_PROVIDERS) | list %}
{% set has_backend = _ollama_models or _lmstudio_models or _remote_models %}
model_list:{{ ' []' if not has_backend else '' }}
{% for _model in _ollama_models %}
  - model_name: "{{ _model.alias }}"
    litellm_params:
      model: "ollama/{{ _model.alias }}"
      api_base: {{ OLLAMA_BASE_LOCAL_URL }}
      rpm: 1000
      max_tokens: {{ LITELLM_MAX_OUTPUT_TOKENS }}
      timeout: {{ LITELLM_UPSTREAM_TIMEOUT }}
{% if _model.context is defined %}
      num_ctx: {{ _model.context }}
    model_info:
      max_input_tokens: {{ _model.context }}
{% endif %}
{% endfor %}
{% for _model in _lmstudio_models if _model.alias not in (_ollama_models | map(attribute='alias') | list) %}
  - model_name: "{{ _model.alias }}"
    litellm_params:
      model: "openai/{{ _model.name }}"
      api_base: {{ LMSTUDIO_BASE_LOCAL_URL }}/v1
      api_key: lm-studio
      rpm: 1000
      max_tokens: {{ LITELLM_MAX_OUTPUT_TOKENS }}
      timeout: {{ LITELLM_UPSTREAM_TIMEOUT }}
{% endfor %}
{% for _model in _remote_models %}
  - model_name: "{{ _model.alias }}"
    litellm_params:
      model: "{{ _model.model }}"
      api_key: os.environ/{{ _model.provider | upper }}_API_KEY
      max_tokens: {{ LITELLM_MAX_OUTPUT_TOKENS }}
      timeout: {{ LITELLM_UPSTREAM_TIMEOUT }}
{% if _model.context is defined %}
    model_info:
      max_input_tokens: {{ _model.context }}
{% endif %}
{% endfor %}

litellm_settings:
  drop_params: true

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
  database_url: os.environ/DATABASE_URL
