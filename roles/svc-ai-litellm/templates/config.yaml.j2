{% set _routes = (lookup('config', 'svc-ai-ollama', 'services.ollama.preload_models') if LITELLM_OLLAMA_BACKEND | bool else [])
  | litellm_model_routes(
      (lookup('config', 'svc-ai-lmstudio', 'services.lmstudio.preload_models') if LITELLM_LMSTUDIO_BACKEND | bool else []),
      (LITELLM_REMOTE_MODELS | selectattr('provider', 'in', LITELLM_KEYED_PROVIDERS) | list),
      ollama_url=OLLAMA_BASE_LOCAL_URL,
      lmstudio_url=LMSTUDIO_BASE_LOCAL_URL,
      max_tokens=LITELLM_MAX_OUTPUT_TOKENS,
      timeout=LITELLM_UPSTREAM_TIMEOUT) %}
model_list:{{ ' []' if not _routes else '' }}
{% for _route in _routes %}
  - model_name: {{ _route.alias | to_json }}
    litellm_params:
{% for _key, _value in _route.params.items() %}
      {{ _key }}: {{ _value | to_json }}
{% endfor %}
{% if _route.context %}
    model_info:
      max_input_tokens: {{ _route.context }}
{% endif %}
{% endfor %}

litellm_settings:
  drop_params: true

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
  database_url: os.environ/DATABASE_URL
