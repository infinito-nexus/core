{%- set _ollama_models = (lookup('config', 'svc-ai-ollama', 'services.ollama.preload_models') | map(attribute='alias') | list) if 'svc-ai-ollama' in group_names else [] -%}
{%- set _lmstudio_declared = lookup('config', 'svc-ai-lmstudio', 'services.lmstudio.preload_models') | map(attribute='alias') | list -%}
{%- set _lmstudio_only = _lmstudio_declared | reject('in', _ollama_models) | list -%}
{%- set _remote = LITELLM_REMOTE_BACKENDS | selectattr('key') | map(attribute='alias') | list -%}
{%- set _expected = _ollama_models + (_lmstudio_only if 'svc-ai-lmstudio' in group_names else []) + _remote -%}
LITELLM_CONTAINER={{ CLI_LOCAL_CID }}
LITELLM_PORT={{ LITELLM_PORT }}
LITELLM_MASTER_KEY_B64={{ LITELLM_MASTER_KEY | b64encode }}
LITELLM_CHAT_MODEL={{ LITELLM_CHAT_MODEL }}
LITELLM_CHAT_MODEL_SERVED={{ LITELLM_CHAT_MODEL_SERVED | bool | string | lower }}
LITELLM_OLLAMA_ENABLED={{ ('svc-ai-ollama' in group_names) | string | lower }}
LITELLM_LMSTUDIO_ENABLED={{ ('svc-ai-lmstudio' in group_names) | string | lower }}
LITELLM_LMSTUDIO_ALIASES='{{ _lmstudio_only | to_json }}'
LITELLM_REMOTE_ALIASES='{{ _remote | to_json }}'
LITELLM_EXPECTED_MODELS='{{ _expected | to_json }}'
