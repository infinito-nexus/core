{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}

  {% set service_name = 'litellm' %}
  {{ service_name }}:
    {{ lookup('container_healthcheck', service_name) | indent(4) }}
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_image', application_id, 'litellm') }}
    {{ lookup('compose_only', 'container_name', LITELLM_CONTAINER) }}
    {% if LITELLM_MESH_BIND_HOST | length > 0 %}
    {{ lookup('container_ports', ['litellm', 'http', DOCKER_BIND_HOST], ['litellm', 'http', LITELLM_MESH_BIND_HOST]) | indent(4) }}
    {% else %}
    {{ lookup('container_ports', ['litellm', 'http', DOCKER_BIND_HOST]) | indent(4) }}
    {% endif %}
    {{ lookup('container_volumes', service_name) | indent(4) }}
    command: >
      --host 0.0.0.0
      --port {{ LITELLM_PORT }}
      --config {{ LITELLM_CONFIG_PATH_DOCKER }}
    {{ lookup('container_extra_hosts', onion_peers=([OIDC.CLIENT.TOKEN_URL, OIDC.CLIENT.USER_INFO_URL] if (LITELLM_UI_SSO | bool) else [])) | indent(4) }}
    {{ lookup('container_networks') | indent(4) }}
    {{ lookup('container_depends_on', application_id) | indent(4) }}

{{ lookup('compose_networks') }}

{{ lookup('compose_volumes') }}
