{% include 'roles/sys-svc-container/templates/env.j2' %}

LITELLM_MASTER_KEY={{ LITELLM_MASTER_KEY | dotenv_quote }}
DATABASE_URL={{ lookup('database', application_id, 'url_full') | dotenv_quote }}
STORE_MODEL_IN_DB=False
UI_USERNAME={{ lookup('users', 'administrator').username }}
UI_PASSWORD={{ lookup('config', application_id, 'secrets.credentials.ui_password') | dotenv_quote }}
{% if LITELLM_OPENROUTER_API_KEY %}
OPENROUTER_API_KEY={{ LITELLM_OPENROUTER_API_KEY | dotenv_quote }}
{% endif %}
