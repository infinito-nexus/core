{% include 'roles/sys-svc-container/templates/env.j2' %}

WEBLATE_DEBUG=0
WEBLATE_LOGLEVEL=INFO
WEBLATE_SITE_TITLE={{ WEBLATE_SITE_TITLE }}
WEBLATE_SITE_DOMAIN={{ lookup('domain', application_id) }}
WEBLATE_ALLOWED_HOSTS={{ lookup('domain', application_id) }}
WEBLATE_REGISTRATION_OPEN={{ WEBLATE_REGISTRATION_OPEN | ternary(1, 0) }}

WEBLATE_ADMIN_NAME={{ lookup('users', 'administrator').username }}
WEBLATE_ADMIN_EMAIL={{ lookup('users', 'administrator').email }}
WEBLATE_ADMIN_PASSWORD={{ WEBLATE_ADMIN_PASSWORD | dotenv_quote }}

POSTGRES_HOST={{ WEBLATE_DATABASE_HOST }}
POSTGRES_PORT={{ WEBLATE_DATABASE_PORT }}
POSTGRES_USER={{ WEBLATE_DATABASE_USER }}
POSTGRES_PASSWORD={{ WEBLATE_DATABASE_PASSWORD | dotenv_quote }}
POSTGRES_DATABASE={{ WEBLATE_DATABASE_NAME }}

REDIS_HOST={{ lookup('engine', 'redis', application_id, 'host') }}
REDIS_PORT={{ lookup('engine', 'redis', application_id, 'port') }}
{% set _redis_password = lookup('engine', 'redis', application_id, 'password') %}
{% if _redis_password | length > 0 %}
REDIS_PASSWORD={{ _redis_password | dotenv_quote }}
{% endif %}

{% if WEBLATE_OIDC_ENABLED | bool %}
WEBLATE_SOCIAL_AUTH_OIDC_KEY={{ OIDC.CLIENT.ID }}
WEBLATE_SOCIAL_AUTH_OIDC_SECRET={{ OIDC.CLIENT.SECRET | dotenv_quote }}
WEBLATE_SOCIAL_AUTH_OIDC_OIDC_ENDPOINT={{ OIDC.CLIENT.ISSUER_URL }}
WEBLATE_SOCIAL_AUTH_OIDC_USERNAME_KEY=preferred_username
WEBLATE_NO_EMAIL_AUTH=1
{% endif %}

{% if WEBLATE_EMAIL_ENABLED %}
WEBLATE_EMAIL_HOST={{ lookup('email', 'host') }}
WEBLATE_EMAIL_PORT={{ lookup('email', 'port') }}
WEBLATE_EMAIL_HOST_USER={{ lookup('email', 'username') }}
WEBLATE_EMAIL_HOST_PASSWORD={{ lookup('email', 'password') | dotenv_quote }}
WEBLATE_SERVER_EMAIL={{ lookup('email', 'from') }}
WEBLATE_DEFAULT_FROM_EMAIL={{ lookup('email', 'from') }}
{% endif %}
