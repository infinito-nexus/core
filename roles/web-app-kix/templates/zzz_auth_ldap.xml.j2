<?xml version="1.0" encoding="utf-8"?>
<kix_config version="1.0" init="Application">
    <ConfigItem AccessLevel="confidential" Name="Authentication###100-Infinito-LDAP" Required="1" Valid="1" ConfigLevel="200">
        <Description Translatable="1">{{ SOFTWARE_NAME }} LDAP backend (svc-db-openldap) for the web-app-kix-administrator role group. Authenticates KIX agents via Auth::LDAP and provisions the contact, its profile fields and the KIX roles of both role groups via Auth::Sync::LDAP.</Description>
        <Group>Framework</Group>
        <Setting>
            <Object>{{ KIX_LDAP_AUTHENTICATION['Authentication###100-Infinito-LDAP'] | to_json }}</Object>
        </Setting>
    </ConfigItem>
    <ConfigItem AccessLevel="confidential" Name="Authentication###200-Infinito-LDAP-User" Required="1" Valid="1" ConfigLevel="200">
        <Description Translatable="1">Second {{ SOFTWARE_NAME }} LDAP backend for the web-app-kix-user role group. KIX iterates over Authentication entries; if the administrator backend (###100) refuses (user not in admin group), this one tries the user group. The OAuth2-proxy `allowed_groups` filter still lets only members of either group through, so this backend never sees a user without an {{ SOFTWARE_NAME }} role. Both backends share one sync, so the KIX roles always follow every role group the user holds.</Description>
        <Group>Framework</Group>
        <Setting>
            <Object>{{ KIX_LDAP_AUTHENTICATION['Authentication###200-Infinito-LDAP-User'] | to_json }}</Object>
        </Setting>
    </ConfigItem>
</kix_config>
