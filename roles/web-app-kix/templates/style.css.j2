}
#kix-header .search-object-dropdown-container,
#kix-header .new-object-dropdown-container ul {
  --design-focus: var(--design-link);
}
.login-wrapper {
  background-image: none;
}
.form-check-input {
  border-color: var(--design-border-strong);
}
.calendar-container > div:first-of-type {
  --bs-white-rgb: var(--design-on-frame-rgb);
}
.tui-full-calendar-layout {
  filter: invert(var(--design-invert)) hue-rotate(calc(var(--design-invert) * 180deg));
}
{% if design.logo is string %}
#kix-header #logo {
  content: url("{{ design.urls.logo.png }}");
}
{% endif %}
