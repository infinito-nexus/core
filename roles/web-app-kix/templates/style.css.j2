  color: var(--design-info);
  background-color: var(--design-info-border);
}
.tiptap-editor-body td,
.tiptap-editor-body th {
  border-color: var(--design-border-strong);
}
:root {
  --ck-color-base-foreground: var(--design-surface-3);
  --ck-color-base-background: var(--design-surface-2);
  --ck-color-base-border: var(--design-border-strong);
  --ck-color-base-action: var(--design-success);
  --ck-color-base-focus: var(--design-link);
  --ck-color-base-text: var(--design-text);
  --ck-color-base-active: var(--design-primary);
  --ck-color-base-active-focus: var(--design-primary-hover);
  --ck-color-base-error: var(--design-danger);
  --ck-color-focus-border: var(--design-link);
  --ck-color-focus-outer-shadow: rgba(var(--design-link-rgb), 0.3);
  --ck-color-focus-disabled-shadow: rgba(var(--design-link-rgb), 0.3);
  --ck-color-focus-error-shadow: rgba(var(--design-danger-rgb), 0.3);
  --ck-color-shadow-drop: rgba(var(--design-shadow-color));
  --ck-color-shadow-drop-active: rgba(var(--design-shadow-color));
  --ck-color-shadow-inner: rgba(var(--design-shadow-color));
  --ck-color-button-default-hover-background: var(--design-surface-hover);
  --ck-color-button-default-active-background: var(--design-surface-active);
  --ck-color-button-on-background: var(--design-surface-active);
  --ck-color-button-on-hover-background: var(--design-surface-hover);
  --ck-color-button-on-active-background: var(--design-surface-active);
  --ck-color-button-on-disabled-background: var(--design-surface-3);
  --ck-color-button-on-color: var(--design-link);
  --ck-color-button-action-hover-background: var(--design-success-hover);
  --ck-color-button-action-active-background: var(--design-success-active);
  --ck-color-button-action-disabled-background: var(--design-success-border);
  --ck-color-button-save: var(--design-success);
  --ck-color-button-cancel: var(--design-danger);
  --ck-color-switch-button-off-background: var(--design-border-strong);
  --ck-color-switch-button-off-hover-background: var(--design-text-muted);
  --ck-color-switch-button-on-hover-background: var(--design-success-hover);
  --ck-color-input-disabled-background: var(--design-surface-3);
  --ck-color-input-disabled-text: var(--design-text-muted);
  --ck-color-engine-placeholder-text: var(--design-text-muted);
  --ck-color-upload-bar-background: var(--design-link);
  --ck-color-link-default: var(--design-link);
  --ck-color-link-selected-background: rgba(var(--design-link-rgb), 0.1);
  --ck-color-link-fake-selection: rgba(var(--design-link-rgb), 0.3);
  --ck-color-highlight-background: var(--design-warning-subtle);
  --ck-color-light-red: var(--design-danger-subtle);
  --ck-color-color-grid-check-icon: var(--design-link);
  --ck-color-split-button-hover-background: var(--design-surface-hover);
  --ck-color-split-button-hover-border: var(--design-border-strong);
  --ck-color-editable-blur-selection: var(--design-surface-active);
  --ck-color-code-block-label-background: var(--design-text-muted);
  --ck-color-image-upload-icon: var(--design-on-success);
  --ck-color-image-upload-icon-background: var(--design-success);
  --ck-color-upload-placeholder-loader: var(--design-border-strong);
  --ck-color-media-embed-placeholder-url-text: var(--design-text-muted);
  --ck-color-mention-background: rgba(var(--design-danger-rgb), 0.1);
  --ck-color-mention-text: var(--design-danger);
  --ck-color-selector-focused-cell-background: rgba(var(--design-link-rgb), 0.3);
  --ck-color-widget-blurred-border: var(--design-border);
  --ck-color-widget-hover-border: var(--design-warning);
  --ck-color-image-caption-background: var(--design-surface-3);
  --ck-color-image-caption-text: var(--design-text);
  --ck-color-image-caption-highlighted-background: var(--design-warning-subtle);
  --ck-color-selector-caption-background: var(--design-surface-3);
  --ck-color-selector-caption-text: var(--design-text);
  --ck-color-selector-caption-highlighted-background: var(--design-warning-subtle);
  --ck-color-resizer-tooltip-background: var(--design-text);
