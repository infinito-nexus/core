:root :focus-visible {
  outline: 2px solid var(--design-focus, var(--design-link));
  outline-offset: 2px;
}
:root input:focus-visible,
:root textarea:focus-visible,
:root select:focus-visible {
  outline-offset: -2px;
}
#kix-header,
.sidebar-widget > .widget-header,
.lane-widget > .widget-header,
.dialog-widget > .widget-header,
.login-wrapper .login-page .login-dialog .dialog-header,
.mobile-main-menu-container ul.main-menu li,
.mobile-main-menu-container ul.user-menu li {
