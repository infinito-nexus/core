#!/usr/bin/env bash
set -euo pipefail
export ANTHROPIC_BASE_URL={{ agnt_claude_anthropic_base_url | quote }}
export ANTHROPIC_AUTH_TOKEN={{ agnt_claude_gateway_key | quote }}
{% if agnt_claude_model | length > 0 %}
export ANTHROPIC_MODEL={{ agnt_claude_model | quote }}
{% endif %}
{% if agnt_claude_background_model | length > 0 %}
export ANTHROPIC_DEFAULT_HAIKU_MODEL={{ agnt_claude_background_model | quote }}
{% endif %}
exec claude "$@"
