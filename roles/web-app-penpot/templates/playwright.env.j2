ADMIN_EMAIL={{ lookup('users', 'administrator').email | dotenv_quote }}
ADMIN_PASSWORD={{ lookup('users', 'administrator').password | dotenv_quote }}
ADMIN_USERNAME={{ lookup('users', 'administrator').username | dotenv_quote }}
APP_BASE_URL={{ lookup('tls', application_id, 'url.base') | dotenv_quote }}
BIBER_EMAIL={{ lookup('users', 'biber').email | dotenv_quote }}
BIBER_PASSWORD={{ lookup('users', 'biber').password | dotenv_quote }}
BIBER_USERNAME={{ lookup('users', 'biber').username | dotenv_quote }}
CANONICAL_DOMAIN={{ lookup('domain', application_id) | dotenv_quote }}
# nocheck: playwright-service-gate — covered by sys-svc-mail integration tests, not the persona surface
EMAIL_SERVICE_ENABLED={{ lookup('config', application_id, 'services.email.enabled') | string | lower }}
LDAP_SERVICE_ENABLED={{ PENPOT_LDAP_ENABLED | string | lower }}
LOGOUT_SERVICE_ENABLED={{ lookup('config', application_id, 'services.logout.enabled') | string | lower }}
MATOMO_BASE_URL={{ lookup('tls', 'web-app-matomo', 'url.base') | dotenv_quote }}
MATOMO_SERVICE_ENABLED={{ lookup('config', application_id, 'services.matomo.enabled') | string | lower }}
NODE_TLS_REJECT_UNAUTHORIZED=0
OIDC_ISSUER_URL={{ OIDC.CLIENT.ISSUER_URL | dotenv_quote }}
PENPOT_BASE_URL={{ lookup('tls', application_id, 'url.base') | dotenv_quote }}
# nocheck: persona-block-rationale — Penpot's login lives on the SPA hash route /#/auth/login (files/playwright/_shared.js:84), which the helper's ${base}/login probing never reaches, and its OIDC entry is a bare "OpenID" text node (files/playwright/_shared.js:94-100) rather than a link or button named log in / sign in / sso; under OIDC the native password form is disabled outright via PENPOT_FLAGS (vars/main.yml:44, README "Identity"). Admin auth is covered by files/playwright/test-login-oidc-admin.js, test-login-ldap-admin.js and test-login-native.js (see README "Testing").
PERSONA_ADMINISTRATOR_BLOCKED=true

# nocheck: persona-block-rationale — see PERSONA_ADMINISTRATOR_BLOCKED above; biber's auth is covered by files/playwright/test-login-oidc-biber.js and test-login-ldap-biber.js (see README "Testing").
PERSONA_BIBER_BLOCKED=true
