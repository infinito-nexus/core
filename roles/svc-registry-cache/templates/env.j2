{% include 'roles/sys-svc-container/templates/env.j2' %}

{% if REGISTRY_CACHE_FLAVOR == 'registry' %}
REGISTRY_PROXY_REMOTEURL={{ REGISTRY_CACHE_PROXY_REMOTE_URL }}
REGISTRY_PROXY_TTL={{ REGISTRY_CACHE_PROXY_TTL }}
{%- else %}
ENABLE_MANIFEST_CACHE=true
MANIFEST_CACHE_SECONDARY_TIME=24h
AUTH_REGISTRIES={{ REGISTRY_CACHE_MULTI_PROXY_AUTH }}
REGISTRIES={{ REGISTRY_CACHE_MULTI_PROXY_REGISTRIES | join(',') }}
CACHE_MAX_SIZE={{ REGISTRY_CACHE_MULTI_PROXY_MAX_SIZE }}
CACHE_MAX_IDLE_DAYS={{ REGISTRY_CACHE_MULTI_PROXY_IDLE_DAYS }}
DISABLE_IPV6=true
{%- endif %}
