{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}
  {% set service_name = 'xwiki' %}
  {{ service_name }}:
    {{ lookup('template', 'roles/sys-svc-container/templates/build.yml.j2') | indent(4) }}
      args:
        XWIKI_IMAGE: "{{ XWIKI_IMAGE }}"
        XWIKI_VERSION: "{{ XWIKI_VERSION }}"
    {{ lookup('container_image', application_id, 'xwiki') }}
    {{ lookup('compose_only', 'container_name', XWIKI_CONTAINER) }}
    hostname: '{{ XWIKI_HOSTNAME}}'
    {{ lookup('container_ports', ['xwiki', 'http', DOCKER_BIND_HOST]) | indent(4) }}
    environment: # nocheck: compose-environment-from-env-file the LDAP keys follow xwiki_ldap_enabled_switch, and tasks/02_manager_ops.yml flips it for a second render of compose.yml.j2 alone; env.j2 renders once under tasks/00_core.yml with the switch pinned false, so an env-file copy would freeze the disabled state and LDAP would never reach the container
      XWIKI_PROPERTIES_SOURCE: "{{ lookup('volume', application_id, 'properties').target }}"
      {% if xwiki_ldap_enabled_switch | bool and not (xwiki_oidc_enabled_switch | bool) %}
      XWIKI_CFG_LDAP_SERVER: "{{ XWIKI_LDAP_SERVER }}"
      XWIKI_CFG_LDAP_PORT: "{{ XWIKI_LDAP_PORT }}"
      XWIKI_CFG_LDAP_BASE_DN: "{{ XWIKI_LDAP_BASE_DN }}"
      XWIKI_CFG_LDAP_BIND_DN: "{{ XWIKI_LDAP_BIND_DN }}"
      XWIKI_CFG_LDAP_BIND_PASS: "{{ XWIKI_LDAP_BIND_PASS }}"
      XWIKI_CFG_LDAP_FIELDS_MAPPING: "{{ XWIKI_LDAP_FIELDS_MAPPING }}"
      XWIKI_CFG_LDAP_GROUP_MAPPING: "XWiki.{{ XWIKI_ADMIN_GROUP_PAGE }}={{ XWIKI_LDAP_ADMIN_GROUP_DN }}"
      XWIKI_CFG_LDAP_TRYLOCAL: "{{ (XWIKI_LDAP_TRYLOCAL | bool) | ternary(1, 0) }}"
      {% endif %}
    {{ lookup('container_volumes', service_name) | indent(4) }}
    {{ lookup('container_healthcheck', service_name) | indent(4) }}
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_depends_on', application_id) | indent(4) }}
    {{ lookup('container_networks') | indent(4) }}

{{ lookup('compose_volumes') }}
{{ lookup('compose_networks') }}
