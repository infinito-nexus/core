{% for peer_host in MARIADB_HA_PEER_HOSTS %}
CREATE USER IF NOT EXISTS '{{ MARIADB_REPLICATION_USER }}'@'{{ peer_host }}';
SET @sql_alter := CONCAT(
  "ALTER USER '{{ MARIADB_REPLICATION_USER }}'@'{{ peer_host }}' IDENTIFIED BY ", QUOTE(@replication_pwd), ";"
);
PREPARE stmt FROM @sql_alter;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;
GRANT REPLICATION SLAVE ON *.* TO '{{ MARIADB_REPLICATION_USER }}'@'{{ peer_host }}';

CREATE USER IF NOT EXISTS '{{ MARIADB_ELECTOR_USER }}'@'{{ peer_host }}';
SET @sql_alter := CONCAT(
  "ALTER USER '{{ MARIADB_ELECTOR_USER }}'@'{{ peer_host }}' IDENTIFIED BY ", QUOTE(@elector_pwd), ";"
);
PREPARE stmt FROM @sql_alter;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;
GRANT SLAVE MONITOR ON *.* TO '{{ MARIADB_ELECTOR_USER }}'@'{{ peer_host }}';

{% endfor %}
DROP USER IF EXISTS '{{ MARIADB_REPLICATION_USER }}'@'%';
DROP USER IF EXISTS '{{ MARIADB_ELECTOR_USER }}'@'%';

CREATE USER IF NOT EXISTS '{{ MARIADB_ELECTOR_LOCAL_USER }}'@'localhost' IDENTIFIED VIA unix_socket;
ALTER USER '{{ MARIADB_ELECTOR_LOCAL_USER }}'@'localhost' IDENTIFIED VIA unix_socket;
GRANT RELOAD, PROCESS, LOCK TABLES, READ_ONLY ADMIN, REPLICATION SLAVE ADMIN, REPLICATION MASTER ADMIN, BINLOG MONITOR, SLAVE MONITOR, CONNECTION ADMIN ON *.* TO '{{ MARIADB_ELECTOR_LOCAL_USER }}'@'localhost';

FLUSH PRIVILEGES;
