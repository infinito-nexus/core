dir /data
user default on >{{ REDIS_PASSWORD }} ~* &* +@all
user {{ REDIS_SENTINEL_USER }} on >{{ REDIS_SENTINEL_PASSWORD }} allchannels +multi +exec +slaveof +replicaof +ping +subscribe +publish +config|rewrite +role +info +client|setname +client|kill +script|kill
user {{ REDIS_HAPROXY_CHECK_USER }} on >{{ REDIS_HAPROXY_CHECK_PASSWORD }} -@all +auth +ping +info +quit
user {{ REDIS_REPLICA_USER }} on >{{ REDIS_REPLICA_PASSWORD }} -@all +psync +replconf +ping
masteruser {{ REDIS_REPLICA_USER }}
masterauth {{ REDIS_REPLICA_PASSWORD }}
maxmemory {{ REDIS_MAXMEMORY_MB }}mb
maxmemory-policy allkeys-lru
appendonly yes
save 3600 1 300 100 60 10000
min-replicas-to-write {{ REDIS_MIN_REPLICAS_TO_WRITE }}
min-replicas-max-lag {{ REDIS_MIN_REPLICAS_MAX_LAG }}
