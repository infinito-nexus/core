{% set workspace_roles = ['web-app-semaphore', 'web-app-openbao', 'web-svc-seaweedfs', 'web-app-gitea'] %}
{% set workspaces = (workspace_roles | difference(group_names) | length == 0) and ((groups.get('svc-virt-incus', []) | length) > 0) and (lookup('config', 'web-app-gitea', 'services.gitea.workspaces.enabled') | bool) %}
BKP_TEST_BACKUPS_DIR={{ DIR_BACKUPS }}
BKP_TEST_CONSUMERLESS_DB_VOLUMES={{ lookup('database_consumerless_volumes') | join(',') }}
BKP_TEST_HEALTH_SCRIPT={{ [ DIR_SCRIPTS_SYSTEMCTL, 'sys-ctl-hlth-container', 'script.sh' ] | path_join }}
BKP_TEST_HEALTH_TIMEOUT={{ lookup('timeout', 1200) | int }}
BKP_TEST_IMAGES_NO_BACKUP={{ BKP_VOLUME_2_LOCAL_DISABLED | join(',') }}
BKP_TEST_IS_STACK_HOST={{ IS_STACK_HOST | bool | lower }}
BKP_TEST_LOCK_TIMEOUT={{ SYS_TIMEOUT_BACKUP_SERVICES_SECONDS | int }}
BKP_TEST_MAINTENANCE_BIN={{ BKP_VOLUME_2_LOCAL_MAINTENANCE_BIN }}
BKP_TEST_MAINTENANCE_FILE={{ FILE_MAINTENANCE_BACKUP }}
BKP_TEST_PYTHON={{ ansible_python_interpreter }}
BKP_TEST_REPO_ROOT={{ playbook_dir }}
BKP_TEST_SCRATCH_IMAGE={{ lookup('config', application_id, 'services.test.image') }}:{{ lookup('config', application_id, 'services.test.version') }}
BKP_TEST_SERVICE={{ SYS_SERVICE_BACKUP_VOLUME_2_LOCAL }}
BKP_TEST_STOPPING={{ BKP_VOLUME_2_LOCAL_STOPPING | join(',') }}
BKP_TEST_STOPPING_PROJECTS={{ BKP_VOLUME_2_LOCAL_STOPPING | map('entity_name') | join(',') }}
BKP_TEST_VOLUMES_NO_BACKUP={{ BKP_VOLUME_2_LOCAL_VOLUMES_DISABLED | join(',') }}
BKP_TEST_WORKSPACES={{ workspaces | lower }}
DEPLOY_IS_UPDATE={{ DEPLOY_IS_UPDATE | bool | lower }}
{% if workspaces %}
BKP_TEST_GITEA_BASIC_AUTH_B64={{ (lookup('users', 'platform_administrator').username ~ ':' ~ lookup('users', 'platform_administrator').password) | b64encode }}
BKP_TEST_GITEA_ORGANIZATION={{ lookup('config', 'web-app-gitea', 'services.gitea.workspaces.organization') }}
BKP_TEST_GITEA_URL={{ lookup('tls', 'web-app-gitea', 'url.base') }}
BKP_TEST_KEYCLOAK_ADMIN_REALM={{ OIDC.ADMIN.REALM }}
BKP_TEST_KEYCLOAK_CLIENT_ID={{ OIDC.ADMIN.CLI_CLIENT_ID }}
BKP_TEST_KEYCLOAK_PASSWORD_B64={{ OIDC.ADMIN.PASSWORD | b64encode }}
BKP_TEST_KEYCLOAK_REALM={{ OIDC.CLIENT.REALM }}
BKP_TEST_KEYCLOAK_URL={{ OIDC.URL }}
BKP_TEST_KEYCLOAK_USERNAME_B64={{ OIDC.ADMIN.USERNAME | b64encode }}
BKP_TEST_OPENBAO_URL={{ lookup('tls', 'web-app-openbao', 'url.base') }}
BKP_TEST_SEAWEEDFS_ACCESS_KEY_B64={{ lookup('users', 'platform_administrator').username | b64encode }}
BKP_TEST_SEAWEEDFS_REGION={{ lookup('config', 'web-svc-seaweedfs', 'services.seaweedfs.region') }}
BKP_TEST_SEAWEEDFS_SECRET_KEY_B64={{ lookup('users', 'platform_administrator').password | b64encode }}
BKP_TEST_SEAWEEDFS_URL={{ lookup('tls', 'web-svc-seaweedfs', 'url.base') }}
BKP_TEST_SEMAPHORE_PASSWORD_B64={{ lookup('users', 'web-app-semaphore-breakglass').password | b64encode }}
BKP_TEST_SEMAPHORE_URL={{ lookup('tls', 'web-app-semaphore', 'url.base') }}
BKP_TEST_SEMAPHORE_USERNAME_B64={{ lookup('users', 'web-app-semaphore-breakglass').username | b64encode }}
BKP_TEST_WORKSPACE_ORDER={{ lookup('config', application_id, 'services.test.workspace_order') | to_json | quote }}
{% endif %}
