  --color-text-positive-default: var(--design-success);
  --color-text-accent-default: var(--design-info);
  --color-text-inverse-default: var(--design-surface-1);
  --color-white: var(--design-surface-2);
  --color-gray-300: var(--design-border);
}

body {
  -webkit-tap-highlight-color: rgba(var(--design-text-rgb), 0);
}
.blockquote-footer {
  color: var(--design-text-muted);
}
.figure-caption {
  color: var(--bs-secondary-color);
}
.table {
  --bs-table-color: var(--design-text);
  --bs-table-striped-color: var(--design-text);
  --bs-table-striped-bg: var(--design-surface-3);
  --bs-table-active-color: var(--design-text);
  --bs-table-hover-color: var(--design-text);
}
