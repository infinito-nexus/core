  --color-interaction-critical-hover: var(--design-danger-hover);
  --color-interaction-critical-pressed: var(--design-danger-active);
  --color-interaction-critical-disabled: var(--design-danger);
  --color-elevation-surface-sunken: var(--design-surface-1);
  --color-elevation-surface-default: var(--design-surface-2);
  --color-elevation-surface-selected: var(--design-surface-active);
  --color-elevation-surface-hover: var(--design-surface-hover);
  --color-elevation-surface-raised: var(--design-surface-2);
