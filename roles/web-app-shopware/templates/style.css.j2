  --bs-table-active-bg: var(--design-text-muted);
  --bs-table-active-color: var(--design-surface-1);
  --bs-table-hover-bg: var(--design-text-muted);
  --bs-table-hover-color: var(--design-surface-1);
  color: var(--bs-table-color);
}
.form-text {
  color: var(--bs-secondary-color);
}
.form-control {
  color: var(--design-text);
  border-color: var(--design-border-strong);
}
.form-control:focus {
  color: var(--design-text);
  border-color: var(--design-link);
  box-shadow: 0 0 0 0.125rem var(--design-surface-2), 0 0 0 0.25rem var(--design-link);
}
.form-control::placeholder {
  color: var(--design-text-muted);
}
.form-control::file-selector-button {
  color: var(--design-text);
}
.form-control-plaintext {
  color: var(--bs-body-color);
  border-color: transparent;
}
.form-select {
  color: var(--design-text);
  border-color: var(--design-border-strong);
}
.form-select:focus {
  border-color: var(--design-link);
  box-shadow: 0 0 0 0.125rem var(--design-surface-2), 0 0 0 0.25rem var(--design-link);
}
.form-select:-moz-focusring {
  text-shadow: none;
}
.form-check-input {
  border-color: var(--design-border-strong);
}
.form-check-input:focus {
  border-color: var(--design-link);
  box-shadow: 0 0 0 0.125rem var(--design-surface-2), 0 0 0 0.25rem var(--design-link);
}
.form-check-input:checked,
.form-check-input[type="checkbox"]:indeterminate {
  background-color: var(--design-primary);
  border-color: var(--design-primary);
}
.form-range:focus::-webkit-slider-thumb,
.form-range:focus::-moz-range-thumb {
  box-shadow: 0 0 0 1px var(--design-surface-2), 0 0 0 0.125rem var(--design-surface-2), 0 0 0 0.25rem var(--design-link);
}
.form-range::-webkit-slider-thumb {
  background-color: var(--design-primary);
}
.form-range::-webkit-slider-thumb:active {
  background-color: var(--design-primary-active);
}
.form-range::-webkit-slider-runnable-track {
  background-color: var(--bs-secondary-bg);
}
.form-range::-moz-range-thumb {
  background-color: var(--design-primary);
}
.form-range::-moz-range-thumb:active {
  background-color: var(--design-primary-active);
}
.form-range::-moz-range-track {
  background-color: var(--bs-secondary-bg);
}
.form-range:disabled::-webkit-slider-thumb,
.form-range:disabled::-moz-range-thumb {
  background-color: var(--bs-secondary-color);
}
.form-floating > :disabled ~ label,
.form-floating > .form-control:disabled ~ label {
  color: var(--design-text-muted);
}
.input-group-text {
  color: var(--design-text);
  border-color: var(--design-border-strong);
}
.valid-feedback {
  color: var(--bs-form-valid-color);
}
.valid-tooltip {
  color: var(--design-surface-1);
}
.form-control.is-valid,
.form-select.is-valid,
.was-validated .form-check-input:valid,
.form-check-input.is-valid {
  border-color: var(--bs-form-valid-border-color);
}
.form-check-input.is-valid:checked {
  background-color: var(--bs-form-valid-color);
}
.invalid-feedback {
  color: var(--bs-form-invalid-color);
}
.invalid-tooltip {
  color: var(--design-on-danger);
}
.form-control.is-invalid,
.form-select.is-invalid,
.was-validated .form-check-input:invalid,
.form-check-input.is-invalid {
  border-color: var(--bs-form-invalid-border-color);
}
.form-check-input.is-invalid:checked {
  background-color: var(--bs-form-invalid-color);
}
.btn {
  --bs-btn-box-shadow: inset 0 1px 0 var(--design-surface-2), var(--design-shadow-1);
  color: var(--bs-btn-color);
  border: var(--bs-btn-border-width) solid var(--bs-btn-border-color);
}
.btn-primary {
  --bs-btn-color: var(--design-on-primary);
  --bs-btn-bg: var(--design-primary);
