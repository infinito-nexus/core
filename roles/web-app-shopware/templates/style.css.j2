.main-navigation-menu {
  background-color: transparent;
}

.offcanvas {
  --bs-offcanvas-bg: var(--design-surface-2);
}
{% for status in ['success', 'info', 'warning', 'danger'] %}

.badge.bg-{{ status }} {
  --bs-badge-color: var(--design-on-{{ status }});
}
{% endfor %}

.sw-admin-menu {
  --design-focus: var(--design-on-frame);
  --color-static-white: var(--design-on-frame);
  --color-text-primary-default: var(--design-on-frame);
  --color-text-secondary-default: var(--design-on-frame);
  --color-icon-primary-default: var(--design-on-frame);
  --color-icon-secondary-default: var(--design-on-frame);
  --color-zinc-200: var(--design-on-frame);
}

html .sw-admin-menu .sw-admin-menu__user-type {
  color: var(--design-on-frame);
}

html .sw-admin-menu :focus-visible {
  outline: 2px solid var(--design-on-frame);
  box-shadow: none;
}

.mt-button--primary,
.sw-button--primary,
.mt-segmented-control__action--pressed,
.sw-pagination__list-button.is-active,
.sw-sidebar-navigation-item .sidebar-item-badge,
.sw-field__checkbox,
.sw-order-address-modal__entry__selected,
.sw-tree-item__child-count,
.sw-text-editor .btn-primary,
.mt-text-editor .btn-primary {
  --color-static-white: var(--design-on-primary);
}

.mt-button--critical,
.sw-button--danger,
.mt-segmented-control__action--critical {
  --color-static-white: var(--design-on-danger);
}

html .sw-login .sw-login__image {
  --color-text-primary-inverse: var(--design-on-frame);
  background-color: var(--design-frame);
  background-image: none;
}

html .sw-login .sw-login__badge {
  --color-static-white: var(--design-on-frame);
  background-color: var(--design-frame);
}
{% if design.logo is string %}

html .sw-admin-menu .sw-admin-menu__header-logo {
  background: url("{{ design.urls['menu-logo'].svg }}") center / contain no-repeat;
}

html .sw-login .sw-login__badge {
  background: var(--design-frame) url("{{ design.urls['menu-logo'].svg }}") center / 60% no-repeat;
}

html .sw-login .sw-login__badge svg {
  visibility: hidden;
}
{% endif %}
