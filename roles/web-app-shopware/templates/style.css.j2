{% set design = lookup('design', application_id) %}
:root {
  --bs-heading-color: var(--design-text);
  --bs-form-valid-color: var(--design-success);
  --bs-form-valid-border-color: var(--design-success);
  --bs-form-invalid-color: var(--design-danger);
  --bs-form-invalid-border-color: var(--design-danger);
  --bs-secondary-text-emphasis: var(--design-text);
  --bs-secondary-bg-subtle: var(--design-surface-3);
  --bs-secondary-border-subtle: var(--design-border);
  --bs-light-text-emphasis: var(--design-text-muted);
  --bs-light-bg-subtle: var(--design-surface-2);
  --bs-light-border-subtle: var(--design-border);
  --bs-dark-text-emphasis: var(--design-text);
  --bs-dark-bg-subtle: var(--design-surface-3);
  --bs-dark-border-subtle: var(--design-border-strong);
  --text-color-brand-primary: var(--design-link);
}

