  --color-elevation-backdrop-default: rgba(var(--design-surface-3-rgb), 0.8);
  --color-background-primary-default: var(--design-surface-2);
  --color-background-primary-disabled: var(--design-surface-3);
  --color-background-secondary-default: var(--design-surface-1);
  --color-background-tertiary-default: var(--design-surface-3);
  --color-background-brand-default: var(--design-primary-100);
  --color-background-critical-default: var(--design-danger-subtle);
  --color-background-critical-dark: var(--design-danger-subtle);
  --color-background-attention-default: var(--design-warning-subtle);
  --color-background-positive-default: var(--design-success-subtle);
  --color-background-accent-default: var(--design-info-subtle);
  --color-icon-primary-default: var(--design-text);
  --color-icon-primary-disabled: var(--design-text-muted);
  --color-icon-primary-inverse: var(--design-surface-1);
  --color-icon-secondary-default: var(--design-text-muted);
  --color-icon-secondary-disabled: var(--design-text-muted);
  --color-icon-secondary-inverse: var(--design-surface-3);
  --color-icon-brand-default: var(--design-link);
  --color-icon-brand-hover: var(--design-link);
  --color-icon-brand-pressed: var(--design-link);
  --color-icon-brand-disabled: var(--design-text-muted);
  --color-icon-critical-default: var(--design-danger);
  --color-icon-critical-hover: var(--design-danger);
  --color-icon-critical-disabled: var(--design-text-muted);
  --color-icon-attention-default: var(--design-warning);
  --color-icon-positive-default: var(--design-success);
  --color-icon-accent-default: var(--design-info);
  --color-icon-inverse-default: var(--design-surface-1);
  --color-border-primary-default: var(--design-border-strong);
  --color-border-secondary-default: var(--design-border);
  --color-border-brand-selected: var(--design-primary);
  --color-border-brand-default: var(--design-primary);
  --color-border-brand-disabled: var(--design-border);
  --color-border-critical-default: var(--design-danger);
  --color-border-critical-dark: var(--design-danger);
  --color-border-critical-disabled: var(--design-danger-border);
  --color-border-attention-default: var(--design-warning);
  --color-border-positive-default: var(--design-success);
  --color-border-accent-default: var(--design-info);
  --color-text-primary-default: var(--design-text);
  --color-text-primary-disabled: var(--design-text-muted);
  --color-text-primary-inverse: var(--design-surface-1);
  --color-text-secondary-default: var(--design-text-muted);
  --color-text-secondary-disabled: var(--design-text-muted);
  --color-text-secondary-inverse: var(--design-surface-3);
  --color-text-tertiary-default: var(--design-text-muted);
  --color-text-brand-default: var(--design-link);
  --color-text-brand-hover: var(--design-link);
  --color-text-brand-pressed: var(--design-link);
  --color-text-brand-disabled: var(--design-text-muted);
  --color-text-brand-inverse: var(--design-surface-1);
  --color-text-critical-default: var(--design-danger);
  --color-text-critical-hover: var(--design-danger);
  --color-text-critical-pressed: var(--design-danger);
