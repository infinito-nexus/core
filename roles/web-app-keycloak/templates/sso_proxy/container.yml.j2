{% if lookup('sso', application_id, 'is_proxy_gated') %}
{% for sso_proxy_instance in lookup('sso', application_id, 'proxy_instances') %}
  {{ sso_proxy_instance.service }}:
    {{ lookup('container_image', 'web-app-keycloak', 'sso_proxy') }}
    {{ lookup('compose_restart') }}
    command: --config /oauth2-proxy.cfg --alpha-config /oauth2-proxy-alpha.yml
    {{ lookup('compose_only', 'container_name', ((application_id | entity_name) ~ '-' ~ sso_proxy_instance.service)) }}
    hostname: {{ sso_proxy_instance.service }}
    labels:
      infinito.sso-proxy.config-sha256: "{{ (lookup('template', lookup('path_absolute', 'roles/web-app-keycloak/templates/sso_proxy/oauth2-proxy-keycloak.cfg.j2'), template_vars={'sso_proxy_application_id': application_id, 'sso_proxy_network': sso_proxy_instance.network}) ~ lookup('template', lookup('path_absolute', 'roles/web-app-keycloak/templates/sso_proxy/oauth2-proxy-keycloak-alpha.yml.j2'), template_vars={'sso_proxy_application_id': application_id})) | hash('sha256') }}"
    ports:
      # nocheck: compose-ports-must-use-container-ports  the published port belongs to the consuming role's own entity and the container port to web-app-keycloak's sso_proxy, so the mapping spans two application_ids and no single container_ports call can read both
      - {{ DOCKER_BIND_HOST }}:{{ lookup('config', application_id, 'services.' ~ (application_id | entity_name) ~ '.ports.local.' ~ sso_proxy_instance.port_key) }}:{{ lookup('config', 'web-app-keycloak', 'services.sso_proxy.ports.internal.http') }}/tcp
    volumes:
      - "{{ lookup('container', application_id, 'directories.volumes') }}{{ sso_proxy_instance.config_file }}:/oauth2-proxy.cfg"
      - "{{ lookup('container', application_id, 'directories.volumes') }}{{ sso_proxy_instance.alpha_config_file }}:/oauth2-proxy-alpha.yml"
{% if (TLS_MODE | lower) == 'self_signed' and OIDC.CLIENT.ISSUER_URL.startswith('https') %}
      - "{{ CA_TRUST.cert_host }}:{{ CA_TRUST.cert_container }}:ro"
{% endif %}
{% if IS_SWARM_MODE %}
    {{ lookup('container_networks', provider_self_alias=False) | indent(4) }}
    deploy:
      placement:
        constraints:
          - node.role == manager
      update_config:
        failure_action: continue
{% endif %}
    {{ lookup('container_extra_hosts', extra_hosts=(
         [] if (lookup('domain', 'web-app-keycloak') | network_of) == 'tor'
         else [lookup('domain', 'web-app-keycloak') ~ ':host-gateway']
       )) | indent(4) }}
    # nocheck: container-healthcheck-literal  per-consumer sidecar partial rendered for the consuming role's application_id, so the declaration has no single meta/services.yml to live in
    healthcheck:
      test: ["CMD", "/bin/oauth2-proxy", "--version"]
      interval: 2m
      timeout: 5s
      retries: 1
      start_period: 10m
      start_interval: 5s
{% endfor %}
{% endif %}
