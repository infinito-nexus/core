  --pf-v5-global--BackgroundColor--dark-transparent-200: rgba(var(--design-primary-950-rgb),0.8);
  --pf-v5-global--color-01--100:           var(--design-primary-950);
  --pf-v5-global--color-01--200:           var(--design-primary-800);
  --pf-v5-global--color-01--300:           var(--design-primary-950);
  --pf-v5-global--color-01--400:           var(--design-primary-600);
  --pf-v5-global--color-01--light-100:     var(--design-surface-2);
  --pf-v5-global--color-01--light-200:     var(--design-primary-200);
  --pf-v5-global--color-01--light-300:     var(--design-primary-400);
  --pf-v5-global--color-01--dark-100:      var(--design-primary-950);
  --pf-v5-global--color-01--dark-200:      var(--design-primary-800);
  --pf-v5-global--active-color--100:    var(--design-primary-500);
