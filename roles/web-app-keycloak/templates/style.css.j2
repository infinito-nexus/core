  --pf-v5-global--link--color-01--light--hover:    var(--design-primary-200);
  --pf-v5-global--link--color-01--dark:            var(--design-primary-500);
  --pf-v5-global--link--color-01--dark--hover:     var(--design-primary-800);
  --pf-v5-global--link--color-01--visited:         var(--design-primary-800);
  --pf-v5-global--BorderColor--100:             var(--design-primary-400);
  --pf-v5-global--BorderColor--200:             var(--design-primary-600);
  --pf-v5-global--BorderColor--300:             var(--design-primary-200);
