  --pf-v5-global--BackgroundColor--100:              var(--design-surface-2);
  --pf-v5-global--BackgroundColor--150:              var(--design-primary-100);
  --pf-v5-global--BackgroundColor--200:              var(--design-primary-200);
  --pf-v5-global--BackgroundColor--300:              var(--design-primary-400);
  --pf-v5-global--BackgroundColor--400:              var(--design-primary-500);
  --pf-v5-global--BackgroundColor--light-100:        var(--design-surface-2);
  --pf-v5-global--BackgroundColor--light-200:        var(--design-primary-100);
  --pf-v5-global--BackgroundColor--light-300:        var(--design-primary-200);
  --pf-v5-global--BackgroundColor--dark-100:         var(--design-primary-950);
  --pf-v5-global--BackgroundColor--dark-200:         var(--design-primary-950);
  --pf-v5-global--BackgroundColor--dark-300:         var(--design-primary-950);
  --pf-v5-global--BackgroundColor--dark-400:         var(--design-primary-900);
