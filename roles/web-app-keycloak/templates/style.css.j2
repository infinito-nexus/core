}
.pf-v5-c-button.pf-m-tertiary {
    --pf-v5-c-button--m-tertiary--BackgroundColor: var(--design-primary-400);
    background-color: var(--pf-v5-c-button--m-tertiary--BackgroundColor); 
}
/* Additional Keykloak Configuration */
a.pf-v5-c-nav__link{
    --pf-v5-c-nav__link--BackgroundColor: rgba(var(--design-primary-600-rgb), 0.4);
}
/* Keycloak */
div#app header{
    background-color: var(--design-primary-500);
    background: linear-gradient(135deg, var(--design-primary-600), var(--design-primary-500), var(--design-primary-500), var(--design-primary-500));
    color: var(--design-surface-2);
}
