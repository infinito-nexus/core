  --pf-v5-global--disabled-color--200:  var(--design-primary-400);
  --pf-v5-global--disabled-color--300:  var(--design-primary-200);
  --pf-v5-global--primary-color--100:   var(--design-primary-500);
  --pf-v5-global--primary-color--200:   var(--design-primary-800);
  --pf-v5-global--primary-color--light-100: var(--design-primary-400);
  --pf-v5-global--primary-color--dark-100:  var(--design-primary-500);
  --pf-v5-global--secondary-color--100: var(--design-primary-800);
  --pf-v5-global--custom-color--100:    var(--design-primary-500);
  --pf-v5-global--custom-color--200:    var(--design-primary-500);
  --pf-v5-global--custom-color--300:    var(--design-primary-900);
