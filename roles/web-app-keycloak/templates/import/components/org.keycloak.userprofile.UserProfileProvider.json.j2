{% set _profile = namespace(attrs=[], groups=[], lookaheads='') %}
{% for pattern in IAM_USERNAME_PATTERNS %}
{% set _profile.lookaheads = _profile.lookaheads ~ '(?=(?:' ~ pattern ~ ')$)' %}
{% endfor %}
{% for attribute in KEYCLOAK_PROFILE_ATTRIBUTES %}
{% set _profile.attrs = _profile.attrs + [{
  "name": attribute.name,
  "displayName": attribute.display,
  "validations": {"length": {"max": attribute.max}},
  "permissions": {"view": ["admin","user"], "edit": KEYCLOAK_PROFILE_GROUPS[attribute.group].edit},
  "group": attribute.group,
  "multivalued": false
}] %}
{% endfor %}
{% for group_name, group in KEYCLOAK_PROFILE_GROUPS.items() %}
{% set _profile.groups = _profile.groups + [{
  "name": group_name,
  "displayHeader": group.header,
  "displayDescription": group.description
}] %}
{% endfor %}
{% set _email = {
  "name": "email",
  "displayName": "Secondary email" if KEYCLOAK_EMAIL_MAILBOX | bool else "${email}",
  "validations": {"email": {}, "length": {"max": 255}},
  "permissions": {"view": ["admin","user"], "edit": ["admin","user"] if KEYCLOAK_EMAIL_UPDATE_ENABLED | bool else ["admin"]},
  "multivalued": false
} %}
{% if KEYCLOAK_EMAIL_MAILBOX | bool %}
{% set _ = _email.validations.update({"pattern": {
  "pattern": KEYCLOAK_EMAIL_SECONDARY_PATTERN,
  "error-message": "An address in " ~ KEYCLOAK_EMAIL_DOMAIN ~ " is a mailbox of this platform and cannot be the secondary address."
}}) %}
{% endif %}
{% if not (KEYCLOAK_EMAIL_MAILBOX | bool) or (KEYCLOAK_EMAIL_SECONDARY_REQUIRED | bool and KEYCLOAK_REGISTRATION_ALLOWED | bool) %}
{% set _ = _email.update({"required": {"roles": ["user"]}}) %}
{% endif %}
{% set _mailbox_attrs = [{
  "name": KEYCLOAK_EMAIL_MAILBOX_ATTRIBUTE,
  "displayName": "Mailbox",
  "validations": {"email": {}, "length": {"max": 255}},
  "annotations": {},
  "permissions": {"view": ["admin","user"], "edit": ["admin"]},
  "multivalued": false
}] if KEYCLOAK_EMAIL_MAILBOX | bool else [] %}
{% set _export_attrs = [{
  "name": KEYCLOAK_EXPORT_RECIPIENT_ATTRIBUTE,
  "displayName": "Export recipient (age public key)",
  "validations": {"pattern": {
    "pattern": KEYCLOAK_EXPORT_RECIPIENT_PATTERN,
    "error-message": "Enter exactly one age recipient: age1 followed by 58 lowercase bech32 characters."
  }},
  "annotations": {},
  "permissions": {"view": ["admin","user"], "edit": ["user"]},
  "group": "user-metadata",
  "multivalued": false
}] if KEYCLOAK_ORGANIZATIONS_ENABLED | bool else [] %}
{% set _base_attrs = [
  {
    "name": "username",
    "displayName": "${username}",
    "validations": {
      "length": { "min": 3, "max": IAM_ACCOUNT_MAX_LENGTH },
      "pattern": {
        "pattern": "^(?!(?:" ~ KEYCLOAK_RESERVED_USERNAMES_REGEX | replace('\\', '\\\\') ~ ")$)" ~ _profile.lookaheads ~ "(?:[a-z1-9]+|[a-z1-9]{4}0[a-z1-9]+)$",
        "error-message": "Username is reserved or contains invalid characters. Only lowercase letters (a–z) and digits (1–9) are allowed."
      }
    },
    "annotations": {},
    "permissions": {"view": ["admin","user"], "edit": ["admin","user"]},
    "multivalued": false
  },
  _email,
  {
    "name": "firstName",
    "displayName": "${firstName}",
    "validations": {"length": {"max": 255}, "person-name-prohibited-characters": {}},
    "required": {"roles": ["user"]},
    "permissions": {"view": ["admin","user"], "edit": ["admin","user"]},
    "multivalued": false
  },
  {
    "name": "lastName",
    "displayName": "${lastName}",
    "validations": {"length": {"max": 255}, "person-name-prohibited-characters": {}},
    "required": {"roles": ["user"]},
    "permissions": {"view": ["admin","user"], "edit": ["admin","user"]},
    "multivalued": false
  },
  {
    "name": LDAP.USER.ATTRIBUTES.SSH_PUBLIC_KEY,
    "displayName": "SSH Public Key",
    "validations": {},
    "annotations": {},
    "permissions": {"view": ["admin","user"], "edit": ["admin","user"]},
    "group": "user-metadata",
    "multivalued": true
  },
  {
    "name": "uidNumber",
    "displayName": "POSIX uid",
    "validations": {"integer": {}},
    "annotations": {},
    "permissions": {"view": ["admin","user"], "edit": ["admin"]},
    "group": "user-metadata",
    "multivalued": false
  },
  {
    "name": LDAP.USER.ATTRIBUTES.NEXTCLOUD_QUOTA,
    "displayName": "Nextcloud quota",
    "validations": {"integer": {}},
    "annotations": {},
    "permissions": {"view": ["admin","user"], "edit": ["admin"]},
    "group": "user-metadata",
    "multivalued": false
  },
  {
    "name": OIDC.ATTRIBUTES.NEXTCLOUD_UID,
    "displayName": "Nextcloud user id",
    "validations": {"length": {"max": 64}},
    "annotations": {},
    "permissions": {"view": ["admin"], "edit": ["admin"]},
    "group": "user-metadata",
    "multivalued": false
  }
] %}
{% set user_profile = {
  "attributes": _base_attrs + _mailbox_attrs + _export_attrs + _profile.attrs,
  "groups": [
    {
      "name": "user-metadata",
      "displayHeader": "User metadata",
      "displayDescription": "Attributes, which refer to user metadata"
    }
  ] + _profile.groups
} %}
"org.keycloak.userprofile.UserProfileProvider": [
  {
    "providerId": "declarative-user-profile",
    "name": "declarative-user-profile",
    "subComponents": {},
    "config": {
      "kc.user.profile.config": [{{ (user_profile | to_json) | to_json }}]
    }
  }
]
