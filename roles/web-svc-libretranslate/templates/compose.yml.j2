{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}

  {% set service_name = LIBRETRANSLATE_SERVICE %}
  {{ service_name }}:
    {{ lookup('template', 'roles/sys-svc-container/templates/build.yml.j2') | indent(4) }}
      args:
        LIBRETRANSLATE_IMAGE: "{{ LIBRETRANSLATE_IMAGE }}"
        LIBRETRANSLATE_VERSION: "{{ LIBRETRANSLATE_VERSION }}"
        LIBRETRANSLATE_LOAD_ONLY: "{{ LIBRETRANSLATE_LOAD_ONLY }}"
    {{ lookup('container_image', application_id, 'libretranslate') }}
    volumes: []
    {{ lookup('container_ports', ['libretranslate', 'http', DOCKER_BIND_HOST]) | indent(4) }}
    healthcheck:
      test: ["CMD-SHELL", "./venv/bin/python scripts/healthcheck.py"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_networks') | indent(4) }}

  {% if LIBRETRANSLATE_MCP_ENABLED | bool %}
  {% set service_name = LIBRETRANSLATE_MCP_SERVICE_KEY %}
  {{ service_name }}:
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_image', application_id, 'libretranslatemcp') }}
    build:
      context: {{ LIBRETRANSLATE_MCP_INSTANCE_DIR }}
      dockerfile: Dockerfile
      args:
        MCP_ADAPTER_BASE_IMAGE: {{ lookup('config', application_id, 'services.libretranslatemcp.image') }}
        MCP_ADAPTER_BASE_VERSION: "{{ lookup('config', application_id, 'services.libretranslatemcp.version') }}"
    {{ lookup('compose_only', 'container_name', LIBRETRANSLATE_MCP_CONTAINER) }}
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    environment:
      ADAPTER_CONTRACT: {{ LIBRETRANSLATE_MCP_CONTRACT | to_json | to_json }}
      ADAPTER_BEARER: {{ LIBRETRANSLATE_MCP_BEARER | to_json }}
      ADAPTER_PORT: "{{ LIBRETRANSLATE_MCP_PORT }}"
      ADAPTER_UPSTREAM_KEY: {{ LIBRETRANSLATE_MCP_UPSTREAM_KEY | to_json }}
    expose:
      - "{{ LIBRETRANSLATE_MCP_PORT }}"
    {{ lookup('container_networks', own_network_only=True, provider_self_alias=False) | indent(4) }}
  {% endif %}

{{ lookup('compose_volumes', application_id,
) }}

{{ lookup('compose_networks') }}
