{% set design = lookup('design', application_id) %}
:root {
  --pri-bg-color: var(--design-surface-1);
  --sec-bg-color: var(--design-surface-2);
  --code-bg-color: var(--design-surface-2);
  --border-color: var(--design-border-strong);
  --fg-color: var(--design-text);
  --nav-fg-color: var(--design-on-frame);
  --accent-color: var(--design-frame);
}

html {
  color: var(--design-text);
}

a {
  color: var(--design-link);
}

nav,
.page-footer {
  --design-focus: var(--design-on-frame);
  color: var(--design-on-frame);
}

nav a,
nav ul a,
nav .brand-logo,
nav .sidenav-trigger,
#nav-mobile a,
#nav-mobile a i.material-icons,
#nav-mobile .locale-panel,
.page-footer a,
.page-footer .footer-copyright {
  color: var(--design-on-frame);
}

.page-footer .white-text,
.page-footer .grey-text.text-lighten-4 {
  color: var(--design-on-frame) !important;
}

nav ul a:hover,
.sidenav li > a:hover {
  background-color: var(--design-frame-hover);
}

nav button:focus,
.page-footer .footer-copyright {
  background-color: var(--design-frame-active);
}

nav a:focus-visible,
nav button:focus-visible,
nav select:focus-visible,
.page-footer a:focus-visible,
.language-select select:focus-visible,
.btn-switch-language:focus-visible,
.btn-delete-text:focus-visible,
.btn-action:focus-visible,
.card .card-action a:focus-visible {
  outline: 2px solid var(--design-focus, var(--design-link));
  outline-offset: 2px;
}

nav,
.card {
  box-shadow: var(--design-shadow-1);
}

.top-nav .locale-panel {
  box-shadow: var(--design-shadow-2);
}

.btn-switch-language {
  color: var(--design-text);
}

.textarea-container .material-icons,
.btn-delete-text,
.btn-action,
.btn-action:disabled {
  color: var(--design-text-muted);
}

.btn-delete-text:hover .material-icons,
.btn-action:hover,
.btn-action:hover .material-icons {
  color: var(--design-text);
}

.textarea-container textarea:focus {
  border-color: var(--design-focus, var(--design-link));
}

.progress {
  background-color: var(--design-surface-3);
}

.progress .indeterminate {
  background-color: var(--design-primary);
}

.spinner-blue-only {
  border-color: var(--design-primary);
}

.card {
  background-color: var(--design-surface-2);
  color: var(--design-text);
}

.card .card-content > i.material-icons {
  color: var(--design-warning);
}

.card .card-action {
  border-top-color: var(--design-border);
}

.card .card-action a:not(.btn):not(.btn-large):not(.btn-small):not(.btn-large):not(.btn-floating),
.card .card-action a:not(.btn):not(.btn-large):not(.btn-small):not(.btn-large):not(.btn-floating):hover {
  color: var(--design-link);
}

.code {
  border-color: var(--design-border);
}

code[class*="language-"],
pre[class*="language-"] {
  text-shadow: none;
}

code[class*="language-"] ::selection,
code[class*="language-"]::selection {
  background: var(--design-surface-active);
}

.token.comment,
.token.prolog,
.token.doctype,
.token.cdata,
.token.punctuation {
  color: var(--design-text-muted);
}

.token.atrule,
.token.attr-value,
.token.keyword {
  color: var(--design-link);
}

.token.attr-name,
.token.builtin,
.token.char,
.token.inserted,
.token.selector,
.token.string {
  color: var(--design-success);
}

.token.boolean,
.token.constant,
.token.deleted,
.token.number,
.token.property,
.token.symbol,
.token.tag,
.token.important,
.token.regex,
.token.variable {
  color: var(--design-warning);
}

.token.class-name,
.token.function {
  color: var(--design-danger);
}

.language-css .token.string,
.style .token.string,
.token.entity,
.token.operator,
.token.url {
  color: var(--design-text);
  background: transparent;
}

body {
  background-color: var(--design-surface-1);
}
.swagger-ui {
  color: var(--design-text);
}
.swagger-ui mark {
  background-color: var(--design-warning);
  color: var(--design-on-warning);
}
.swagger-ui legend {
  color: inherit;
}
.swagger-ui .debug-white * {
  outline-color: var(--design-surface-2);
}
.swagger-ui .debug-black * {
  outline-color: var(--design-border-strong);
}
.swagger-ui .debug-grid-8-solid,
.swagger-ui .debug-grid-16-solid {
  background-color: var(--design-surface-2);
}
.swagger-ui .outline {
  outline-color: currentcolor;
}
.swagger-ui .outline-transparent {
  outline-color: transparent;
}
@media screen and (min-width:30em) {
.swagger-ui .outline-ns {
  outline-color: currentcolor;
}
.swagger-ui .outline-transparent-ns {
  outline-color: transparent;
