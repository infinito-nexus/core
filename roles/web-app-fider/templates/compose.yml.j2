{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}

  {% set service_name = 'fider' %}
  {{ service_name }}:
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_image', application_id, 'fider') }}
    {{ lookup('compose_only', 'container_name', FIDER_CONTAINER) }}
    {{ lookup('container_ports', ['fider', 'http', DOCKER_BIND_HOST]) | indent(4) }}
    healthcheck:
      test: ["CMD", "./fider", "ping"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s

    {{ lookup('container_networks') | indent(4) }}
    {{ lookup('container_depends_on', application_id) | indent(4) }}


  {% if FIDER_MCP_ENABLED | bool %}
  {% set service_name = FIDER_MCP_SERVICE_KEY %}
  {{ service_name }}:
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_image', application_id, 'fidermcp') }}
    build:
      context: {{ FIDER_MCP_INSTANCE_DIR }}
      dockerfile: Dockerfile
      args:
        MCP_ADAPTER_BASE_IMAGE: {{ lookup('config', application_id, 'services.fidermcp.image') }}
        MCP_ADAPTER_BASE_VERSION: "{{ lookup('config', application_id, 'services.fidermcp.version') }}"
    {{ lookup('compose_only', 'container_name', FIDER_MCP_CONTAINER) }}
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    environment:
      ADAPTER_CONTRACT: {{ FIDER_MCP_CONTRACT | to_json | to_json }}
      ADAPTER_BEARER: {{ FIDER_MCP_BEARER | to_json }}
      ADAPTER_PORT: "{{ FIDER_MCP_PORT }}"
      ADAPTER_UPSTREAM_KEY: {{ FIDER_MCP_UPSTREAM_KEY | to_json }}
    expose:
      - "{{ FIDER_MCP_PORT }}"
    {{ lookup('container_networks', own_network_only=True, provider_self_alias=False) | indent(4) }}
  {% endif %}

{{ lookup('compose_volumes', application_id,
) }}
{{ lookup('compose_networks') }}
