# nocheck: persona-block-rationale — the MinIO Console version pinned by this role never renders an SSO button: /api/v1/login answers redirectRules: null however the IdP is registered server-side, so there is no in-page OIDC entry point for the shared helper to click. The integrated OIDC path is proven at the STS AssumeRoleWithWebIdentity tier by the role's own spec instead (see README "Persona contract opt-outs").
PERSONA_ADMINISTRATOR_BLOCKED=true

# nocheck: persona-block-rationale — the only MinIO policy this role creates is the administrator RBAC group path (vars/main.yml MINIO_OIDC_POLICY_NAME, attached in tasks/02_ldap.yml), and MinIO has no self-service signup; biber maps to no policy, so neither the STS exchange nor the Console yields an authenticated surface for him (see README "Persona contract opt-outs").
PERSONA_BIBER_BLOCKED=true

SSO_SERVICE_ENABLED={{ lookup('config', application_id, 'services.sso.enabled') | string | lower }}

