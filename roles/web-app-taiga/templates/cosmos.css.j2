{{ COSMOS_SKY_SELECTOR }},
{{ COSMOS_SKY_SELECTOR }} body,
{{ COSMOS_SKY_SELECTOR }} .master,
{{ COSMOS_SKY_SELECTOR }} .auth {
  background: transparent;
  color: var(--cosmos-text);
}
{{ COSMOS_SKY_SELECTOR }} .auth :is(.tagline, .login-text, .register-text, .login-text a, .register-text a, .white-link, .forgot-text) {
  color: inherit;
}
{{ COSMOS_LEGIBLE_TOP_SELECTOR }} .master,
{{ COSMOS_LEGIBLE_TOP_SELECTOR }} .auth,
{{ COSMOS_LEGIBLE_TOP_SELECTOR }} #container {
  background-color: var(--design-surface-1);
  color: var(--design-text);
}
