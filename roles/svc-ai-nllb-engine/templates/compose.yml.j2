{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}

  {% set service_name = NLLB_SERVICE %}
  {{ service_name }}:
    {{ lookup('template', 'roles/sys-svc-container/templates/build.yml.j2') | indent(4) }}
      cache_from:
        - "{{ lookup('image', application_id, 'nllb-engine', version=NLLB_IMAGE_VERSION) }}"
      args:
        BUILDKIT_INLINE_CACHE: "1"
        NLLB_BASE_IMAGE: "{{ NLLB_BASE_IMAGE }}"
        NLLB_BASE_VERSION: "{{ NLLB_BASE_VERSION }}"
        NLLB_GPU: "{{ NLLB_GPU | bool | lower }}"
        NLLB_MODELS_DIR: "{{ NLLB_MODELS_TARGET }}"
    {{ lookup('container_image', application_id, 'nllb-engine', version=NLLB_IMAGE_VERSION) }}
    {{ lookup('compose_only', 'container_name', NLLB_CONTAINER) }}
    expose:
      - "{{ NLLB_PORT }}"
    {{ lookup('container_volumes', service_name) | indent(4) }}
    {{ lookup('container_healthcheck', service_name) | indent(4) }}
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_networks') | indent(4) }}

{{ lookup('compose_volumes') }}

{{ lookup('compose_networks') }}
