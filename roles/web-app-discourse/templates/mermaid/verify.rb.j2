SiteSetting.refresh!
verify_url = '{{ DISCOURSE_MERMAID_REPOSITORY }}'
verify_theme = Theme.joins(:remote_theme).find_by(remote_themes: { remote_url: verify_url })
verify_parent = Theme.find_by(id: SiteSetting.default_theme_id)
puts "mermaid_installed=#{!verify_theme.nil?}"
puts "mermaid_component=#{verify_theme && verify_theme.component}"
puts "mermaid_enabled=#{verify_theme && verify_theme.enabled?}"
puts "mermaid_attached=#{!verify_theme.nil? && !verify_parent.nil? && verify_parent.child_themes.include?(verify_theme)}"
