(function () {
  var root = document.documentElement;

  function mirror() {
    var light = document.querySelector("link.light-scheme");
    var dark = document.querySelector("link.dark-scheme");
    var mode = null;
    if (dark) {
      if (dark.media === "all") mode = "dark";
      else if (dark.media === "none") mode = "light";
    } else if (light) {
      var meta = document.querySelector('meta[name="color-scheme"]');
      mode = meta && meta.content.trim() === "dark" ? "dark" : "light";
    }
    if (mode) root.setAttribute("data-design-theme", mode);
    else root.removeAttribute("data-design-theme");
  }

  function watch() {
    mirror();
    var links = document.querySelectorAll("link.light-scheme, link.dark-scheme");
    var observer = new MutationObserver(mirror);
    for (var i = 0; i < links.length; i += 1) {
      observer.observe(links[i], { attributes: true, attributeFilter: ["media"] });
    }
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", watch);
  else watch();
})();
