/* Discourse */
:root section#main{
  --primary:                   var(--design-primary-950);
  --secondary:                 var(--design-primary-100);
  --tertiary:                  var(--design-primary-800);
  --quaternary:                var(--design-primary-600);
  --header_background:         var(--design-primary-200);
  --header_primary:            var(--design-primary-950);
  --highlight:                 var(--design-primary-400);
  --d-selected:                var(--design-primary-200);
  --d-hover:                   var(--design-primary-200);
  --d-sidebar-background:      var(--design-primary-100); 
  --d-sidebar-footer-fade:     var(--design-primary-100);
  --always-black-rgb:          var(--design-text-rgb);
  --primary-rgb:               var(--design-primary-950-rgb);
  --primary-low-rgb:           var(--design-primary-100-rgb);
  --primary-very-low-rgb:      var(--design-surface-2-rgb);
  --secondary-rgb:             var(--design-primary-100-rgb);
  --header_background-rgb:     var(--design-primary-400-rgb);
  --tertiary-rgb:              var(--design-primary-800-rgb);
  --highlight-rgb:             var(--design-primary-400-rgb);
  --success-rgb:               var(--design-primary-600-rgb);
  --primary-very-low:          var(--design-surface-2);
  --primary-low:               var(--design-primary-100);
  --primary-low-mid:           var(--design-primary-400);
  --primary-medium:            var(--design-primary-500);
  --primary-high:              var(--design-primary-800);
  --primary-very-high:         var(--design-primary-950);
  --primary-50:                var(--design-surface-2);
{% for step in range(100, 1000, 100) %}
  --primary-{{ step }}: var(--design-neutral-{{ step }});
{% endfor %}
  --header_primary-low:        rgb(var(--design-primary-400-rgb));
  --header_primary-low-mid:    rgb(var(--design-primary-400-rgb));
  --header_primary-medium:     rgb(var(--design-primary-500-rgb));
  --header_primary-high:       rgb(var(--design-primary-600-rgb));
  --header_primary-very-high:  rgb(var(--design-primary-950-rgb));
  --secondary-low:             var(--design-primary-950);
  --secondary-medium:          var(--design-primary-800);
  --secondary-high:            var(--design-primary-500);
  --secondary-very-high:       var(--design-primary-200);
  --tertiary-very-low:         var(--design-surface-2);
  --tertiary-low:              var(--design-primary-100);
  --tertiary-medium:           var(--design-primary-500);
  --tertiary-high:             var(--design-primary-800);
  --tertiary-hover:            var(--design-primary-950);
  --tertiary-50:               var(--design-surface-2);
{% for step in range(100, 1000, 100) %}
  --tertiary-{{ step }}: var(--design-primary-{{ step }});
{% endfor %}
  --quaternary-low:           var(--design-primary-300);
  --highlight-bg:             var(--design-primary-200);
  --highlight-low:            var(--design-primary-200);
  --highlight-medium:         var(--design-primary-300);
  --highlight-high:           var(--design-primary-900);
  --blend-primary-secondary-5:          rgb(var(--design-primary-100-rgb));
  --primary-med-or-secondary-med:       var(--design-primary-500);
  --primary-med-or-secondary-high:      var(--design-primary-500);
  --primary-high-or-secondary-low:      var(--design-primary-800);
  --primary-low-mid-or-secondary-high:  var(--design-primary-400);
  --primary-low-mid-or-secondary-low:   var(--design-primary-400);
  --primary-or-primary-low-mid:         var(--design-primary-950);
  --highlight-low-or-medium:            var(--design-primary-200);
  --tertiary-or-tertiary-low:           var(--design-primary-800);
  --tertiary-low-or-tertiary-high:      var(--design-primary-100);
  --tertiary-med-or-tertiary:           var(--design-primary-500);
  --secondary-or-primary:               var(--design-primary-100);
  --tertiary-or-white:                  var(--design-primary-800);
  --float-kit-arrow-stroke-color:       var(--primary-low);
  --float-kit-arrow-fill-color:         var(--secondary);
  --d-content-background: rgba( var(--design-primary-300-rgb),1 );
}
.search-input--header{
      background-color: rgba( var(--design-primary-300-rgb),0.2 ) !important;
      color: var(--design-text)
}
div#main-outlet, #list-area{
      background-color: rgba( var(--design-primary-200-rgb),1 ) !important;
}
.list-controls{
      background-color: rgba( var(--design-primary-200-rgb), 0.9) !important;
      border-radius: 30px;
}
.topic-list-item{
      background-color: rgba( var(--design-primary-200-rgb), 0.4) !important;
}
.topic-list-item a{
      color: var(--design-primary-950) !important;
}
div#main-outlet div.regular.ember-view{
  background-color: rgba( var(--design-primary-200-rgb),0.3 );
  border-radius: 06px;
}
button.btn{
  background-color: rgba( var(--design-primary-200-rgb),0.9 );
}
div.timeline-scrollarea div.timeline-scroller{
  background-color: rgba( var(--design-primary-200-rgb),0.9 ) !important;
  border-radius: 06px;
}