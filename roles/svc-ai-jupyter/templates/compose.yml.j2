{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}

  {% set service_name = 'jupyter' %}
  {{ service_name }}:
    {{ lookup('container_healthcheck', service_name) | indent(4) }}
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_image', application_id, 'jupyter') }}
    {{ lookup('compose_only', 'container_name', JUPYTER_CONTAINER) }}
    expose:
      - "{{ JUPYTER_PORT }}"
    command: >
      start-notebook.py
      --IdentityProvider.token={{ JUPYTER_AUTH_TOKEN }}
      --ServerApp.ip=0.0.0.0
      --ServerApp.port={{ JUPYTER_PORT }}
      --ServerApp.allow_origin=*
      --ServerApp.disable_check_xsrf=True
    {{ lookup('container_networks') | indent(4) }}

{{ lookup('compose_networks') }}

{{ lookup('compose_volumes') }}
