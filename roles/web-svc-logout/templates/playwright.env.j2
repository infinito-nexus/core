ADMIN_PASSWORD={{ lookup('users', 'platform_administrator').password | dotenv_quote }}

ADMIN_USERNAME={{ lookup('users', 'platform_administrator').username | dotenv_quote }}

APP_BASE_URL={{ lookup('tls', application_id, 'url.base') | dotenv_quote }}

{% set logout_matrix_deployed = ('web-app-matrix' in group_names) and (lookup('config', 'web-app-matrix', 'services.sso.enabled') | bool) %}
{% set logout_backchannel_targets = [] %}
{% set logout_backchannel_clients = [('web-app-opencloud', 'services.sso.enabled', 'services.sso.oidc.clients.web'), ('web-app-openpost', 'services.openpost.login.method.sso.enabled', 'services.sso.oidc.clients.web'), ('web-app-opentalk', 'services.sso.enabled', 'services.sso.oidc.frontend_client_id'), ('web-app-openwebui', 'services.openwebui.login.method.sso.enabled', 'services.sso.oidc.clients.web')] %}
{% for app, sso_flag, client_key in logout_backchannel_clients if app in group_names and lookup('config', app, sso_flag) | bool %}
{%   set _ = logout_backchannel_targets.append({'id': app, 'url': lookup('backchannel_receiver', app), 'client_id': lookup('config', app, client_key)}) %}
{% endfor %}
{% for gate_app in lookup('applications') | logout_gate_apps(group_names) if lookup('config', gate_app, 'services.sso.enabled') | bool %}
{%   set _ = logout_backchannel_targets.append({'id': gate_app, 'url': lookup('tls', 'web-svc-logout', 'url.origin') ~ '/backchannel/' ~ gate_app, 'client_id': lookup('config', gate_app, 'services.sso.oidc.clients.web'), 'sealed_url': lookup('backchannel_receiver', gate_app), 'app_urls': lookup('network_urls', lookup('tls', gate_app, 'url.base'))}) %}
{% endfor %}
BACKCHANNEL_TARGETS_JSON={{ logout_backchannel_targets | to_json | dotenv_quote }}

BIBER_PASSWORD={{ lookup('users', 'biber').password | dotenv_quote }}

BIBER_USERNAME={{ lookup('users', 'biber').username | dotenv_quote }}

CANONICAL_DOMAIN={{ lookup('domain', application_id) | dotenv_quote }}

CDN_BASE_URL={{ lookup('landing_url', 'web-svc-cdn') | dotenv_quote }}

COSMOS_SERVICE_ENABLED={{ (lookup('design', application_id).cosmos | length > 0) | string | lower }}

{% set logout_dashboard_deployed = ('web-app-dashboard' in group_names) and (lookup('config', 'web-app-dashboard', 'services.sso.enabled') | bool) %}
DASHBOARD_URLS_JSON={{ (lookup('network_urls', lookup('landing_url', 'web-app-dashboard')) if logout_dashboard_deployed else []) | to_json | dotenv_quote }}

DESIGN_FAVICON_URL={{ (lookup('design', application_id).urls.favicon_ico if lookup('design', application_id).logo is string else '') | dotenv_quote }}

DESIGN_SERVICE_ENABLED={{ lookup('config', application_id, 'services.design.enabled') | string | lower }}

DESIGN_TITLE={{ (lookup('design', application_id).title if lookup('design', application_id).title is string else '') | dotenv_quote }}

KEYCLOAK_ACCOUNT_URL={{ OIDC.CLIENT.ACCOUNT.URL | dotenv_quote }}

KEYCLOAK_LOGOUT_URL={{ OIDC.CLIENT.LOGOUT_URL | dotenv_quote }}

KEYCLOAK_THEME_ENABLED={{ lookup('config', 'web-app-keycloak', 'services.design.enabled') | string | lower }}

KEYCLOAK_TOKEN_URL={{ OIDC.CLIENT.TOKEN_URL | dotenv_quote }}

LOGOUT_EVERYWHERE_MARKER={{ lookup('config', 'web-app-dashboard', 'services.sso.oidc.logout_everywhere') | dotenv_quote }}

{% set logout_targets = [] %}
{% for _t in lookup('roles_with_service', 'logout', network=domain | network_of) %}
{% set _ = logout_targets.append(_t | combine({'is_proxy_gated': lookup('sso', _t.id, 'is_proxy_gated') | bool})) %}
{% endfor %}
LOGOUT_TARGET_ROLES_JSON={{ logout_targets | to_json | dotenv_quote }}

MATRIX_SYNAPSE_URL={{ (lookup('canonical_url', 'web-app-matrix', 'synapse') if logout_matrix_deployed else '') | dotenv_quote }}

OIDC_CLIENT_ID={{ OIDC.CLIENT.ID | dotenv_quote }}

OIDC_ISSUER_URL={{ OIDC.CLIENT.ISSUER_URL | dotenv_quote }}

# nocheck: persona-block-rationale — meta/services.yml declares no sso service, so this role is never registered as a Keycloak client; its only surface is the anonymous logout conductor plus the /logout endpoints proxied in templates/logout-proxy.conf.j2. There is no login form and no session to end.
PERSONA_ADMINISTRATOR_BLOCKED=true

# nocheck: persona-block-rationale — see PERSONA_ADMINISTRATOR_BLOCKED above; the injected logout JS is asserted per consumer role via roles_with_service('logout') in files/playwright/playwright.spec.js.
PERSONA_BIBER_BLOCKED=true

{% set logout_proxy_targets = [] %}
{% for _t in logout_targets if _t.is_proxy_gated and not lookup('sso', _t.id, 'oauth2_allowed_groups') %}
{%   set _ = logout_proxy_targets.append(_t) %}
{% endfor %}
{% set logout_proxy_target = logout_proxy_targets | first %}
{% set logout_proxy_acl = lookup('sso', logout_proxy_target.id, 'oauth2_acl') if logout_proxy_target is defined else {} %}
{% set logout_proxy_gated_path = (logout_proxy_acl.blacklist | first) if logout_proxy_acl.blacklist is defined else '' %}
PROXY_TARGET_URLS_JSON={{ (lookup('network_urls', logout_proxy_target.canonical_url ~ logout_proxy_gated_path) if logout_proxy_target is defined else []) | to_json | dotenv_quote }}

SSO_PROXY_COOKIE_REFRESH={{ lookup('config', 'web-app-keycloak', 'services.sso_proxy.cookie_refresh') | dotenv_quote }}
