{% include 'roles/sys-svc-container/templates/env.j2' %}

LOGOUT_PORT={{ container_port }}

LOGOUT_GATE_ISSUER={{ OIDC.CLIENT.ISSUER_URL | dotenv_quote }}

LOGOUT_GATE_JWKS_URL={{ OIDC.CLIENT.CERTS | dotenv_quote }}

{% set logout_gate_clients = {} %}
{% for gate_app in LOGOUT_GATE_APPS %}
{%   set _ = logout_gate_clients.update({gate_app: {'audience': lookup('config', gate_app, 'services.sso.oidc.clients.web'), 'receiver': lookup('tls', gate_app, 'url.origin') ~ lookup('config', gate_app, 'services.sso.oidc.backchannel_logout_path'), 'key': lookup('config', gate_app, 'secrets.credentials.logout_gate_key')}}) %}
{% endfor %}
LOGOUT_GATE_CLIENTS={{ logout_gate_clients | to_json | dotenv_quote }}
