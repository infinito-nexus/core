{% set domain = front_proxy_domain | default(domain) %}
{% set _logout_label = (LOGOUT_INSTANCES | selectattr('network', 'equalto', domain | network_of) | first).label %}
{% set http_port = lookup('config', application_id, 'services.logout.ports.local.' ~ ('http' | labelled(_logout_label, '_'))) %}
{% set proxy_service_key = 'logout' | labelled(_logout_label, '-') %}
