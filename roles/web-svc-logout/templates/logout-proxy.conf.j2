location = /logout {
    {{ lookup('proxy_pass', 'web-svc-logout', 'logout', 'http', tail='/logout') }}
    {% include 'roles/sys-svc-proxy/templates/headers/forwarded_base.conf.j2' %}
    proxy_http_version 1.1;

    {% include 'roles/sys-svc-proxy/templates/headers/upstream_strips.conf.j2' %}

    {%- set aca_origin = lookup('tls', 'web-svc-logout', 'url.origin') ~ " always" -%}
    {%- set aca_credentials = "'true' always" -%}
    {%- set aca_methods = "'GET, OPTIONS' always" -%}
    {%- set aca_headers = "'Accept, Authorization' always" -%}
    {%- include 'roles/sys-svc-proxy/templates/headers/access_control_allow.conf.j2' -%}

    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    add_header Expires "0" always;

    if ($request_method = OPTIONS) {
      return 204;
    }
}