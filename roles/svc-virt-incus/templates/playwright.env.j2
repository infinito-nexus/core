INCUS_AGENTS_PROJECT={{ INCUS_PROJECT | dotenv_quote }}

INCUS_API_ALLOWED_SOURCES_JSON={{ INCUS_API.allowed_sources | to_json | dotenv_quote }}

INCUS_API_ENABLED={{ INCUS_API.enabled | bool | string | lower }}

INCUS_API_URL={{ INCUS_API_ENDPOINT | dotenv_quote }}

INCUS_BRIDGE_PREFIX={{ INCUS_WORKSPACES.bridge_prefix | dotenv_quote }}

INCUS_IMAGE={{ (lookup('config', 'web-app-semaphore', 'services.semaphore.workspaces.catalog.incus.cloud.image') if 'web-app-semaphore' in group_names else '') | dotenv_quote }}

INCUS_PROVISION_MOUNT={{ INCUS_PROVISION_MOUNT | dotenv_quote }}

INCUS_PROVISION_PATH={{ INCUS_PROVISION_PATH | dotenv_quote }}

# nocheck: playwright-service-gate  the incus service is the role itself; every spec of the role runs against it, so none gates on the flag
INCUS_SERVICE_ENABLED={{ lookup('config', application_id, 'services.incus.enabled') | string | lower }}

INCUS_TENANT_MOUNT={{ INCUS_TENANT_MOUNT | dotenv_quote }}

INCUS_WORKSPACES_ENABLED={{ INCUS_WORKSPACES.enabled | bool | string | lower }}

INCUS_WORKSPACE_LIMITS_JSON={{ INCUS_WORKSPACES.limits | to_json | dotenv_quote }}

INCUS_WORKSPACE_RESTRICTIONS_JSON={{ INCUS_WORKSPACE_RESTRICTIONS | to_json | dotenv_quote }}

OPENBAO_BASE_URL={{ (lookup('landing_url', 'web-app-openbao') if 'web-app-openbao' in group_names else '') | dotenv_quote }}

OPENBAO_PLAYWRIGHT_MOUNT={{ (lookup('config', 'web-app-openbao', 'services.openbao.workspaces.playwright.mount') if 'web-app-openbao' in group_names else '') | dotenv_quote }}

OPENBAO_PLAYWRIGHT_ROLE_ID={{ (lookup('config', 'web-app-openbao', 'secrets.credentials.playwright_approle_role_id') if 'web-app-openbao' in group_names else '') | dotenv_quote }}

OPENBAO_PLAYWRIGHT_SECRET_ID={{ (lookup('config', 'web-app-openbao', 'secrets.credentials.playwright_approle_secret_id') if 'web-app-openbao' in group_names else '') | dotenv_quote }}

OPENBAO_PLAYWRIGHT_SEMAPHORE_PATH={{ (lookup('config', 'web-app-openbao', 'services.openbao.workspaces.playwright.logins.semaphore') if 'web-app-openbao' in group_names else '') | dotenv_quote }}

SEMAPHORE_BASE_URL={{ (lookup('landing_url', 'web-app-semaphore') if 'web-app-semaphore' in group_names else '') | dotenv_quote }}

SEMAPHORE_WORKSPACES_ENABLED={{ ('web-app-semaphore' in group_names and 'web-app-openbao' in group_names and (lookup('config', 'web-app-semaphore', 'services.workspaces-runner.enabled') | bool)) | string | lower }}

SEMAPHORE_WORKSPACES_PROJECT={{ (SOFTWARE_NAME ~ ' Workspaces') | dotenv_quote }}
