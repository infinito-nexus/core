{% include 'roles/sys-svc-container/templates/env.j2' %}

{% if LIBRETRANSLATE_ENGINE_LOAD_ONLY %}
LT_LOAD_ONLY={{ LIBRETRANSLATE_ENGINE_LOAD_ONLY }}
{% endif %}
{% if LIBRETRANSLATE_ENGINE_STORED | bool %}
ARGOS_PACKAGES_DIR={{ LIBRETRANSLATE_ENGINE_STORE.packages }}
{% endif %}
LT_THREADS={{ LIBRETRANSLATE_ENGINE_THREADS }}
LT_DISABLE_FILES_TRANSLATION=true
{% if lookup('config', LIBRETRANSLATE_ENGINE_FRONT_ID, 'services.design.enabled') | bool %}
{% set _front_title = lookup('design', LIBRETRANSLATE_ENGINE_FRONT_ID).title %}
{% if _front_title %}
LT_FRONTEND_TITLE={{ _front_title }}
{% endif %}
{% endif %}
