{% macro push_snippets(list_name, features) -%}
{% set kind = list_name | regex_replace('_snippets$','') %}
{% for f in features if inj_enabled.get(f) -%}
{{ list_name }}[#{{ list_name }} + 1] = [=[
  {%- include 'roles/sys-front-inj-' ~ f ~ '/templates/' ~ kind ~ '_sub.j2' -%}
]=]
{% endfor -%}
{%- endmacro %}

if not (ngx.ctx.is_html or ngx.ctx.is_css) then
    return
end

ngx.ctx.buf = ngx.ctx.buf or {}
local chunk, eof = ngx.arg[1], ngx.arg[2]

if chunk ~= "" then
    table.insert(ngx.ctx.buf, chunk)
end

if not eof then
    ngx.arg[1] = nil
    return
end

local whole = table.concat(ngx.ctx.buf)
ngx.ctx.buf = nil

if ngx.ctx.gunzip and whole ~= "" then
    local gunzip = package.loaded.infinito_gunzip
    if not gunzip then
        local ffi = require("ffi")
        ffi.cdef([[
            typedef struct {
                const unsigned char *next_in;
                unsigned int avail_in;
                unsigned long total_in;
                unsigned char *next_out;
                unsigned int avail_out;
                unsigned long total_out;
                const char *msg;
                void *state;
                void *zalloc;
                void *zfree;
                void *opaque;
                int data_type;
                unsigned long adler;
                unsigned long reserved;
            } infinito_z_stream;
            const char *zlibVersion(void);
            int inflateInit2_(infinito_z_stream *strm, int windowBits, const char *version, int stream_size);
            int inflate(infinito_z_stream *strm, int flush);
            int inflateEnd(infinito_z_stream *strm);
        ]])
        local zlib = ffi.load("libz.so.1")
        gunzip = function(data)
            local stream = ffi.new("infinito_z_stream")
            if zlib.inflateInit2_(stream, 47, zlib.zlibVersion(), ffi.sizeof(stream)) ~= 0 then
                return nil, "inflateInit2_ failed"
            end
            local size = 65536
            local buffer = ffi.new("unsigned char[?]", size)
            local parts = {}
            stream.next_in = ffi.cast("const unsigned char *", data)
            stream.avail_in = #data
            local status
            repeat
                stream.next_out = buffer
                stream.avail_out = size
                status = zlib.inflate(stream, 0)
                if status ~= 0 and status ~= 1 then
                    zlib.inflateEnd(stream)
                    return nil, "inflate returned " .. status
                end
                parts[#parts + 1] = ffi.string(buffer, size - stream.avail_out)
            until status == 1
            zlib.inflateEnd(stream)
            return table.concat(parts)
        end
        package.loaded.infinito_gunzip = gunzip
    end
    local plain, err = gunzip(whole)
    if plain then
        whole = plain
    else
        ngx.log(ngx.ERR, "gunzip of the upstream markup failed: ", err)
    end
end

{% if (lookup('config', application_id, 'services.tor.enabled', False) | bool) and (domain | network_of) == 'tor' %}
{% set _mirror_origins = lookup('applications') | external_asset_origins(application_id, DOMAIN_PRIMARY) %}
{% set _mirror_base = lookup('tls', 'web-svc-mirror', 'url.base') | regex_replace('/+$', '') %}
{% for origin in _mirror_origins %}
do
    local pat = ([=[https://{{ origin }}]=]):gsub("([^%w])", "%%%1")
    whole = (whole:gsub(pat, [=[{{ _mirror_base }}/{{ origin }}]=]))
end
{% endfor %}
{% endif %}
if ngx.ctx.is_css then
    ngx.arg[1] = whole
    return
end

{% set _cdn_base = lookup('tls', 'web-svc-cdn', 'url.base') | regex_replace('/+$', '') %}
{% set _tor_node = lookup('config', 'svc-net-tor', 'services.tor.node', '') %}
{% set _cdn_onion = (lookup('network_urls', _cdn_base) | select('search', '\\.onion') | list | first) | default(_cdn_base, true) %}
local function onionize(s)
{% if _tor_node and _cdn_onion != _cdn_base %}
    local host = ngx.var.http_host or ""
    if host:sub(-6) == ".onion" then
        local pat = ([=[{{ _cdn_base }}]=]):gsub("([^%w])", "%%%1")
        s = (s:gsub(pat, [=[{{ _cdn_onion }}]=]))
    end
{% endif %}
    return s
end

local function marked(snippets)
    return "<!--infinito-inj-->" .. table.concat(snippets, "\n") .. "<!--/infinito-inj-->"
end

-- Remove inline CSP <meta http-equiv="Content-Security-Policy"> (case-insensitive)
local meta_re = [[<meta[^>]+http-equiv=["']Content-Security-Policy["'][^>]*>\s*]]
whole = ngx.re.gsub(whole, meta_re, "", "ijo")

local top_snippets = {}
{{ push_snippets('top_snippets', inj_top_features) }}
if #top_snippets > 0 then
    local top_payload = onionize(marked(top_snippets))
    local function repl_top(m) return m[0] .. top_payload end
    local with_top = ngx.re.sub(whole, [[<head\b[^>]*>]], repl_top, "ijo")
    if with_top then
        whole = with_top
    end
end

-- Build head snippets (rendered by Jinja at template time)
local head_snippets = {}
{{ push_snippets('head_snippets', inj_head_features) }}
local head_payload = onionize(marked(head_snippets)) .. "</head>"

local function repl_head(_) return head_payload end
local new, n, err = ngx.re.sub(whole, [[</head\s*>]], repl_head, "ijo")
if n and n > 0 then
    whole = new
else
    local head_fallback = onionize(marked(head_snippets))
    local function repl_body_open(m) return m[0] .. "\n" .. head_fallback end
    new, n, err = ngx.re.sub(whole, [[<body\b[^>]*>]], repl_body_open, "ijo")
    if n and n > 0 then
        whole = new
    elseif err then
        ngx.log(ngx.ERR, "Head-fallback failed: ", err)
    end
end

local body_snippets = {}
{{ push_snippets('body_snippets', inj_body_features) }}
local body_payload = onionize(marked(body_snippets)) .. "</body>"

local function repl_body(_) return body_payload end
new, n, err = ngx.re.sub(whole, [[</body\s*>]], repl_body, "ijo")
if n and n > 0 then
    whole = new
elseif err then
    ngx.log(ngx.ERR, "Body injection failed: ", err)
end

ngx.arg[1] = whole or ""
