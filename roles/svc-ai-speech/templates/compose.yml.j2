{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}

  {% set service_name = SPEECH_SERVICE %}
  {{ service_name }}:
    {{ lookup('container_image', application_id, service_name) }}
    {{ lookup('compose_only', 'container_name', SPEECH_CONTAINER) }}
    entrypoint: ["whisper-server"]
    command:
      - "--host"
      - "0.0.0.0"
      - "--port"
      - "{{ SPEECH_PORT }}"
      - "--model"
      - "{{ SPEECH_MODEL_FILE }}"
      - "--inference-path"
      - "{{ SPEECH_INFERENCE_PATH }}"
      - "--convert"
      - "--tmp-dir"
      - "/tmp"
      - "--language"
      - "{{ SPEECH_LANGUAGE }}"
      - "--threads"
      - "{{ SPEECH_THREADS }}"
    expose:
      - "{{ SPEECH_PORT }}"
    {{ lookup('container_volumes', service_name, extra_volumes=SPEECH_STORE_MOUNTS) | indent(4) }}
    {{ lookup('container_healthcheck', service_name) | indent(4) }}
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_networks') | indent(4) }}

{{ lookup('compose_networks') }}

{{ lookup('compose_volumes') }}
