{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}

  {% set service_name = SPEECH_SERVICE %}
  {{ service_name }}:
    {{ lookup('container_image', application_id, service_name, version=SPEECH_IMAGE_VERSION) }}
    {{ lookup('compose_only', 'container_name', SPEECH_CONTAINER) }}
    entrypoint: ["whisper-server"]
    command:
      - "--host"
      - "0.0.0.0"
      - "--port"
      - "{{ SPEECH_PORT }}"
      - "--model"
      - "{{ SPEECH_MODEL_FILE }}"
      - "--inference-path"
      - "{{ SPEECH_INFERENCE_PATH }}"
      - "--convert"
      - "--tmp-dir"
      - "/tmp"
      - "--language"
      - "{{ SPEECH_LANGUAGE }}"
      - "--threads"
      - "{{ SPEECH_THREADS }}"
    expose:
      - "{{ SPEECH_PORT }}"
    {{ lookup('container_volumes', service_name, extra_volumes=SPEECH_STORE_MOUNTS) | indent(4) }}
    {{ lookup('container_healthcheck', service_name) | indent(4) }}
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_networks') | indent(4) }}

  {% set service_name = PIPER_SERVICE %}
  {{ service_name }}:
    {{ lookup('template', 'roles/sys-svc-container/templates/build.yml.j2') | indent(4) }}
      args:
        PIPER_BASE_IMAGE: "{{ PIPER_BASE_IMAGE }}"
        PIPER_BASE_VERSION: "{{ PIPER_BASE_VERSION }}"
    {{ lookup('container_image', application_id, service_name) }}
    {{ lookup('compose_only', 'container_name', PIPER_CONTAINER) }}
    command:
      - "--host"
      - "0.0.0.0"
      - "--port"
      - "{{ PIPER_PORT }}"
      - "--model"
      - "{{ PIPER_VOICE_FILE }}"
      - "--config"
      - "{{ PIPER_VOICE_CONFIG_FILE }}"
      - "--speaker"
      - "{{ PIPER_SPEAKER }}"
      - "--inference-path"
      - "{{ PIPER_INFERENCE_PATH }}"
      - "--max-input-chars"
      - "{{ PIPER_MAX_INPUT_CHARS }}"
      - "--timeout"
      - "{{ PIPER_TIMEOUT }}"
      - "--tmp-dir"
      - "/tmp"
    expose:
      - "{{ PIPER_PORT }}"
    {{ lookup('container_volumes', service_name, extra_volumes=SPEECH_STORE_MOUNTS) | indent(4) }}
    {{ lookup('container_healthcheck', service_name) | indent(4) }}
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_networks') | indent(4) }}

{{ lookup('compose_networks') }}

{{ lookup('compose_volumes') }}
