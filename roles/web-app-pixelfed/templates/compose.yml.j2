{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}
  {% set service_name = 'pixelfed' %}
  {{ service_name }}:
    {{ lookup('container_image', application_id, 'pixelfed') }}
    {{ lookup('compose_only', 'container_name', PIXELFED_CONTAINER) }}
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_extra_hosts') | indent(4) }}
    {{ lookup('container_volumes', service_name) | indent(4) }}
    {{ lookup('container_ports', ['pixelfed', 'http', DOCKER_BIND_HOST]) | indent(4) }}
    {{ lookup('container_depends_on', application_id) | indent(4) }}
    {{ lookup('container_networks') | indent(4) }}
  {% set service_name = 'worker' %}
  {{ service_name }}:
    {{ lookup('compose_only', 'container_name', PIXELFED_WORKER_CONTAINER) }}
    {{ lookup('container_image', application_id, 'pixelfed') }}
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    environment: # nocheck: compose-environment-from-env-file worker-only override; no service here sets docker_compose_env, so the role's single env.j2 is also the env_file of the primary pixelfed container, where these same four keys are already set to true
      AUTORUN_LARAVEL_EVENT_CACHE: "false"
      AUTORUN_LARAVEL_ROUTE_CACHE: "false"
      AUTORUN_LARAVEL_VIEW_CACHE: "false"
      AUTORUN_ENABLED: "false"
    {{ lookup('container_volumes', service_name) | indent(4) }}
    command: ["sh", "-c", "until [ -e {{ PIXELFED_INIT_MARKER }} ]; do echo 'worker: waiting for the Pixelfed bootstrap marker'; sleep 5; done; exec php artisan horizon"]
    {{ lookup('container_healthcheck', service_name) | indent(4) }}
    {{ lookup('container_depends_on', application_id, extra={
  'pixelfed': {'condition': 'service_started'},
}) | indent(4) }}
    {{ lookup('container_networks') | indent(4) }}

{{ lookup('compose_volumes') }}
{{ lookup('compose_networks') }}
