FROM {{ POSTGRES_IMAGE }}:{{ POSTGRES_VERSION }}

{% if POSTGRES_LIBRARIES | length > 0 %}
RUN rm -rf /var/lib/apt/lists/* \
 && apt-get -o Acquire::Retries=3 update \
 && apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
{% for lib in POSTGRES_LIBRARIES %}
      postgresql-{{ POSTGRES_VERSION_MAJOR }}-{{ lib.apt_package }} \
{% endfor %}
 && rm -rf /var/lib/apt/lists/*
{% endif %}
{% if POSTGRES_HA | bool %}

RUN rm -rf /var/lib/apt/lists/* \
 && apt-get -o Acquire::Retries=3 update \
 && apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
      patroni={{ POSTGRES_PATRONI_VERSION }} \
      python3-etcd \
 && rm -rf /var/lib/apt/lists/*
{% endif %}

COPY <<'BOOT_ENTRYPOINT_EOF' /usr/local/bin/boot-entrypoint.sh
{{ lookup('file', lookup('path_absolute', 'roles/svc-db-postgres/files/shell/boot-entrypoint.sh')) }}
BOOT_ENTRYPOINT_EOF
{% if POSTGRES_HA | bool %}
COPY <<'PATRONI_ENTRYPOINT_EOF' /usr/local/bin/patroni-entrypoint.sh
{{ lookup('file', lookup('path_absolute', 'roles/svc-db-postgres/files/shell/patroni-entrypoint.sh')) }}
PATRONI_ENTRYPOINT_EOF
RUN chmod +x /usr/local/bin/boot-entrypoint.sh /usr/local/bin/patroni-entrypoint.sh
{% else %}
RUN chmod +x /usr/local/bin/boot-entrypoint.sh
{% endif %}

ENTRYPOINT ["boot-entrypoint.sh"]
CMD ["postgres"]

# nocheck: healthcheck-timing-override  a first initdb of a large cluster outlasts the ten minute window
HEALTHCHECK --interval=2m \
            --timeout=5s \
            --start-period=15m \
            --retries=5 \
            --start-interval=5s \
  CMD pg_isready -h 127.0.0.1 -U postgres || exit 1
