{#
  Param: POSTGRES_SUPERUSER / POSTGRES_PASSWORD
  Param: POSTGRES_REPLICATION_USER / POSTGRES_REPLICATION_PASSWORD
  Param: POSTGRES_REWIND_USER / POSTGRES_REWIND_PASSWORD
#}
\set ON_ERROR_STOP on
SET synchronous_commit TO local;
DO $$
BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '{{ POSTGRES_REPLICATION_USER }}') THEN
    CREATE ROLE "{{ POSTGRES_REPLICATION_USER }}";
  END IF;
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '{{ POSTGRES_REWIND_USER }}') THEN
    CREATE ROLE "{{ POSTGRES_REWIND_USER }}";
  END IF;
END
$$;
ALTER ROLE "{{ POSTGRES_SUPERUSER }}" WITH PASSWORD '{{ POSTGRES_PASSWORD | string | replace("'", "''") }}';
ALTER ROLE "{{ POSTGRES_REPLICATION_USER }}" WITH LOGIN REPLICATION PASSWORD '{{ POSTGRES_REPLICATION_PASSWORD | string | replace("'", "''") }}';
ALTER ROLE "{{ POSTGRES_REWIND_USER }}" WITH LOGIN NOREPLICATION PASSWORD '{{ POSTGRES_REWIND_PASSWORD | string | replace("'", "''") }}';
GRANT EXECUTE ON FUNCTION pg_catalog.pg_ls_dir(text, boolean, boolean) TO "{{ POSTGRES_REWIND_USER }}";
GRANT EXECUTE ON FUNCTION pg_catalog.pg_stat_file(text, boolean) TO "{{ POSTGRES_REWIND_USER }}";
GRANT EXECUTE ON FUNCTION pg_catalog.pg_read_binary_file(text) TO "{{ POSTGRES_REWIND_USER }}";
GRANT EXECUTE ON FUNCTION pg_catalog.pg_read_binary_file(text, bigint, bigint, boolean) TO "{{ POSTGRES_REWIND_USER }}";
