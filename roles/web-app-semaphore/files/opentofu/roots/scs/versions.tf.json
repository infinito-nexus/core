{
  "terraform": {
    "required_version": ">= 1.10.0",
    "required_providers": {
      "openstack": {"source": "terraform-provider-openstack/openstack", "version": "3.4.0"},
      "tls": {"source": "hashicorp/tls", "version": "4.4.2"},
      "dns": {"source": "hashicorp/dns", "version": "3.6.2"},
      "aws": {"source": "hashicorp/aws", "version": "6.71.0"},
      "cloudflare": {"source": "cloudflare/cloudflare", "version": "5.28.1"}
    },
    "backend": {
      "s3": {
        "use_lockfile": true,
        "use_path_style": true,
        "skip_credentials_validation": true,
        "skip_region_validation": true,
        "skip_requesting_account_id": true,
        "skip_metadata_api_check": true
      }
    }
  }
}
