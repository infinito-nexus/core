{
  "terraform": {
    "required_providers": {
      "dns": {"source": "hashicorp/dns"}
    }
  },
  "variable": {
    "zone": {"type": "string", "description": "Deploy zone apex without trailing dot."},
    "zone_id": {"type": "string", "description": "Provider zone id; unused by RFC 2136 updates."},
    "name": {"type": "string", "description": "Owner name relative to the zone."},
    "ipv4": {"type": "list(string)", "description": "IPv4 addresses of the A record set."},
    "ipv6": {"type": "list(string)", "description": "IPv6 addresses of the AAAA record set."}
  },
  "resource": {
    "dns_a_record_set": {
      "record": {
        "count": "${length(var.ipv4) > 0 ? 1 : 0}",
        "zone": "${var.zone}.",
        "name": "${var.name}",
        "addresses": "${var.ipv4}",
        "ttl": 300
      }
    },
    "dns_aaaa_record_set": {
      "record": {
        "count": "${length(var.ipv6) > 0 ? 1 : 0}",
        "zone": "${var.zone}.",
        "name": "${var.name}",
        "addresses": "${var.ipv6}",
        "ttl": 300
      }
    }
  },
  "output": {
    "fqdn": {"value": "${var.name}.${var.zone}", "description": "Fully qualified record name."}
  }
}
