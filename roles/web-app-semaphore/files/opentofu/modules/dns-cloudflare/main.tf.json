{
  "terraform": {
    "required_providers": {
      "cloudflare": {"source": "cloudflare/cloudflare"}
    }
  },
  "variable": {
    "zone": {"type": "string", "description": "Deploy zone apex without trailing dot."},
    "zone_id": {"type": "string", "description": "Cloudflare zone id of the deploy zone."},
    "name": {"type": "string", "description": "Owner name relative to the zone."},
    "ipv4": {"type": "list(string)", "description": "IPv4 addresses, one A record each."},
    "ipv6": {"type": "list(string)", "description": "IPv6 addresses, one AAAA record each."}
  },
  "resource": {
    "cloudflare_dns_record": {
      "a": {
        "count": "${length(var.ipv4)}",
        "zone_id": "${var.zone_id}",
        "name": "${var.name}.${var.zone}",
        "type": "A",
        "ttl": 300,
        "proxied": false,
        "content": "${var.ipv4[count.index]}"
      },
      "aaaa": {
        "count": "${length(var.ipv6)}",
        "zone_id": "${var.zone_id}",
        "name": "${var.name}.${var.zone}",
        "type": "AAAA",
        "ttl": 300,
        "proxied": false,
        "content": "${var.ipv6[count.index]}"
      }
    }
  },
  "output": {
    "fqdn": {"value": "${var.name}.${var.zone}", "description": "Fully qualified record name."}
  }
}
