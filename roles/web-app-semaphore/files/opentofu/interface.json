{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provision root module inputs",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "flavor", "size", "region", "ssh_public_key", "dns_label"],
  "properties": {
    "name": {
      "description": "State key name: <sales order>-<line>; it names the server, so it is a hostname label that every provider accepts.",
      "type": "string",
      "pattern": "^[A-Za-z](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
    },
    "flavor": {
      "description": "Order flavor; selects the catalog of the root.",
      "type": "string",
      "enum": ["demo", "cloud"]
    },
    "size": {
      "description": "Catalog size the root maps to a server type.",
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "region": {
      "description": "Catalog region the root maps to provider settings.",
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "ssh_public_key": {
      "description": "Workspace public key installed for the first login.",
      "type": "string",
      "pattern": "^(ssh-ed25519|ecdsa-sha2-nistp256|ecdsa-sha2-nistp384|ecdsa-sha2-nistp521|sk-ssh-ed25519@openssh\\.com|sk-ecdsa-sha2-nistp256@openssh\\.com|ssh-rsa) [A-Za-z0-9+/]{32,1400}={0,3}$"
    },
    "dns_label": {
      "description": "Label of the per-deploy record <dns_label>.<workspace>.<zone>.",
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    }
  },
  "outputs": ["host", "host_key", "server_id", "fqdn"],
  "$defs": {
    "workspace": {
      "description": "workspace.json the provision script writes into the task directory beside the root.",
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "dns"],
      "properties": {
        "workspace": {
          "description": "Workspace name ws-<id>: DNS suffix, Proxmox pool and Incus project.",
          "type": "string",
          "pattern": "^ws-[a-z0-9](?:[a-z0-9-]{0,58}[a-z0-9])?$"
        },
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "required": ["zone", "zone_id"],
          "properties": {
            "zone": {
              "description": "Deploy zone apex without trailing dot.",
              "type": "string",
              "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
            },
            "zone_id": {
              "description": "Provider zone id: Route 53 hosted zone or Cloudflare zone; empty for knot.",
              "type": "string",
              "pattern": "^[A-Za-z0-9]{0,64}$"
            }
          }
        }
      }
    },
    "catalog": {
      "description": "catalog.json beside each root: per flavor the sizes and regions the root maps to provider settings.",
      "type": "object",
      "propertyNames": {"enum": ["demo", "cloud"]},
      "additionalProperties": {
        "type": "object",
        "required": ["sizes", "regions"],
        "properties": {
          "sizes": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {"pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"},
            "additionalProperties": {"type": "object"}
          },
          "regions": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {"pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"},
            "additionalProperties": {"type": "object"}
          }
        }
      }
    }
  }
}
