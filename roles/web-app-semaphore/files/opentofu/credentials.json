{
  "state": {
    "path": "tenant/data/{workspace}-provision/s3",
    "backend": {"access_key": "access_key", "secret_key": "secret_key"}
  },
  "zone": {
    "path": "platform/data/provision/cloudflare-zones",
    "env": {"CLOUDFLARE_API_TOKEN": "token", "TF_VAR_account_id": "account_id"},
    "api": "https://api.cloudflare.com/client/v4/zones"
  },
  "dns": {
    "knot": {
      "path": "tenant/data/{workspace}-provision/dns",
      "env": {
        "DNS_UPDATE_SERVER": "server",
        "DNS_UPDATE_PORT": "port",
        "DNS_UPDATE_KEYNAME": "key_name",
        "DNS_UPDATE_KEYALGORITHM": "key_algorithm",
        "DNS_UPDATE_KEYSECRET": "key_secret"
      }
    },
    "route53": {
      "path": "tenant/data/{workspace}-provision/dns",
      "env": {"AWS_ACCESS_KEY_ID": "access_key", "AWS_SECRET_ACCESS_KEY": "secret_key"}
    },
    "cloudflare": {
      "path": "platform/data/provision/cloudflare/{zone}",
      "env": {"CLOUDFLARE_API_TOKEN": "token"}
    }
  },
  "providers": {
    "hetzner": {
      "secrets": [{"path": "platform/data/provision/hetzner", "env": {"HCLOUD_TOKEN": "token"}}],
      "workspace_secrets": [{"path": "tenant/data/{workspace}-provision/providers/hetzner", "env": {"HCLOUD_TOKEN": "token"}}],
      "env": {}
    },
    "ionos": {
      "secrets": [{"path": "platform/data/provision/ionos", "env": {"IONOS_TOKEN": "token"}}],
      "workspace_secrets": [{"path": "tenant/data/{workspace}-provision/providers/ionos", "env": {"IONOS_TOKEN": "token"}}],
      "env": {}
    },
    "scs": {
      "secrets": [
        {
          "path": "tenant/data/{workspace}-provision/scs",
          "env": {
            "OS_AUTH_URL": "auth_url",
            "OS_REGION_NAME": "region_name",
            "OS_APPLICATION_CREDENTIAL_ID": "application_credential_id",
            "OS_APPLICATION_CREDENTIAL_SECRET": "application_credential_secret"
          }
        }
      ],
      "workspace_secrets": [
        {
          "path": "tenant/data/{workspace}-provision/providers/scs",
          "env": {
            "OS_APPLICATION_CREDENTIAL_ID": "application_credential_id",
            "OS_APPLICATION_CREDENTIAL_SECRET": "application_credential_secret"
          },
          "catalog": {"OS_AUTH_URL": "auth_url", "OS_REGION_NAME": "region"},
          "keystone": ["OS_AUTH_URL", "OS_APPLICATION_CREDENTIAL_ID", "OS_APPLICATION_CREDENTIAL_SECRET"]
        }
      ],
      "env": {"OS_AUTH_TYPE": "v3applicationcredential"}
    },
    "proxmox": {
      "secrets": [
        {
          "path": "platform/data/provision/proxmox-{host}",
          "env": {"PROXMOX_VE_ENDPOINT": "endpoint"},
          "files": {"servercerts/{host}.crt": "certificate"}
        },
        {"path": "tenant/data/{workspace}-provision/proxmox", "env": {"PROXMOX_VE_API_TOKEN": "{token_id}={secret}"}}
      ],
      "env": {"SSL_CERT_DIR": "{credentials}/servercerts"}
    },
    "incus": {
      "secrets": [
        {
          "path": "platform/data/provision/incus-{host}",
          "env": {"INCUS_ADDR": "endpoint"},
          "files": {"servercerts/{host}.crt": "certificate"}
        },
        {
          "path": "tenant/data/{workspace}-provision/incus",
          "files": {"client.crt": "certificate", "client.key": "key"}
        }
      ],
      "env": {"INCUS_REMOTE": "{host}", "INCUS_CONF": "{credentials}"}
    }
  }
}
