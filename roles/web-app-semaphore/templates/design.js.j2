{% set design = lookup('design', application_id) %}
(function () {
  var root = document.documentElement;
  var prefersDark = window.matchMedia("(prefers-color-scheme: dark)");
  var choiceKey = "infinito.design.theme";
  var themeKey = "darkMode";
  function read(key) {
    try {
      return window.localStorage.getItem(key);
    } catch (error) {
      return null;
    }
  }
  function write(key, value) {
    try {
      if (value === null) {
        window.localStorage.removeItem(key);
      } else {
        window.localStorage.setItem(key, value);
      }
    } catch (error) {
      return;
    }
  }
  function appDark() {
    return read(themeKey) === "1";
  }
  function chosen() {
    return read(choiceKey) === "explicit";
  }
  function follow() {
    if (!chosen()) {
      write(themeKey, prefersDark.matches ? "1" : null);
    }
  }
  function mirror() {
    if (chosen()) {
      root.setAttribute("data-design-theme", appDark() ? "dark" : "light");
    } else {
      root.removeAttribute("data-design-theme");
    }
  }
  follow();
  mirror();
  var last = appDark();
  function toggled() {
    var now = appDark();
    if (now !== last) {
      last = now;
      write(choiceKey, "explicit");
      mirror();
    }
  }
  ["change", "click", "touchend", "keyup"].forEach(function (type) {
    document.addEventListener(
      type,
      function (event) {
        if (event.target && event.target.closest && event.target.closest(".DarkModeSwitchWrap")) {
          window.setTimeout(toggled, 0);
        }
      },
      true
    );
  });
  prefersDark.addEventListener("change", function () {
    follow();
    last = appDark();
  });
{% if design.title is string or design.logo is string %}
  function brand() {
{% if design.title is string %}
    if (document.title !== {{ design.title | to_json }}) {
      document.title = {{ design.title | to_json }};
    }
{% endif %}
{% if design.logo is string %}
    var icons = document.querySelectorAll("link[rel~='icon']");
    for (var index = 0; index < icons.length; index += 1) {
      if (icons[index].getAttribute("href") !== {{ design.urls.favicon_ico | to_json }}) {
        icons[index].setAttribute("type", "image/x-icon");
        icons[index].setAttribute("href", {{ design.urls.favicon_ico | to_json }});
      }
    }
{% endif %}
  }
  new MutationObserver(brand).observe(document.head, { childList: true, subtree: true, characterData: true });
  brand();
  document.addEventListener("DOMContentLoaded", brand);
{% endif %}
})();
