{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}
  {% set service_name = SEMAPHORE_SERVICE %}
  {{ service_name }}:
    {{ lookup('container_image', application_id, 'semaphore') }}
    {{ lookup('compose_only', 'container_name', SEMAPHORE_NAME) }}
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_ports', ['semaphore', 'http', DOCKER_BIND_HOST]) | indent(4) }}
    {{ lookup('container_healthcheck', service_name) | indent(4) }}

    {{ lookup('container_depends_on', application_id) | indent(4) }}
    {{ lookup('container_volumes', service_name) | indent(4) }}
    {{ lookup('container_extra_hosts') | indent(4) }}
    {{ lookup('container_networks') | indent(4) }}

  {% set service_name = SEMAPHORE_RUNNER_SERVICE %}
  {{ service_name }}:
    {{ lookup('container_image', application_id, service_name, version=SEMAPHORE_RUNNER_IMAGE_TAG) }}
    build:
      context: {{ SEMAPHORE_RUNNER_BUILD_DIR }}
      dockerfile: Dockerfile
      args:
        {% for build_arg, build_value in SEMAPHORE_RUNNER_BUILD_ARGS | dictsort %}
        {{ build_arg }}: "{{ build_value }}"
        {% endfor %}
    {{ lookup('compose_only', 'container_name', SEMAPHORE_RUNNER_NAME) }}
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_volumes', service_name) | indent(4) }}
    {{ lookup('container_extra_hosts', host_alias=True) | indent(4) }}
    {{ lookup('container_networks') | indent(4) }}

{{ lookup('compose_volumes') }}

{{ lookup('compose_networks') }}
