ADMIN_NATIVE_PASSWORD={{ lookup('users', 'administrator').password | dotenv_quote }}

ADMIN_PASSWORD={{ lookup('users', 'administrator').password | dotenv_quote }}

ADMIN_USERNAME={{ lookup('users', 'administrator').username | dotenv_quote }}

APP_BASE_URL={{ lookup('tls', application_id, 'url.base') | dotenv_quote }}

BIBER_PASSWORD={{ lookup('users', 'biber').password | dotenv_quote }}

BIBER_USERNAME={{ lookup('users', 'biber').username | dotenv_quote }}

CANONICAL_DOMAIN={{ lookup('domain', application_id) | dotenv_quote }}

# nocheck: playwright-service-gate — assertCspInjections resolves this injector through a computed loop variable (personas/utils/csp.js), never a literal gate argument, so this rule's literal-only regex cannot see the gate
CSS_SERVICE_ENABLED={{ lookup('config', application_id, 'services.css.enabled') | string | lower }}

# nocheck: playwright-service-gate — the flag only decides whether templates/env.j2 renders the SMTP_* relay credentials; no scenario in this spec triggers a transactional mail, so no browser-visible surface changes with it
EMAIL_SERVICE_ENABLED={{ lookup('config', application_id, 'services.email.enabled') | string | lower }}

LOGOUT_SERVICE_ENABLED={{ lookup('config', application_id, 'services.logout.enabled') | string | lower }}

# nocheck: playwright-service-gate — setup:install aborts without the database, so every scenario already proves it
MARIADB_SERVICE_ENABLED={{ lookup('config', application_id, 'services.mariadb.enabled') | string | lower }}

MATOMO_BASE_URL={{ lookup('tls', 'web-app-matomo', 'url.base') | dotenv_quote }}

MATOMO_SERVICE_ENABLED={{ lookup('config', application_id, 'services.matomo.enabled') | string | lower }}

# nocheck: persona-block-rationale — the administrator holds a native admin account and reaches it through personas/admin.js's native-login branch, but that branch is gated on !oidcEnabled. With sso: true the Keycloak round trip satisfies the flow's authenticated check while Magento itself still renders a guest storefront, so no in-app logout control exists (see README "Persona contract opt-outs").
PERSONA_ADMINISTRATOR_BLOCKED={{ 'true' if (lookup('config', application_id, 'services.sso.enabled') | bool) else 'false' }}

# nocheck: persona-block-rationale — Magento ships no OIDC integration, so the oauth2-proxy round trip authenticates at the edge without creating a Magento session, and tasks/01_setup.yml seeds only the administrator into the admin table (setup:install --admin-user). biber therefore has no in-app session in any variant: with sso: false it has no native account, with sso: true it reaches a guest storefront (see README "Persona contract opt-outs").
PERSONA_BIBER_BLOCKED=true

# nocheck: playwright-service-gate — session backend behind every authenticated scenario, no surface of its own
REDIS_SERVICE_ENABLED={{ lookup('config', application_id, 'services.redis.enabled') | string | lower }}

# nocheck: playwright-service-gate — setup:install passes --search-engine=opensearch, so a missing search engine fails the deploy
SEARCH_SERVICE_ENABLED={{ lookup('config', application_id, 'services.search.enabled') | string | lower }}

# nocheck: playwright-service-gate — remote storage is wired into setup:install, Magento exposes no user-facing upload surface
SEAWEEDFS_SERVICE_ENABLED={{ lookup('config', application_id, 'services.seaweedfs.enabled') | string | lower }}

SSO_SERVICE_ENABLED={{ lookup('config', application_id, 'services.sso.enabled') | string | lower }}
