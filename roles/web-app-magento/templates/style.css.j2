{% set design = lookup('design', application_id) %}
{% set static = MAGENTO_URL | regex_replace('/+$', '') ~ '/static' %}
{% set shop = ':where(html:not(:has(> head > link[href*="/adminhtml/"])))' %}
{% set admin = ':where(html:has(> head > link[href*="/adminhtml/"]))' %}
:where(html:not(:has(> head > link[href*="/adminhtml/"]))) {
& body {
  color: var(--design-text);
}
& abbr[title] {
  border-bottom-color: var(--design-border);
}
& mark {
  background-color: var(--design-surface-3);
  color: var(--design-text);
}
& hr {
  border-top-color: var(--design-border);
}
& h1 small,
& h2 small,
& h3 small,
& h4 small,
& h5 small,
& h6 small,
& h1 .small,
& h2 .small,
& h3 .small,
& h4 .small,
& h5 .small,
& h6 .small {
  color: var(--design-text);
}
& a,
& .alink,
& a:visited,
& .alink:visited,
& a:hover,
& .alink:hover,
& a:active,
& .alink:active {
  color: var(--design-link);
}
& code,
& kbd {
  background-color: var(--design-surface-3);
  color: var(--design-text);
}
& pre {
  background-color: var(--design-surface-3);
  border-color: var(--design-border);
  color: var(--design-text);
}
& blockquote {
  border-left-color: var(--design-border);
  color: var(--design-text);
}
& blockquote footer,
& blockquote small,
& blockquote .small {
  color: var(--design-text);
}
& button {
  background-color: var(--design-surface-3);
  border-color: var(--design-border-strong);
  color: var(--design-text);
}
& button:focus,
& button:active {
  background-color: var(--design-surface-active);
  border-color: var(--design-border-strong);
  color: var(--design-text);
}
& button:hover {
  background-color: var(--design-surface-hover);
  border-color: var(--design-border-strong);
  color: var(--design-text);
}
& input[type="text"],
& input[type="password"],
& input[type="url"],
& input[type="tel"],
& input[type="search"],
& input[type="number"],
& input[type*="date"],
& input[type="email"],
& select {
