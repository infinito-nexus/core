  border-color: var(--design-warning-border) transparent transparent transparent;
}
& .data-grid-editable-row .admin__field-error:before {
  border-color: var(--design-danger) transparent transparent transparent;
}
& .data-grid-row-changed .data-grid-row-changed-tooltip {
  background-color: var(--design-surface-3);
  border-color: var(--design-border);
  box-shadow: var(--design-shadow-2);
}
& .data-grid-row-changed._changed:hover:before {
  background-color: var(--design-surface-hover);
  border-color: var(--design-border);
  box-shadow: var(--design-shadow-1);
}
& .data-grid-column-tooltip .data-tooltip,
& .data-grid-column-tooltip .data-tooltip-tail:before {
  background-color: var(--design-warning-subtle);
  border-color: var(--design-border-strong);
  box-shadow: var(--design-shadow-2);
}
& .data-grid-column-tooltip .data-tooltip-tail:after {
  background-color: var(--design-warning-subtle);
}
& .masonry-image-column {
  background-color: var(--design-surface-2);
}
& .masonry-image-column .masonry-image-block.active img {
  border-color: var(--design-link);
}
& .masonry-image-overlay {
  background-color: var(--design-primary);
  color: var(--design-on-primary);
}
& .masonry-image-preview {
  background-color: var(--design-surface-2);
}
& .masonry-image-sortby select:active {
  background-image: url("{{ static }}/adminhtml/Magento/backend/en_US/images/arrows-bg.svg");
}
& .version-fieldset .grid-actions {
  border-bottom-color: var(--design-warning-border);
}
& .manage-rules-panel .smart-category-table .action-delete {
  border-color: transparent;
}
& .colorRed {
  color: var(--design-danger);
}
& .rule-tree ul {
  border-left-color: var(--design-border-strong);
}
& .rule-param .label {
  color: var(--design-text);
}
& .rule-param .label-disabled {
  color: var(--design-on-primary);
}
& .rule-chooser {
  border-color: var(--design-border);
}
& .rule-param-wait {
  background: url("{{ static }}/adminhtml/Magento/backend/en_US/mui/images/ajax-loader-small.gif") no-repeat left center;
}
}

{{ shop }} .page-header .panel.wrapper,
{{ shop }} .copyright,
{{ admin }} .menu-wrapper,
{{ admin }} body.page-layout-admin-login {
  --design-focus: var(--design-on-frame);
}

{{ admin }} body.page-layout-admin-login .page-wrapper {
  --design-focus: var(--design-link);
}

{{ shop }} body._keyfocus .page-header .panel.wrapper :focus,
{{ admin }} body._keyfocus .menu-wrapper a:focus,
{{ admin }} body._keyfocus .menu-wrapper a.logo:focus {
  box-shadow: inset 0 0 0 2px var(--design-on-frame);
}

{{ admin }} .jstree-default .jstree-hovered {
  background: var(--design-surface-hover);
  box-shadow: none;
}

{{ admin }} .jstree-default .jstree-clicked {
  background: var(--design-surface-active);
  box-shadow: none;
}
{% if design.logo is string %}

{{ admin }} .menu-wrapper .logo .logo-img {
  content: url("{{ design.urls['admin-logo'].svg }}");
}

{{ admin }} .login-header .logo-img {
  content: url("{{ design.urls['admin-login-logo'].svg }}");
}
{% endif %}
