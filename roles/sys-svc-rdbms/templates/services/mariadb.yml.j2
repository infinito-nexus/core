{# This template needs to be included in compose.yml, which depend on a mariadb database #}
{% if lookup('database', application_id, 'local') %}

  {{ lookup('database', application_id, 'host') }}:
    {{ lookup('container_deploy', replicas=1) | indent(4) }}
    {{ lookup('compose_only', 'container_name', ((application_id | get_entity_name) ~ '-database')) }}
    logging:
      driver: journald
    {{ lookup('container_image', 'svc-db-mariadb', 'mariadb', image=lookup('database', application_id, 'image'), version=lookup('database', application_id, 'version')) }}
    {{ lookup('compose_restart') }}
    env_file:
      - {{ lookup('database', application_id, 'env') }}
    command: "--transaction-isolation=READ-COMMITTED --binlog-format=ROW --init-file={{ lookup('database', application_id, 'realign_target') }}"
    configs:
      - source: {{ lookup('database', application_id, 'realign_config') }}
        target: {{ lookup('database', application_id, 'realign_target') }}
    volumes:
      - database:/var/lib/mysql
    # nocheck: container-healthcheck-literal  shared partial rendered for the consuming role's application_id, so the declaration has no single meta/services.yml to live in
    healthcheck:
      test: [ "CMD", "sh", "-c", "/usr/bin/mariadb --user=$$MYSQL_USER --password=$$MYSQL_PASSWORD --execute 'SHOW DATABASES;'" ]
      interval: 30s
      timeout: 5s
      retries: 18
      start_period: 30s
      start_interval: 5s
    networks:  # nocheck: networks-literal  local sidecar inside consumer stack, default-only attachment
      - default
{% endif %}
{{ "\n" }}