.alert-{{ status }} {
  background-color: var(--design-{{ status }}-subtle);
  border-color: var(--design-{{ status }}-border);
  color: var(--design-text);
}
.label-{{ status }},
.progress-bar-{{ status }} {
  background-color: var(--design-{{ status }});
  color: var(--design-on-{{ status }});
}
{% endfor %}
{% if design.logo is string %}
header #banner #logo-img,
.navbar-brand #logo-img {
  -webkit-mask-image: none;
  mask-image: none;
  background: url("{{ design.urls.logo.svg }}") center / contain no-repeat;
}
.navbar-brand #navbrand-container #logo-img {
  width: 160px;
  height: 32px;
  background-image: url("{{ design.urls.brand.svg }}");
}
#navbrand-container #navbar-brand-text {
  display: none;
}
{% endif %}
