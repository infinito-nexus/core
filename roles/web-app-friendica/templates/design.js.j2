(function () {
  var provisioned = {{ FRIENDICA_DESIGN_PALETTE['--design-surface-1'] | to_json }};
  var selector = 'link[href*="view/theme/frio/style.pcss"]';
  var fills = ["--design-primary", "--design-info", "--design-success", "--design-warning", "--design-danger", "--design-primary-300", "--design-primary-700", "--design-neutral-500"];

  function normalize(value) {
    var probe = document.createElement("span");
    probe.style.color = value;
    document.documentElement.appendChild(probe);
    var color = getComputedStyle(probe).color;
    probe.remove();
    return color;
  }

  function lightness(rgb) {
    var parts = rgb.match(/\d+(\.\d+)?/g);
    if (!parts) return 1;
    return (0.2126 * parts[0] + 0.7152 * parts[1] + 0.0722 * parts[2]) / 255;
  }

  function schemeBackground(link) {
    var rules;
    try {
      rules = link.sheet.cssRules;
    } catch (error) {
      return null;
    }
    for (var i = 0; i < rules.length; i += 1) {
      if (rules[i].selectorText === "body" && rules[i].style.backgroundColor) {
        return rules[i].style.backgroundColor;
      }
    }
    return null;
  }

  function token(name) {
    return normalize("var(" + name + ")");
  }

  function repeat(value, length) {
    var list = [];
    for (var i = 0; i < length; i += 1) list.push(value);
    return list;
  }

  function paint(chart, colors, border, hover) {
    var dataset = chart.data.datasets[0];
    dataset.backgroundColor = colors;
    dataset.hoverBackgroundColor = repeat(hover, colors.length);
    dataset.borderColor = repeat(border, colors.length);
    dataset.hoverBorderColor = repeat(border, colors.length);
    chart.update(0);
  }

  function recolor() {
    var registry = window.Chart && window.Chart.instances;
    if (!registry) return;
    var palette = fills.map(token);
    var border = token("--design-surface-2");
    var hover = token("--design-primary-active");
    Object.keys(registry).forEach(function (key) {
      var chart = registry[key];
      var canvas = chart.canvas;
      if (!canvas || !chart.data.datasets[0]) return;
      if (canvas.id === "FederationChart") {
        var data = chart.data.datasets[0].data;
        var colors = [];
        var used = 0;
        for (var i = 0; i < data.length; i += 1) {
          colors.push(palette[used % palette.length]);
          if (data[i] > 0) used += 1;
        }
        paint(chart, colors, border, hover);
        return;
      }
      if (!canvas.classList.contains("federation-network-graph")) return;
      var position = Array.prototype.indexOf.call(document.querySelectorAll("canvas.federation-network-graph"), canvas);
      paint(chart, repeat(palette[position % palette.length], chart.data.datasets[0].data.length), border, hover);
    });
  }

  function mirror() {
    var link = document.querySelector(selector);
    if (!link || !link.sheet) return;
    var background = schemeBackground(link);
    if (background === null) return;
    var root = document.documentElement;
    if (normalize(background) === normalize(provisioned)) {
      root.removeAttribute("data-design-theme");
    } else {
      root.setAttribute("data-design-theme", lightness(normalize(background)) < 0.5 ? "dark" : "light");
    }
    recolor();
  }

  function start() {
    recolor();
    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", recolor);
    var link = document.querySelector(selector);
    if (link && !link.sheet) {
      link.addEventListener("load", mirror, { once: true });
      return;
    }
    mirror();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", start, { once: true });
  } else {
    start();
  }
})();
