{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}
  {% set service_name = 'jenkins' %}
  {{ service_name }}:
    {{ lookup('template', 'roles/sys-svc-container/templates/build.yml.j2') | indent(4) }}
      args:
        JENKINS_IMAGE: "{{ JENKINS_IMAGE }}"
        JENKINS_VERSION: "{{ JENKINS_VERSION }}"
    {{ lookup('container_image', application_id, 'jenkins') }}
    {{ lookup('compose_only', 'container_name', JENKINS_CONTAINER) }}
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    environment:
      JAVA_OPTS: "-Djenkins.install.runSetupWizard=false"
      CASC_JENKINS_CONFIG: {{ lookup('volume', 'web-app-jenkins', 'casc').target }}
    {{ lookup('container_ports', ['jenkins', 'http', DOCKER_BIND_HOST]) | indent(4) }}
    {{ lookup('container_volumes', service_name) | indent(4) }}
    {{ lookup('container_healthcheck', service_name) | indent(4) }}
    {{ lookup('container_networks') | indent(4) }}

{{ lookup('compose_volumes') }}
{{ lookup('compose_networks') }}
