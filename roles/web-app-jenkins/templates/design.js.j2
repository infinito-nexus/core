{% set design = lookup('design', application_id) %}
(function () {
{% if design.title is string %}
  var title = {{ design.title | to_json }};
  function brandTitle() {
    var current = document.title;
    if (current.indexOf(title) !== -1) {
      return;
    }
    document.title = /(^|\s-\s)Jenkins$/.test(current) ? current.replace(/Jenkins$/, title) : current;
    var name = document.querySelector(".app-jenkins-logo span");
    if (name && name.textContent.trim() === "Jenkins") {
      name.textContent = title;
    }
  }
{% endif %}
{% if design.logo is string %}
  function brandIcon() {
    var icons = document.querySelectorAll("link[rel~='icon'], link[rel='apple-touch-icon'], link[rel='mask-icon']");
    for (var index = 0; index < icons.length; index += 1) {
      var icon = icons[index];
      var target = icon.rel === "apple-touch-icon" ? {{ design.urls['apple-touch-icon'].png | to_json }} : {{ design.urls.favicon_ico | to_json }};
      if (icon.rel === "mask-icon") {
        icon.remove();
      } else if (icon.getAttribute("href") !== target) {
        icon.setAttribute("type", icon.rel === "apple-touch-icon" ? "image/png" : "image/x-icon");
        icon.setAttribute("href", target);
      }
    }
  }
{% endif %}
  function brand() {
{% if design.title is string %}
    brandTitle();
{% endif %}
{% if design.logo is string %}
    brandIcon();
{% endif %}
  }
  brand();
  document.addEventListener("DOMContentLoaded", brand);
})();
