ADMIN_PASSWORD={{ lookup('users', 'administrator').password | dotenv_quote }}

ADMIN_USERNAME={{ lookup('users', 'administrator').username | dotenv_quote }}

APP_BASE_URL={{ lookup('tls', application_id, 'url.base') }}

BIBER_PASSWORD={{ lookup('users', 'biber').password | dotenv_quote }}

BIBER_USERNAME={{ lookup('users', 'biber').username | dotenv_quote }}

CANONICAL_DOMAIN={{ lookup('domain', application_id) | dotenv_quote }}

JENKINS_BASE_URL={{ lookup('tls', application_id, 'url.base') | dotenv_quote }}

LDAP_SERVICE_ENABLED={{ JENKINS_LDAP_ENABLED | string | lower }}

LOGOUT_SERVICE_ENABLED={{ lookup('config', application_id, 'services.logout.enabled') | string | lower }}

MATOMO_BASE_URL={{ lookup('tls', 'web-app-matomo', 'url.base') | dotenv_quote }}

MATOMO_SERVICE_ENABLED={{ lookup('config', application_id, 'services.matomo.enabled') | string | lower }}

NODE_TLS_REJECT_UNAUTHORIZED=0

OIDC_ISSUER_URL={{ OIDC.CLIENT.ISSUER_URL | dotenv_quote }}

# nocheck: persona-block-rationale — outside the OIDC variant Jenkins' only login surface is its own Java-realm form, whose fields are named j_username / j_password (templates/casc.yaml.j2 selects the ldap or local securityRealm; files/playwright/playwright.spec.js pins those names in the LDAP scenario). The shared native-login probe matches username / email / login only, so it cannot fill Jenkins' form and the persona never authenticates (see README "Persona contract opt-outs").
PERSONA_ADMINISTRATOR_BLOCKED=true

# nocheck: persona-block-rationale — see PERSONA_ADMINISTRATOR_BLOCKED above.
PERSONA_BIBER_BLOCKED=true

SSO_SERVICE_ENABLED={{ JENKINS_OIDC_ENABLED | string | lower }}

