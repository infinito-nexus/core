  --custom-scroll-bar-thumb-color: var(--design-border-strong);
  --custom-scroll-bar-backgroud-color: var(--design-surface-1);
  --help-text-bg-color: var(--design-surface-3);
  --help-text-font-color: var(--design-text);
  --form-element-required-color: var(--design-success);
  --input-hover-bg-color: var(--design-surface-hover);
  --qs-stage-line-color: var(--design-border);
}
html body[data-theme] .cmk-button--variant-primary,
html body[data-theme] .cmk-button--variant-success {
  color: var(--design-on-primary);
}
@media (prefers-color-scheme: dark) {
{% for icon in checkmk_design_dark_icons.stdout_lines | sort %}
  img[src$="{{ CHECKMK_DESIGN_THEME_LIGHT }}/images/{{ icon }}"] {
    content: url("../{{ CHECKMK_DESIGN_THEME_DARK }}/images/{{ icon }}");
  }
{% endfor %}
}
