{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}
  {% set service_name = 'checkmk' %}
  {{ service_name }}:
    {{ lookup('container_image', application_id, 'checkmk') }}
    {{ lookup('compose_only', 'container_name', CHECKMK_NAME) }}
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_ports', ['checkmk', 'http', DOCKER_BIND_HOST], ['checkmk', 'agent', DOCKER_BIND_HOST]) | indent(4) }}
    {{ lookup('container_healthcheck', service_name) | indent(4) }}

    {{ lookup('container_depends_on', application_id) | indent(4) }}
    {{ lookup('container_volumes', application_id, service_name) | indent(4) }}
    {{ lookup('container_networks') | indent(4) }}


  {% if CHECKMK_MCP_ENABLED | bool %}
  {% set service_name = CHECKMK_MCP_SERVICE_KEY %}
  {{ service_name }}:
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_image', application_id, 'checkmkmcp') }}
    build:
      context: {{ CHECKMK_MCP_INSTANCE_DIR }}
      dockerfile: Dockerfile
      args:
        MCP_ADAPTER_BASE_IMAGE: {{ lookup('config', application_id, 'services.checkmkmcp.image') }}
        MCP_ADAPTER_BASE_DIGEST: "{{ lookup('config', application_id, 'mcp.adapter.digest') }}"
    {{ lookup('compose_only', 'container_name', CHECKMK_MCP_CONTAINER) }}
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    environment:
      ADAPTER_CONTRACT: {{ CHECKMK_MCP_CONTRACT | to_json | to_json }}
      ADAPTER_BEARER: {{ CHECKMK_MCP_BEARER | to_json }}
      ADAPTER_PORT: "{{ CHECKMK_MCP_PORT }}"
      ADAPTER_UPSTREAM_KEY: {{ CHECKMK_MCP_UPSTREAM_KEY | to_json }}
      ADAPTER_UPSTREAM_AUTH_HEADER: {{ CHECKMK_MCP_UPSTREAM_AUTH_HEADER | to_json }}
      ADAPTER_UPSTREAM_AUTH_FORMAT: {{ CHECKMK_MCP_UPSTREAM_AUTH_FORMAT | to_json }}
    expose:
      - "{{ CHECKMK_MCP_PORT }}"
    {{ lookup('container_networks', own_network_only=True, provider_self_alias=False) | indent(4) }}
  {% endif %}

{{ lookup('compose_volumes', application_id) }}

{{ lookup('compose_networks') }}
