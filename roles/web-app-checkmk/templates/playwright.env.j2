ADMIN_PASSWORD={{ lookup('users', 'administrator').password | dotenv_quote }}

ADMIN_USERNAME={{ lookup('users', 'administrator').username | dotenv_quote }}

APP_BASE_URL={{ lookup('tls', application_id, 'url.base') }}

BIBER_PASSWORD={{ lookup('users', 'biber').password | dotenv_quote }}

BIBER_USERNAME={{ lookup('users', 'biber').username | dotenv_quote }}

CANONICAL_DOMAIN={{ lookup('domain', application_id) | dotenv_quote }}

CHECKMK_BASE_URL={{ lookup('tls', application_id, 'url.base') | dotenv_quote }}

# nocheck: playwright-service-gate - CSS injection is asserted by the central CSP helper, not a per-persona surface
CSS_SERVICE_ENABLED={{ lookup('config', application_id, 'services.css.enabled') | string | lower }}

# nocheck: playwright-service-gate - covered by sys-svc-mail integration tests, not the persona surface
EMAIL_SERVICE_ENABLED={{ lookup('config', application_id, 'services.email.enabled') | string | lower }}

# nocheck: playwright-service-gate - universal-logout redirect is exercised by the persona logout step; covered by web-svc-logout integration tests
LOGOUT_SERVICE_ENABLED={{ lookup('config', application_id, 'services.logout.enabled') | string | lower }}

# nocheck: playwright-service-gate - Matomo tracking is an injected snippet, not a per-persona surface; covered by Matomo integration tests
MATOMO_SERVICE_ENABLED={{ lookup('config', application_id, 'services.matomo.enabled') | string | lower }}

NODE_TLS_REJECT_UNAUTHORIZED=0

OIDC_ISSUER_URL={{ OIDC.CLIENT.ISSUER_URL | dotenv_quote }}

# nocheck: persona-block-rationale — with SSO off, tasks/01_manager_ops.yml never has files/configure-sso.sh write `auth_by_http_header` into multisite.d, so the OMD site accepts nothing but its built-in `cmkadmin` account, whose password is `credentials.cmk_password` (vars/main.yml CHECKMK_ADMIN_PASSWORD → templates/env.j2 CMK_PASSWORD) — a site-local secret, not the Keycloak username/password the shared helper types.
PERSONA_ADMINISTRATOR_BLOCKED={{ 'false' if (CHECKMK_SSO_ENABLED | bool) else 'true' }}

# nocheck: persona-block-rationale — the same SSO-off site has no header auth and no user provisioning at all: `cmkadmin` is the only account the role creates, so a non-admin persona has no Checkmk login to attempt. See PERSONA_ADMINISTRATOR_BLOCKED above.
PERSONA_BIBER_BLOCKED={{ 'false' if (CHECKMK_SSO_ENABLED | bool) else 'true' }}

SSO_SERVICE_ENABLED={{ CHECKMK_SSO_ENABLED | string | lower }}
