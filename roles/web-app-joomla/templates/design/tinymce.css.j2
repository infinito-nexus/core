  border-color: rgba(var(--design-border-strong-rgb), 0.7);
}
:root .tox .tox-card--has-decision .tox-card__body {
  color: var(--design-text-muted);
}
:root .tox .tox-card--has-decision .tox-card__actions .tox-button--secondary--outline {
  border-color: var(--design-border);
}
:root .tox .tox-card--has-decision .tox-card__actions .tox-button--secondary--outline:focus:not(:disabled) {
  background-color: var(--design-surface-active);
  border-color: var(--design-border-strong);
}
:root .tox .tox-card--has-decision .tox-card__actions .tox-button--secondary--outline:hover:not(:disabled) {
  background-color: var(--design-surface-hover);
  border-color: var(--design-border-strong);
}
:root .tox .tox-card--has-decision .tox-card__actions .tox-button--secondary--outline:active:not(:disabled) {
  background-color: var(--design-surface-active);
  border-color: var(--design-border-strong);
}
:root .tox .tox-card__header,
:root .tox .tox-card__header-label,
:root .tox .tox-card__body {
  color: var(--design-text);
}
:root .tox .tox-card__highlight {
  border-bottom-color: var(--design-link);
}
:root .tox .tox-card__highlight--added {
  background-color: var(--design-success-subtle);
}
:root .tox .tox-card__highlight--deleted {
  background-color: var(--design-danger-subtle);
}
:root .tox .tox-card__highlight--modified {
  background-color: var(--design-info-subtle);
}
:root .tox [data-mce-name=suggestededits] .tox-icon .tox-icon--badge {
