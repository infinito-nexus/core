:root joomla-tab[view=tabs]>div[role=tablist] {
  background-color: var(--design-surface-3);
  border-color: var(--design-border);
  box-shadow: inset 0 1px var(--design-surface-2), inset 0 -4px transparent, var(--design-shadow-1);
}
:root joomla-tab button[role=tab] {
  color: var(--design-text);
  background-color: rgba(var(--design-text-rgb), 0);
  box-shadow: 1px 0 var(--design-border);
}
:root joomla-tab button[role=tab][aria-expanded=true],
:root joomla-tab button[role=tab][aria-selected=true] {
  background-color: var(--design-surface-2);
  background-image: none;
  box-shadow: inset 2px 0 1px -1px rgba(var(--design-text-rgb), 0.08), inset -2px 0 1px -1px rgba(var(--design-text-rgb), 0.08), inset 0 1px transparent;
}
:root joomla-tab button[aria-expanded=true]:after,
:root joomla-tab button[aria-selected=true]:after {
  background-color: var(--design-primary);
}
:root joomla-tab>joomla-tab-element {
  background-color: var(--design-surface-2);
  border-color: var(--design-border);
  box-shadow: var(--design-shadow-1);
}
:root joomla-tab[orientation=vertical]>div[role=tablist] {
  box-shadow: none;
  border-color: var(--design-border);
}
:root joomla-tab[orientation=vertical]>div[role=tablist] button {
  color: var(--design-text);
  background-color: rgba(var(--design-text-rgb), 0);
  border-bottom-color: var(--design-border);
}
:root joomla-tab[orientation=vertical]>div[role=tablist] button[aria-expanded=true] {
  background-color: var(--design-surface-2);
}
:root joomla-tab[orientation=vertical]>joomla-tab-element {
  box-shadow: none;
}
:root joomla-tab[view=accordion] {
  box-shadow: inset 0 1px var(--design-surface-2), var(--design-shadow-1);
}
:root joomla-tab[view=accordion]>button {
  color: var(--design-text);
  background-color: var(--design-surface-3);
  box-shadow: 1px 0 var(--design-border);
}
:root joomla-tab[view=accordion]>button:focus,
:root joomla-tab[view=accordion]>button[aria-expanded=true] {
  background-color: var(--design-surface-2);
  background-image: none;
}
:root joomla-tab[view=accordion] joomla-tab-element[active],
:root joomla-tab[view=accordion] button {
  border-bottom-color: var(--design-border);
}
:root joomla-tab[view=accordion] [active] {
  background-color: var(--design-surface-2);
}
