.header,
.sidebar-wrapper {
  --design-focus: var(--design-on-frame);
  --focus: var(--design-on-frame);
}
{% if JOOMLA_DESIGN_LOGO_ENABLED | bool %}

.header .logo:not(.small) {
  padding-block: 5px;
}

.header .logo:not(.small) img:not(.logo-collapsed) {
  block-size: {{ lookup('design', application_id).slots['admin-brand'].height }}px;
  inline-size: 100%;
}
{% endif %}

.header,
.header a,
.header .page-title,
.header .dropdown-header,
.header .dropdown-item,
.header-item-content,
.header-item-content a,
.header-item-content button,
.header-item-icon > *,
.view-login .h1,
.task-logout .h1,
.view-login .sidebar-wrapper .card-header {
  color: var(--design-on-frame);
}

.view-login #sidebar .card {
  color: var(--design-on-frame);
  background: var(--design-frame-hover);
}

.bg-warning {
  color: var(--design-on-warning);
}

html .skip-to {
  --design-focus: var(--design-link);
}

html .skip-to button,
html .skip-to [role="menu"],
html .skip-to [role="menuitem"] {
  color: var(--design-text);
  background-color: var(--design-surface-2);
  border-color: var(--design-border-strong);
}

html .skip-to button:focus,
html .skip-to button:hover,
html .skip-to [role="menuitem"]:focus,
html .skip-to [role="menuitem"]:hover {
  color: var(--design-text);
  background-color: var(--design-surface-hover);
  border-color: var(--design-link);
}

.js-stools-container-bar .btn-toolbar .js-stools-btn-clear {
  color: var(--design-on-primary);
  background-color: var(--design-primary);
}

.js-stools-container-bar .btn-toolbar .js-stools-btn-clear[disabled],
[data-bs-theme="dark"] .js-stools-container-bar .btn-toolbar .js-stools-btn-clear[disabled] {
  color: var(--design-text-muted);
  background: var(--design-surface-3);
  border-color: var(--design-border);
}

joomla-tab[view="accordion"] > div[role="tablist"] {
  background-color: var(--design-surface-2);
}

joomla-tab > button[role="region"]:not([aria-selected="true"], :hover, :focus) {
  color: var(--design-on-primary);
  background-color: var(--design-primary);
}

joomla-alert {
  --jui-alert-button-color-dark: var(--design-text);
  --jui-alert-button-color-light: transparent;
{% for status in ['success', 'info', 'warning', 'danger'] %}
  --jui-alert-{{ status }}-color: var(--design-text);
  --jui-alert-{{ status }}-background-color: var(--design-{{ status }}-subtle);
  --jui-alert-{{ status }}-border-color: var(--design-{{ status }}-border);
  --jui-alert-{{ status }}-link-color: var(--design-link);
{% endfor %}
}
{% for type, status in [('success', 'success'), ('message', 'success'), ('info', 'info'), ('notice', 'info'), ('warning', 'warning'), ('error', 'danger'), ('danger', 'danger')] %}

#system-message-container joomla-alert[type="{{ type }}"] {
  --alert-heading-text: var(--design-on-{{ status }});
}

#system-message-container joomla-alert[type="{{ type }}"] .alert-heading {
  color: var(--design-on-{{ status }});
}
{% endfor %}

.choices {
  --choices-bg-color: var(--design-surface-2);
  --choices-bg-color-dropdown: var(--design-surface-2);
  --choices-bg-color-disabled: var(--design-surface-3);
  --choices-keyline-color: var(--design-border-strong);
  --choices-primary-color: var(--design-primary);
  --choices-item-color: var(--design-on-primary);
  --choices-text-color: var(--design-text);
  --choices-highlighted-color: var(--design-surface-hover);
  --choices-highlight-color: var(--design-link);
  --choices-invalid-color: var(--design-danger);
  --choices-disabled-color: var(--design-surface-3);
  --choices-item-disabled-color: var(--design-text-muted);
  border-color: var(--design-border-strong);
}

.choices.is-focused {
  border-color: var(--design-link);
  box-shadow: var(--design-focus-ring-inset);
}

.choices[data-type*="select-one"] .choices__inner,
.choices[data-type*="select-multiple"] .choices__inner,
[data-bs-theme="dark"] .choices[data-type*="select-one"] .choices__inner,
[data-bs-theme="dark"] .choices[data-type*="select-multiple"] .choices__inner {
  background: var(--design-surface-2);
}

.choices__input::placeholder {
  color: var(--design-text-muted);
}

.form-select,
.custom-select,
[data-bs-theme="dark"] .form-select,
[data-bs-theme="dark"] .custom-select {
  --form-select-bg-img: none;
  appearance: auto;
}
{% for status in ['success', 'danger'] %}

.form-select.form-select-{{ status }},
.form-select.custom-select-{{ status }} {
  color: var(--design-{{ status }});
  background-color: var(--design-surface-2);
  border-color: var(--design-{{ status }});
}

.form-select.form-select-{{ status }} option,
.form-select.custom-select-{{ status }} option {
  color: var(--design-text);
  background-color: var(--design-surface-2);
}
{% endfor %}

.table th .inactive [class^="icon-"],
.table th .inactive [class*=" icon-"] {
  color: var(--design-text-muted);
}

.dropdown-item + .dropdown-item,
[data-bs-theme="dark"] .dropdown-divider {
  border-block-start-color: var(--design-border);
}

[data-bs-theme="dark"] .j-main-container .table {
  border-color: var(--design-border);
  box-shadow: var(--design-shadow-1);
}

[data-bs-theme="dark"] .j-main-container .table tr:hover,
[data-bs-theme="dark"] .com_cpanel .card .list-group-item:hover {
  background: var(--design-surface-hover);
}

[data-bs-theme="dark"] .subhead {
  border-block-color: var(--design-border);
}

[data-bs-theme="dark"] .com_cpanel .card {
  box-shadow: var(--design-shadow-1);
}

[data-bs-theme="dark"] .sidebar-wrapper .main-nav .badge {
  color: var(--design-on-frame);
  background-color: var(--design-frame-active);
}

.form-check-input:focus,
.switcher input:focus ~ .toggle-outside {
  box-shadow: var(--design-focus-ring);
}

.form-check-input[type="checkbox"]:indeterminate {
  background-color: var(--design-primary);
  border-color: var(--design-primary);
}
{% for fill in ['primary', 'success', 'danger'] %}

.modal .btn.btn-{{ fill }},
.modal .btn.btn-{{ fill }}:not([href]),
[data-bs-theme="dark"] .modal .btn.btn-{{ fill }},
[data-bs-theme="dark"] .modal .btn.btn-{{ fill }}:not([href]) {
  color: var(--design-on-{{ fill }});
  background: var(--design-{{ fill }});
  border-color: var(--design-{{ fill }});
}

.modal .btn.btn-{{ fill }}:hover,
.modal .btn.btn-{{ fill }}:not([href]):hover,
.modal .btn.btn-{{ fill }}:not([href]):focus,
[data-bs-theme="dark"] .modal .btn.btn-{{ fill }}:hover,
[data-bs-theme="dark"] .modal .btn.btn-{{ fill }}:not([href]):hover {
  color: var(--design-on-{{ fill }});
  background: var(--design-{{ fill }}-hover);
  border-color: var(--design-{{ fill }}-hover);
}

.modal .btn.btn-{{ fill }} [class^="icon-"],
.modal .btn.btn-{{ fill }} [class*=" icon-"] {
  color: var(--design-on-{{ fill }});
}
{% endfor %}

.modal .btn.btn-secondary,
.modal .btn.btn-secondary:not([href]),
[data-bs-theme="dark"] .modal .btn.btn-secondary,
[data-bs-theme="dark"] .modal .btn.btn-secondary:not([href]) {
  color: var(--design-text);
  background: var(--design-surface-3);
  border-color: var(--design-border-strong);
}

.modal .btn.btn-secondary:not([href]):hover,
.modal .btn.btn-secondary:not([href]):focus,
[data-bs-theme="dark"] .modal .btn.btn-secondary:hover,
[data-bs-theme="dark"] .modal .btn.btn-secondary:not([href]):hover {
  color: var(--design-text);
  background: var(--design-surface-hover);
  border-color: var(--design-border-strong);
}

.quick-icons .quickicon-linkadd a:hover *,
.quick-icons .quickicon-linkadd a:focus * {
  color: var(--design-on-primary);
}

.plg_system_webauthn_login_button svg path,
.plg_system_webauthn_login_button svg circle {
  fill: currentcolor;
}

.btn-close {
  filter: brightness(0) invert(var(--design-invert));
}
