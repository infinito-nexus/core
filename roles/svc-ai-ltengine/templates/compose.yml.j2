{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}

  {% set service_name = LTENGINE_SERVICE %}
  {{ service_name }}:
    {{ lookup('template', 'roles/sys-svc-container/templates/build.yml.j2') | indent(4) }}
      cache_from:
        - "{{ lookup('image', application_id, 'ltengine') }}"
      args:
        BUILDKIT_INLINE_CACHE: "1"
        LTENGINE_BUILDER_IMAGE: "{{ LTENGINE_BUILDER_IMAGE }}"
        LTENGINE_BUILDER_VERSION: "{{ LTENGINE_BUILDER_VERSION }}"
        LTENGINE_BASE_IMAGE: "{{ LTENGINE_BASE_IMAGE }}"
        LTENGINE_BASE_VERSION: "{{ LTENGINE_BASE_VERSION }}"
        LTENGINE_REPOSITORY: "{{ LTENGINE_REPOSITORY }}"
        LTENGINE_REF: "{{ LTENGINE_REF }}"
        LTENGINE_MODELS_DIR: "{{ LTENGINE_MODELS_TARGET }}"
    {{ lookup('container_image', application_id, 'ltengine') }}
    {{ lookup('compose_only', 'container_name', LTENGINE_CONTAINER) }}
    expose:
      - "{{ LTENGINE_PORT }}"
    {{ lookup('container_volumes', service_name) | indent(4) }}
    {{ lookup('container_healthcheck', service_name) | indent(4) }}
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_networks') | indent(4) }}

{{ lookup('compose_volumes') }}

{{ lookup('compose_networks') }}
