# nocheck: playwright-service-gate — the SMTP sender is pushed into Listmonk's settings table by tasks/02_manager_ops.yml (the `smtp` entry in vars/main.yml), never into a browser-visible surface, and no scenario in this spec sends a campaign
EMAIL_SERVICE_ENABLED={{ lookup('config', application_id, 'services.email.enabled') | string | lower }}

# nocheck: playwright-service-gate — hCaptcha guards the public subscription form, which no persona scenario submits and which no headless run can solve
HCAPTCHA_SERVICE_ENABLED={{ lookup('config', application_id, 'services.hcaptcha.enabled') | string | lower }}

