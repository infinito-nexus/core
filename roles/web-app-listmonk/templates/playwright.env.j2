MATOMO_SERVICE_ENABLED={{ lookup('config', application_id, 'services.matomo.enabled') | string | lower }}

MCP_SERVICE_ENABLED={{ lookup('config', application_id, 'mcp.enabled') | string | lower }}

OIDC_ISSUER_URL={{ OIDC.CLIENT.ISSUER_URL | dotenv_quote }}

# nocheck: persona-block-rationale — Listmonk is a restricted application: tasks/04_rbac.yml provisions accounts only for the administrator, manager and viewer members and keeps security.oidc.auto_create_users off, so cmd/auth.go OIDCFinish refuses biber, who holds none of these roles; test-rbac-gate.js asserts that refusal.
PERSONA_BIBER_BLOCKED=true

# nocheck: playwright-service-gate — Listmonk refuses to start without its Postgres DSN, so every scenario already proves it and no DB status surface exists in the UI
POSTGRES_SERVICE_ENABLED={{ lookup('config', application_id, 'services.postgres.enabled') | string | lower }}

SSO_SERVICE_ENABLED={{ lookup('config', application_id, 'services.sso.enabled') | string | lower }}

