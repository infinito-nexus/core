  fill: rgba(var(--design-text-rgb), 0.5);
}
html .tox .tox-tbtn--enabled,
html .tox .tox-tbtn--enabled:hover {
  background-color: var(--design-border-strong);
  box-shadow: none;
  color: var(--design-text);
}
html .tox .tox-tbtn--enabled svg,
html .tox .tox-tbtn--enabled:hover svg,
html .tox .tox-tbtn:focus:not(.tox-tbtn--disabled) svg {
  fill: var(--design-text);
}
html .tox .tox-tbtn:focus:not(.tox-tbtn--disabled) {
  color: var(--design-text);
}
html .tox .tox-tbtn__select-chevron svg,
html .tox .tox-split-button__chevron svg {
  fill: rgba(var(--design-text-rgb), 0.5);
}
html .tox .tox-split-button:hover {
  box-shadow: 0 0 0 1px inset var(--design-border);
}
html .tox .tox-split-button:focus {
  background-color: var(--design-surface-active);
  box-shadow: none;
  color: var(--design-text);
}
html .tox .tox-split-button.tox-tbtn--disabled:hover,
html .tox .tox-split-button.tox-tbtn--disabled:focus,
html .tox .tox-split-button.tox-tbtn--disabled .tox-tbtn:hover,
html .tox .tox-split-button.tox-tbtn--disabled .tox-tbtn:focus {
  background-color: transparent;
  background-image: none;
  color: rgba(var(--design-text-rgb), 0.5);
}
html .tox .tox-toolbar-overlord {
  background-color: var(--design-surface-2);
}
html .tox .tox-toolbar,
html .tox .tox-toolbar__primary,
html .tox .tox-toolbar__overflow {
  background-color: var(--design-surface-2);
  background-color: var(--design-surface-2);
}
html .tox .tox-menubar+.tox-toolbar,
html .tox .tox-menubar+.tox-toolbar-overlord .tox-toolbar__primary,
html .tox-tinymce:not(.tox-tinymce-inline) .tox-editor-header:not(:first-child) .tox-toolbar:first-child,
html .tox-tinymce:not(.tox-tinymce-inline) .tox-editor-header:not(:first-child) .tox-toolbar-overlord:first-child .tox-toolbar__primary {
  border-top-color: var(--design-border-strong);
}
html .tox .tox-toolbar--no-divider {
  background-image: none;
}
html .tox.tox-tinymce-aux .tox-toolbar__overflow {
  background-color: var(--design-surface-2);
  border-color: var(--design-border-strong);
  box-shadow: var(--design-shadow-1);
}
html .tox:not([dir=rtl]) .tox-toolbar__group:not(:last-of-type) {
  border-right-color: var(--design-border-strong);
}
html .tox[dir=rtl] .tox-toolbar__group:not(:last-of-type) {
  border-left-color: var(--design-border-strong);
}
html .tox .tox-tooltip__body {
  background-color: var(--design-primary);
  box-shadow: 0 2px 4px rgba(var(--design-link-rgb), 0.3);
  color: rgba(var(--design-on-primary-rgb), 0.75);
}
html .tox .tox-tooltip--down .tox-tooltip__arrow {
  border-left-color: transparent;
  border-right-color: transparent;
  border-top-color: var(--design-link);
}
html .tox .tox-tooltip--up .tox-tooltip__arrow {
  border-bottom-color: var(--design-link);
  border-left-color: transparent;
  border-right-color: transparent;
}
html .tox .tox-tooltip--right .tox-tooltip__arrow {
  border-bottom-color: transparent;
  border-left-color: var(--design-link);
  border-top-color: transparent;
}
html .tox .tox-tooltip--left .tox-tooltip__arrow {
  border-bottom-color: transparent;
  border-right-color: var(--design-link);
  border-top-color: transparent;
}
html .tox .tox-well,
html .tox .tox-custom-editor {
  border-color: var(--design-border-strong);
}
html .tox .tox-dialog-loading:before {
  background-color: rgba(var(--design-text-rgb), 0.5);
}
html .visual-editor-wrapper {
  border-color: var(--design-border);
}
html .code-editor .cm-editor,
html .code-editor .cm-gutters {
