{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}
  {% set service_name = 'tor' %}
  {{ service_name }}:
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('template', 'roles/sys-svc-container/templates/build.yml.j2') | indent(4) }}
      args:
        TOR_BASE_IMAGE:        "{{ TOR_IMAGE }}"
        TOR_BASE_VERSION:      "{{ TOR_VERSION }}"
        TOR_FLAVOR:            "{{ TOR_FLAVOR }}"
        TOR_ENTRYPOINT_PATH:   "{{ TOR_ENTRYPOINT_PATH }}"
        TOR_HEALTHCHECK_PATH:  "{{ TOR_HEALTHCHECK_PATH }}"
    {{ lookup('compose_only', 'container_name', TOR_CONTAINER) }}
    {{ lookup('container_image', application_id, 'tor') }}
    {% if IS_SWARM_MODE %}
    {{ lookup('container_ports',
              {'service': 'tor', 'protocol': 'socks', 'mode': 'host',
               'container': 'same'},
              {'service': 'tor', 'protocol': 'dns', 'mode': 'host',
               'container': 'same', 'transport': ['udp', 'tcp']},
              {'service': 'tor', 'protocol': 'trans', 'mode': 'host',
               'container': 'same', 'transport': 'tcp'}) | indent(4) }}
    {{ lookup('container_networks') | indent(4) }}
    {% else %}
    network_mode: "host"
    {% endif %}
    {{ lookup('container_volumes', service_name) | indent(4) }}
    healthcheck:
      test: ["CMD", "{{ TOR_HEALTHCHECK_PATH }}", "{{ lookup('volume', 'svc-net-tor', 'tor_data').target }}"]
      interval: 2m
      timeout: 5s
      retries: 3
      start_period: 10m
      start_interval: 5s

{{ lookup('compose_volumes') }}
{{ lookup('compose_networks') }}
