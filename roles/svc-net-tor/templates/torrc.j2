# Managed by {{ SOFTWARE_NAME }} (roles/svc-net-tor) — do not edit by hand.
RunAsDaemon 0
Log notice stdout
DataDirectory {{ lookup('volume', 'svc-net-tor', 'tor_data').target }}

{% set _listen_hosts = ['127.0.0.1'] + ([TOR_NODE_BRIDGE] if TOR_NODE_BRIDGE | length > 0 else []) %}
{% for _host in _listen_hosts %}
SocksPort {{ lookup('tor_socks', _host) }}
{% endfor %}
{% for _cidr in NETWORK_INTERNAL_CIDRS %}
SocksPolicy accept {{ _cidr }}
{% endfor %}
SocksPolicy reject *
ControlPort 127.0.0.1:9051
CookieAuthentication 1

{% if not (TOR_USE_ENTRY_GUARDS | bool) %}
UseEntryGuards 0
{% endif %}

{% if TOR_FLAVOR == 'chutney' %}
%include /run/tor/chutney-net.conf
{% endif %}

{% if TOR_NODE_ROUTES %}
AutomapHostsOnResolve 1
AutomapHostsSuffixes {{ '.' if TOR_EGRESS_PLAN.automap_all else '.onion' }}
VirtualAddrNetworkIPv4 {{ TOR_EGRESS_VIRTUAL_NET_IPV4 }}
{% for _host in _listen_hosts %}
TransPort {{ _host }}:{{ TOR_TRANS_PORT }}
DNSPort {{ _host }}:{{ TOR_DNS_PORT }}
{% endfor %}
{% endif %}
{% if tor_node == STACK_HOST %}
HiddenServiceDir /var/lib/tor/infinito/node/
HiddenServiceVersion 3
{% for _p in TOR_ONION_EXTRA_PORTS %}
HiddenServicePort {{ _p.onion_port }} {{ TOR_HS_BACKEND_HOST }}:{{ _p.target.rsplit(':', 1) | last }}
{% endfor %}
{% endif %}
