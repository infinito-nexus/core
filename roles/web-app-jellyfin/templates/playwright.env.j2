ADMIN_NATIVE_PASSWORD={{ JELLYFIN_ADMIN_PASSWORD | dotenv_quote }}

ADMIN_USERNAME={{ lookup('users', 'administrator').username | dotenv_quote }}

BIBER_PASSWORD={{ lookup('users', 'biber').password | dotenv_quote }}

BIBER_USERNAME={{ lookup('users', 'biber').username | dotenv_quote }}

CANONICAL_DOMAIN={{ lookup('domain', application_id) | dotenv_quote }}

# nocheck: playwright-service-gate - CSS injection is asserted by the central CSP helper, not a per-persona surface
CSS_SERVICE_ENABLED={{ lookup('config', application_id, 'services.css.enabled') | string | lower }}

JELLYFIN_BASE_URL={{ lookup('tls', application_id, 'url.base') | dotenv_quote }}

LDAP_SERVICE_ENABLED={{ JELLYFIN_LDAP_ENABLED | string | lower }}

# nocheck: playwright-service-gate - universal-logout redirect is exercised by the persona logout step; covered by web-svc-logout integration tests
LOGOUT_SERVICE_ENABLED={{ lookup('config', application_id, 'services.logout.enabled') | string | lower }}

# nocheck: playwright-service-gate - Matomo tracking is an injected snippet, not a per-persona surface; covered by Matomo integration tests
MATOMO_SERVICE_ENABLED={{ lookup('config', application_id, 'services.matomo.enabled') | string | lower }}

OIDC_ISSUER_URL={{ OIDC.CLIENT.ISSUER_URL | dotenv_quote }}

# nocheck: persona-block-rationale — a Jellyfin account binds to exactly one auth provider, so biber's login journey is owned by the per-addon specs that know which provider is live: files/playwright/addons/sso-authentication.spec.js (OIDC) and addons/ldap-authentication.spec.js (LDAP-only matrix variant). The generic persona cannot pick between them and would duplicate or contradict the addon coverage (see README "Persona contract opt-outs").
PERSONA_BIBER_BLOCKED=true

SSO_SERVICE_ENABLED={{ JELLYFIN_SSO_ENABLED | string | lower }}

{{ lookup('addon_env_flags', application_id) }}
