{% set jf_palette = [
  ('background-default', 'var(--design-surface-1)'),
  ('background-paper', 'var(--design-surface-2)'),
  ('common-background', 'var(--design-surface-1)'),
  ('common-onBackground', 'var(--design-text)'),
  ('text-primary', 'var(--design-text)'),
  ('text-secondary', 'var(--design-text-muted)'),
  ('divider', 'var(--design-border)'),
  ('action-active', 'var(--design-text)'),
  ('action-selected', 'var(--design-surface-active)'),
  ('primary-main', 'var(--design-link)'),
  ('primary-light', 'var(--design-link)'),
  ('primary-dark', 'color-mix(in oklab, var(--design-link), var(--design-text) 12%)'),
  ('primary-contrastText', 'var(--design-surface-2)'),
  ('secondary-main', 'var(--design-info)'),
  ('secondary-light', 'var(--design-info)'),
  ('secondary-dark', 'var(--design-info-hover)'),
  ('secondary-contrastText', 'var(--design-on-info)'),
  ('error-main', 'var(--design-danger)'),
  ('error-light', 'var(--design-danger)'),
  ('error-dark', 'var(--design-danger-hover)'),
  ('error-contrastText', 'var(--design-on-danger)'),
  ('warning-main', 'var(--design-warning)'),
  ('warning-light', 'var(--design-warning)'),
  ('warning-dark', 'var(--design-warning-hover)'),
  ('warning-contrastText', 'var(--design-on-warning)'),
  ('info-main', 'var(--design-info)'),
  ('info-light', 'var(--design-info)'),
  ('info-dark', 'var(--design-info-hover)'),
  ('info-contrastText', 'var(--design-on-info)'),
  ('success-main', 'var(--design-success)'),
  ('success-light', 'var(--design-success)'),
  ('success-dark', 'var(--design-success-hover)'),
  ('success-contrastText', 'var(--design-on-success)'),
] %}
html[data-design-palette] {
{% for name, value in jf_palette %}
  --jf-palette-{{ name }}: {{ value }};
  --jf-palette-{{ name }}Channel: from {{ value }} r g b;
{% endfor %}
{% for level in range(1, 25) %}
  --jf-overlays-{{ level }}: none;
{% endfor %}
{% for status, token in [('error', 'danger'), ('warning', 'warning'), ('info', 'info'), ('success', 'success')] %}
  --jf-palette-Alert-{{ status }}Color: var(--design-{{ token }});
  --jf-palette-Alert-{{ status }}IconColor: var(--design-{{ token }});
  --jf-palette-Alert-{{ status }}StandardBg: var(--design-{{ token }}-subtle);
  --jf-palette-Alert-{{ status }}FilledBg: var(--design-{{ token }});
  --jf-palette-Alert-{{ status }}FilledColor: var(--design-on-{{ token }});
{% endfor %}
  --jf-palette-text-disabled: rgba(var(--design-text-muted-rgb), 0.7);
  --jf-palette-text-icon: var(--design-text-muted);
  --jf-palette-action-hover: var(--design-surface-hover);
  --jf-palette-action-focus: var(--design-surface-active);
  --jf-palette-action-disabled: rgba(var(--design-text-muted-rgb), 0.7);
  --jf-palette-action-disabledBackground: var(--design-surface-3);
  --jf-palette-AppBar-defaultBg: var(--design-surface-2);
  --jf-palette-AppBar-darkBg: var(--design-surface-2);
  --jf-palette-AppBar-darkColor: var(--design-text);
  --jf-palette-Avatar-defaultBg: var(--design-text-muted);
  --jf-palette-Button-inheritContainedBg: var(--design-surface-3);
  --jf-palette-Button-inheritContainedHoverBg: var(--design-surface-hover);
  --jf-palette-Chip-defaultBorder: var(--design-border-strong);
  --jf-palette-FilledInput-bg: var(--design-surface-3);
  --jf-palette-FilledInput-hoverBg: var(--design-surface-hover);
  --jf-palette-FilledInput-disabledBg: var(--design-surface-3);
{% for color in ['primary', 'secondary', 'error', 'info', 'success', 'warning'] %}
  --jf-palette-LinearProgress-{{ color }}Bg: var(--design-surface-3);
{% endfor %}
  --jf-palette-Skeleton-bg: var(--design-surface-3);
  --jf-palette-SnackbarContent-bg: var(--design-text);
  --jf-palette-SnackbarContent-color: var(--design-surface-1);
  --jf-palette-Switch-defaultColor: var(--design-text-muted);
  --jf-palette-Switch-defaultDisabledColor: var(--design-border);
  --jf-palette-TableCell-border: var(--design-border);
  --jf-palette-Tooltip-bg: var(--design-text);
  --jf-palette-starIcon-main: var(--design-warning);
}
