{% if design.logo is string %}
html[data-design-palette] .pageTitleWithDefaultLogo {
  background-image: url("{{ design.urls.brand.svg }}");
}
html[data-design-palette].layout-tv .pageTitleWithDefaultLogo {
  background-image: url("{{ design.urls.icon.svg }}");
}
html[data-design-palette] .MuiDrawer-paper .MuiListItemIcon-root > img {
  content: url("{{ design.urls.icon.svg }}");
}
{% endif %}
