{% set design = lookup('design', application_id) %}
(function () {
  var root = document.documentElement;
{% if design.title is string %}
  document.title = {{ design.title | to_json }};
{% endif %}
{% if design.logo is string %}
  var icon = document.querySelector("link[rel='icon']") || document.head.appendChild(document.createElement("link"));
  icon.rel = "icon";
  icon.type = "image/svg+xml";
  icon.href = {{ design.urls.favicon.svg | to_json }};
  var touch = document.querySelector("link[rel='apple-touch-icon']") || document.head.appendChild(document.createElement("link"));
  touch.rel = "apple-touch-icon";
  touch.href = {{ design.urls['apple-touch-icon'].png | to_json }};
{% endif %}
  function mirror() {
    var choice = null;
    try {
      choice = window.localStorage.getItem("dark-mode-preference");
    } catch (error) {
      choice = null;
    }
    if (choice === "light" || choice === "dark") {
      root.setAttribute("data-design-theme", choice);
    } else {
      root.removeAttribute("data-design-theme");
    }
  }
  new MutationObserver(mirror).observe(root, { attributes: true, attributeFilter: ["class"] });
  document.addEventListener(
    "click",
    function () {
      window.setTimeout(mirror, 0);
    },
    true
  );
  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", mirror);
  mirror();
})();
