{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}
  {% set service_name = 'pretix' %}
  {{ service_name }}:
    {{ lookup('compose_only', 'pull_policy', 'never') }}
    build:
      context: "{{ PRETIX_SOURCE_DIR }}"
      dockerfile: "{{ PRETIX_SOURCE_DOCKERFILE_NAME }}"
      args:
        PRETIX_BASE_IMAGE: "{{ PRETIX_BASE_IMAGE }}"
        PRETIX_BASE_VERSION: "{{ PRETIX_BASE_VERSION }}"
        PRETIX_OIDC_PLUGIN_VERSION: "{{ PRETIX_OIDC_PLUGIN_VERSION }}"
    {{ lookup('container_image', application_id, 'pretix', version=PRETIX_SOURCE_VERSION) }}
    {{ lookup('compose_only', 'container_name', PRETIX_CONTAINER) }}
    hostname: '{{ PRETIX_HOSTNAME}}'
    command: ["all"]
    {{ lookup('container_ports', ['pretix', 'http', DOCKER_BIND_HOST]) | indent(4) }}
    {{ lookup('container_volumes', service_name) | indent(4) }}
    {{ lookup('container_healthcheck', service_name) | indent(4) }}
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_depends_on', application_id) | indent(4) }}
    {{ lookup('container_extra_hosts') | indent(4) }}
    {{ lookup('container_networks') | indent(4) }}

  {% if PRETIX_MCP_ENABLED | bool %}
  {% set service_name = PRETIX_MCP_SERVICE_KEY %}
  {{ service_name }}:
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_image', application_id, 'pretixmcp') }}
    build:
      context: {{ PRETIX_MCP_INSTANCE_DIR }}
      dockerfile: Dockerfile
      args:
        MCP_ADAPTER_BASE_IMAGE: {{ lookup('config', application_id, 'services.pretixmcp.image') }}
        MCP_ADAPTER_BASE_VERSION: "{{ lookup('config', application_id, 'services.pretixmcp.version') }}"
    {{ lookup('compose_only', 'container_name', PRETIX_MCP_CONTAINER) }}
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    environment: # nocheck: compose-environment-from-env-file pretixmcp-only keys; this role sets no docker_compose_env, so its single templates/env.j2 is also the env_file of the primary pretix container, which must not receive ADAPTER_BEARER or ADAPTER_UPSTREAM_KEY, and swarm does not unescape the $$ of ADAPTER_CONTRACT in an env file
      ADAPTER_CONTRACT: {{ PRETIX_MCP_CONTRACT | to_json | to_json | replace('$', '$$') }}
      ADAPTER_BEARER: {{ PRETIX_MCP_BEARER | to_json }}
      ADAPTER_PORT: "{{ PRETIX_MCP_PORT }}"
      ADAPTER_UPSTREAM_KEY: {{ PRETIX_MCP_UPSTREAM_KEY | to_json }}
      ADAPTER_UPSTREAM_AUTH_HEADER: {{ PRETIX_MCP_UPSTREAM_AUTH_HEADER | to_json }}
      ADAPTER_UPSTREAM_AUTH_FORMAT: {{ PRETIX_MCP_UPSTREAM_AUTH_FORMAT | to_json }}
    expose:
      - "{{ PRETIX_MCP_PORT }}"
    {{ lookup('container_networks', own_network_only=True, provider_self_alias=False) | indent(4) }}
  {% endif %}

{{ lookup('compose_volumes') }}
{{ lookup('compose_networks') }}
