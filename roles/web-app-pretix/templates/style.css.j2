{% set design = lookup('design', application_id) %}
html:root {
  --pretix-body-bg: var(--design-surface-1);
  --pretix-link-contrast-color: var(--design-link);
  --pretix-link-hover-contrast-color: var(--design-link);
  --pretix-border-radius-base: var(--design-radius);
  --pretix-border-radius-large: var(--design-radius-lg);
  --pretix-border-radius-small: var(--design-radius-sm);
  --pretix-brand-primary: var(--design-primary);
  --pretix-brand-primary-darken-5: var(--design-primary);
  --pretix-brand-primary-darken-10: var(--design-primary-active);
  --pretix-brand-primary-darken-15: var(--design-link);
  --pretix-brand-primary-darken-17: var(--design-primary-hover);
  --pretix-brand-primary-darken-20: var(--design-primary-active);
  --pretix-brand-primary-darken-30: var(--design-primary-active);
  --pretix-brand-primary-lighten-5: var(--design-primary-hover);
  --pretix-brand-primary-lighten-20: var(--design-primary-300);
  --pretix-brand-primary-lighten-23-saturate-2: var(--design-primary-300);
  --pretix-brand-primary-lighten-28-saturate-20: var(--design-primary-200);
  --pretix-brand-primary-lighten-30: var(--design-primary-200);
  --pretix-brand-primary-lighten-40: var(--design-on-primary);
  --pretix-brand-primary-lighten-48: var(--design-surface-active);
  --pretix-brand-primary-lighten-50: var(--design-surface-active);
  --pretix-brand-primary-lighten-53: var(--design-surface-hover);
  --pretix-brand-primary-lighten-55: var(--design-surface-2);
  --pretix-brand-primary-tint-90: var(--design-surface-active);
  --pretix-brand-primary-shade-25: var(--design-link);
  --pretix-brand-primary-shade-42: var(--design-text);
{% for status in ['success', 'info', 'warning', 'danger'] %}
  --pretix-brand-{{ status }}: var(--design-{{ status }});
  --pretix-brand-{{ status }}-darken-5: var(--design-{{ status }});
{% for step in [10, 12, 15, 20, 25, 30, 35] %}
  --pretix-brand-{{ status }}-darken-{{ step }}: var(--design-{{ status }}-active);
{% endfor %}
  --pretix-brand-{{ status }}-darken-17: var(--design-{{ status }}-hover);
  --pretix-brand-{{ status }}-lighten-5: var(--design-{{ status }});
{% for step in [10, 12, 15, 20, 23, 25, 30, 31] %}
  --pretix-brand-{{ status }}-lighten-{{ step }}: var(--design-{{ status }}-border);
{% endfor %}
{% for step in [33, 35, 38, 40, 41, 43, 45, 48, 50] %}
  --pretix-brand-{{ status }}-lighten-{{ step }}: var(--design-{{ status }}-subtle);
{% endfor %}
  --pretix-brand-{{ status }}-tint-50: var(--design-{{ status }}-border);
  --pretix-brand-{{ status }}-tint-85: var(--design-{{ status }}-subtle);
  --pretix-brand-{{ status }}-shade-25: var(--design-{{ status }});
  --pretix-brand-{{ status }}-shade-42: var(--design-{{ status }});
{% endfor %}
  --pretix-brand-warning-transparent-60: rgba(var(--design-warning-rgb), 0.4);
}
