{% include 'roles/sys-svc-container/templates/env.j2' %}

YOURLS_DB_HOST={{ lookup('database', application_id, 'host') }}
YOURLS_DB_USER={{ lookup('database', application_id, 'username') }}
YOURLS_DB_PASS={{ lookup('database', application_id, 'password') | dotenv_quote }}
YOURLS_DB_NAME={{ lookup('database', application_id, 'name') }}
YOURLS_SITE={{ lookup('tls', application_id, 'url.base') }}
{% set yourls_base_urls = lookup('network_urls', YOURLS_URL) %}
INFINITO_NETWORK_BASE_URLS={{ yourls_base_urls | join(',') }}
YOURLS_USER={{ YOURLS_USER }}
YOURLS_PASS={{ YOURLS_PASSWORD | dotenv_quote }}
YOURLS_COOKIEKEY={{ YOURLS_COOKIE_KEY | dotenv_quote }}
YOURLS_PRIVATE=true
PROXY_HEADER_SSO={{ YOURLS_SSO_PROXY_GATED | string | lower }}
PROXY_HEADER_SSO_ADMIN_GROUP={{ YOURLS_SSO_ADMIN_GROUP }}
PROXY_HEADER_SSO_GATED_PATH={{ YOURLS_ADMIN_LOCATION }}
DESIGN_TITLE={{ (lookup('design', application_id).title if (lookup('config', application_id, 'services.design.enabled') | bool and lookup('design', application_id).title is string) else '') | dotenv_quote }}
{% set yourls_favicon = lookup('design', application_id).urls.favicon.png if (lookup('config', application_id, 'services.design.enabled') | bool and lookup('design', application_id).logo is string) else '' %}
{% set yourls_favicons = namespace(by_host={}) %}
{% for base in (yourls_base_urls if yourls_favicon else []) %}
{% for url in lookup('network_urls', yourls_favicon) if (url | urlsplit('hostname') | network_of) == (base | urlsplit('hostname') | network_of) %}
{% set yourls_favicons.by_host = yourls_favicons.by_host | combine({base | urlsplit('hostname'): url}) %}
{% endfor %}
{% endfor %}
DESIGN_FAVICON_URL={{ yourls_favicon | dotenv_quote }}
DESIGN_FAVICON_URLS={{ yourls_favicons.by_host | to_json | dotenv_quote }}
