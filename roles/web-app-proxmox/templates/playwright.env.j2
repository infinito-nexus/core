ADMIN_PASSWORD={{ lookup('users', 'platform_administrator').password | dotenv_quote }}

ADMIN_USERNAME={{ lookup('users', 'platform_administrator').username | dotenv_quote }}

APP_BASE_URL={{ lookup('tls', application_id, 'url.base') | dotenv_quote }}

CANONICAL_DOMAIN={{ lookup('domain', application_id) | dotenv_quote }}

# nocheck: playwright-service-gate  no design scenario yet; the CSP helper gates design only through a computed loop variable (personas/utils/csp.js:116-119), which the literal-only regex of test_spec_env_gates.py cannot see
DESIGN_SERVICE_ENABLED={{ lookup('config', application_id, 'services.design.enabled') | string | lower }}

LOGOUT_SERVICE_ENABLED={{ lookup('config', application_id, 'services.logout.enabled') | string | lower }}

NODE_TLS_REJECT_UNAUTHORIZED=0

OIDC_ISSUER_URL={{ OIDC.CLIENT.ISSUER_URL | dotenv_quote }}

OPENBAO_BASE_URL={{ (lookup('landing_url', 'web-app-openbao') if 'web-app-openbao' in group_names else '') | dotenv_quote }}

OPENBAO_PLAYWRIGHT_MOUNT={{ (lookup('config', 'web-app-openbao', 'services.openbao.workspaces.playwright.mount') if 'web-app-openbao' in group_names else '') | dotenv_quote }}

OPENBAO_PLAYWRIGHT_ROLE_ID={{ (lookup('config', 'web-app-openbao', 'secrets.credentials.playwright_approle_role_id') if 'web-app-openbao' in group_names else '') | dotenv_quote }}

OPENBAO_PLAYWRIGHT_SECRET_ID={{ (lookup('config', 'web-app-openbao', 'secrets.credentials.playwright_approle_secret_id') if 'web-app-openbao' in group_names else '') | dotenv_quote }}

OPENBAO_PLAYWRIGHT_SEMAPHORE_PATH={{ (lookup('config', 'web-app-openbao', 'services.openbao.workspaces.playwright.logins.semaphore') if 'web-app-openbao' in group_names else '') | dotenv_quote }}

# nocheck: persona-block-rationale  meta/services.yml admits only the web-app-proxmox administrator RBAC group to the oauth2-proxy (sso.oauth2.allowed_groups) and biber carries no roles, so biber never reaches Proxmox VE (see README "Persona contract opt-outs")
PERSONA_BIBER_BLOCKED=true

PROXMOX_ADMIN_GROUP={{ PROXMOX_ADMIN_GROUP | dotenv_quote }}

PROXMOX_ADMIN_ROLE={{ PROXMOX_ADMIN_ROLE | dotenv_quote }}

PROXMOX_API_URL={{ ('https://host.docker.internal:' ~ http_port) | dotenv_quote }}

PROXMOX_FLAVOR={{ PROXMOX_FLAVOR | dotenv_quote }}

PROXMOX_IMAGE_SHA256={{ PROXMOX_WORKSPACES.image.sha256 | dotenv_quote }}

PROXMOX_NODE={{ PROXMOX_NODE | dotenv_quote }}

PROXMOX_OTHER_BRIDGE={{ lookup('config', application_id, 'services.proxmox.vm_network.bridge') | dotenv_quote }}

PROXMOX_PINNED_RELEASE={{ PROXMOX_VE.iso.file | regex_replace('^proxmox-ve_([0-9]+[.][0-9]+)-[0-9]+[.]iso$', '\\1') | dotenv_quote }}

PROXMOX_PROVISION_MOUNT={{ PROXMOX_PROVISION_MOUNT | dotenv_quote }}

PROXMOX_PROVISION_PATH={{ PROXMOX_PROVISION_PATH | dotenv_quote }}

PROXMOX_REALM={{ PROXMOX_REALM | dotenv_quote }}

PROXMOX_TEMPLATE_EMULATED={{ PROXMOX_WORKSPACES.templates.emulated | string | dotenv_quote }}

PROXMOX_TEMPLATE_KVM={{ PROXMOX_WORKSPACES.templates.kvm | string | dotenv_quote }}

PROXMOX_TENANT_MOUNT={{ PROXMOX_TENANT_MOUNT | dotenv_quote }}

PROXMOX_WORKSPACE_BRIDGE={{ PROXMOX_WORKSPACES.bridge | dotenv_quote }}

PROXMOX_WORKSPACE_STORAGE={{ PROXMOX_WORKSPACES.storage | dotenv_quote }}

PROXMOX_WORKSPACE_TOKEN_NAME={{ PROXMOX_WORKSPACE_TOKEN_NAME | dotenv_quote }}

SEMAPHORE_APP_CONTROL_PROJECT={{ SOFTWARE_NAME | dotenv_quote }}

SEMAPHORE_BASE_URL={{ (lookup('landing_url', 'web-app-semaphore') if 'web-app-semaphore' in group_names else '') | dotenv_quote }}

SEMAPHORE_WORKSPACES_ENABLED={{ ('web-app-semaphore' in group_names and 'web-app-openbao' in group_names and (lookup('config', 'web-app-semaphore', 'services.workspaces-runner.enabled') | bool)) | string | lower }}

SEMAPHORE_WORKSPACES_PROJECT={{ (SOFTWARE_NAME ~ ' Workspaces') | dotenv_quote }}

SSO_SERVICE_ENABLED={{ lookup('config', application_id, 'services.sso.enabled') | string | lower }}
