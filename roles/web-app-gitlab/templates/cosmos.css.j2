{{ COSMOS_SKY_SELECTOR }},
{{ COSMOS_SKY_SELECTOR }} body,
{{ COSMOS_SKY_SELECTOR }}.html-devise-layout body,
{{ COSMOS_SKY_SELECTOR }} .super-topbar {
  background: transparent;
  color: var(--cosmos-text);
}
{{ COSMOS_SKY_SELECTOR }} .super-topbar {
  --gl-text-color-default: var(--cosmos-text);
  --gl-text-color-heading: var(--cosmos-text);
  --gl-text-color-strong: var(--cosmos-text);
  --gl-text-color-subtle: var(--cosmos-text);
  --gl-text-color-link: var(--cosmos-text);
  --gl-icon-color-default: var(--cosmos-text);
  --gl-icon-color-strong: var(--cosmos-text);
  --gl-icon-color-subtle: var(--cosmos-text);
  --gl-nav-item-foreground-color-default: var(--cosmos-text);
  --gl-button-default-tertiary-foreground-color-default: var(--cosmos-text);
  --gl-action-neutral-foreground-color-default: var(--cosmos-text);
}
{{ COSMOS_SKY_SELECTOR }} .super-sidebar {
  background-color: var(--design-frame);
  color: var(--design-on-frame);
}
{{ COSMOS_LEGIBLE_TOP_SELECTOR }}.html-devise-layout main {
  background-color: var(--design-surface-1);
  color: var(--design-text);
}
