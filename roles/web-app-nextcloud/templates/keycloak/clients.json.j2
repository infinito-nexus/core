{% set nextcloud_kc_origin = lookup('tls', 'web-app-nextcloud', 'url.origin') %}
{% set nextcloud_kc_origins = lookup('network_urls', nextcloud_kc_origin) %}
{% set nextcloud_kc_redirects = nextcloud_kc_origins | map('regex_replace', '$', '/*') | list %}
{% set nextcloud_kc_client_id = lookup('config', 'web-app-nextcloud', 'services.sso.oidc.clients').user_oidc %}
{
  "clientId": "{{ nextcloud_kc_client_id }}",
  "name": "Nextcloud user_oidc",
  "description": "Confidential Nextcloud user_oidc client that receives OIDC back-channel logout tokens. Reuses the shared client secret.",
  "enabled": true,
  "surrogateAuthRequired": false,
  "alwaysDisplayInConsole": false,
  "clientAuthenticatorType": "client-secret",
  "secret": "{{ OIDC.CLIENT.SECRET }}",
  "redirectUris": {{ nextcloud_kc_redirects | to_json }},
  "webOrigins": {{ nextcloud_kc_origins | to_json }},
  "notBefore": 0,
  "bearerOnly": false,
  "consentRequired": false,
  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "publicClient": false,
  "frontchannelLogout": false,
  "protocol": "openid-connect",
  "attributes": {
    "post.logout.redirect.uris": "{{ nextcloud_kc_redirects | join('##') }}",
    "backchannel.logout.url": "{{ nextcloud_kc_origin ~ lookup('config', 'web-app-nextcloud', 'services.sso.oidc.backchannel_logout_path') }}",
    "backchannel.logout.session.required": "true",
    "backchannel.logout.revoke.offline.tokens": "false",
    "oauth2.device.authorization.grant.enabled": "false",
    "oidc.ciba.grant.enabled": "false",
    "display.on.consent.screen": "false"
  },
  "authenticationFlowBindingOverrides": {},
  "protocolMappers": [
    {
      "name": "nextcloud client roles",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-usermodel-client-role-mapper",
      "consentRequired": false,
      "config": {
        "usermodel.clientRoleMapping.clientId": "{{ nextcloud_kc_client_id }}",
        "usermodel.clientRoleMapping.rolePrefix": "",
        "multivalued": "true",
        "claim.name": "{{ KEYCLOAK_RBAC_GROUP_CLAIM }}",
        "jsonType.label": "String",
        "id.token.claim": "true",
        "access.token.claim": "true",
        "userinfo.token.claim": "true",
        "introspection.token.claim": "true",
        "lightweight.claim": "false"
      }
    },
    {
      "name": "nextcloud uid",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-usermodel-attribute-mapper",
      "consentRequired": false,
      "config": {
        "user.attribute": "{{ OIDC.ATTRIBUTES.NEXTCLOUD_UID }}",
        "claim.name": "{{ OIDC.ATTRIBUTES.NEXTCLOUD_UID }}",
        "jsonType.label": "String",
        "multivalued": "false",
        "aggregate.attrs": "false",
        "id.token.claim": "true",
        "access.token.claim": "true",
        "userinfo.token.claim": "true",
        "introspection.token.claim": "true",
        "lightweight.claim": "false"
      }
    },
    {
      "name": "nextcloud no groups",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-hardcoded-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "{{ lookup('config', 'web-app-nextcloud', 'services.sso.oidc.no_groups_claim') }}",
        "claim.value": "[]",
        "jsonType.label": "JSON",
        "id.token.claim": "true",
        "access.token.claim": "true",
        "userinfo.token.claim": "true",
        "introspection.token.claim": "true",
        "lightweight.claim": "false"
      }
    }
  ],
  "fullScopeAllowed": true,
  "nodeReRegistrationTimeout": -1,
  "defaultClientScopes": [
    "web-origins",
    "acr",
    "roles",
    "profile",
    "basic",
    "email",
    "openid",
    "{{ KEYCLOAK_RBAC_GROUP_CLAIM }}"
  ],
  "optionalClientScopes": [
    "address",
    "phone",
    "organization",
    "offline_access",
    "microprofile-jwt",
    "{{ lookup('config', 'web-app-keycloak', 'services.keycloak.scopes.nextcloud') }}"
  ]
}
