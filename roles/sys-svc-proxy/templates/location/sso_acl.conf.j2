{# Param sso_gated_location_extra_configuration: directives appended to every SSO-gated location. #}
{# Param sso_open_location_extra_configuration: directives appended to every location the ACL leaves ungated. #}
{% if lookup('sso', application_id, 'is_proxy_gated') %}
  {% set _base_extra = webserver_location_extra_configuration | default('') %}
  {% set _gated_extra = _base_extra ~ (sso_gated_location_extra_configuration | default('')) %}
  {% set _open_extra = _base_extra ~ (sso_open_location_extra_configuration | default('')) %}
  {% set acl = lookup('sso', application_id, 'oauth2_acl') %}

  {% if acl.blacklist is defined %}
    {% with sso_proxy_enabled = false, location = "/", webserver_location_extra_configuration = _open_extra %}
      {% include 'roles/sys-svc-proxy/templates/location/html.conf.j2' %}
    {% endwith %}

    {% for loc in acl.blacklist %}
      {% with sso_proxy_enabled = true, location = loc, webserver_location_extra_configuration = _gated_extra %}
        {% include 'roles/sys-svc-proxy/templates/location/html.conf.j2' %}
      {% endwith %}
    {% endfor %}

  {% elif acl.whitelist is defined %}
    {% with sso_proxy_enabled = true, location = "/", webserver_location_extra_configuration = _gated_extra %}
      {% include 'roles/sys-svc-proxy/templates/location/html.conf.j2' %}
    {% endwith %}

    {% for loc in acl.whitelist %}
      {% with sso_proxy_enabled = false, location = loc, webserver_location_extra_configuration = _open_extra %}
        {% include 'roles/sys-svc-proxy/templates/location/html.conf.j2' %}
      {% endwith %}
    {% endfor %}

  {% else %}
    {% with sso_proxy_enabled = true, location = "/", webserver_location_extra_configuration = _gated_extra %}
      {% include 'roles/sys-svc-proxy/templates/location/html.conf.j2' %}
    {% endwith %}
  {% endif %}

{% else %}
  {% set sso_proxy_enabled = false %}
  {% set location = "/" %}
  {% include 'roles/sys-svc-proxy/templates/location/html.conf.j2' %}
{% endif %}
