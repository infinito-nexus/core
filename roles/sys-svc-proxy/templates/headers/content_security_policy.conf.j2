{% set _network = domain | network_of %}
{% set _onion = namespace(host='') %}
{% for _sibling in lookup('network_siblings', domain) if (_sibling | network_of) == 'tor' %}{% set _onion.host = _sibling %}{% endfor %}
set $csp "{{ lookup('applications') | build_csp_header(application_id, lookup('domains'), ('https' if TLS_ENABLED | bool else 'http'), (webserver_csp_whitelist_extra_by_app | default({})).get(application_id, {}), (webserver_csp_hashes_extra_by_app | default({})).get(application_id, {}), DOMAIN_PRIMARY, domain) | replace('\"','\\\"') }}";

header_filter_by_lua_block {
    local ct   = ngx.header.content_type or ngx.header["Content-Type"] or ""
    local dest = ngx.var.http_sec_fetch_dest or ""

    local lct = ct:lower()
    local is_html   = lct:find("^text/html") or lct:find("^application/xhtml+xml")
    local is_worker = (dest == "worker") or (dest == "serviceworker")

    if is_html or is_worker then
        ngx.header["Content-Security-Policy"] = ngx.var.csp
    else
        ngx.header["Content-Security-Policy"] = nil
        ngx.header["Content-Security-Policy-Report-Only"] = nil
    end

    if is_html then
        ngx.ctx.is_html = true
        ngx.header.content_length = nil
{% if _network == 'clearnet' and _onion.host and domain != (OIDC.URL | urlsplit('hostname')) and not lookup('config', application_id, 'networks.reachability.handover', False) %}
        ngx.header["Onion-Location"] = "{{ lookup('tls', _onion.host, 'url.base') | regex_replace('/+$', '') }}" .. ngx.var.request_uri
{% endif %}
    else
        ngx.ctx.is_html = false
{% if _network == 'tor' and (lookup('config', application_id, 'services.tor.enabled', False) | bool) and (lookup('applications') | external_asset_origins(application_id, DOMAIN_PRIMARY)) %}
        if lct:find("^text/css") then
            ngx.ctx.is_css = true
            ngx.header.content_length = nil
        end
{% endif %}
    end

    if (ngx.ctx.is_html or ngx.ctx.is_css) and ngx.ctx.inj_inflate then
        local encoding = (ngx.header["Content-Encoding"] or ""):lower()
        if encoding == "gzip" then
            ngx.ctx.gunzip = true
            ngx.header["Content-Encoding"] = nil
        elseif encoding ~= "" and encoding ~= "identity" then
            ngx.log(ngx.WARN, "upstream sent ", encoding, "-encoded markup, nothing gets injected")
        end
    end
}

proxy_hide_header Content-Security-Policy;
proxy_hide_header Content-Security-Policy-Report-Only;
