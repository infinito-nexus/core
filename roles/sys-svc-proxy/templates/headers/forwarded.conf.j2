{% set _forward_host = lookup('domain', application_id) if lookup('network_handover', application_id, domain) else '$host' %}
proxy_set_header Host {{ _forward_host }};
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Host {{ _forward_host }};
proxy_set_header X-Forwarded-Proto {{ proxy_x_forwarded_proto | default('$scheme') }};
proxy_set_header X-Forwarded-Port {{ lookup('tls', domain, 'ports.web') }};
proxy_set_header X-Forwarded-Ssl {{ lookup('tls', domain, 'enabled') | on_off }};
