proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto {{ proxy_x_forwarded_proto | default('$scheme') }};
proxy_set_header X-Forwarded-Port {{ lookup('tls', application_id, 'ports.web') }};
proxy_set_header X-Forwarded-Ssl {{ lookup('tls', application_id, 'enabled') | on_off }};
