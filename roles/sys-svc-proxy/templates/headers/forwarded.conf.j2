{% include 'roles/sys-svc-proxy/templates/headers/forwarded_base.conf.j2' %}
{% if proxy_forwarded_client_address | default(false) | bool %}
proxy_set_header Forwarded "for=$remote_addr";
{% endif %}
proxy_set_header X-Forwarded-Port {{ lookup('tls', application_id, 'ports.web') }};
proxy_set_header X-Forwarded-Ssl {{ lookup('tls', application_id, 'enabled') | on_off }};
