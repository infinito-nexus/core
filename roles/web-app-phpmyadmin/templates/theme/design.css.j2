h2,
.h2 {
  text-shadow: none;
  color: var(--design-text-muted);
}
.table th,
.table td {
  text-shadow: none;
}
.table th,
.table-striped>tbody>tr:nth-of-type(even)>th {
  color: var(--design-text);
}
.table thead th {
  border-right-color: var(--design-surface-2);
  background-color: var(--design-surface-3);
  background-image: none;
}
.table caption {
  background-color: var(--design-surface-3);
}
.table-hover tbody tr:hover {
  background-color: var(--design-surface-hover);
  background-image: none;
}
.btn-primary,
.btn-secondary {
  border-color: var(--design-border-strong);
  text-shadow: none;
  background-color: var(--design-surface-3);
  background-image: none;
}
.btn-primary:hover,
.btn-secondary:hover {
  background-color: var(--design-surface-hover);
  background-image: none;
}
.btn-outline-primary,
.btn-outline-secondary {
  color: var(--design-text);
  border-color: var(--design-border-strong);
}
.nav-pills .nav-link {
  background-color: var(--design-surface-3);
  color: var(--design-link);
  border-color: var(--design-border);
}
.nav-pills .nav-link:hover {
  background-color: var(--design-surface-hover);
}
.nav-pills .nav-link.active,
.nav-pills .show>.nav-link {
  background-color: var(--design-surface-2);
  color: var(--design-link);
}
.nav-tabs .nav-link {
  background-color: var(--design-surface-3);
  color: var(--design-text-muted);
  border-color: var(--design-border) var(--design-border) var(--design-border-strong);
}
.nav-tabs .nav-link:hover {
  background-color: var(--design-surface-hover);
}
.nav-tabs .nav-link:focus {
  background-color: var(--design-surface-active);
}
.navbar.bg-light {
  background-color: var(--design-surface-2);
  background-image: none;
}
.navbar-nav .nav-item {
  background-color: var(--design-surface-2);
  background-image: none;
  border-right-color: var(--design-surface-2);
  border-left-color: var(--design-border-strong);
  border-bottom-color: var(--design-border-strong);
}
.navbar-nav .nav-item:hover {
  background-color: var(--design-surface-hover);
  background-image: none;
}
.navbar-nav .nav-item.active {
  background-color: var(--design-surface-2);
}
.card,
.card-footer {
  text-shadow: none;
  box-shadow: 1px 1px 2px inset rgba(var(--design-surface-2-rgb), 0.12);
}
.card-header {
  border-color: var(--design-border);
  box-shadow: var(--design-shadow-3);
}
.card-footer {
  color: var(--design-text);
  background-color: var(--design-surface-3);
}
#maincontainer .card {
  background-color: var(--design-surface-3);
  border-color: var(--design-border);
  box-shadow: var(--design-shadow-2);
}
#maincontainer .card-header {
  background-color: var(--design-surface-3);
  color: var(--design-text);
  text-shadow: none;
  box-shadow: 1px 1px 15px inset rgba(var(--design-text-rgb), 0.12);
}
.breadcrumb-navbar {
  background-color: var(--design-frame);
}
.breadcrumb-navbar {
  text-shadow: none;
}
.breadcrumb-navbar .breadcrumb-item a,
.breadcrumb-navbar .breadcrumb-comment {
  color: var(--design-on-frame);
}
.page-link {
  background-color: var(--design-surface-2);
  background-image: none;
}
.page-item.active .page-link {
  background-color: var(--design-surface-active);
  background-image: none;
}
.page-item.disabled .page-link {
  background-image: none;
}
.alert {
  box-shadow: 0 1px 1px inset rgba(var(--design-surface-2-rgb), 0.12);
}
.alert-primary {
  color: var(--design-text);
  background-color: var(--design-info-subtle);
  background-image: none;
  border-color: var(--design-info-subtle);
}
.alert-primary h1,
.alert-primary .h1 {
  border-color: var(--design-warning);
}
.alert-success {
  color: var(--design-text);
  background-color: var(--design-warning-border);
  background-image: none;
  border-color: var(--design-success);
}
.alert-success h1,
.alert-success .h1 {
  border-color: lime;
}
.alert-danger {
  color: var(--design-text);
  background-color: pink;
  background-image: none;
  border-color: var(--design-border-strong);
}
.alert-danger h1,
.alert-danger .h1 {
  border-color: var(--design-danger);
}
.modal-header {
  background-color: var(--design-surface-3);
  background-image: none;
}
@media print {
body {
  color: var(--design-text);
  background-color: var(--design-surface-1);
}
table,
th,
td {
  color: var(--design-text);
  background-color: var(--design-surface-2);
}
a:link {
  color: var(--design-text);
}
table,
th,
td {
  border-color: var(--design-border-strong);
  background-color: var(--design-surface-2);
}
thead {
  border-color: var(--design-border-strong);
}
thead th {
  background-color: var(--design-surface-active);
  border-color: var(--design-border-strong);
}
.sqlOuter {
  color: var(--design-text);
  background-color: var(--design-text);
}
table tbody:first-of-type tr:nth-child(odd),
table tbody:first-of-type tr:nth-child(odd) th {
  background-color: var(--design-surface-2);
}
table tbody:first-of-type tr:nth-child(even),
table tbody:first-of-type tr:nth-child(even) th {
  background-color: var(--design-surface-3);
}
}
:root {
  --bs-gradient: none;
  --bs-body-bg-rgb: var(--design-surface-1-rgb);
  --bs-body-color-rgb: var(--design-text-rgb);
  --bs-emphasis-color-rgb: var(--design-text-rgb);
  --bs-secondary-color-rgb: var(--design-text-muted-rgb);
  --bs-secondary-bg-rgb: var(--design-surface-2-rgb);
  --bs-tertiary-color-rgb: var(--design-text-muted-rgb);
  --bs-tertiary-bg-rgb: var(--design-surface-3-rgb);
  --bs-link-color-rgb: var(--design-link-rgb);
  --bs-link-hover-color-rgb: var(--design-link-rgb);
  --bs-primary: var(--design-primary);
  --bs-primary-rgb: var(--design-primary-rgb);
  --bs-secondary-rgb: var(--design-text-muted-rgb);
  --bs-success-rgb: var(--design-success-rgb);
  --bs-info-rgb: var(--design-info-rgb);
  --bs-warning-rgb: var(--design-warning-rgb);
  --bs-danger-rgb: var(--design-danger-rgb);
  --bs-light-rgb: var(--design-surface-2-rgb);
  --bs-dark-rgb: var(--design-text-rgb);
}

.btn-primary,
.btn-primary:disabled {
  background-color: var(--design-primary);
  border-color: var(--design-primary);
  color: var(--design-on-primary);
}

.btn-primary:hover,
.btn-primary:focus-visible {
  background-color: var(--design-primary-hover);
  border-color: var(--design-primary-hover);
  color: var(--design-on-primary);
}

.btn-primary:active,
.btn-primary.active {
  background-color: var(--design-primary-active);
  border-color: var(--design-primary-active);
  color: var(--design-on-primary);
}

.breadcrumb-navbar {
  --design-focus: var(--design-on-frame);
}
{% if design.logo is string %}

#imgpmalogo,
#pmalogo h1 {
  content: url("{{ design.urls.logo.svg }}");
}
{% endif %}
