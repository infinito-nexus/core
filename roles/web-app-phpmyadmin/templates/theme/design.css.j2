  color: var(--design-text);
}
.tab_field:hover {
  background-color: var(--design-success-subtle);
  color: var(--design-text);
}
.tab_field_3 {
  background-color: var(--design-danger-subtle) !important;
  color: var(--design-text);
}
.tab_field_3:hover {
  background-color: var(--design-success-subtle);
  color: var(--design-text);
}
#designer_hint {
  background-color: var(--design-success-border);
  color: var(--design-text);
  border-color: var(--design-success-border);
}
.designer_Tabs {
  color: var(--design-link);
  background-color: var(--design-surface-2);
  background-image: none;
  border-color: var(--design-border-strong);
}
.designer_Tabs:hover {
  color: var(--design-link);
  background-color: var(--design-warning-border);
  border-color: var(--design-info-border);
}
.owner {
  color: var(--design-text-muted);
}
.select_all {
  color: var(--design-text);
  background-color: var(--design-surface-3);
  background-image: none;
}
.small_tab {
  background-color: var(--design-primary-active);
  color: var(--design-on-primary);
  background-image: url("../../pmahomme/css/../img/designer/small_tab.png");
}
.small_tab:hover {
  color: var(--design-on-danger);
  background-color: var(--design-danger-hover);
}
.small_tab_pref {
  background-color: var(--design-surface-3);
  background-image: none;
}
.small_tab_pref:hover {
  color: var(--design-on-danger);
  background-color: var(--design-danger-hover);
}
.butt {
  border-color: var(--design-link);
  background-color: var(--design-surface-2);
  color: var(--design-text);
}
.L_butt2_1:hover {
  border-color: var(--design-info);
  background-color: var(--design-warning-border);
  color: var(--design-text);
}
.frams1 {
  background: url("../../pmahomme/css/../img/designer/1.png") no-repeat right bottom;
}
.frams2 {
  background: url("../../pmahomme/css/../img/designer/2.png") no-repeat left bottom;
}
.frams3 {
  background: url("../../pmahomme/css/../img/designer/3.png") no-repeat left top;
}
.frams4 {
  background: url("../../pmahomme/css/../img/designer/4.png") no-repeat right top;
}
.frams5 {
  background: url("../../pmahomme/css/../img/designer/5.png") repeat-x center bottom;
}
.frams6 {
  background: url("../../pmahomme/css/../img/designer/6.png") repeat-y left;
}
.frams7 {
  background: url("../../pmahomme/css/../img/designer/7.png") repeat-x top;
}
.frams8 {
  background: url("../../pmahomme/css/../img/designer/8.png") repeat-y right;
}
#osn_tab {
  background-color: var(--design-surface-2);
  color: var(--design-text);
}
.designer_header {
  background-color: var(--design-surface-3);
  color: var(--design-text);
  background-image: url("../../pmahomme/css/../img/designer/top_panel.png");
  border-right-color: var(--design-border-strong);
  border-left-color: var(--design-border-strong);
}
.designer_header a,
.designer_header span {
  border-color: var(--design-surface-2);
}
a.M_butt_Selected_down_IE,
a.M_butt_Selected_down {
  border-color: var(--design-border-strong);
  background-color: var(--design-success-border);
  color: var(--design-text);
}
a.M_butt_Selected_down_IE:hover,
a.M_butt_Selected_down:hover,
a.M_butt:hover {
  border-color: var(--design-info);
  background-color: var(--design-warning-border);
  color: var(--design-text);
}
#layer_menu {
  background-color: var(--design-surface-3);
  border-color: var(--design-border-strong);
}
#layer_menu_sizer {
  background-image: url("../../pmahomme/css/../img/designer/resize.png");
}
a.trigger {
  color: var(--design-surface-1);
  background-color: var(--design-text);
  border-color: var(--design-text);
}
a.trigger:hover {
  color: var(--design-text);
  background-color: var(--design-warning-border);
  border-color: var(--design-border-strong);
}
a.active.trigger {
  background-color: var(--design-text);
}
a.active.trigger:hover {
  background-color: var(--design-warning-border);
}
.toggle_container .block {
  background-color: var(--design-surface-3);
  border-top-color: var(--design-border-strong);
}
.history_table {
  background-color: var(--design-surface-3);
}
.history_table:hover {
  background-color: var(--design-surface-hover);
}
.side-menu {
  background-color: var(--design-surface-3);
  border-color: var(--design-border-strong);
}
#name-panel {
  border-bottom-color: var(--design-border-strong);
  background-color: var(--design-surface-3);
}
.insertRowTable .CodeMirror {
  border-color: var(--design-border-strong);
}
#pma_console .CodeMirror-gutters {
  background-color: initial;
}
span.cm-keyword,
span.cm-statement-verb {
  color: var(--design-info);
}
span.cm-variable {
  color: var(--design-text);
}
span.cm-comment {
  color: olive;
}
span.cm-mysql-string {
  color: var(--design-success);
}
span.cm-operator {
  color: var(--design-info);
}
span.cm-mysql-word {
  color: var(--design-text);
}
span.cm-builtin {
  color: var(--design-danger);
}
span.cm-variable-2 {
  color: var(--design-warning);
}
span.cm-variable-3 {
  color: var(--design-link);
}
span.cm-separator {
  color: var(--design-info);
}
span.cm-number {
  color: teal;
}
.autocomplete-column-hint {
  color: var(--design-text-muted);
}
.jqplot-target {
  color: var(--design-text);
}
.jqplot-meterGauge-tick,
.jqplot-meterGauge-label {
  color: var(--design-text-muted);
}
table.jqplot-table-legend,
table.jqplot-cursor-legend {
  background-color: rgba(var(--design-surface-2-rgb), 0.6);
  border-color: var(--design-border-strong);
}
div.jqplot-table-legend-swatch-outline,
table.jqplot-cursor-tooltip {
  border-color: var(--design-border-strong);
}
.jqplot-cursor-tooltip,
.jqplot-highlighter-tooltip,
.jqplot-canvasOverlay-tooltip {
  border-color: var(--design-border-strong);
  background-color: rgba(var(--design-surface-3-rgb), 0.8);
}
div.jqplot-bubble-label {
  color: var(--design-text);
}
div.jqplot-bubble-label.jqplot-bubble-label-highlight {
  background-color: rgba(var(--design-surface-active-rgb), 0.7);
}
div.jqplot-noData-container {
  background-color: rgba(var(--design-surface-3-rgb), 0.3);
}
