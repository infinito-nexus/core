{% include 'roles/sys-svc-container/templates/env.j2' %}

WORDPRESS_DB_HOST={{ lookup('database', application_id, 'host') }}:{{ lookup('database', application_id, 'port') }}
WORDPRESS_DB_USER={{ lookup('database', application_id, 'username') }}
WORDPRESS_DB_PASSWORD={{ lookup('database', application_id, 'password') | dotenv_quote }}
WORDPRESS_DB_NAME={{ lookup('database', application_id, 'name') }}

WP_CLI_CACHE_DIR=/tmp/wp-cli-cache

WORDPRESS_INTERNAL_HOST={{ WORDPRESS_MCP_SERVICE_KEY }}
INFINITO_NETWORK_BASE_URLS={{ WORDPRESS_NETWORK_BASE_URLS }}
WORDPRESS_MANAGED_OPTIONS_FILE={{ WORDPRESS_MANAGED_OPTIONS_FILE | dotenv_quote }}

WORDPRESS_OIDC_CLAIM_GROUPS={{ RBAC.GROUP.CLAIM }}
WORDPRESS_OIDC_CLAIM_EMAIL={{ OIDC.ATTRIBUTES.EMAIL }}
WORDPRESS_OIDC_CLAIM_NAME={{ OIDC.ATTRIBUTES.NAME }}
WORDPRESS_OIDC_CLAIM_GIVEN_NAME={{ OIDC.ATTRIBUTES.GIVEN_NAME }}
WORDPRESS_OIDC_CLAIM_FAMILY_NAME={{ OIDC.ATTRIBUTES.FAMILY_NAME }}
WORDPRESS_OIDC_CLAIM_WEBSITE={{ OIDC.ATTRIBUTES.WEBSITE }}
WORDPRESS_OIDC_CLAIM_LOCALE={{ OIDC.ATTRIBUTES.LOCALE }}
WORDPRESS_OIDC_CLAIM_USERNAME={{ OIDC.ATTRIBUTES.USERNAME }}
WORDPRESS_OIDC_PROFILE_LOCKED={{ lookup('field_locks', application_id).profile | list | to_json | dotenv_quote }}
WORDPRESS_RBAC_GROUP_MAP={{ WORDPRESS_RBAC_GROUP_MAP | to_json | dotenv_quote }}
WORDPRESS_SSO_ENABLED={{ WORDPRESS_LOGIN_SSO | bool | string | lower }}
{% if WORDPRESS_LOGIN_SSO | bool %}
WORDPRESS_OIDC_SETTINGS={{ WORDPRESS_OIDC_SETTINGS | to_json | dotenv_quote }}
{% endif %}
WORDPRESS_SITE_OWNER_ENABLED={{ WORDPRESS_SITE_OWNER_ENABLED | bool | string | lower }}
{% if WORDPRESS_SITE_OWNER_ENABLED | bool %}
WORDPRESS_SITE_OWNER_BASE_URL={{ WORDPRESS_SITE_OWNER_BASE_URL }}
{% endif %}

{% if lookup('objstore', application_id, 'enabled') | bool %}
WORDPRESS_S3_BUCKET={{ lookup('objstore', application_id, 'bucket') }}
WORDPRESS_S3_ENDPOINT={{ lookup('objstore', application_id, 'url') }}
WORDPRESS_S3_KEY={{ lookup('objstore', application_id, 'access_key') }}
WORDPRESS_S3_PUBLIC_URL={{ lookup('objstore', application_id, 'relative_url') }}
WORDPRESS_S3_REGION={{ lookup('objstore', application_id, 'region') }}
WORDPRESS_S3_SECRET={{ lookup('objstore', application_id, 'secret_key') | dotenv_quote }}
{% endif %}

WP_DEBUG={{ lookup('debug') | lower }}
WP_DEBUG_LOG={{ lookup('debug') | lower }}
WP_DEBUG_DISPLAY={{ lookup('debug') | lower }}
{% if (OIDC.CLIENT.ISSUER_URL | urlsplit('hostname') | network_of) == 'tor' %}

WORDPRESS_OIDC_SOCKS_PROXY={{ lookup('tor_socks_proxy') }}
WORDPRESS_OIDC_SOCKS_SUFFIX={{ 'tor' | network_suffix }}
{% endif %}
