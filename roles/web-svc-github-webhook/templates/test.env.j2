API_TIMEOUT={{ GITHUB_WEBHOOK_API_TIMEOUT }}
DEFAULT_BRANCH=main
ENTITY={{ entity_name }}
EVENTS_SCRIPT={{ GITHUB_WEBHOOK_EVENTS_HOST }}
EVENTS_TARGET={{ GITHUB_WEBHOOK_EVENTS_TARGET }}
MANAGER_LOGS_VOLUME={{ lookup('volume', 'web-app-wazuh', 'manager_logs').docker_name if GITHUB_WEBHOOK_TEST_WAZUH | bool else '' }}
MAX_BYTES={{ GITHUB_WEBHOOK_MAX_BYTES }}
RECEIVER_HOST={{ lookup('tls', application_id, 'domain') }}
RECEIVER_IMAGE={{ GITHUB_WEBHOOK_IMAGE }}
RECEIVER_PATH={{ GITHUB_WEBHOOK_PATH }}
RECEIVER_PORT={{ GITHUB_WEBHOOK_PORT }}
RECEIVER_SCRIPT={{ GITHUB_WEBHOOK_RECEIVER_HOST }}
RECEIVER_TARGET={{ GITHUB_WEBHOOK_RECEIVER_TARGET }}
RECEIVER_URL=http://127.0.0.1:{{ lookup('config', application_id, 'services.' ~ entity_name ~ '.ports.local.http') }}
RETRIES=60
SETTINGS_DRIFT_RULE={{ GITHUB_WEBHOOK_SETTINGS_RULE_IDS.drift }}
SETTINGS_FAILED_RULE={{ GITHUB_WEBHOOK_SETTINGS_RULE_IDS.failed }}
SETTINGS_PRT_RULE={{ GITHUB_WEBHOOK_SETTINGS_RULE_IDS.pull_request_target }}
SETTINGS_SCRIPT={{ 'sys-ctl-hlth-github-settings' | get_service_script_path('py') }}
SETTINGS_TAG={{ lookup('wazuh_ruleset', scope='host').github_settings.program }}
SLEEP_SECONDS=5
WAZUH_MANAGER_LOCAL={{ GITHUB_WEBHOOK_TEST_WAZUH | bool | lower }}
WEBHOOK_SECRET={{ GITHUB_WEBHOOK_SECRET | dotenv_quote }}
