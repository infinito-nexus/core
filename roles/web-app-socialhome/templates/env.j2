{% include 'roles/sys-svc-container/templates/env.j2' %}

SH_CONFIG={{ SOCIALHOME_CONFIG_FILE | dotenv_quote }}

SH_LISTEN_PORT={{ SOCIALHOME_LISTEN_PORT }}

SH_INSTANCE_NAME={{ SOCIALHOME_INSTANCE_NAME | dotenv_quote }}

SH_SECURE_COOKIES=true

SH_MAX_STORAGE_BYTES={{ SOCIALHOME_MAX_STORAGE_BYTES }}

SH_APPS_CATALOG_URL=

{# Exception: upstream reads these by env PRESENCE, so an empty value beats the
   in-app default and would leave WebRTC with no STUN server at all. #}
{% if SOCIALHOME_COTURN_ENABLED | bool %}
SH_WEBRTC_STUN_URL={{ SOCIALHOME_STUN_URL | dotenv_quote }}

SH_WEBRTC_TURN_URL={{ SOCIALHOME_TURN_URL | dotenv_quote }}

SH_WEBRTC_TURN_SECRET={{ SOCIALHOME_COTURN_SECRET | dotenv_quote }}
{% endif %}

SH_ADMIN_USERNAME={{ SOCIALHOME_ADMIN_USERNAME | dotenv_quote }}

SH_ADMIN_PASSWORD={{ SOCIALHOME_ADMIN_PASSWORD | dotenv_quote }}
