{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}

  {% set service_name = 'peertube' %}
  {{ service_name }}:
    {{ lookup('container_image', application_id, 'peertube') }}
    {{ lookup('compose_only', 'container_name', PEERTUBE_CONTAINER) }}
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_extra_hosts') | indent(4) }}
    {% if PEERTUBE_LIVE_ENABLED | bool %}
    {{ lookup('container_ports',
              ['peertube', 'http', DOCKER_BIND_HOST],
              ['peertube', 'rtmp']) | indent(4) }}
    {% else %}
    {{ lookup('container_ports', ['peertube', 'http', DOCKER_BIND_HOST]) | indent(4) }}
    {% endif %}
    {{ lookup('container_volumes', service_name) | indent(4) }}
    environment:
      - NODE_OPTIONS=--max-old-space-size={{ PEERTUBE_MAX_OLD_SPACE_SIZE }}
      - PEERTUBE_TRANSCODING_CONCURRENCY={{ PEERTUBE_TRANSCODING_CONCURRENCY }}
    shm_size: "512m"
    tmpfs:
      - /tmp:size=1g,exec
    ulimits:
      nofile:
        soft: 131072
        hard: 131072
      nproc:  8192
    {{ lookup('container_depends_on', application_id) | indent(4) }}
    {{ lookup('container_networks') | indent(4) }}
    {{ lookup('container_healthcheck', service_name) | indent(4) }}
{{ lookup('compose_volumes') }}
{{ lookup('compose_networks') }}
