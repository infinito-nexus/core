{% include 'roles/sys-svc-container/templates/env.j2' %}

OPENPOST_PORT={{ container_port }}
OPENPOST_EDITION=selfhost
OPENPOST_APP_URL={{ OPENPOST_URL }}
OPENPOST_PUBLIC_URL={{ OPENPOST_URL }}
OPENPOST_TRUSTED_PROXY_CIDRS={{ OPENPOST_TRUSTED_PROXY_CIDRS | join(',') }}
OPENPOST_DISABLE_REGISTRATIONS={{ (not (OPENPOST_OIDC_ENABLED | bool)) | string | lower }}
OPENPOST_OAUTH_DYNAMIC_REGISTRATION_ENABLED=false

OPENPOST_DATABASE_DRIVER=postgres
OPENPOST_DATABASE_URL={{ (lookup('database', application_id, 'url_full') ~ '?sslmode=disable') | dotenv_quote }}

OPENPOST_JWT_SECRET={{ OPENPOST_JWT_SECRET | dotenv_quote }}
OPENPOST_ENCRYPTION_KEY={{ OPENPOST_ENCRYPTION_KEY | dotenv_quote }}
OPENPOST_MEDIA_SIGNING_KEY={{ OPENPOST_MEDIA_SIGNING_KEY | dotenv_quote }}

{% if OPENPOST_OBJSTORE_ENABLED | bool %}
OPENPOST_STORAGE_DRIVER=s3
OPENPOST_S3_ENDPOINT={{ lookup('objstore', application_id, 'public_url') | regex_replace('/[^/]+/?$', '') }}
OPENPOST_S3_REGION={{ lookup('objstore', application_id, 'region') }}
OPENPOST_S3_BUCKET={{ lookup('objstore', application_id, 'bucket') }}
OPENPOST_S3_ACCESS_KEY_ID={{ lookup('objstore', application_id, 'access_key') }}
OPENPOST_S3_SECRET_ACCESS_KEY={{ lookup('objstore', application_id, 'secret_key') | dotenv_quote }}
OPENPOST_S3_PUBLIC_BASE_URL={{ lookup('objstore', application_id, 'public_url') }}
OPENPOST_S3_FORCE_PATH_STYLE=true
{% else %}
OPENPOST_STORAGE_DRIVER=local
OPENPOST_MEDIA_PATH={{ lookup('volume', application_id, 'media').target }}
OPENPOST_MEDIA_URL=/media
{% endif %}

OPENPOST_DIAGNOSTICS_ENABLED=false
OPENPOST_UPDATE_CHECK_ENABLED=false
OPENPOST_TELEMETRY_ENABLED=false
OPENPOST_FEEDBACK_ENABLED=false
OPENPOST_PUBLIC_PROFILES_ENABLED=false
OPENPOST_STOCK_MEDIA_ENABLED=false
OPENPOST_WORKFLOWS_AI_ENABLED=false

{% if OPENPOST_OIDC_ENABLED | bool %}
OPENPOST_OIDC_ISSUER={{ OIDC.CLIENT.ISSUER_URL }}
OPENPOST_OIDC_CLIENT_ID={{ OIDC.CLIENT.ID }}
OPENPOST_OIDC_CLIENT_SECRET={{ OIDC.CLIENT.SECRET | dotenv_quote }}
OPENPOST_OIDC_NAME={{ OIDC.BUTTON_TEXT | dotenv_quote }}
OPENPOST_OIDC_SCOPES=openid,profile,email
OPENPOST_OIDC_JIT_ENABLED=true
OPENPOST_OIDC_BOOTSTRAP_ALLOWLIST={{ OPENPOST_BOOTSTRAP_ADMINS | join(',') }}
{% if OPENPOST_OIDC_SOCKS_PROXY | length > 0 %}
http_proxy={{ OPENPOST_OIDC_SOCKS_PROXY }}
{% endif %}
{% endif %}

{% if OPENPOST_SMTP_ENABLED | bool %}
{% set email = lookup('email', application_id) %}
OPENPOST_EMAIL_PROVIDER=smtp
OPENPOST_EMAIL_FROM={{ email['from'] }}
OPENPOST_SMTP_HOST={{ email.host }}
OPENPOST_SMTP_PORT={{ email.port }}
OPENPOST_SMTP_USERNAME={{ email.username }}
OPENPOST_SMTP_PASSWORD={{ email.password | dotenv_quote }}
OPENPOST_SMTP_TLS_MODE={{ 'tls' if email.tls | bool else 'starttls' }}
{% endif %}

{% for _platform in ['mastodon', 'pixelfed'] %}
{% set _servers = [] %}
{% for _instance in OPENPOST_PINNED_INSTANCES if _instance.platform == _platform and _instance.url in openpost_fediverse_apps %}
{% set _ = _servers.append({'name': _instance.name, 'instance_url': _instance.url, 'client_id': openpost_fediverse_apps[_instance.url].client_id, 'client_secret': openpost_fediverse_apps[_instance.url].client_secret}) %}
{% endfor %}
{% if _servers %}
{{ _platform | upper }}_SERVERS={{ _servers | to_json(separators=[',', ':']) | dotenv_quote }}
{% endif %}
{% endfor %}

{% for _provider in ['x', 'threads', 'linkedin'] if _provider in OPENPOST_PROVIDER_CREDENTIALS %}
{{ _provider | upper }}_CLIENT_ID={{ OPENPOST_PROVIDER_CREDENTIALS[_provider].client_id | dotenv_quote }}
{{ _provider | upper }}_CLIENT_SECRET={{ OPENPOST_PROVIDER_CREDENTIALS[_provider].client_secret | dotenv_quote }}
{% endfor %}
{% if OPENPOST_PROVIDER_APPS | length > 0 %}
OPENPOST_PROVIDER_APPS={{ OPENPOST_PROVIDER_APPS | to_json(separators=[',', ':']) | dotenv_quote }}
{% endif %}
{% if OPENPOST_SIMULATOR_ENABLED | bool or OPENPOST_ROOT_CA_TRUSTED | bool %}
SSL_CERT_DIR={{ lookup('volume', application_id, 'root_ca').target | dirname }}:/etc/ssl/certs
{% endif %}
