{% set _tokens = {} %}
{% for _route in OPENPOST_CROSSPOSTER_ROUTES %}
{% set _ = _tokens.update({_route.name: _route.source.token | default(openpost_crossposter_sources[_route.name] | default('', true), true)}) %}
{% endfor %}
{{ {
  'openpost_token': openpost_crossposter_token,
  'database_dsn': lookup('database', application_id, 'url_full'),
  'mail_password': lookup('email', application_id).password if OPENPOST_EMAIL_ENABLED | bool else '',
  'routes': _tokens
} | to_json }}
