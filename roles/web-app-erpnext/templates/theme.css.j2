  --gray-600: var(--design-neutral-600);
  --gray-700: var(--design-neutral-700);
  --gray-800: var(--design-neutral-800);
  --gray-900: var(--design-neutral-900);

  --neutral: var(--design-surface-2);
  --invert-neutral: var(--design-text);

  --bg-color: var(--design-surface-2);
  --fg-color: var(--design-surface-2);
  --card-bg: var(--design-surface-2);
  --modal-bg: var(--design-surface-2);
  --popover-bg: var(--design-surface-2);
  --navbar-bg: var(--design-surface-2);
  --subtle-accent: var(--design-surface-1);
  --subtle-fg: var(--design-surface-3);
