  --fg-hover-color: var(--design-surface-hover);
  --control-bg: var(--design-surface-3);
  --control-bg-on-gray: var(--design-surface-hover);
  --disabled-control-bg: var(--design-surface-1);
  --input-disabled-bg: var(--design-surface-1);
  --awesomebar-focus-bg: var(--design-surface-2);
  --awesomplete-hover-bg: var(--design-surface-hover);
  --placeholder-color: var(--design-surface-3);
  --skeleton-bg: var(--design-surface-3);

  --surface-white: var(--design-surface-2);
