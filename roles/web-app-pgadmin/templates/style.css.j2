{% set design = lookup('design', application_id) %}
{% set scope = 'html:not([data-pgadmin-theme="high_contrast"]) body' %}
{{ scope }} {
  background-color: var(--design-surface-1);
  color: var(--design-text);
}

{{ scope }} .dock-layout .dock-content,
{{ scope }} .dock-layout .dock-bar,
{{ scope }} .dock-layout .dock-panel .dock-tabpane {
  background-color: var(--design-surface-1);
  color: var(--design-text);
}

{{ scope }} .dock-layout .dock-tab {
  color: var(--design-text-muted);
}

{{ scope }} .dock-layout .dock-tab.dock-tab-active {
  color: var(--design-link);
}

{{ scope }} .dock-layout .dock-ink-bar {
  background-color: var(--design-primary);
}

{{ scope }} .dock-layout .dock-divider::before {
  background-color: var(--design-border);
}

{{ scope }} .file-tree {
  color: var(--design-text) !important;
  background-color: var(--design-surface-1) !important;
}

{{ scope }} .file-entry:hover,
{{ scope }} .file-entry.pseudo-active {
  color: var(--design-text) !important;
  background-color: var(--design-surface-hover) !important;
}

{{ scope }} .file-entry.active,
{{ scope }} .file-entry.prompt {
  color: var(--design-text) !important;
  background-color: var(--design-surface-active) !important;
}

{{ scope }} [data-test="app-menu-bar"] {
  --design-focus: var(--design-on-frame);
  background-color: var(--design-frame);
  color: var(--design-on-frame);
}

{{ scope }} [data-test="app-menu-bar"] .MuiButton-root {
  background-color: var(--design-frame);
  color: var(--design-on-frame);
  border-color: var(--design-frame);
}

{{ scope }} [data-test="app-menu-bar"] .MuiButton-root:hover {
  background-color: var(--design-frame-hover);
}

{{ scope }} [data-test="app-menu-bar"] .MuiButton-root[aria-expanded="true"] {
  background-color: var(--design-frame-active);
}

{{ scope }} .szh-menu {
  --design-focus: var(--design-link);
  background-color: var(--design-surface-2);
  color: var(--design-text);
  border-color: var(--design-border);
}

{{ scope }} .MuiPaper-root,
{{ scope }} .MuiDialog-paper {
  background-color: var(--design-surface-2);
  color: var(--design-text);
}

{{ scope }} .MuiTabs-root,
{{ scope }} .MuiAccordionSummary-root,
{{ scope }} .MuiCardHeader-root {
  background-color: var(--design-surface-2);
  border-color: var(--design-border);
}

{{ scope }} .MuiTab-root.Mui-selected {
  color: var(--design-link);
}

{{ scope }} .MuiTabs-indicator {
  background-color: var(--design-primary);
}

{{ scope }} .MuiInputBase-root,
{{ scope }} .MuiInputBase-input {
  background-color: var(--design-surface-2);
  color: var(--design-text);
}

{{ scope }} .MuiOutlinedInput-notchedOutline {
  border-color: var(--design-border-strong);
}

{{ scope }} .MuiInputBase-root.Mui-disabled,
{{ scope }} .MuiInputBase-input[readonly] {
  background-color: var(--design-surface-3);
  color: var(--design-text-muted);
}

{{ scope }} .MuiFormLabel-root {
  color: var(--design-text);
}

{{ scope }} .MuiFormHelperText-root,
{{ scope }} .text-muted {
  color: var(--design-text-muted);
}

{{ scope }} .MuiButton-containedPrimary {
  background-color: var(--design-primary);
  color: var(--design-on-primary);
  border-color: var(--design-primary);
}

{{ scope }} .MuiButton-containedPrimary:hover {
  background-color: var(--design-primary-hover);
  border-color: var(--design-primary-hover);
}

{{ scope }} .MuiButton-outlined {
  background-color: var(--design-surface-2);
  color: var(--design-text);
  border-color: var(--design-border-strong);
}

{{ scope }} .MuiButton-outlined:hover {
  background-color: var(--design-surface-hover);
}

{{ scope }} .MuiListItemButton-root.Mui-selected,
{{ scope }} .MuiToggleButton-root.Mui-selected {
  background-color: var(--design-surface-active);
  color: var(--design-text);
}

{{ scope }} .MuiTooltip-tooltip {
  background-color: var(--design-text);
  color: var(--design-surface-1);
}

{{ scope }} a {
  color: var(--design-link);
}

{{ scope }} .cm-editor {
  background-color: var(--design-surface-1);
}

{{ scope }} .cm-editor .cm-gutters {
  background-color: var(--design-surface-3);
  color: var(--design-text-muted);
  border-color: var(--design-border);
}

{{ scope }} .cm-editor .cm-activeLine {
  background-color: var(--design-surface-hover);
}

{{ scope }} [data-test="app-menu-bar"] .MuiButton-root:focus-visible,
{{ scope }} [data-test="app-menu-bar"] .MuiButton-root.Mui-focusVisible {
  outline: 2px solid var(--design-focus);
  outline-offset: -2px;
}

html body #root > div:has(> div > .BasePage-pageContent) {
  background-color: var(--design-frame);
  color: var(--design-on-frame);
}

html body #root .BasePage-pageContent {
  background-color: var(--design-frame-active);
  color: var(--design-on-frame);
}

html body #root .BasePage-pageContent a {
  color: var(--design-on-frame);
}

html body #root .BasePage-pageContent .MuiButton-root.MuiButton-outlinedPrimary {
  background-color: var(--design-primary);
  border-color: var(--design-primary);
  color: var(--design-on-primary);
}

html body #root .BasePage-pageContent .MuiButton-root.MuiButton-outlinedPrimary:hover {
  background-color: var(--design-primary-hover);
}
{% if design.logo is string %}

html body #root [data-test="app-menu-bar"] .AppMenuBar-logo {
  background: url("{{ design.urls.logo.svg }}") center / contain no-repeat;
}

html body #root .BasePage-logo {
  background: url("{{ design.urls['login-logo'].svg }}") center / contain no-repeat;
}
{% endif %}
