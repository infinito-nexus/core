{% include 'roles/sys-svc-container/templates/env.j2' %}

PGADMIN_DISABLE_POSTFIX=True

PGADMIN_DEFAULT_EMAIL={{ PGADMIN_ADMIN_EMAIL }}

PGADMIN_CONFIG_ALLOW_SPECIAL_EMAIL_DOMAINS=['{{ PGADMIN_ADMIN_EMAIL_TLD }}']

PGADMIN_DEFAULT_PASSWORD={{ PGADMIN_ADMIN_PASSWORD | dotenv_quote }}

PGADMIN_CONFIG_AUTHENTICATION_SOURCES={{ PGADMIN_AUTHENTICATION_SOURCES | to_json }}

PGADMIN_CONFIG_MFA_ENABLED={{ PGADMIN_LOGIN_2FA | string | capitalize }}

PGADMIN_CONFIG_MFA_FORCE_REGISTRATION={{ PGADMIN_LOGIN_2FA_ENFORCED | bool | string | capitalize }}

{% if PGADMIN_OIDC_ENABLED | bool %}
PGADMIN_CONFIG_OAUTH2_AUTO_CREATE_USER=True

PGADMIN_CONFIG_OAUTH2_CONFIG={{ PGADMIN_OAUTH2_CONFIG | to_json | dotenv_quote }}
{% endif %}

{% if PGADMIN_SERVER_MODE | bool %}
PGADMIN_SERVER_JSON_FILE={{ pgadmin_docker_server_file }}

PGADMIN_CONFIG_SERVER_MODE=False

PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED={{ PGADMIN_MASTER_PASSWORD_REQUIRED | capitalize | dotenv_quote }}
{% endif %}

{% set email = lookup('email', application_id) %}
{% if email.enabled | bool %}
PGADMIN_CONFIG_MAIL_SERVER={{ email.host | tojson | dotenv_quote }}
PGADMIN_CONFIG_MAIL_PORT={{ email.port }}
PGADMIN_CONFIG_MAIL_USE_SSL={{ email.tls | string | capitalize | dotenv_quote }}
PGADMIN_CONFIG_MAIL_USE_TLS={{ email.start_tls | string | capitalize | dotenv_quote }}
PGADMIN_CONFIG_MAIL_USERNAME={{ email.username | tojson | dotenv_quote }}
PGADMIN_CONFIG_MAIL_PASSWORD={{ email.password | tojson | dotenv_quote }}
PGADMIN_CONFIG_MAIL_DEFAULT_SENDER={{ email['from'] | tojson | dotenv_quote }}
{% endif %}

{% set design = lookup('design', application_id) %}
{% if lookup('config', application_id, 'services.design.enabled') | bool and design.title is string %}
PGADMIN_CONFIG_APP_NAME={{ design.title | tojson | dotenv_quote }}
{% endif %}
