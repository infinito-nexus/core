{% if lookup('tls', domain, 'enabled') | bool %}
listen {{ lookup('tls', domain, 'ports.web') }} ssl;
listen [::]:{{ lookup('tls', domain, 'ports.web') }} ssl;
http2 on;

ssl_protocols TLSv1.2 TLSv1.3;
ssl_ecdh_curve X25519:P-256;
ssl_prefer_server_ciphers on;

ssl_session_timeout 1d;
ssl_session_cache shared:SSL:50m;
ssl_session_tickets on;

add_header Strict-Transport-Security "{{ (lookup('applications') | security_headers(application_id, WEBSERVER_SECURITY_HEADERS)).hsts }}" always;

{% include 'roles/sys-front-tls/templates/ssl_credentials.j2' %}

{% else %}
listen {{ lookup('tls', domain, 'ports.web') }};
listen [::]:{{ lookup('tls', domain, 'ports.web') }};
proxy_cookie_flags ~ nosecure;
{% endif %}
