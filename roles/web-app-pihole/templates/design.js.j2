{% set design = lookup('design', application_id) %}
(function () {
  var root = document.documentElement;
  var modes = {
    "default-light": "light",
    "high-contrast": "light",
    "default-dark": "dark",
    "default-darker": "dark",
    "high-contrast-dark": "dark",
    "lcars": "dark"
  };
  function mirror() {
    var links = document.querySelectorAll("link[rel='stylesheet'][href*='style/themes/']");
    var theme = null;
    if (links.length === 1) {
      var name = (links[0].getAttribute("href") || "").split("style/themes/")[1].split(".css")[0];
      theme = Object.prototype.hasOwnProperty.call(modes, name) ? modes[name] : null;
    }
    if (theme) {
      root.setAttribute("data-design-theme", theme);
    } else {
      root.removeAttribute("data-design-theme");
    }
  }
{% if design.title is string or design.logo is string %}
  function brand() {
{% if design.title is string %}
    if (document.title !== {{ design.title | to_json }}) {
      document.title = {{ design.title | to_json }};
    }
    var marks = document.querySelectorAll(".main-header .logo .logo-lg, .login-logo .logo-lg");
    for (var mark = 0; mark < marks.length; mark += 1) {
      if (marks[mark].textContent !== {{ design.title | to_json }}) {
        marks[mark].textContent = {{ design.title | to_json }};
      }
    }
{% endif %}
{% if design.logo is string %}
    var icons = document.querySelectorAll("link[rel~='icon']");
    for (var icon = 0; icon < icons.length; icon += 1) {
      if (icons[icon].getAttribute("href") !== {{ design.urls.favicon_ico | to_json }}) {
        icons[icon].removeAttribute("sizes");
        icons[icon].setAttribute("type", "image/x-icon");
        icons[icon].setAttribute("href", {{ design.urls.favicon_ico | to_json }});
      }
    }
    var touch = document.querySelector("link[rel='apple-touch-icon']");
    if (touch && touch.getAttribute("href") !== {{ design.urls['apple-touch-icon'].png | to_json }}) {
      touch.setAttribute("href", {{ design.urls['apple-touch-icon'].png | to_json }});
    }
{% endif %}
  }
{% endif %}
  function apply() {
    mirror();
{% if design.title is string or design.logo is string %}
    brand();
{% endif %}
  }
  apply();
  document.addEventListener("DOMContentLoaded", apply);
})();
