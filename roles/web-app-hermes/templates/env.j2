{% include 'roles/sys-svc-container/templates/env.j2' %}

HERMES_SKIP_CONFIG_MIGRATION=true
HERMES_CONFIG_SEED={{ lookup('volume', application_id, 'hermes_config').target | dotenv_quote }}
HERMES_CONFIG_TARGET={{ [ lookup('volume', application_id, 'hermes_data').target, 'config.yaml' ] | path_join | dotenv_quote }}

API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT={{ HERMES_PORT_INTERNAL }}
API_SERVER_KEY={{ HERMES_API_SERVER_KEY | dotenv_quote }}
{% if HERMES_WEBUI_ENABLED | bool %}

HERMES_DASHBOARD=1
HERMES_DASHBOARD_PORT={{ HERMES_WEBUI_PORT_INTERNAL }}
HERMES_DASHBOARD_PUBLIC_URL={{ HERMES_URL | dotenv_quote }}
{% if HERMES_SSO_ENABLED | bool %}
HERMES_DASHBOARD_OIDC_ISSUER={{ OIDC.CLIENT.ISSUER_URL | dotenv_quote }}
HERMES_DASHBOARD_OIDC_CLIENT_ID={{ OIDC.CLIENT.ID | dotenv_quote }}
{% else %}
HERMES_DASHBOARD_BASIC_AUTH_USERNAME={{ lookup('users', 'platform_administrator').username | dotenv_quote }}
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD={{ HERMES_WEBUI_PASSWORD | dotenv_quote }}
{% endif %}
{% endif %}
{% if HERMES_LITELLM_ENABLED | bool %}
OLLAMA_API_KEY={{ HERMES_LITELLM_API_KEY | dotenv_quote }}
OLLAMA_BASE_URL={{ LITELLM_BASE_LOCAL_URL }}/v1
{% endif %}
{% for server in HERMES_MCP_SERVERS %}
{{ server.id | upper | replace('-', '_') }}_MCP_TOKEN={{ server.token | dotenv_quote }}
{% endfor %}
