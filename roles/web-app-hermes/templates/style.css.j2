{% if lookup('config', application_id, 'services.webui.enabled') | bool %}
{% set design = lookup('design', application_id) %}
:root:has(.provider-list) {
  --background: var(--design-surface-1);
  --background-base: var(--design-surface-1);
  --midground: var(--design-link);
  --foreground: var(--design-text);
  --hairline: var(--design-border);
  --hairline-strong: var(--design-border-strong);
}
:root:has(.provider-list) body {
  background-image: none;
}
:root:has(.provider-list) :is(.card, .field-input) {
  background: var(--design-surface-2);
}
:root:has(.provider-list) .card {
  box-shadow: var(--design-shadow-3);
}
:root:has(.provider-list) :is(.subtitle, .form-title, .field-label, footer) {
  color: var(--design-text-muted);
}
:root:has(.provider-list) .form-error {
  color: var(--design-danger);
}
:root:has(.provider-list) .provider-btn {
  background: var(--design-primary);
  color: var(--design-on-primary);
  box-shadow: none;
}
:root:has(.provider-list) .provider-btn:hover {
  background: var(--design-primary-hover);
  filter: none;
}
:root:has(.provider-list) .provider-btn:active {
  background: var(--design-primary-active);
  filter: none;
}
{% if design.logo is string %}
:root:has(.provider-list) .brand {
  height: 3rem;
  font-size: 0;
  background: url("{{ design.urls.brand.svg }}") center / contain no-repeat;
}
:root:has(.provider-list) .brand .dot {
  display: none;
}
:root:not([data-design-theme]) #app-sidebar > div:first-child > div:first-child > span:last-child,
:root:not([data-design-theme]) #root header[class~="lg:hidden"] > span:last-child {
  display: block;
  width: 10rem;
  height: 2rem;
  font-size: 0;
  background: url("{{ design.urls.brand.svg }}") left center / contain no-repeat;
}
{% endif %}
{% endif %}
