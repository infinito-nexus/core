{% include 'roles/sys-svc-container/templates/env.j2' %}

PORT={{ container_port }}
ORGANIZATION={{ ORGANIZATION | dotenv_quote }}
{% set simpleicons_docs = (lookup('tls', 'web-app-docs', 'url.base') ~ 'latest/' ~ (application_id | rel_role_path_by_application_id) ~ '/README.html') if 'web-app-docs' in group_names else '' %}
{% set simpleicons_docs_urls = namespace(by_host={}) %}
{% for base in (lookup('network_urls', lookup('tls', application_id, 'url.base')) if simpleicons_docs else []) %}
{% for url in lookup('network_urls', simpleicons_docs) if (url | urlsplit('hostname') | network_of) == (base | urlsplit('hostname') | network_of) %}
{% set simpleicons_docs_urls.by_host = simpleicons_docs_urls.by_host | combine({base | urlsplit('hostname'): url}) %}
{% endfor %}
{% endfor %}
DOCS_URLS={{ simpleicons_docs_urls.by_host | to_json | dotenv_quote }}
