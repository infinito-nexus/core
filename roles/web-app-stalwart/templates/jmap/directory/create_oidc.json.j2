{
  "using": ["urn:ietf:params:jmap:core", "urn:stalwart:jmap"],
  "methodCalls": [["x:Directory/set", {"create": {"kc": {
    "@type": "Oidc",
    "description": {{ ('Keycloak SSO (' ~ OIDC.CLIENT.REALM ~ ')') | to_json }},
    "issuerUrl": {{ OIDC.CLIENT.ISSUER_URL | to_json }},
    "claimUsername": {{ OIDC.ATTRIBUTES.USERNAME | to_json }},
    "usernameDomain": {{ STALWART_DOMAIN | to_json }},
    "claimName": "name",
    "skipAudienceValidation": {{ STALWART_OIDC_TOKEN_VALIDATION.skipAudienceValidation | to_json }},
    "unscopedTokens": {{ STALWART_OIDC_TOKEN_VALIDATION.unscopedTokens | to_json }}
  }}}, "c0"]]
}
