@media screen and (min-width: 481px) {
  body[class*="task-"] #layout-menu,
  body[class*="task-"] #taskmenu .special-buttons {
    background-color: var(--design-frame);
  }
  body[class*="task-"] #layout-menu {
    --design-focus: var(--design-on-frame);
    border-right-color: var(--design-frame-active);
  }
  body[class*="task-"] #layout-menu .popover-header {
    background-color: var(--design-frame) !important;
  }
  body[class*="task-"] #layout-menu .special-buttons a:not(:focus) {
    background-color: var(--design-frame);
  }
  body[class*="task-"] #taskmenu a,
  body[class*="task-"] #taskmenu .action-buttons a,
  body[class*="task-"] #taskmenu .action-buttons a:hover {
    color: var(--design-on-frame);
  }
  body[class*="task-"] #taskmenu a.logout,
  body[class*="task-"] #taskmenu a.logout:hover {
    color: var(--design-on-frame) !important;
  }
  body[class*="task-"] #taskmenu a.selected {
    background-color: var(--design-frame-active);
  }
  body[class*="task-"] #taskmenu a:hover,
  body[class*="task-"] #taskmenu a:focus,
  body[class*="task-"] #taskmenu .action-buttons a:hover {
    background-color: var(--design-frame-hover);
  }
  body[class*="task-"] #taskmenu a:focus-visible {
    outline: 2px solid var(--design-on-frame);
    outline-offset: -2px;
  }
}
@media screen and (max-width: 480px) {
  body[class*="task-"] #layout-menu,
  html.layout-phone body[class*="task-"] #layout-menu {
    background-color: var(--design-surface-2);
  }
  body[class*="task-"] #taskmenu a {
    color: var(--design-text);
    border-bottom-color: var(--design-border) !important;
  }
  body[class*="task-"] #taskmenu .action-buttons a {
    color: var(--design-link);
  }
  body[class*="task-"] #layout-menu .special-buttons a:not(:focus) {
    background-color: var(--design-surface-2);
  }
  body[class*="task-"] #taskmenu a:hover {
    background-color: var(--design-surface-hover);
  }
}
html.layout-phone body[class*="task-"] .popover-header,
html.layout-small body[class*="task-"] .popover-header {
  --design-focus: var(--design-on-frame);
  background-color: var(--design-frame);
  border-bottom-color: var(--design-frame-active);
  color: var(--design-on-frame);
}
html.layout-phone body[class*="task-"] .popover-header a,
html.layout-small body[class*="task-"] .popover-header a {
  color: var(--design-on-frame);
}
body[class*="task-"] #rcmdraglayer {
  background-color: var(--design-frame);
  border-color: var(--design-frame-active);
  box-shadow: var(--design-shadow-2);
  color: var(--design-on-frame);
}
body[class*="task-"] #messagestack div {
  background-color: var(--design-frame);
  color: var(--design-on-frame);
}
body[class*="task-"] #messagestack div i.icon:before {
  color: inherit;
}
body[class*="task-"] #messagestack .alert-info {
  background-color: var(--design-info);
  color: var(--design-on-info);
}
body[class*="task-"] #messagestack .alert-success {
  background-color: var(--design-success);
  color: var(--design-on-success);
}
body[class*="task-"] #messagestack .alert-warning {
  background-color: var(--design-warning);
  color: var(--design-on-warning);
}
body[class*="task-"] #messagestack .alert-danger {
  background-color: var(--design-danger);
  color: var(--design-on-danger);
}
body[class*="task-"] #messagestack .loading {
  background-color: var(--design-frame-hover);
  color: var(--design-on-frame);
}
body[class*="task-"] .ui.alert {
  background-color: var(--design-info-subtle);
  color: var(--design-text);
}
body[class*="task-"] .ui.alert > i.icon,
body[class*="task-"] .ui.alert.loading {
  color: var(--design-text-muted);
}
body[class*="task-"] .ui.alert.alert-success > i.icon:before {
  color: var(--design-success);
}
body[class*="task-"] .ui.alert.alert-warning > i.icon:before {
  color: var(--design-warning);
}
body[class*="task-"] .ui.alert.alert-danger > i.icon:before {
  color: var(--design-danger);
}
body[class*="task-"] .ui.alert a:not(.btn) {
  color: var(--design-link);
}
body[class*="task-"] .ui.alert.boxerror {
  background-color: var(--design-danger-subtle);
}
body[class*="task-"] .ui.alert.boxinformation {
  background-color: var(--design-info-subtle);
}
body[class*="task-"] .ui.alert.boxconfirmation {
  background-color: var(--design-success-subtle);
}
body[class*="task-"] .ui.alert.boxwarning {
  background-color: var(--design-warning-subtle);
}
