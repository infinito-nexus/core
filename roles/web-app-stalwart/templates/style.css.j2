{% set design = lookup('design', application_id) %}
:root,
.dark {
  --background: var(--design-surface-2);
  --foreground: var(--design-text);
  --card: var(--design-surface-2);
  --card-foreground: var(--design-text);
  --popover: var(--design-surface-2);
  --popover-foreground: var(--design-text);
  --content-background: var(--design-surface-1);
  --primary: var(--design-primary);
  --primary-foreground: var(--design-on-primary);
  --secondary: var(--design-surface-3);
  --secondary-foreground: var(--design-text);
  --muted: var(--design-surface-3);
  --muted-foreground: var(--design-text-muted);
  --accent: var(--design-surface-active);
  --accent-foreground: var(--design-text);
  --destructive: var(--design-danger);
  --destructive-foreground: var(--design-on-danger);
  --border: var(--design-border);
  --input: var(--design-border-strong);
  --ring: var(--design-link);
  --color-red-50: var(--design-danger-subtle);
  --color-red-300: var(--design-danger-border);
  --color-red-400: var(--design-danger);
  --color-red-500: var(--design-danger);
  --color-red-600: var(--design-danger);
  --color-amber-500: var(--design-warning);
  --color-yellow-500: var(--design-warning);
  --color-green-500: var(--design-success);
  --color-green-600: var(--design-success);
  --color-emerald-400: var(--design-success);
  --color-emerald-500: var(--design-success);
  --color-blue-500: var(--design-info);
}
.text-primary,
.hover\:text-primary\/80:hover {
  color: var(--design-link);
}
.text-foreground\/60,
.text-muted-foreground\/50,
.text-muted-foreground\/60 {
  color: var(--design-text-muted);
}
.hover\:bg-primary\/80:hover,
.hover\:bg-primary\/90:hover {
  background-color: var(--design-primary-hover);
}
.hover\:bg-destructive\/80:hover,
.hover\:bg-destructive\/90:hover {
  background-color: var(--design-danger-hover);
}
.hover\:bg-accent:hover,
.hover\:bg-accent\/50:hover,
.hover\:bg-muted\/50:hover,
.hover\:bg-secondary\/80:hover,
.focus\:bg-accent:focus {
  background-color: var(--design-surface-hover);
}
{% if design.logo is string %}
svg[viewBox="95 84 500 90"] {
  background: url("{{ design.urls.brand.svg if design.title is string else design.urls.icon.svg }}") left center / contain no-repeat;
}
svg[viewBox="95 84 500 90"] > * {
  visibility: hidden;
}
@media (min-width: 768px) {
  svg[viewBox="95 84 500 90"] {
    width: 13rem;
    background-size: auto 125%;
  }
}
{% endif %}
