IMAGE={{ STALWART_MIGRATE_IMAGE | quote }}
TARGET_VERSION={{ lookup('config', application_id, 'services.stalwart.version') | quote }}
NETWORK={{ lookup('database', application_id, 'network') | quote }}
PG_ADMIN={{ ('postgres' if STALWART_DATABASE_SHARED | bool else lookup('database', application_id, 'username')) | quote }}
PG_ADDRESS={{ lookup('database', application_id, 'address') }}
DB={{ lookup('database', application_id, 'name') | quote }}
DB_OWNER={{ lookup('database', application_id, 'username') | quote }}
DB_V1={{ STALWART_MIGRATE_TARGET_DATABASE | quote }}
DB_V016={{ STALWART_MIGRATE_RETIRED_DATABASE | quote }}
LAYOUT_SQL={{ lookup('file', 'sql/store/layout.sql') | replace('\n', ' ') | quote }}
SOURCE_DIR={{ STALWART_CONFIG_DIR | quote }}
TARGET_DIR={{ STALWART_MIGRATE_TARGET_CONFIG | dirname | quote }}
STATE_DIR={{ [STALWART_MIGRATE_DIR, 'state'] | path_join | quote }}
BACKUP_FILE={{ [STALWART_MIGRATE_DIR, 'backup', lookup('database', application_id, 'name') ~ '-v016.dump'] | path_join | quote }}
MARKER={{ STALWART_STORE_MARKER_FILE | quote }}
DEPLOYMENT_MODE={{ DEPLOYMENT_MODE | quote }}
STALWART_CONTAINER={{ STALWART_CONTAINER | quote }}
STACK_DIR={{ lookup('container', application_id, 'directories.instance') | quote }}
COMPOSE_SERVICE=stalwart
STALWART_ADDRESS={{ STALWART_CONTAINER_ADDRESS }}
{% if IS_SWARM_MODE %}
STALWART_SERVICE={{ lookup('container_service', application_id, 'stalwart') | quote }}
{% endif %}
