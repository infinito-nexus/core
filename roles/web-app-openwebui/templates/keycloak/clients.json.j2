{% set openwebui_kc_origin = lookup('tls', 'web-app-openwebui', 'url.origin') %}
{% set openwebui_kc_origins = lookup('network_urls', openwebui_kc_origin) %}
{% set openwebui_kc_redirects = openwebui_kc_origins | map('regex_replace', '$', '/*') | list %}
{
  "clientId": "{{ lookup('config', 'web-app-openwebui', 'services.sso.oidc.clients.web') }}",
  "name": "Open WebUI",
  "description": "Public Open WebUI client that signs in with PKCE and receives OIDC back-channel logout tokens.",
  "enabled": true,
  "surrogateAuthRequired": false,
  "alwaysDisplayInConsole": false,
  "clientAuthenticatorType": "client-secret",
  "redirectUris": {{ openwebui_kc_redirects | to_json }},
  "webOrigins": {{ openwebui_kc_origins | to_json }},
  "notBefore": 0,
  "bearerOnly": false,
  "consentRequired": false,
  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "publicClient": true,
  "frontchannelLogout": false,
  "protocol": "openid-connect",
  "attributes": {
    "pkce.code.challenge.method": "S256",
    "post.logout.redirect.uris": "{{ openwebui_kc_redirects | join('##') }}",
    "backchannel.logout.url": "{{ openwebui_kc_origin ~ lookup('config', 'web-app-openwebui', 'services.sso.oidc.backchannel_logout_path') }}",
    "backchannel.logout.session.required": "true",
    "backchannel.logout.revoke.offline.tokens": "false",
    "oauth2.device.authorization.grant.enabled": "false",
    "oidc.ciba.grant.enabled": "false",
    "display.on.consent.screen": "false"
  },
  "authenticationFlowBindingOverrides": {},
  "fullScopeAllowed": true,
  "nodeReRegistrationTimeout": -1,
  "defaultClientScopes": [
    "web-origins",
    "acr",
    "roles",
    "profile",
    "basic",
    "email",
    "openid",
    "{{ KEYCLOAK_RBAC_GROUP_CLAIM }}"
  ],
  "optionalClientScopes": [
    "address",
    "phone",
    "organization",
    "offline_access",
    "microprofile-jwt"
  ]
}
