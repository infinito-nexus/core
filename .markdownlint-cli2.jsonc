{
  "config": {
    "default": true,
    "MD004": { "style": "dash" },
    "MD013": false,
    "MD007": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD036": false,
    "MD038": false,
    "MD040": false,
    "MD042": false,
    "MD046": false,
    "MD051": false,
    "MD059": false,
    "MD060": false
  },
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "node_modules/**",
    "vendor/**",
    ".cache/**",
    ".git/**",
    "venv/**",
    ".venv/**",
    "**/__pycache__/**",
    ".github/PULL_REQUEST_TEMPLATE/**",
    ".agents/**",
    ".claude/**",
    "skills/**"
  ]
}
