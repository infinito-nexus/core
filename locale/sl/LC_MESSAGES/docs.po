msgid "OpenID Connect (OIDC) Support 🔐"
msgstr "OpenID Connect (OIDC) Podpora 🔐"

# translated-by: libretranslate
msgid "OpenID Connect Generic Client 🔐"
msgstr "Odjemalec OpenID Connect 🔐"

