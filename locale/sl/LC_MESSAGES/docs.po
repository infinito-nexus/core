# translated-by: libretranslate
msgid "The role's HTML references the expected asset host AND a request returns < 400 with the right content-type."
msgstr "Vlogo HTML navaja pričakovani gostitelj premoženja IN zahtevek vrne < 400 s pravim tipom vsebine."

# translated-by: libretranslate
msgid "The role's ``README.md`` heading as one separator-joined fragment."
msgstr "Vloga je. ``README.md`` smer kot en fragment, ki se loči."

# translated-by: libretranslate
