msgstr "NE vnašajte hrupnih razhroščevalnih zapisov, napak brez naključja, podvajajte urejevalnikov dogodkov ali neskončnih opazovalcev v injicirane skripte."

# translated-by: libretranslate
msgid "Do NOT leave implementation warnings unresolved just because they are inconvenient."
msgstr "NE puščajte opozoril o izvajanju nerešena samo zato, ker so neprijetna."

# translated-by: libretranslate
msgid "Do NOT reimplement server-side logic, authentication protocols, or business rules in injected JavaScript."
msgstr "Ne izvajajte logike strežnika, protokolov za avtentikacijo ali poslovnih pravil v injiciranem JavaScriptu."

# translated-by: libretranslate
msgid "Do NOT rely on fragile selectors, broad text matching, or timing hacks when more stable hooks exist."
msgstr "NE zanašajte se na krhke selektorje, ujemanje širokega besedila ali vdore v čas, ko obstajajo stabilnejši kavlji."

# translated-by: libretranslate
msgid "Do NOT rerun `make compose-deploy mode=reinstall apps=<roles> full_cycle=true` just because a deploy failed or you changed code. That restarts the stack unnecessarily and burns time."
msgstr "NE ponavljaj `make compose-deploy mode=reinstall apps=<roles> full_cycle=true` Samo zato, ker uporaba ni uspela ali pa ste spremenili kodo. To po nepotrebnem požene kup in zažge čas."

# translated-by: libretranslate
