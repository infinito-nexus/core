msgstr "Goli poženi ID razreši lastnika/repo od ``repo_override`` ali trenutni GH repo."

# translated-by: libretranslate
msgid "A baseline deploy for `<role>` completed successfully in the current environment."
msgstr "Izhodiščna razporeditev za `<role>` uspešno zaključena v trenutnem okolju."

# translated-by: libretranslate
msgid "A bind on `127.0.0.1:5672` plus the shared cross-stack overlay network for consumers."
