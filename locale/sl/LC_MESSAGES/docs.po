msgid "Tests that statically analyze Ansible config or task YAML files without exercising runtime boundaries MUST live under `tests/lint/ansible/` instead."
msgstr "Testi, ki statično analizirajo Ansible config ali opravilo YAML datoteke brez izvajanja meja časa delovanja MORA živeti pod `tests/lint/ansible/` Namesto tega."

# translated-by: libretranslate
msgid "Tests that verify real runtime component interactions MUST live under `tests/integration/`."
msgstr "Preskusi, ki preverjajo interakcije med sestavnimi deli v realnem času delovanja, MORAJO živeti pod `tests/integration/`."

