msgid "Tests patch collaborators on the submodule that uses them (e.g. ``deploy.cli._run_deploy``), not on this package."
msgstr "Testi obliž sodelavcev na podmodul, ki jih uporablja (Npr. ``deploy.cli._run_deploy``), Ne na tem paketu."

# translated-by: libretranslate
msgid "Tests that MUST adjust `sys.path` or load fixtures before importing the module under test."
msgstr "Preskusi, ki MORAjo biti prilagojeni `sys.path` ali polnilne naprave pred uvozom preskušenega modula."

# translated-by: libretranslate
msgid "Tests that enforce the `test_*.py` prefix convention and the rule that every `test_*.py` file lives under `tests/` and contains at least one runnable `unittest.TestCase`."
msgstr "Testi, ki uveljavljajo `test_*.py` predpona konvencija in pravilo, da vsak `test_*.py` živi pod datoteko `tests/` in vsebuje vsaj eno utekočinljivo `unittest.TestCase`."

# translated-by: libretranslate
msgid "Tests that only assert that a file contains a string, task name, variable name, or template fragment are not allowed."
msgstr "Testi, ki samo trdijo, da datoteka vsebuje niz, ime opravila, ime spremenljivke ali fragment predloge, niso dovoljeni."

