# translated-by: libretranslate
msgid "**Health Checks:** Container healthcheck for quicker failure detection and stable automation."
msgstr "**Zdravstveni pregledi:** Pregled stanja zabojnikov za hitrejše odkrivanje napak in stabilno avtomatizacijo."

