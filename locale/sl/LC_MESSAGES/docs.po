# translated-by: libretranslate
msgid "A missing event indicates a coverage regression in the deploy chain (typically: a once-flag swallowed an include before the role could run)."
msgstr "Manjkajoči dogodek pomeni regresijo pokritosti v verigi uporabe (tipično: enkrat pogoltna zastavica vključuje, preden lahko vloga teče)."

