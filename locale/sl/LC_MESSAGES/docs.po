# translated-by: libretranslate
msgid "Assuming every job burns its full timeout is deliberately pessimistic — no job can outlast it — so the estimate can only overshoot the real drain time. With the current constants that is 4 waves of 20 runners, so 80 rows per chunk, and the last job of a chunk starts around t=18h, well inside the 24h window."
msgstr "Ob predpostavki, da vsako delo zažge svoj polni delovni čas, je namerno pesimistično – nobeno delo ga ne more preseči – zato lahko ocena le prekorači pravi čas odtekanja. S trenutnimi konstantami, ki so 4 valov 20 Tekači, torej 80 vrstice na delček in zadnje opravilo delčka se začne okoli t=18h, v notranjosti 24h okno."

# translated-by: libretranslate
msgid "Assumption 10: `~/.ssh` is intentionally readable to allow `git push` on `ask` 🔑"
msgstr "Domneva 10: `~/.ssh` je namerno berljiv, da omogoča `git push` o `ask` 🔑"

# translated-by: libretranslate
msgid "Assumption 1: The sandbox backend is installed and functional ⚙️"
msgstr "Domneva 1: Hrbtenica za peskovnik je nameščena in funkcionalna ⚙️"

# translated-by: libretranslate
msgid "Assumption 2: `sandbox.filesystem.allowWrite` is the authoritative write boundary ✍️"
msgstr "Domneva 2: `sandbox.filesystem.allowWrite` je avtoritativna meja pisanja ✍️"

# translated-by: libretranslate
msgid "Assumption 3: The host runs only test workloads 🧪"
msgstr "Domneva 3: Gostitelj izvaja samo preizkusne delovne obremenitve 🧪"

# translated-by: libretranslate
msgid "Assumption 4: Operators review `ask` prompts before approval 👀"
msgstr "Domneva 4: Pregled izvajalcev `ask` naprave pred odobritvijo 👀"

# translated-by: libretranslate
msgid "Assumption 5: DinD ask-gates are comfort thresholds, not hard barriers 🐳"
msgstr "Domneva 5: Dind ask-gates so pragi udobja, ne trde ovire 🐳"

# translated-by: libretranslate
msgid "Assumption 6: Access to `/var/run/docker.sock` equals host root 🔓"
msgstr "Domneva 6: Dostop do `/var/run/docker.sock` je enako korenu gostitelja 🔓"

# translated-by: libretranslate
msgid "Assumption 7: The `Makefile` is peer-reviewed and trusted 🔧"
msgstr "Domneva 7: `Makefile` je strokovno pregledana in zaupa 🔧"

