# translated-by: libretranslate
msgid "**Health Checks & Logging:** Integrates with Infinito.Nexus health checking and journald logging 📈"
msgstr "**Pregledi stanja in beleženje:** Integracija Infinito.Nexus zdravstveni pregled in beleženje dnevnikov 📈"

# translated-by: libretranslate
