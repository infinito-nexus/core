msgstr "**Lokalna podpora času:** Pravilno prikaže imenik seznam časovnih žigov, ko je to potrebno."

# translated-by: libretranslate
msgid "**Local `act` runs**: append `--env INFINITO_PLAYWRIGHT_KEEP=true` to the `act` command."
msgstr "**Krajevno `act` teče**: dodatek `--env INFINITO_PLAYWRIGHT_KEEP=true` k `act` Ukaz."

# translated-by: libretranslate
msgid "**Local caching:** Models are cached locally to avoid repeated downloads."
msgstr "**Krajevno caching:** Modeli so shranjeni lokalno, da bi se izognili večkratnim prenosom."

