msgstr "**Integracija Persona:** Razširi ``dev-core`` z orodji, specifičnimi za Python."

# translated-by: libretranslate
msgid "**Persona Integration:** Extends ``dev-core`` with embedded-specific tools."
msgstr "**Integracija Persona:** Razširi ``dev-core`` z vgrajenimi orodji."

