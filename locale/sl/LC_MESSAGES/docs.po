msgstr "**Globalno Matomo Spremljanje** Vloga vključuje Matomo sledenje nastavitev in vbrizga ustrezno skripto sledenja v vaš HTML."

# translated-by: libretranslate
msgid "**Global Theming**"
msgstr "**Globalna tema**"

