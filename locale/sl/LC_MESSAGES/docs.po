msgid "A regex over dotted octets, e.g. ``192\\.168\\.24\\.\\d+`` for a /24 or ``192\\.168\\.(24|25)\\.\\d+`` for a /23."
msgstr "Regeks nad pikčastimi okteti, npr. ``192\\.168\\.24\\.\\d+`` za a /24 ali ``192\\.168\\.(24|25)\\.\\d+`` za a /23."

