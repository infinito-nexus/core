# translated-by: libretranslate
msgid "**Idempotent Execution:** Tasks are intelligently executed only once per playbook run."
msgstr "**Nepovratna izvedba:** Naloge se inteligentno izvajajo samo enkrat na igro."

# translated-by: libretranslate
msgid "**Idempotent Execution:** Utilizes a ``run_once`` flag to prevent repeated runs."
msgstr "**Nepovratna izvedba:** Uporablja a ``run_once`` zastavo za preprečevanje ponavljajočih se tekov."

# translated-by: libretranslate
