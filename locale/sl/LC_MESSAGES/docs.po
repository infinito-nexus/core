msgstr "**``sys-front-inj-all``** – uporablja globalne spremembe in vključuje."

# translated-by: libretranslate
msgid "**``sys-svc-certs``** – obtains Let’s Encrypt certificates."
msgstr "**``sys-svc-certs``** – pridobi Šifrirajmo potrdila."

