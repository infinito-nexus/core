msgstr "**Zdravstveni pregledi:** Pregled stanja zabojnikov na osnovi Curl za zgodnje odkrivanje napak."

# translated-by: libretranslate
msgid "**Health endpoint:** A `/health` endpoint reports the runtime status and backs the container healthcheck."
msgstr "**Opazovani dogodek na področju zdravja:** A `/health` končna točka poroča o stanju časa delovanja in podpira pregled stanja posode."

# translated-by: libretranslate
