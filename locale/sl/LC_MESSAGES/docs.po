msgstr "NE DOKUMENTIRANI vzorci ali razširitvene točke, ki v kodi ne obstajajo."

# translated-by: libretranslate
msgid "Do NOT expose unused variables, duplicate values, or secrets that the spec never reads."
msgstr "NE izpostavljajte neuporabljenih spremenljivk, podvajajte vrednosti ali skrivnosti, ki jih spec nikoli ne bere."

# translated-by: libretranslate
