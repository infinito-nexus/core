msgid "Nextcloud plugin pipeline"
msgstr "Vstavek Nextcloud"

# translated-by: libretranslate
msgid "Nextcloud serves a Model Context Protocol endpoint through the AppAPI proxy of the ``context_agent`` ExApp."
msgstr "Nextcloud služi opazovanem dogodku v okviru protokola o vzorčnem kontekstu prek AppAPI posrednika ``context_agent`` ExApp."

