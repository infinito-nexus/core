msgstr "Zahteva ostane lokalna, medtem ko jo lahko lokalni model postreže, zamenja ali ne"

# translated-by: libretranslate
msgid "A request whose demands exceed a model's capabilities never reaches it"
msgstr "Zahteva, katere zahteve presegajo zmožnosti modela, je nikoli ne doseže."

