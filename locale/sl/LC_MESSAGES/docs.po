# translated-by: libretranslate
msgid "**Idempotent persistence**"
msgstr "**Nepovratna vztrajnost**"

# translated-by: libretranslate
msgid "**Idempotent provisioning** ACL users reconciled on every deploy via `ACL SETUSER`."
msgstr "**Nepovratne določbe** Uporabniki ACL so se z vsako uporabo uskladili `ACL SETUSER`."

# translated-by: libretranslate
msgid "**Idempotent provisioning** ACL users reconciled on every deploy via ``ACL SETUSER``."
