msgstr "Nastavitev NFS na strani odjemalca za namestitev izvoza oddaljenega strežnika na vsako vozlišče roja s sondo, ki omogoča časovno razporeditev"

# translated-by: libretranslate
msgctxt "role:svc-net-wireguard-plain:description"
msgid "Client-side WireGuard VPN role for stable connectivity with a systemd service and script that tune interface MTU"
msgstr "Vloga WireGuard VPN na strani naročnika za stabilno povezljivost s sistemsko storitvijo in skripto, ki uglašuje vmesnik MTU"

# translated-by: libretranslate
msgctxt "role:dsk-copyq:description"
msgid "Clipboard manager with editable history, custom actions, and scripting support"
msgstr "Upravljalnik odložišča z urejevalno zgodovino, dejanji po meri in podporo za skripte"

