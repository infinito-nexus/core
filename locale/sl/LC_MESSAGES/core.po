msgstr "Načrtovani zdravstveni pregled skeniranje sistemsko dnevnik za dnevne napake in opozarjanje na tekme"

# translated-by: libretranslate
msgctxt "role:sys-ctl-hlth-webserver:description"
msgid "Scheduled health check verifying each NGINX domain returns its expected HTTP status and alerting on deviations"
msgstr "Predvideni zdravstveni pregled, s katerim se preveri vsaka domena NGINX, vrne svoj pričakovani status HTTP in opozarja na odstopanja"

# translated-by: libretranslate
msgctxt "role:sys-ctl-cln-faild-bkps:description"
msgid "Scheduled maintenance service for detecting and removing failed Docker backups while keeping recent sets intact"
msgstr "Načrtovana vzdrževalna storitev za odkrivanje in odstranjevanje neuspešnih varnostnih kopij Docker, medtem ko so nedavni kompleti nedotaknjeni"

# translated-by: libretranslate
msgctxt "role:sys-ctl-cln-anon-volumes:description"
