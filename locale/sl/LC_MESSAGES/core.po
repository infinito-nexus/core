msgstr "Načrtovana vzdrževalna naloga za regeneracijo prostora na disku z odstranjevanjem neuporabljenih anonimnih Docker zvezkov in njihovih simlinkov"

# translated-by: libretranslate
msgctxt "role:svc-bkp-remote-2-local:description"
msgid "Scheduled pull-style backup replicating remote hosts onto this host over SSH and rsync as hard-linked snapshots"
msgstr "Načrtovano varnostno kopiranje oddaljenih gostiteljev na tega gostitelja preko SSH in rsync kot trdo vezane posnetke"

# translated-by: libretranslate
msgctxt "role:sys-ctl-cln-bkps:description"
msgid "Scheduled systemd maintenance service for pruning outdated backup versions when disk usage exceeds a threshold"
msgstr "Načrtovana sistemska storitev vzdrževanja za obrezovanje zastarelih varnostnih različic, če uporaba diska presega prag"

# translated-by: libretranslate
msgctxt "role:sys-ctl-rpr-btrfs-balancer:description"
