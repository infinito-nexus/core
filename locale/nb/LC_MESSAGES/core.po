msgid "Version-control client for personal workstations, preconfigured with identity, signing, and merge defaults"
msgstr "Versionskontrollklient for personlige arbeidsstasjoner, forhåndskonfigurert med identitet, signering og sammenslå standarder"

# translated-by: libretranslate
msgctxt "role:sys-svc-cdn:description"
msgid "Versioned asset-tree layout for CDN delivery with shared, vendor, and per-role release directories"
msgstr "Versjonsbasert aktivtrelayout for CDN-leveranse med delte, leverandør og per-role release kataloger"

# translated-by: libretranslate
msgctxt "role:dsk-code:description"
msgid "Visual Studio Code workstation editor in a selectable flavor, carrying the extensions of the agents the host deploys"
msgstr "Visual Studio Code Arbeidsplassredigering i en utvalgbar smak, med utvidelser av agentene verten distribuerer"

# translated-by: libretranslate
msgctxt "category:web:title"
msgid "Web Infrastructure"
msgstr "Nettinfrastruktur"

# translated-by: libretranslate
msgctxt "role:web-app-semaphore:description"
msgid "Web UI and API for running Ansible, Terraform/OpenTofu, and shell automation on a schedule or on demand"
msgstr "Web UI og API for kjøring Ansible, Terraform/OpenTofu, og skal automatisering på en tidsplan eller etterspørsel"

# translated-by: libretranslate
msgctxt "role:web-app-lam:description"
msgid "Web interface for administering LDAP directories: managing users, groups, and other directory objects"
msgstr "Nettgrensesnitt for å administrere LDAP-mapper: administrere brukere, grupper og andre katalogobjekter"

# translated-by: libretranslate
msgctxt "role:web-app-fusiondirectory:description"
msgid "Web-based LDAP administration interface for managing users, groups, and directory objects"
msgstr "Nettbasert LDAP-administrasjonsgrensesnitt for styring av brukere, grupper og katalogobjekter"

# translated-by: libretranslate
msgctxt "role:web-app-phpldapadmin:description"
msgid "Web-based LDAP client for browsing, searching, and administering directory entries in LDAP servers"
msgstr "Nettbasert LDAP-klient for å bla gjennom, søke og administrere katalogoppføringer i LDAP-servere"

# translated-by: libretranslate
msgctxt "role:web-app-pgadmin:description"
msgid "Web-based administration and development platform for managing multiple PostgreSQL servers, with optional OAuth2 login"
msgstr "Webbasert administrasjon og utviklingsplattform for å administrere flere PostgreSQL-servere, med valgfri OAuth2 pålogging"

# translated-by: libretranslate
msgctxt "role:web-app-phpmyadmin:description"
msgid "Web-based administration tool for MySQL and MariaDB with schema management, querying, and import/export"
msgstr "Webbasert administrasjonsverktøy for MySQL og MariaDB med skjemastyring, spørring og import/eksport"

# translated-by: libretranslate
msgctxt "category:web.opt:title"
msgid "Webserver Optimation"
msgstr "Webserver Optimasjon"

# translated-by: libretranslate
msgctxt "role:dsk-docker:description"
msgid "Workstation setup for Docker and Docker Compose with the local user in the docker group for rootless development use"
msgstr "Workstation-oppsett for Docker og Docker Compose med den lokale brukeren i docker-gruppen for rotløs utviklingsbruk"

# translated-by: libretranslate
msgctxt "role:dev-arduino:description"
msgid "Workstation toolchain and serial-port permissions for Arduino board development on Linux"
msgstr "Workstation toolchain og serieport tillatelser for Arduino styre utvikling på Linux"

# translated-by: libretranslate
msgctxt "role:pkgmgr-install:description"
msgid "Wrapper role for idempotent package installation and updates through the pkgmgr universal package manager"
msgstr "Innpakningsrolle for idempotent pakkeinstallasjon og oppdateringer gjennom pkgmgr universell pakkehåndtering"

# translated-by: libretranslate
msgctxt "logout:may_close"
msgid "You can close this page now."
msgstr "Du kan lukke denne siden nå."

