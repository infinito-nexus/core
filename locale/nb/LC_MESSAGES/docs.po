msgstr "Les strengt: En manglende erklæring må mislykkes i stedet for å utstede en hardkodet adresse, som lageret forbyr og linter for. Bare den første oppføringen tas fordi en oppløserliste er dekket ved tre og broen allerede har en av disse spilleautomatene."

# translated-by: libretranslate
msgid "Read the MCP credential a provider issued, from its declared owner."
msgstr "Les MCP-godkjente en leverandør utstedt fra sin erklærte eier."

# translated-by: libretranslate
msgid "Read the band for `<scope>.<category>` from `PORT_BANDS`. If absent and no `--range` is given, exit non-zero with a clear error listing the available categories."
msgstr "Les bandet for `<scope>.<category>` fra `PORT_BANDS`. Hvis fraværende og nei `--range` er gitt, avslutte ikke-null med en klar feilliste over tilgjengelige kategorier."

# translated-by: libretranslate
msgid "Read the contributor SPOT and treat every MUST there as a non-negotiable acceptance criterion for the generated spec."
msgstr "Les bidragsyteren SPOT og behandle alle må der som et ikke-forenlig akseptkriterie for den genererte spesifikasjonen."

# translated-by: libretranslate
msgid "Read the deploy axes an operator pins in ``whitelist`` and ``priority``."
msgstr "Les utplasseringen aksjerer en operatørpinner i ``whitelist`` og ``priority``.."

