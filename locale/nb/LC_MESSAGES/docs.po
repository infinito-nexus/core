# translated-by: libretranslate
msgid "**Automated Installation**"
msgstr "**Automatisert installasjon**"

# translated-by: libretranslate
msgid "**Automated Installation**   Installs Docker and Docker Compose via the system package manager."
msgstr "**Automatisert installasjon** Installerer Docker og Docker Compose via systempakkehåndtering."

# translated-by: libretranslate
msgid "**Automated Installation:** Installs LibreOffice along with Liberation fonts and additional language packages using Pacman."
msgstr "**Automatisert installasjon:** Installeringer LibreOffice sammen med Liberation skrifttyper og ekstra språkpakker ved hjelp av Pacman."

# translated-by: libretranslate
msgid "**Automated Installation:** Installs fakeroot via the OS package manager."
msgstr "**Automatisert installasjon:** Installerer fakeroot via OS pakke manager."

# translated-by: libretranslate
msgid "**Automated Maintenance:** Simplifies updates and re-deployments via automated container management."
msgstr "**Automatisert vedlikehold:** Forenkler oppdateringer og redistribusjoner via automatisert containerhåndtering."

# translated-by: libretranslate
msgid "**Automated Recovery:** Restarts failed containers and resolves port binding issues."
msgstr "**Automatisert gjenoppretting:** Omstart mislykkes beholdere og løser problemer med portbinding."

# translated-by: libretranslate
msgid "**Automated Service Management:** Automatically reloads the systemd daemon and restarts the timer when changes are detected."
msgstr "**Automatisert Service Management:** Laster automatisk den systembaserte nissen på nytt og starter timeren på nytt når det oppdages endringer."

# translated-by: libretranslate
msgid "**Automated Service Management:** Automatically restarts the notifier service upon configuration changes."
msgstr "**Automatisert Service Management:** Start automatisk abonnementstjenesten på nytt ved endring av konfigurasjon."

# translated-by: libretranslate
msgid "**Automated Setup & Maintenance:** Installs, migrates, and configures Shopware automatically."
msgstr "**Automatisert oppsett og vedlikehold:** Installerer, trekker og konfigurerer Shopware Automatisk."

# translated-by: libretranslate
msgid "**Automated Updates & Re-creation:** Simplify maintenance with automated update and container recreation procedures."
msgstr "**Automatiserte oppdateringer og gjenoppretting:** Forenkle vedlikehold med automatisert oppdatering og beholder rekreasjonsprosedyrer."

# translated-by: libretranslate
msgid "**Automated provisioning:** Configured by Ansible without manual steps."
msgstr "**Automatisert levering:** Konfigurert av Ansible uten manuelle trinn."

# translated-by: libretranslate
