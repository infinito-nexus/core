msgid "This Ansible role manages the configuration of `systemd-journald` on target hosts."
msgstr "Funtzio ansible honek konfigurazioa kudeatzen du `systemd-journald` helburuko ostalarietan."

# translated-by: libretranslate
msgid "This Ansible role manages the system locale configuration by deploying ``locale.gen`` and ``locale.conf``, then generating the requested locales."
msgstr "Funtzio zahar honek sistemaren konfigurazioa kudeatzen du hedatuz ``locale.gen`` eta ``locale.conf``, Ondoren, eskatutako lokalak sortu."

# translated-by: libretranslate
msgid "This Ansible role manages the system locale configuration by deploying `locale.gen` and `locale.conf`, then generating the requested locales."
