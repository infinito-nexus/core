msgstr "Yield existitzen diren vhost fitxategiak (http + https) aplikazio bakoitzeko *entitatea*plus ``www.<domain>.conf`` birbideratze-aldaera eta - nodo bat ematen denean (``services.tor.node`` / gakoaren fitxategia) - 2. maila ``<sub>.<node-onion>.conf`` aldagarria, beraz, eroritako aplikazio batek ere ez du onion vhost zaharkiturik uzten. Existitzen diren fitxategiak bakarrik ematen ditu."

# translated-by: libretranslate
msgid "Yield mount dicts in ``volume['mounts']`` that target ``service``."
msgstr "Yield muntatzeko diktak ``volume['mounts']`` helburu hori ``service``."

# translated-by: libretranslate
msgid "Yield project files filtered through ``.gitignore``."
msgstr "Yield proiektuaren fitxategiak iragazita ``.gitignore``."

msgid "Yield the URL of the translation gateway, deploying it when absent."
msgstr ""

msgid "Yield the gateway's URL, deploying the whole bundle when it is absent."
msgstr ""

