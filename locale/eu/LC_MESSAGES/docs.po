# translated-by: libretranslate
msgid "**Snapshot-aware:** on a btrfs data root the whole run is captured from one atomic filesystem snapshot with no container stopped; the host is probed before every run and falls back to the live copy when a snapshot would not be faithful."
msgstr "**Snapshot-awarea:** btrfs datu-erro batean, exekuzio osoa fitxategi-sistema atomiko bateko argazki batetik harrapatzen da, edukiontzirik gelditu gabe; ostalaria proba egiten da lasterka egin aurretik, eta kopia zuzenean erortzen da, argazkia fidagarria ez denean."

# translated-by: libretranslate
msgid "**Snapshot-aware:** rsync `--link-dest` against the previous local snapshot deduplicates unchanged files."
msgstr "**Snapshot-awarea:** rsync `--link-dest` aurreko lokaleko argazkien aurrean, aldatu gabeko fitxategiak bikoizten ditu."

# translated-by: libretranslate
msgid "**Snapshot-aware:** rsync `--link-dest` against the previous snapshot keeps storage growth proportional to actual change."
msgstr "**Snapshot-awarea:** rsync `--link-dest` aurreko pantailaren aurka biltegiaren hazkundea benetako aldaketarekiko proportzionala izaten jarraitzen du."

# translated-by: libretranslate
