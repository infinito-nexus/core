msgstr "Emaneld ImageRef sarrera guztiak paper guztietan aurkituak ``repo_root``."

# translated-by: libretranslate
msgid "Yield all canonical + alias domains from an app config."
msgstr "Aplikazio baten konfigurazioko domeinu kanoniko eta alias guztiak Yield."

msgid "Yield every declared field of well-formed forms."
msgstr ""

msgid "Yield every task of a task list, descending into blocks."
msgstr ""

# https) aplikazio bakoitzeko *entitatea*plus ``www.<domain>.conf``
# birbideratze-aldaera eta - nodo bat ematen denean (``services.tor.node`` /
