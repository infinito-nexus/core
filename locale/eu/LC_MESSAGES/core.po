msgstr "Aplikazioak"

# libretranslate
msgctxt "menu:Sales:description"
msgid "Applications for e-commerce, ticketing, and sales management."
msgstr "Merkataritza elektronikoa, sarrera eta salmenta kudeatzeko aplikazioak."

# libretranslate
msgctxt "role:drv-epson-multiprinter:description"
msgid "Arch Linux driver bundle for Epson multifunction printing and scanning via escpr and imagescan"
msgstr "Arch Linux gidari sorta Epson funtzio anitzeko inprimatzeko eta eskaneatzeko escpr eta irudiakcan bidez"

# libretranslate
msgctxt "menu:Artificial Intelligence:title"
msgid "Artificial Intelligence"
msgstr "Adimen artifiziala"

# libretranslate
msgctxt "menu:Asset Management:title"
msgid "Asset Management"
msgstr "Aktiboen kudeaketa"

# libretranslate
msgctxt "role:sys-ctl-rpr-container-soft:description"
msgid "Automated recovery service restarting exited or unhealthy Docker Compose stacks and resolving port conflicts"
msgstr "Berreskuratze-zerbitzu automatikoa, Docker Compose pilak osatuz eta portuko gatazkak konponduz"

# libretranslate
msgctxt "role:sys-dns-hetzner-rdns:description"
msgid "Automation role for reverse DNS (PTR) records on Hetzner Cloud servers, primary IPs, floating IPs, and load balancers"
msgstr "Automatizazio-rola alderantzizko DNSarentzat (PTR) erregistroak Hetzner Cloud zerbitzarietan, IP nagusiak, IP mugikorrak eta karga orekatzaileak"

# libretranslate
msgctxt "category:sys.ctl.bkp:title"
msgid "Backup & Restore"
msgstr "Babeskopia eta leheneratu"

# libretranslate
msgctxt "category:svc.bkp:title"
msgid "Backup Services"
msgstr "Babeskopia-zerbitzuak"

# libretranslate
msgctxt "category:sys.ctl.bkp:description"
msgid "Backup strategies & restore procedures"
msgstr "Babeskopia estrategiak eta prozedurak leheneratu"

# libretranslate
msgctxt "role:dev-core:description"
msgid "Base development environment for software engineers on Linux, with core editors and language-agnostic tooling"
msgstr "Linuxeko software ingeniarientzako oinarrizko garapen-ingurunea, oinarrizko editoreekin eta hizkuntza-tresna agnostikoekin"

# libretranslate
msgctxt "role:sys-daemon:description"
msgid "Base role for systemd manager configuration via drop-ins, default settings, and unit validation"
msgstr "Sistematutako kudeatzailearen konfigurazioaren oinarri-rola tanta-ins, ezarpen lehenetsi eta balioztapen unitateen bidez."

# libretranslate
msgctxt "role:web-app-roulette-wheel:description"
msgid "Browser-based spinning wheel app for decision making, random selection, and gamification"
msgstr "Arakatzailean oinarritutako gurpil birakaria aplikazioa erabakiak hartzeko, ausazko hautapena eta gamifikazioa"

# libretranslate
msgctxt "role:web-app-litellm:description"
msgid "Browser-facing admin interface for the shared LLM gateway, published on its own domain behind the front proxy"
msgstr "LLM ate partekaturako arakatzaile-administratzailearen interfazea, proxy-aren atzeko bere domeinuan argitaratua"

# libretranslate
msgctxt "role:dev-fakeroot:description"
msgid "Build-time tool for simulating root-owned file operations without elevated privileges during package builds"
msgstr "Erroko fitxategi-eragiketak simulatzeko eraiki-denbora tresna, pakete-eraikinetan pribilegiorik gabe"

# libretranslate
msgctxt "category:svc.runner:title"
msgid "CI Runner"
msgstr "CI Runner"

# libretranslate
msgctxt "role:svc-db-typesense:description"
msgid "Central Dockerized search engine shared by multiple apps with per-consumer scoped API keys"
msgstr "Erdialdeko Dockerized bilaketa-motorra, hainbat aplikaziok partekatua, kontsumoko API gakoekin"

# libretranslate
msgctxt "menu:Help:description"
msgid "Central help resources, including documentation, support tools, and guidance."
msgstr "Laguntza-baliabide zentralak, dokumentazioa, laguntza-tresnak eta orientazioa barne."

# libretranslate
msgctxt "role:svc-db-memcached:description"
msgid "Central in-memory caching engine with per-consumer key-prefix isolation, usable centrally or as an embedded sidecar"
msgstr "Erdi-memoriako cache-motorra, gako-kontsumitzailearen isolamenduarekin, erdi-mailako edo kapsulatutako sidecar gisa erabil daitekeena"

# libretranslate
msgctxt "role:sys-service-loader:description"
msgid "Central loader role for ordered shared-service preloading and queued post-load role inclusions across the deployment"
msgstr "Kargatzailearen paper nagusia zerbitzu partekatuaren aurrekargarako eta ilaratutako post-kargarako inklusioak hedatzean zehar"

# libretranslate
msgctxt "role:web-svc-logout:description"
msgid "Central logout proxy for single-action sign-out across all OIDC-connected apps, with Nginx snippets and a live status UI"
msgstr "Saio erdiko proxy-a ekintza bakarreko saioa hasteko OIDC-rekin konektatutako aplikazio guztietan, Nginx mozkinekin eta zuzeneko egoera UI"

# libretranslate
msgctxt "role:sys-svc-mail:description"
msgid "Central mail orchestration layer routing host mail through Mailu, msmtp, or an optional local SMTP relay"
msgstr "Posta zentraleko orkestrazio-geruza ostalari-posta Mailu, msmtp edo aukerako SMTP errelebo lokalaren bidez bideratzeko"

# libretranslate
msgctxt "category:svc.dns:description"
msgid "Central recursive/forwarding DNS resolver engines (Unbound, etc.)"
msgstr "DNS konpontzeko motor errekurtsibo eta aurrerakoiak (Mugagabea, etab.)"

# libretranslate
msgctxt "role:svc-dns-unbound:description"
msgid "Central recursive/forwarding DNSSEC resolver on a static IP for consumer stacks to target as their DNS"
msgstr "DNSSEC ebazlea IP estatikoan kontsumitzaileen pilak DNS gisa helburura bideratzeko"

# libretranslate
msgctxt "role:svc-db-elasticsearch:description"
msgid "Central search and analytics engine with per-consumer index namespaces isolating tenants in a shared Docker deployment"
msgstr "Bilaketa- eta analisi-motor zentrala, kontsumoko izen-espazioak isolatuz Dockerren hedapen partekatu batean"

# libretranslate
msgctxt "role:svc-db-qdrant:description"
msgid "Central vector database engine for storing and searching per-consumer embeddings shared across the stack"
msgstr "Bektore zentralaren datu-basearen motorra, pilan zehar partekatutako konsumer kapsulak gordetzeko eta bilatzeko"

# libretranslate
msgctxt "role:sys-svc-rdbms:description"
msgid "Centralized MariaDB or PostgreSQL database service shared across applications via Docker Compose"
msgstr "Centralized MariaDB edo PostgreSQL datu-base zerbitzua, Docker Compose aplikazioen bidez partekatua"

# libretranslate
msgctxt "role:sys-svc-certs:description"
msgid "Certbot-driven ACME service for Let's Encrypt single-domain and wildcard TLS certificates on NGINX domains"
msgstr "Certbot-ek gidatutako ACME zerbitzua, domeinu bakarreko TLS ziurtagiriak NGINX domeinuetan Enkriptatu ditzagun"

# libretranslate
msgctxt "logout:checking"
msgid "Checking your other sessions…"
msgstr "Beste saioak begiratzen..."

# libretranslate
msgctxt "category:sys.ctl.cln:title"
msgid "Cleanup"
msgstr "Garbiketa"

# libretranslate
msgctxt "role:sys-svc-cln-domains:description"
msgid "Cleanup routine for deprecated domains, removing Nginx configs and revoking their Certbot certificates"
msgstr "Domeinu zaharkituen garbiketa-ertina, Nginx konfigurazioak kendu eta haien Certbot ziurtagiriak errebokatzea"

# libretranslate
msgctxt "role:sys-ctl-cln-disc-space:description"
msgid "Cleanup routine for reclaiming disk space from temp files, package caches, optional Docker data and old backups"
msgstr "Garbiketa-errutina diskoaren lekua temp fitxategiak, paketeen cacheak, aukerako Docker datuak eta babeskopia zaharrak berreskuratzeko."

# libretranslate
msgctxt "role:svc-storage-nfs-client:description"
msgid "Client-side NFS setup for mounting a remote server export on every swarm node, with a deploy-time reachability probe"
msgstr "NFS bezero-aldearen konfigurazioa urruneko zerbitzari baten esportazioa muntatzeko leku guztietan, zabaltze-denborako zunda batekin"

# libretranslate
msgctxt "role:svc-net-wireguard-plain:description"
msgid "Client-side WireGuard VPN role for stable connectivity with a systemd service and script that tune interface MTU"
msgstr "Bezero-aldeko WireGuard VPN-ren papera konexio egonkorra izateko, sistematutako zerbitzu batekin eta MTU interfaze sintonizatuarekin"

# libretranslate
msgctxt "role:desk-copyq:description"
msgid "Clipboard manager with editable history, custom actions, and scripting support"
msgstr "Arbeleko kudeatzailea historia editagarriarekin, ekintza pertsonalizatuak eta script-en euskarriarekin"

# libretranslate
msgctxt "menu:Cloud:title"
msgid "Cloud"
msgstr "Lainoa"

# libretranslate
msgctxt "role:sys-svc-dns:description"
msgid "Cloudflare DNS bootstrap role for apex and wildcard A/AAAA records (and optional CAA) across a web stack's base domains"
msgstr "Cloudflare DNS botaktrap-en papera A/AAAA erregistroetarako (eta aukerakoa) web pila baten oinarrizko domeinuetan zehar"

# libretranslate
msgctxt "role:svc-registry-docker:description"
msgid "Cluster-local container image registry for serving custom-built images to Docker Swarm worker nodes"
msgstr "Kluster-lokaleko edukiontzi-irudien erregistroa, Docker Swarm-eko langileen nodoei irudi pertsonalizatuak zerbitzatzeko."

# libretranslate
msgctxt "role:svc-registry-cache:description"
msgid "Cluster-local pull-through cache for shared Docker Hub base-image pulls, cutting duplicate transfers and rate limits"
msgstr "Kluster-lokaleko cache-a Docker Hub-en oinarri-irudia tiratzeko, transferentzia bikoiztuak eta tasa-mugak mozteko"

# libretranslate
msgctxt "role:web-app-mediawiki:description"
msgid "Collaborative wiki platform for user-driven documentation with an extensible extension ecosystem and content management"
msgstr "Erabiltzaileei zuzendutako dokumentaziorako wiki kolaboratiboaren plataforma hedapen-ekosistema zabal batekin eta edukien kudeaketarekin"

# libretranslate
msgctxt "role:desk-jrnl:description"
msgid "Command-line journal application for creating and managing personal diary entries from the terminal"
msgstr "Komando-lerroko egunkari-aplikazioa terminaleko egunkari-sarrera pertsonalak sortzeko eta kudeatzeko"

