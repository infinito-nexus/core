msgstr "Web eta dokumentaziorako Simple Icons markako SVG eta PNG bilduma ostatatzeko edukiontzidun ikono-zerbitzaria."

# libretranslate
msgctxt "role:svc-db-postgres:description"
msgid "Containerized relational database with automated database, user, and privilege provisioning"
msgstr "Datu-base erlazionalizatua, datu-base automatizatuarekin, erabiltzailearekin eta pribilegioen horniketarekin."

# libretranslate
msgctxt "menu:Content Management:title"
msgid "Content Management"
msgstr "Edukien kudeaketa"

# libretranslate
msgctxt "menu:Content Management:description"
msgid "Content Management Systems (CMS) and web publishing platforms"
msgstr "Edukiak kudeatzeko sistemak (CMS) eta web edizio plataformak"

# libretranslate
msgctxt "role:web-app-wordpress:description"
msgid "Content management system for building and managing websites, blogs, and multisite networks with themes and plugins"
msgstr "Edukiak kudeatzeko sistema, webguneak, blogak eta sare anitzak sortzeko eta kudeatzeko gai eta pluginekin"

# libretranslate
msgctxt "category:sys.ctl:title"
msgid "Control"
msgstr "Kontrola"

# libretranslate
msgctxt "category:sys.ctl:description"
msgid "Control layer for system lifecycle management—handling cleanup, monitoring, backups, alerting, maintenance, and repair tasks."
msgstr "Kontrol-geruza sistemako bizi-zikloaren kudeaketarako: garbiketa, monitorizazioa, babeskopiak, alertak, mantentze-lanak eta konponketa-lanak."

# libretranslate
msgctxt "category:svc.ai:description"
msgid "Core AI building blocks—model serving, OpenAI-compatible gateways, vector databases, orchestration, and chat UIs."
msgstr "Oinarrizko AA eraikuntza-blokeak: zerbitzu-ereduak, OpenAI-rekin bateragarriak diren atebideak, datu-base bektorialak, orkestrazioa eta berriketa UIak."

# libretranslate
msgctxt "role:sys-svc-webserver-core:description"
msgid "Core NGINX webserver with HTTP and TCP/UDP stream support and performance-tuned defaults"
msgstr "Oinarrizko NGINX web zerbitzaria HTTP eta TCP/UDP korrontearen euskarriarekin eta errendimenduarekin lotutako lehenespenez"

# libretranslate
msgctxt "logout:no_check"
msgid "Could not check your other sessions."
msgstr "Ezin izan dira zure beste saioak egiaztatu."

# libretranslate
msgctxt "logout:stalled"
msgid "Could not confirm every sign-out."
msgstr "Ezin izan dira sinatu."

# libretranslate
msgctxt "role:dev-nix:description"
msgid "Cross-distribution installer for the Nix package manager with checksum-verified, reproducible multi-user setup"
msgstr "Nix pakete-kudeatzailearen banaketa-instalatzailea erabiltzaile anitzeko konfigurazioa egiaztatu eta erreproduzigarriarekin"

# libretranslate
msgctxt "role:sys-cleanup:description"
msgid "Cross-distribution maintenance routine for disk reclamation across CI, container, and build environments"
msgstr "Zeharkako mantentze-errutina CI, edukiontzi eta inguruneetan zehar diskoen birmoldaketarako"

# libretranslate
msgctxt "menu:Customer Relationship:title"
msgid "Customer Relationship"
msgstr "Bezeroekiko harremana"

# libretranslate
msgctxt "menu:Customer Relationship:description"
msgid "Customer Relationship Management (CRM) software for managing customer relationships, sales pipelines, marketing, and support activities."
msgstr "Bezeroekiko harremanen kudeaketa (CRM) bezero-harremanak, salmenta-hodiak, marketina eta laguntza-jarduerak kudeatzeko softwarea."

# libretranslate
msgctxt "category:sys.dns:title"
msgid "DNS Automation"
msgstr "DNS automatizazioa"

# libretranslate
msgctxt "category:svc.dns:title"
msgid "DNS Resolvers"
msgstr "DNS ebaztea"

# libretranslate
msgctxt "category:sys.dns:description"
msgid "DNS providers, records, and rDNS management (Cloudflare, Hetzner, etc.)."
msgstr "DNS hornitzaileak, erregistroak eta rDNS kudeaketa (Cloudflare, Hetzner, etab.)."

# libretranslate
msgctxt "role:sys-dns-cloudflare-records:description"
msgid "Data-driven role for managing Cloudflare DNS records (A/AAAA, CNAME, MX, TXT, SRV) across apps and environments"
msgstr "Datuetan oinarritutako rola Cloudflare DNS erregistroak kudeatzeko (A/AAAA, CNAME, MX, TXT, SRV) aplikazio eta inguruneetan zehar"

# libretranslate
msgctxt "category:svc.db:description"
msgid "Database applications (DBMS, LDAP, Redis, etc.)"
msgstr "Datu-baseen aplikazioak (DBMS, LDAP, Redis, etab.)"

# libretranslate
msgctxt "category:svc.db:title"
msgid "Databases"
msgstr "Datu-baseak"

# libretranslate
msgctxt "role:web-app-peertube:description"
msgid "Decentralized, federated platform for peer-to-peer video hosting, streaming, and live broadcasting"
msgstr "Plataforma deszentralizatu eta federatua bideo-ostatu, streaming eta zuzeneko emisioetarako"

# libretranslate
msgctxt "role:web-app-pixelfed:description"
msgid "Decentralized, federated platform for photo sharing and image feeds across the fediverse"
msgstr "Plataforma deszentralizatu eta federatu bat, argazkiak partekatzeko eta irudien iturriak fediverse-n zehar"

# libretranslate
msgctxt "role:web-app-friendica:description"
msgid "Decentralized, federated social-networking platform for peer-to-peer communication and community building"
msgstr "Gizarte sare-lanerako plataforma deszentralizatu eta federatua, parekoen arteko komunikazioa eta komunitatea eraikitzeko"

# libretranslate
msgctxt "role:user-administrator:description"
msgid "Dedicated administrator account with SSH key access and password-authenticated sudo for secure privilege escalation"
msgstr "Emandako administratzaile kontua SSH gakoen sarbide eta pasahitzaren bidez legeztatutako sudoarekin pribilegioen eskalatze segururako"

# libretranslate
msgctxt "role:user-backup:description"
msgid "Dedicated system account with SSH-restricted commands and passwordless rsync sudo for secure backup access"
msgstr "Sistema dedikatuaren kontua SSHren agindu murriztuekin eta pasahitzik gabeko erresinkronaren sudoarekin babeskopiaren sarbide segurua lortzeko"

# libretranslate
msgctxt "role:sys-service-terminator:description"
msgid "Deferred-start orchestrator for enabling and starting collected systemd services once a play completes"
msgstr "Hasiera-orduko orkestratzailea, behin emanaldia amaituta, sistematutako zerbitzuak gaitzeko eta hasteko."

# libretranslate
msgctxt "category:web.app:description"
msgid "Deployable web applications (GitLab, Nextcloud, Mastodon, etc.)"
msgstr "Web aplikazio hedatuak (GitLab, Nextcloud, Mastodon, etab.)"

# libretranslate
msgctxt "category:desk:title"
msgid "Desktop"
msgstr "Mahaigaina"

# libretranslate
msgctxt "role:desk-spotify:description"
msgid "Desktop client for streaming music, playlists, and podcasts"
msgstr "Mahaigaineko bezeroa musika, erreprodukzio-zerrenda eta podcastetarako"

# libretranslate
msgctxt "role:desk-nextcloud:description"
msgid "Desktop client setup linking home folders into the cloud-synced directory for integrated file synchronization"
msgstr "Mahaigainaren bezero-konfigurazioa, etxeko karpetak hodeian sinkronizatutako direktoriora estekatzen fitxategi-sinkronizazio integraturako"

# libretranslate
msgctxt "role:desk-gnome-extensions:description"
msgid "Desktop config role for activating GNOME Shell extensions and installing a CLI tool to manage them"
msgstr "Mahaigainaren konfigurazio-funtzioa GNOME Shell hedapenak aktibatzeko eta CLI tresna bat instalatzeko haiek kudeatzeko"

# libretranslate
msgctxt "category:desk:description"
msgid "Desktop environment roles & apps (GNOME, browser, LibreOffice, etc.)"
msgstr "Mahaigainaren ingurune-rolak eta aplikazioak (GNOME, arakatzailea, LibreOffice, etab.)"

# libretranslate
msgctxt "role:desk-bluray-player:description"
msgid "Desktop media-player setup with VLC and AACS/BD+ libraries for Blu-ray disc decryption and playback on Arch Linux"
msgstr "Mahaigaineko multimedia-jokalaria VLC eta AACS/BD+ liburutegiekin konfiguratu da Blu-ray diskoaren desenkripziorako eta erreproduzitzeko Arch Linux-en"

# libretranslate
msgctxt "role:desk-libreoffice:description"
msgid "Desktop office suite for documents, spreadsheets, and presentations with Liberation fonts and language packs"
msgstr "Mahaigaineko bulegoko suitea, dokumentuak, kalkulu-orriak eta aurkezpenak Liberation letra-tipoekin eta hizkuntza-paketeekin"

# libretranslate
msgctxt "role:desk-gnome-caffeine:description"
msgid "Desktop utility for inhibiting screen blanking and sleep, autostarted on the GNOME desktop"
msgstr "Mahaigainaren utilitatea pantaila husteko eta lo egiteko, GNOME mahaigainean automatikoki abiarazia"

