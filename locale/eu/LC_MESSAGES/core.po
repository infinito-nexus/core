msgid "Ansible helper role for idempotent persistence and lookup of per-user application tokens in a local YAML store"
msgstr "Laguntza-eginkizun ansiblea erabiltzailearen aplikazio-tokenen jarraipena egiteko YAML biltegi lokal batean"

# libretranslate
msgctxt "category:web.app:title"
