# libretranslate
msgid "You MUST NOT add a target unless a human operator or CI should run it directly."
msgstr "Non debe engadir un obxectivo a menos que un operador humano ou CI o execute directamente."

# libretranslate
msgid "You MUST NOT add emojis to `docs/agents/` files, but workflow `name:` fields are not agent files and MUST use emojis."
msgstr "Non hai que engadir emojis `docs/agents/` Ficheiros, pero fluxo de traballo `name:` Os campos non son ficheiros de axente e deben usar emojis."

# libretranslate
msgid "You MUST NOT add emojis to headlines in `docs/agents/` files, as these are machine-readable instruction files where emojis interfere with parsing."
msgstr "Non debes engadir emojis aos titulares `docs/agents/` ficheiros, xa que estes son ficheiros de instrucións lexibles por máquina onde os emojis interfiren co parsing."

