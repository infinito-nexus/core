# libretranslate
msgid "Review the process at regular intervals and change it when it is not working."
msgstr "Tinjau proses pada interval reguler dan mengubahnya ketika tidak bekerja."

# libretranslate
msgid "Reviewer MUST confirm both source and destination repos."
msgstr "Peninjau MUST mengkonfirmasi kedua sumber dan tujuan repos."

# libretranslate
msgid "Reviewer MUST confirm intent for every invocation; in particular `gh auth token` MUST be declined unless the operator deliberately wants the token in the transcript."
msgstr "Ulasan HARUS mengkonfirmasi niat untuk setiap doa; khususnya `gh auth token` HARUS ditolak kecuali operator sengaja ingin token dalam transkrip."

# libretranslate
msgid "Reviewer MUST confirm the Dockerfile path, build context, and target tag."
msgstr "Peninjau MUST mengkonfirmasi path Dockerfile, membangun konteks, dan target tag."

# libretranslate
msgid "Reviewer MUST confirm the enterprise slug and intended scope."
msgstr "Review MUST mengkonfirmasi perusahaan siput dan tujuan lingkup."

# libretranslate
msgid "Reviewer MUST confirm the environment and gating change."
msgstr "Review MUST mengkonfirmasi lingkungan dan gating perubahan."

# libretranslate
msgid "Reviewer MUST confirm the key and value, especially for `editor`, `pager`, `git_protocol`."
msgstr "Peninjau MUST mengkonfirmasi kunci dan nilai, terutama untuk `editor`, `pager`, `git_protocol`."

# libretranslate
msgid "Reviewer MUST confirm the new default repository."
msgstr "Peninjau MUST mengkonfirmasi repositori baku baru."

# libretranslate
msgid "Reviewer MUST confirm the org and the specific endpoint."
msgstr "Review MUST mengkonfirmasi org dan titik akhir spesifik."

# libretranslate
msgid "Reviewer MUST confirm the policy delta before approval."
msgstr "Peninjau MUST mengkonfirmasi kebijakan delta sebelum persetujuan."

# libretranslate
msgid "Reviewer MUST confirm the registry URL. If a password is passed via `--password` / `--password-stdin`, the reviewer MUST also confirm that no credential lands in the transcript."
msgstr "Peninjau MUST mengkonfirmasi URL registri. Jika sandi dilewatkan melalui `--password` / `--password-stdin`, Peninjau MUST juga mengkonfirmasi bahwa tidak ada lahan kredensial dalam transkrip."

# libretranslate
msgid "Reviewer MUST confirm the rule delta."
msgstr "Review MUST mengkonfirmasi aturan delta."

# libretranslate
msgid "Reviewer MUST confirm the source/destination owners and visibility."
msgstr "Peninjau MUST mengkonfirmasi pemilik sumber / tujuan dan visibilitas."

# libretranslate
msgid "Reviewer MUST confirm the source/destination repos and that the local working tree tolerates the sync."
msgstr "Peninjau MUST mengkonfirmasi repos sumber / tujuan dan bahwa pohon lokal bekerja mentolerir sinkronisasi."

# libretranslate
msgid "Reviewer MUST confirm the tag and asset payload before approval."
msgstr "Peninjau MUST mengkonfirmasi muatan tag dan aset sebelum persetujuan."

# libretranslate
msgid "Reviewer MUST confirm the target registry, repository, and tag before approval."
msgstr "Peninjau MUST mengkonfirmasi target registri, repositori, dan tag sebelum persetujuan."

# libretranslate
msgid "Reviewer MUST confirm the team and intended change."
msgstr "Review MUST mengkonfirmasi tim dan tujuan perubahan."

# libretranslate
msgid "Reviewer MUST confirm the workflow ref and inputs payload."
msgstr "Peninjau MUST mengkonfirmasi arus kerja ref dan memasukkan muatan."

# libretranslate
msgid "Reviewer MUST confirm the working tree is clean (or stashed) before approving."
msgstr "Review MUST mengkonfirmasi pohon kerja bersih (atau disimpan) sebelum menyetujui."

# libretranslate
msgid "Revisit ambiguous roles only after the confirmed set is green."
msgstr "Revisit ambigu peran hanya setelah dikonfirmasi ditetapkan hijau."

# libretranslate
msgid "Revokes and deletes corresponding Certbot certificates."
msgstr "Membatalkan dan menghapus sesuai Certbot Sertifikat."

# libretranslate
msgid "Revolutionize your email communications with Mailu, a secure and flexible mail server solution that integrates comprehensive features like robust SMTP/IMAP support, advanced spam filtering, DKIM signing, and seamless webmail access. With its modern design and performance-oriented architecture, Mailu empowers you to manage digital correspondence with efficiency and reliability."
msgstr "Revolutionize komunikasi email Anda dengan Mailu, solusi server surat yang aman dan fleksibel yang memadukan fitur komprehensif seperti dukungan SMTP / IMAP yang kuat, penyaringan spam canggih, penandatanganan DKIM, dan akses webmail tanpa warna. Dengan desain modern dan arsitektur pertunjukan, Mailu memberdayakan Anda untuk mengelola korespondensi digital dengan efisiensi dan ketergantungan."

# libretranslate
msgid "Reworked contributor, agent, and operations documentation into granular SPOT-style guides covering workflow, testing, debugging, sandboxing, PR creation, and environment setup"
msgstr "Kontributor, agen, dan dokumentasi operasi menjadi panduan gaya Glular SPOT yang meliputi alur kerja, uji, debug, sandboxing, penciptaan PR, dan pengaturan lingkungan"

# libretranslate
msgid "Reworked image build, push, mirror, wait, and release helper scripts for clearer repository and distro resolution"
msgstr "Bangun ulang gambar, push, mirror, tunggu, dan lepaskan skrip pembantu untuk resolusi repositori yang lebih jelas dan distro"

# libretranslate
msgid "Reworked shared service discovery and loading around the new sys-utils-service-loader flow and the required service semantics"
msgstr "Bekerja ulang penemuan layanan bersama dan memuat sekitar sys-utils- service- loader flow dan semantik layanan yang diperlukan"

