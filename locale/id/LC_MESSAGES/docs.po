# libretranslate
#, python-brace-format
msgid "Read `${TMPDIR:-/tmp}/roundtrip-<app>-<mode>.log` to see which app and mode failed, and the first error."
msgstr "Baca `${TMPDIR:-/tmp}/roundtrip-<app>-<mode>.log` untuk melihat aplikasi dan mode mana yang gagal, dan galat pertama."

# libretranslate
msgid "Read `disable` from the environment and apply to host_vars and inventory."
msgstr "Baca `disable` dari lingkungan dan berlaku ke host_vars dan inventaris."

# libretranslate
msgid "Read `docs/contributing/tools/agents/cheatsheet.md` (relative to the Infinito.Nexus repository root) and answer from it; that document is the source of truth and this skill only routes you there."
msgstr "Baca `docs/contributing/tools/agents/cheatsheet.md` (relatif terhadap Infinito.Nexus akar repositori) dan menjawab dari itu; dokumen yang merupakan sumber kebenaran dan keterampilan ini hanya rute Anda di sana."

# libretranslate
msgid "Read a fact from either the task_vars shape or the setup-module one."
msgstr "Baca fakta dari baik task_vars bentuk atau setup-modul satu."

# libretranslate
msgid "Read a lint tool's pinned release from the ``sys-lint`` role."
msgstr "Baca sebuah alat barus yang disematkan rilis dari ``sys-lint`` peran."

# libretranslate
msgid "Read attribute names, DNs, and the server URI from `LDAP.*`. Never hardcode `uid`, `cn`, base DNs, or LDAP URIs."
msgstr "Baca nama atribut, DNs, dan URI server dari `LDAP.*`. Tidak pernah hardcode `uid`, `cn`, DNs dasar, atau URI LDAP."

# libretranslate
msgid "Read database credentials from the host's databases.csv."
msgstr "Baca kredensial basis data dari host databases.csv."

