msgid "Ask the docker daemon what a replay is allowed to touch."
msgstr "Tanyakan daemon docker apa sebuah replay diperbolehkan untuk menyentuh."

# libretranslate
msgid "Assemble the healthcheck mapping."
msgstr "Kumpulkan pemetaan pemeriksaan kesehatan."

# libretranslate
msgid "Assemble the shared context for a network lookup."
msgstr "Kumpulkan konteks bersama untuk pencarian jaringan."

# libretranslate
msgid "Assertion at the gate"
msgstr "Assertion at the gate"

# libretranslate
msgid "Asset Mirror (Privacy Proxy)"
msgstr "Cermin Asset (Proksi Privasi)"

# libretranslate
msgid "Assets Server"
msgstr "Server Aset"

# libretranslate
msgid "Assets are stored on the filesystem backend (`PENPOT_ASSETS_STORAGE_BACKEND=assets-fs`) on the backup-ready named volume `penpot_assets`, mounted into both `frontend` and `backend` at `/opt/data/assets`."
msgstr "Aset disimpan pada backend sistem berkas (`PENPOT_ASSETS_STORAGE_BACKEND=assets-fs`) pada backup-siap bernama volume `penpot_assets`, dipasang ke keduanya `frontend` dan `backend` di `/opt/data/assets`."

# libretranslate
msgid "Assets are stored on the filesystem backend (``PENPOT_ASSETS_STORAGE_BACKEND=assets-fs``) on the backup-ready named volume ``penpot_assets``, mounted into both ``frontend`` and ``backend`` at ``/opt/data/assets``."
msgstr "Aset disimpan pada backend sistem berkas (``PENPOT_ASSETS_STORAGE_BACKEND=assets-fs``) pada backup-siap bernama volume ``penpot_assets``, dipasang ke keduanya ``frontend`` dan ``backend`` di ``/opt/data/assets``."

# libretranslate
msgid "Assets do not update after a deployment."
msgstr "Aset tidak update setelah penyebaran."

# libretranslate
msgid "Assign exactly one workspace track to every dev-runtime image."
msgstr "Atur tepat satu area kerja trek ke setiap gambar dev- runtime."

