msgid "Reading a Requirement"
msgstr "Membaca Penambahan"

# libretranslate
msgid "Reading a failure 🔍"
msgstr "Membaca kegagalan 🔍"

# libretranslate
msgid "Reading or mutating Actions environments."
msgstr "Membaca atau bermutasi Lingkungan Aksi."

# libretranslate
msgid "Reading or mutating Actions permissions on a repo."
msgstr "Pembacaan atau mutasi Izin Aksi pada repo."

# libretranslate
msgid "Reading or mutating GitHub releases."
msgstr "Membaca atau bermutasi GitHub rilis."

# libretranslate
msgid "Reading or mutating branch protection on a specific branch."
msgstr "Membaca atau bermutasi perlindungan cabang pada cabang tertentu."

# libretranslate
msgid "Reading or mutating branch/tag rulesets (branch protection successor)."
msgstr "Membaca atau bermutasi cabang / tag ruleset (penerus proteksi percabangan)."

