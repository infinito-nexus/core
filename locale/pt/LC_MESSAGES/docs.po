msgid "**Automatic HTTPS Certificates:** Handles secure certificate issuance via Let’s Encrypt."
msgstr "**Certificados HTTPS automáticos:** Lida com emissão segura de certificado via Let’s Encriptar."

# translated-by: libretranslate
msgid "**Automatic Hardware Detection**"
msgstr "**Detecção automática de hardware**"

# translated-by: libretranslate
