# translated-by: libretranslate
msgid "**Single Container:** No database server, no cache, no worker, no object store. SQLite in one volume."
msgstr "**Container único:** Sem servidor de banco de dados, sem cache, sem trabalhador, sem loja de objetos. SQLite em um volume."

# translated-by: libretranslate
msgid "**Single Domain and Wildcard Support:** Handles both individual domains and wildcard domains (`*.example.com`)."
msgstr "**Suporte de Domínio Único e Wildcard:** Lida com domínios individuais e wildcard (`*.example.com`)."

# translated-by: libretranslate
