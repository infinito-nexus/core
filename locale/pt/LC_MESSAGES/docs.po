# translated-by: libretranslate
msgid "**RBAC** — only users in the ``web-app-pihole-administrator`` group can access the dashboard"
msgstr "**RBAC** — apenas os utilizadores no ``web-app-pihole-administrator`` grupo pode acessar o painel"

# translated-by: libretranslate
