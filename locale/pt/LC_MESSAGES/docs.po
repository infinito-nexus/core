msgstr "Sim."

# translated-by: libretranslate
msgid "Yield ``(entity_path, repository, ref)`` for every dict in the tree that declares both keys with truthy string values."
msgstr "Rendimento ``(entity_path, repository, ref)`` para cada dict na árvore que declara ambas as chaves com valores de string truty."

# translated-by: libretranslate
msgid "Yield ``(path, content)`` for matching files; content is cached."
msgstr "Rendimento ``(path, content)`` para os arquivos correspondentes; o conteúdo está em cache."

