msgstr "`web-app-funkwhale` — infra- estrutura do cabeçalho / utilizador remoto do django"

# translated-by: libretranslate
msgid "`web-app-hermes/meta/mcp.yml` `direction: client`, held to the 025 schema by the MCP lint suite"
msgstr "`web-app-hermes/meta/mcp.yml` `direction: client`, 025 esquema pelo conjunto de linhas MCP"

# translated-by: libretranslate
msgid "`web-app-hermes` and `web-app-openclaw` each gain the RBAC role `agent-user` and keep their existing shared instance unchanged."
msgstr "`web-app-hermes` e `web-app-openclaw` cada ganha o papel RBAC `agent-user` e manter a sua instância partilhada existente inalterada."

