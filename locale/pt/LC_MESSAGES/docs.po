msgid "``(files_glob, dump_glob)`` for the layout *names* describe."
msgstr "``(files_glob, dump_glob)`` para a disposição *nomes* descrever."

# translated-by: libretranslate
msgid "``(healthcheck, source)`` where source is ``cache``, ``mirror``, ``upstream`` or ``none``. Reading upstream is the documented fallback for images the mirror does not carry; a caller that sweeps many images can use the counts to tell a fallback from a mirror that stopped working."
msgstr "``(healthcheck, source)`` onde está a fonte ``cache``, ``mirror``, ``upstream`` ou ``none``. Ler a montante é o recurso documentado para imagens que o espelho não carrega; um chamador que varre muitas imagens pode usar as contagens para dizer um recuo de um espelho que parou de funcionar."

# translated-by: libretranslate
msgid "``(input name, opening literal, is_marker)`` per rendered segment, in template order."
msgstr "``(input name, opening literal, is_marker)`` por segmento renderizado, em ordem de modelo."

# translated-by: libretranslate
msgid "``(msgctxt, msgid)`` mapped to ``msgstr``; empty and fuzzy entries are left out, so their source text stands in."
msgstr "``(msgctxt, msgid)`` mapeado para ``msgstr``; entradas vazias e fuzzy são deixadas de fora, então seu texto fonte fica dentro."

# translated-by: libretranslate
msgid "``(msgctxt, msgid)`` pairs in source order."
msgstr "``(msgctxt, msgid)`` pares em ordem de origem."

