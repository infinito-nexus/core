msgid "``(\"SKIPPED\", reason)`` when ping is unavailable or lacks CAP_NET_RAW"
msgstr "``(\"SKIPPED\", reason)`` quando ping não está disponível ou falta CAP_NET_RAW"

# translated-by: libretranslate
msgid "``('', '')`` when the role has no instructions to replay or this sweep deploys no variant that could carry them."
msgstr "``('', '')`` quando o papel não tem instruções para repetir ou esta varredura não implementa nenhuma variante que possa carregá-los."

# translated-by: libretranslate
msgid "``(1-based line number, text)`` for every line inside a ``## Credits`` section, ending at the next heading of any level."
msgstr "``(1-based line number, text)`` para cada linha dentro de uma ``## Credits`` seção, terminando no próximo cabeçalho de qualquer nível."

# translated-by: libretranslate
msgid "``(None, None)`` when every probe size is dropped"
msgstr "``(None, None)`` quando cada tamanho da sonda é largado"

