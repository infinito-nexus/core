msgid "You MUST wait for the DOM before touching elements, and guard missing elements so unrelated pages do not break."
msgstr "Você deve esperar pelo DOM antes de tocar elementos, e guardar elementos ausentes para que páginas não relacionadas não quebram."

# translated-by: libretranslate
