msgstr "`true` ou `false`; anexos `--debug` quando verdadeiro"

# translated-by: libretranslate
msgid "`true` stops an agent after `idle_minutes` without a request; `false` keeps it running"
msgstr "`true` pára um agente depois `idle_minutes` Sem pedido; `false` mantém-na a funcionar"

# translated-by: libretranslate
