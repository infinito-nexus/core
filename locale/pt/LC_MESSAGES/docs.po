msgid "Yield ``(path, lines)`` for every tracked markdown file."
msgstr "Rendimento ``(path, lines)`` para cada ficheiro de marcação."

# translated-by: libretranslate
msgid "Yield ``(role, entity, scope, category, port)`` for every single-int port."
msgstr "Rendimento ``(role, entity, scope, category, port)`` para cada porto de entrada única."

