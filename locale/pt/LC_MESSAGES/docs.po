msgstr "INFINITO_GPU_COUNT: GPUs a reserva de serviços de composição, 'all' quando o daemon docker registra um tempo de execução NVIDIA, caso contrário 0."

# translated-by: libretranslate
msgid "INFINITO_I18N_BATCH_SIZE / INFINITO_I18N_LANES: client settings `make i18n-tune` measured on this host, falling back to the shipped defaults."
msgstr "INFINITO_I18N_BATCH_SIZE / INFINITO_I18N_LANES: configurações do cliente `make i18n-tune` medido nesta máquina, recuando para os padrões enviados."

