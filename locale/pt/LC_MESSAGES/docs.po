msgstr "Você deve preferir alvos que compõem scripts menores em vez de incorporar grandes fragmentos de shell no `Makefile`."

# translated-by: libretranslate
msgid "You SHOULD prefer the explicit cached getter over re-implementing the same memoisation in a calling module."
msgstr "Você deve preferir o getter em cache explícito sobre a reimplementação da mesma memória em um módulo de chamada."

