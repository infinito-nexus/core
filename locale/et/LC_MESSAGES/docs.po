msgid "Do NOT introduce noisy debug logging, uncaught errors, duplicate event handlers, or endless observers into injected scripts."
msgstr "ÄRGE tutvustage lärmakat silumislogimist, tegemata vigu, dubleerivaid sündmuste käitlejaid ega lõputuid vaatlejaid süstitud skriptidesse."

# libretranslate
