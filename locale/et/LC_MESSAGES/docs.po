# libretranslate
msgid "**No external database** - self-contained SQLite under `/config`."
msgstr "**Välist andmebaasi pole** - iseseisev SQLite all `/config`."

# libretranslate
msgid "**No external database** - self-contained SQLite under ``/config``."
