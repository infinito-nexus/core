msgstr "Väline DB puudub; sisemine SQLiit on all `/config`."

# libretranslate
msgid "No external dependencies"
msgstr "Välised sõltuvused puuduvad"

# libretranslate
msgid "No fixed team is always required"
msgstr "Alati ei ole vaja kindlat meeskonda"

# libretranslate
msgid "No git commit until every Acceptance Criterion is checked off (`- [x]`)."
msgstr "Git ei võta kohustust enne, kui iga aktsepteerimiskriteerium on välja lülitatud (`- [x]`)."

# libretranslate
msgid "No git commit until every Acceptance Criterion is checked off."
msgstr "Ei ole kohustuslik enne, kui iga aktsepteerimise kriteerium on kontrollitud."

# libretranslate
msgid "No intermediate merged `users` fact exists. No other source is consulted."
msgstr "Vaheühendit ei ole `users` fakt on olemas. Teiste allikatega ei konsulteerita."

# libretranslate
