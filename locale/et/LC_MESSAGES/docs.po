# translated-by: libretranslate
#, python-brace-format
msgid "**Per-Consumer Isolation:** OSS Qdrant has no per-user auth; each consumer is isolated by the collection-name prefix ``{entity}_``."
msgstr "**Tarbijapõhine eraldamine:** OSS Qdrantil puudub kasutaja autentimine; iga tarbija on eraldatud kogu nime eesliitega ``{entity}_``."

# translated-by: libretranslate
