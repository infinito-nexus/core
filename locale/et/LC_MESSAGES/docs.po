# translated-by: libretranslate
msgid "**HTTP serving** with MIME types, gzip compression, caching, and custom `NGINX.conf` templating."
msgstr "**HTTP serveerimine** MIME tüüpidega, gzip-tihendusega, vahemäluga ja kohandatud `NGINX.conf` ahvatlev."

# translated-by: libretranslate
