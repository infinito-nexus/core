# libretranslate
msgid "**Native OIDC SSO:** Authenticate users against Keycloak via the ``oic-auth`` plugin, configured by JCasC at boot."
msgstr "**Native OIDC SSO:** Kasutajate autentimine Keycloaki vastu ``oic-auth`` plugin, mille JCasC on seadistanud alglaadimisel."

# libretranslate
msgid "**Native OIDC SSO:** Authenticate users against Keycloak via the `oic-auth` plugin, configured by JCasC at boot."
