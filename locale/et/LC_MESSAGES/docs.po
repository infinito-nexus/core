msgstr "**Fail Suletud triivil:** Tööriistaleping, mille räss ei vasta enam oma pinnedile `schema_sha256` keeldub alustamast."

# libretranslate
msgid "**Fails gracefully** with an optional debug message if the Git repository is unreachable."
msgstr "**Ebaõnnestunud graatsiliselt** valikulise silumissõnumiga, kui Git hoidlat ei ole võimalik kätte saada."

# libretranslate
msgid "**Failure Notification**"
msgstr "**Rikkest teatamine**"

# libretranslate
