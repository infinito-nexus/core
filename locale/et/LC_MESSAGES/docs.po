# libretranslate
msgid "Exposes `tasks/utils/debug.yml` as the canonical Ansible wrapper around that script."
msgstr "Avaldab `tasks/utils/debug.yml` Kanooniline Ansible ümbris selle stsenaariumi ümber."

# libretranslate
msgid "Exposes changes to all repository collaborators and CI."
msgstr "Avab muudatused kõigile hoidla kaastöötajatele ja CI-le."

# libretranslate
