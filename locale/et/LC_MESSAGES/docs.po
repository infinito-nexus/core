msgid "**Local-first vault:** Keeps the password database on the workstation, with no mandatory cloud sync."
msgstr "**Kohalik esimene võlvkelder:** Hoiab paroolide andmebaasi tööjaamas ilma kohustusliku pilvsünkroonimiseta."

# translated-by: libretranslate
msgid "**Locale generation**"
msgstr "**Kohalike elanike genereerimine**"

