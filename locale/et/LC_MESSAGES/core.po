msgstr "ebaõnnestus"

# libretranslate
msgctxt "role:svc-net-firewall:description"
msgid "nftables packet filter whose rules each role owns as its own table, replaced atomically and reloaded at boot"
msgstr "nftables pakettfilter, mille reeglid igale rollile kuuluvad oma tabelina, asendatud aatomiliselt ja laaditud alglaadimisel uuesti"

