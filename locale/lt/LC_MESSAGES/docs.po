msgid "`INFINITO_DNS_HOSTS` can still override the generated list explicitly"
msgstr "`INFINITO_DNS_HOSTS` gali dar aiškiai nepaisyti sukurto sąrašo"

# translated-by: libretranslate
msgid "`INFINITO_VERSION_ENV_NAME` (default: `INFINITO_VERSION`)"
msgstr "`INFINITO_VERSION_ENV_NAME` (numatytasis: `INFINITO_VERSION`)"

