# translated-by: libretranslate
msgid "This role detects unused **anonymous Docker volumes** that are not bound to any running container."
msgstr "Šis vaidmuo aptinka nenaudojamas **anoniminiai Docker tomai** kurie nėra sujungti su jokia važiuokle."

# translated-by: libretranslate
msgid "This role detects unused **anonymous Docker volumes** that are not bound to any running container.   It can optionally exclude specific volumes from the check using a configurable whitelist."
msgstr "Šis vaidmuo aptinka nenaudojamas **anoniminiai Docker tomai** kurie nėra sujungti su jokia važiuokle. Jis gali pasirinktinai pašalinti tam tikrus tomus iš patikrinimo naudojant konfigūruojamą baltąjį."

# translated-by: libretranslate
