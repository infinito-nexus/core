msgstr "Iš vaidmens meta / addons /<id>.yml."

# translated-by: libretranslate
msgid "A single commit (or a tight related sequence) lands the whole role addition."
msgstr "Vienas patvirtinimas (arba standi susijusi seka) sumažina visą vaidmenį."

