# translated-by: libretranslate
msgid "Keep hard code easy to explain."
msgstr "Laikyti sunku kodą lengvai paaiškinti."

# translated-by: libretranslate
msgid "Keep helpers focused and composable."
msgstr "Susikoncentruokite ir sukonfigūruokite pagalbininkus."

# translated-by: libretranslate
msgid "Keep injected scripts small, explicit, and tightly scoped to the role's real integration need."
