msgstr "Jei sistema jau veikia, tyliai išėjimai (`/run/systemd/system` egzistuoja)"

# translated-by: libretranslate
msgid "Simple and lightweight"
msgstr "Paprastas ir lengvas"

# translated-by: libretranslate
msgid "Simple code changes more safely."
msgstr "Paprastas kodas keičiasi saugiau."

# translated-by: libretranslate
msgid "Simple code is easier to change."
msgstr "Paprastas kodas yra lengviau pakeisti."

# translated-by: libretranslate
