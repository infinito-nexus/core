msgid "**Static Content Hosting:** Serve any type of static files (documents, software, media, etc.)."
msgstr "**Statinio turinio kaupimas:** Tarnauti bet kokio tipo statinius failus (dokumentai, programinė įranga, žiniasklaida ir t. t.)."

# translated-by: libretranslate
msgid "**Static IP:** Exposes a fixed resolver address on its own network for ``dns:`` targeting."
msgstr "**Statinis IP:** Pateikia fiksuoto resolver adresą savo tinkle ``dns:`` taikinys."

# translated-by: libretranslate
msgid "**Static IP:** Exposes a fixed resolver address on its own network for `dns:` targeting."
