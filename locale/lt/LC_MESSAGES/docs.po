# translated-by: libretranslate
msgid "This role ensures that GNU Make is installed on the target system. It is intended for environments where automated build processes or custom software compilation are required."
msgstr "Šis vaidmuo užtikrina, kad GNU Make yra įdiegta tikslinės sistemos. Ji skirta aplinkai, kurioje reikia automatizuotų kūrimo procesų arba programinės įrangos kompiliavimo pagal užsakymą."

# translated-by: libretranslate
msgid "This role executes common tasks for user environment configuration."
msgstr "Šis vaidmuo atlieka bendras užduotis vartotojo aplinkos konfigūravimui."

