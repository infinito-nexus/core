msgid "Interactive REPL that forwards each input line to ``python -m cli`` on the host."
msgstr "Interaktyvus REPL, kuris siunčia kiekvieną įvesties liniją į ``python -m cli`` ant šeimininko."

# translated-by: libretranslate
msgid "Interactive graph visualization of all Infinito.Nexus roles and their dependencies for architecture transparency"
msgstr "Interaktyvus visų vizualizavimas Infinito.Nexus vaidmenys ir jų priklausomybė nuo architektūros skaidrumo"

# translated-by: libretranslate
msgid "Interactive operator prompts for the credentials CLI."
msgstr "Interaktyvus operatorius ragina CLI duomenis."

