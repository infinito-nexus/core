msgid "`templates/openbao.hcl.j2` shape"
msgstr "`templates/openbao.hcl.j2` forma"

msgid "`templates/package.json.j2`: `@playwright/test` version derived from `meta/services.yml.playwright.version`, and `@axe-core/playwright` (WCAG checks through `AxeBuilder`) pinned by `meta/services.yml.playwright.axe_version`"
msgstr ""

