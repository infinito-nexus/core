msgstr "INFINITO_DNS53_SAMPLER_LOG:53 mėginių ėmėjo žurnalas, skaityti iš group_vars keliai SPOT (group_vars/all/05_paths.yml FILE_DNS53_SAMPLER_LOG)."

# translated-by: libretranslate
msgid "INFINITO_DOCKER_PLATFORM: target the architecture this deploy was assigned."
msgstr "INFINITO_DOCKER_PLATFORM: nusitaikyk į architektūrą, kuriai buvo paskirtas šis dislokavimas."

