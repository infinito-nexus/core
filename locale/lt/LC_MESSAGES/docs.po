msgid "Exit code is ``0`` if the file was already sorted (no write), ``0`` after a successful rewrite, ``1`` on read/parse failure."
msgstr "Išvežimo kodas yra ``0`` jei failas jau buvo rikiuotas (nėra rašymo), ``0`` po sėkmingo perrašymo, ``1`` dėl skaitymo / skaitymo gedimo."

# translated-by: libretranslate
msgid "Exit codes as a module: 0 with one ``<volume>\\t<engine>`` line per undumped database volume, 2 when the generation carries no manifest, 64 on bad usage."
msgstr "Išeiti kodus kaip modulį: 0 su vienu ``<volume>\\t<engine>`` eilutė kiekvienam nedempingo duomenų bazės kiekiui, 2 kai generavimas neturi manifesto, 64 dėl netinkamo naudojimo."

# translated-by: libretranslate
msgid "Exit non-zero if `K` ranges of size `N` cannot be fit within the band."
msgstr "Išeiti - nulis, jei `K` dydžio ribos `N` negali būti tinkami toje juostoje."

# translated-by: libretranslate
msgid "Exit non-zero if the requested count cannot be satisfied within the band."
msgstr "Išeiti ne nulį, jei prašomas skaičius negali būti patenkintas juostoje."

# translated-by: libretranslate
msgid "Exit the shell:"
msgstr "Išimkite apvalkalą:"

# translated-by: libretranslate
msgid "Exits non-zero on matches."
msgstr "Išeina be nulio rungtynėse."

