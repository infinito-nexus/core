# translated-by: libretranslate
msgid "INFINITO_FORK_REPOSITORY_URL: GitHub URL of the operator's fork, composed from INFINITO_FORK_ACCOUNT and INFINITO_FORK_REPOSITORY_NAME."
msgstr "INFINITO_FORK_REPOSITORY_URL: GitHub URL operatoriaus šakutės, sudarytas iš INFINITO_FORK_ACCOUNT ir INFINITO_FORK_REPOSITORY_NAME."

# translated-by: libretranslate
msgid "INFINITO_GIT_AUTHOR_NAME / INFINITO_GIT_AUTHOR_EMAIL: the identity this checkout commits under. The test container mounts the checkout but not the contributor's git configuration, so the suite cannot ask git who is about to commit; the ``.env`` carries the answer across."
msgstr "INFINITO_GIT_AUTHOR_NAME / INFINITO_GIT_AUTHOR_EMAIL: tapatybė, kurią šis kasos įsipareigoja pagal. Bandymo konteineris prideda kasos, bet ne duomenų teikėjo git konfigūraciją, todėl rinkinys negali paklausti git kas ketina įsipareigoti; ``.env`` pateikia atsakymą."

# translated-by: libretranslate
msgid "INFINITO_GPU_COUNT: GPUs the compose services reserve, 'all' when the docker daemon registers an NVIDIA runtime, else 0."
msgstr "INFINITO_GPU_COUNT: GPU kūrimo paslaugų rezervas, 'all' kai doker tarnyba registruoja NVIDIA bėgimo laikas, kita 0."

# translated-by: libretranslate
msgid "INFINITO_I18N_BATCH_SIZE / INFINITO_I18N_LANES: client settings `make i18n-tune` measured on this host, falling back to the shipped defaults."
msgstr "INFINITO_I18N_BATCH_SIZE / INFINITO_I18N_LANES: kliento nustatymai `make i18n-tune` matuojami šiame mazge, grįžtant prie siunčiamų įsipareigojimų neįvykdymo atvejų."

