msgstr "Flowise registras prijungtame kaištyje"

# libretranslate
msgid "Flowise supports Custom MCP. Production deployment MUST NOT enable arbitrary stdio commands by default."
msgstr "Flowise palaiko Custom MCP. Gamybos diegimas NEGALI leisti savavališkai stdio komandas pagal nutylėjimą."

