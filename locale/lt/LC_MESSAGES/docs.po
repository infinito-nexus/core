msgid "``package.json`` and ``playwright.config.js`` are provided centrally by this role:"
msgstr "``package.json`` ir ``playwright.config.js`` yra centralizuotai teikiamos šio vaidmens:"

# translated-by: libretranslate
msgid "``package_name`` (string) Name of the Python package to install (e.g., ``dockreap``, ``backup-docker-to-local``)."
msgstr "``package_name`` (eilutė) Įdiegtino Python paketo pavadinimas (pvz., ``dockreap``, ``backup-docker-to-local``)."

