msgid "Assemble the healthcheck mapping."
msgstr "Surinkti sveikatos patikrinimo žemėlapį."

msgid "Assemble the iteration plan of one diff: tiers T0 to T3, the rows behind them and every cut."
msgstr ""

# translated-by: libretranslate
msgid "Assemble the shared context for a network lookup."
msgstr "Surinkite bendrą kontekstą tinklo peržiūrai."

