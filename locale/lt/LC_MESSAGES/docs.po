msgid "An `ImageRef` carries: `role`, `service`, `name` (without registry), `version`, `source` (full pull ref), `registry`, and `source_file`."
msgstr "An `ImageRef` turi: `role`, `service`, `name` (be registro), `version`, `source` (visiškai traukti ref), `registry`, ir `source_file`."

# translated-by: libretranslate
