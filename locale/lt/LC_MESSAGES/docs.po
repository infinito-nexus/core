# translated-by: libretranslate
msgid "The description MUST use `kebab-case` (lowercase words separated by hyphens) and SHOULD be short enough to read at a glance."
msgstr "Aprašymas PRIVALO būti naudojamas `kebab-case` (Žemagrindžiai žodžiai atskirti hyphens) Ir TURĖTŲ būti pakankamai trumpas skaityti iš pirmo žvilgsnio."

# translated-by: libretranslate
msgid "The description paragraph MUST be a single paragraph (no blank lines inside it)."
