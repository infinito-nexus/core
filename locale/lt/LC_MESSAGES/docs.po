# translated-by: libretranslate
msgid "Multi-user (daemon) installation mode"
msgstr "Daugiasrautis naudotojas (daemon) montavimo veiksena"

# translated-by: libretranslate
msgid "Multiple paths (returns list, one result per term)::"
msgstr "Keli keliai (grąžina sąrašą, vieną rezultatą per terminą):"

# translated-by: libretranslate
msgid "Multiple roles or shared code"
msgstr "Keli vaidmenys arba bendras kodas"

# translated-by: libretranslate
msgid "Multiple rules may be combined on one comment, comma-separated:"
msgstr "Su vienu komentaru gali būti sujungtos kelios taisyklės:"

# translated-by: libretranslate
