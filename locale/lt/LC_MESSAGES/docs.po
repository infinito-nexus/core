msgstr "INFINITO_DIR_SECRETS: šeimininkas paslaptys dir, kilęs iš var- lib SPOT (INFINITO_DIR_VAR_LIB); veidrodžiai group_vars/all/05_paths.yml DIR_SECRETS."

# translated-by: libretranslate
msgid "INFINITO_DIR_VAR_LIB: Infinito state/secrets base dir, read from the group_vars paths SPOT (group_vars/all/05_paths.yml DIR_VAR_LIB)."
msgstr "INFINITO_DIR_VAR_LIB: Infinito valstybės / paslapčių bazė, skaityti iš group_vars keliai SPOT (group_vars/all/05_paths.yml DIR_VAR_LIB)."

