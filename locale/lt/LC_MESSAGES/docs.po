msgid "Reuses an existing `devices.yml` inventory and redeploys one or more apps quickly."
msgstr "Pakartotinai naudoja esamą `devices.yml` inventorius ir perdislokuoja vieną ar daugiau programų greitai."

# translated-by: libretranslate
msgid "Reuses an existing `devices.yml` inventory, purges the entity first, and redeploys one or more apps quickly."
msgstr "Pakartotinai naudoja esamą `devices.yml` inventorizacija, valo subjektas pirmiausia, ir perdislokuoja vieną ar daugiau programų greitai."

# translated-by: libretranslate
msgid "Reuses the existing inventory, keeps app state, runs the deploy only."
msgstr "Pakartotinai naudoja esamą inventorių, išlaiko app būseną, veikia tik dislokavimas."

