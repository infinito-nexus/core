msgstr "Moduliai turi būti identiški ir nuspėjami."

# translated-by: libretranslate
msgid "Keep one implementation for each behavior and remove repeated logic from the touched files."
msgstr "Išlaikyti vieną įgyvendinimą kiekvienam elgesiui ir pašalinti pasikartojančią logiką iš paliestų failų."

# translated-by: libretranslate
msgid "Keep one inventory directory per environment."
