# translated-by: libretranslate
msgctxt "role:svc-db-typesense:description"
msgid "Central Dockerized search engine shared by multiple apps with per-consumer scoped API keys"
msgstr "Centrinė dokumentuota paieškos sistema, kuria dalinasi kelios programėlės su vartotojo programėlėmis API raktai"

# translated-by: libretranslate
msgctxt "role:svc-ai-tika:description"
msgid "Central document extraction engine that turns uploaded files into text for retrieval-augmented chat"
msgstr "Centrinis dokumentų ištraukimo variklis, kuris įkeltus failus paverčia tekstu, skirtu reseval- augmenizuotiems pokalbiams"

# translated-by: libretranslate
msgctxt "menu:Help:description"
msgid "Central help resources, including documentation, support tools, and guidance."
msgstr "Centrinės pagalbos ištekliai, įskaitant dokumentus, pagalbines priemones ir gaires."

# translated-by: libretranslate
msgctxt "role:svc-db-memcached:description"
msgid "Central in-memory caching engine with per-consumer key-prefix isolation, usable centrally or as an embedded sidecar"
msgstr "Centrinis atminties spartinimo variklis su vartotojo raktų priešdėlio izoliacija, naudojamas centralizuotai arba kaip įtaisyta šoninė dalis"

# translated-by: libretranslate
msgctxt "role:sys-service-loader:description"
msgid "Central loader role for ordered shared-service preloading and queued post-load role inclusions across the deployment"
msgstr "Centrinis krautuvas funkcija užsakyta dalybės- paslaugų išankstinio pakrovimo ir eilėje po apkrovos vaidmenį introdukcijos visoje diegimo"

# translated-by: libretranslate
msgctxt "role:web-svc-logout:description"
msgid "Central logout proxy for single-action sign-out across all OIDC-connected apps, with Nginx snippets and a live status UI"
msgstr "Centrinis registracijos proxy single-action sign- out visoje OIDC-connected programėlių, su Nginx iškarpos ir gyvas statusas UI"

# translated-by: libretranslate
msgctxt "role:sys-svc-mail:description"
msgid "Central mail orchestration role for Infinito.Nexus, integrating Email SaaS, msmtp, and an optional local SMTP relay"
msgstr "Centrinės pašto orkestravimo vaidmuo Infinito.Nexus, integruoti elektroninio pašto SaaS, msmtp, ir pasirinktinai vietos SMTP relės"

# translated-by: libretranslate
msgctxt "category:svc.dns:description"
msgid "Central recursive/forwarding DNS resolver engines (Unbound, etc.)"
msgstr "Centriniai rekursiniai / ekspedijavimo DNS resolver varikliai (Unboundir t. t.)"

# translated-by: libretranslate
msgctxt "role:svc-dns-unbound:description"
msgid "Central recursive/forwarding DNSSEC resolver on a static IP for consumer stacks to target as their DNS"
msgstr "Centrinis rekursinis / ekspedijavimo DNSSEC resolver ant statinio IP vartotojų kaminai, kad būtų siekiama kaip jų DNS"

# translated-by: libretranslate
msgctxt "role:svc-db-elasticsearch:description"
msgid "Central search and analytics engine with per-consumer index namespaces isolating tenants in a shared Docker deployment"
msgstr "Centrinė paieškos ir analizės sistema su vartotojų indekso vardais, izoliuojančiais nuomininkus bendrame Docker diegimo"

# translated-by: libretranslate
msgctxt "role:svc-db-qdrant:description"
msgid "Central vector database engine for storing and searching per-consumer embeddings shared across the stack"
