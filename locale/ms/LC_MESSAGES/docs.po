msgid "You MUST NOT run more than one deploy command at the same time. Deployments MUST be executed serially, never in parallel."
msgstr "Anda TIDAK HARUS menjalankan lebih dari satu perintah mengerahkan pada saat yang sama. Penghancuran akan dilaksanakan secara berantai, tidak pernah paralel."

# translated-by: libretranslate
msgid "You MUST NOT run more than one unit test command at the same time. Unit tests MUST be executed serially, never in parallel."
msgstr "Anda TIDAK HARUS menjalankan lebih dari satu perintah tes unit pada saat yang sama. Tes unit unit .yang harus dilaksanakan secara berantai, tidak pernah paralel."

# translated-by: libretranslate
msgid "You MUST NOT skip the inter-round purge."
msgstr "Kau tidak boleh melewatkan pembersihan antar ronde."

# translation-refused: libretranslate protected-span
# nocheck: url
# translation-rejected: Kau tidak boleh menggunakan `--no-verify` Kecuali
