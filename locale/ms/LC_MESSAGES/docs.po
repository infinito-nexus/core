# translated-by: libretranslate
msgid "Walk every `roles/*/meta/server.yml` and collect occupied CIDRs from `networks.local.subnet`."
msgstr "Berjalan setiap `roles/*/meta/server.yml` Dan mengumpulkan CIDR yang diduduki dari `networks.local.subnet`."

