msgid "Always create the new domain and user in Mailu first."
msgstr "Selalu buat domain dan pengguna baru di Mailu Pertama."

# translated-by: libretranslate
msgid "Always overwrite `image`/`version` from the mirror"
msgstr "Sentiasa tulis-ganti `image`/ / / //`version` Dari cermin"

# translated-by: libretranslate
msgid "Always purge the Cloudflare cache after significant changes to your website or OpenResty/NGINX configuration."
msgstr "Selalu singkir cache Cloudflare setelah perubahan signifikan ke situs web Anda atau OpenRestyKonfigurasi /NGINX."

# translated-by: libretranslate
msgid "Always resolve tokens as: **``users → token store → empty``**"
msgstr "Selalu menyelesaikan token sebagai: **``users → token store → empty``**"

# translated-by: libretranslate
msgid "Always resolve tokens as: **`users → token store → empty`**"
