# OpenBao menyimpan ruang nama metrik Vault, dan pancaran node tak tersegel
# yang sehat ``vault_core_unsealed{cluster=""} 0``, Jadi waspadalah ``== 0``
# Kebakaran permanen. Guna ``/v1/sys/health`` (503 Saat dimeteraikan));
# ``vault_core_active{cluster="…"} == 1`` Keteguhan.
#, python-brace-format
msgid "**Do not alert on ``vault_core_unsealed``.** OpenBao keeps Vault’s metric namespace, and a healthy unsealed node emits ``vault_core_unsealed{cluster=\"\"} 0``, so an alert on ``== 0`` fires permanently. Use ``/v1/sys/health`` (503 while sealed); ``vault_core_active{cluster=\"…\"} == 1`` corroborates."
msgstr ""

# menyimpan ruang nama metrik Vault, dan pancaran node tak tersegel yang sehat
# `vault_core_unsealed{cluster=""} 0`, Jadi waspadalah `== 0` Kebakaran
# permanen. Guna `/v1/sys/health` (503 Saat dimeteraikan));
# `vault_core_active{cluster="…"} == 1` Keteguhan.
#, python-brace-format
msgid "**Do not alert on `vault_core_unsealed`.** OpenBao keeps Vault's metric namespace, and a healthy unsealed node emits `vault_core_unsealed{cluster=\"\"} 0`, so an alert on `== 0` fires permanently. Use `/v1/sys/health` (503 while sealed); `vault_core_active{cluster=\"…\"} == 1` corroborates."
msgstr ""

