# translated-by: libretranslate
msgid "The description MUST use `kebab-case` (lowercase words separated by hyphens) and SHOULD be short enough to read at a glance."
msgstr "Përdorimi i përshkrimit MUST `kebab-case` (poshtë) ASKUSH do të ishte aq i shkurtër sa të lexonte."

