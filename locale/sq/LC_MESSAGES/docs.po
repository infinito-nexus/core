msgstr "**Pastrimi i njësive:** Heqja automatike e njësive të vjetra të shërbimit."

# translated-by: libretranslate
msgid "**Universal logout:** Integrated session termination across the stack."
msgstr "**Ndërpritja Universale:** Integruar sesion fund nëpër stuck."

# translated-by: libretranslate
