msgid "Exports `sys_token_store_token`"
msgstr "Eksporto `sys_token_store_token`"

# translated-by: libretranslate
msgid "Expose app-specific base URLs, issuer URLs, feature flags, and credentials only when the spec consumes them."
msgstr "Shfaq URLtë bazë specifike të programeve, URL-të e lëshimit, flamujt dhe kredencialet vetëm kur spektori i konsumon ato."

