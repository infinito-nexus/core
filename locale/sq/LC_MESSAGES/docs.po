# translated-by: libretranslate
msgid "__Increment fallback:__ if the band has no internal gaps, propose `max(used) + 1` (clamped to the band's upper bound)."
msgstr "Nëse grupi nuk ka boshllëqe të brendshme, propozon `max(used) + 1` (Të lidhur në pjesën e sipërme të grupit)."

