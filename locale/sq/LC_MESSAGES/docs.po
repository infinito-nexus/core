# translated-by: libretranslate
msgid "Allows a raw `Path.rglob`, `os.walk`, or `glob.glob` call outside the `utils.cache.files.iter_project_files` contract."
msgstr "Lejon një të gjallë `Path.rglob`. `os.walk`, ose `glob.glob` Thirrje jashtë `utils.cache.files.iter_project_files` Kontrata."

# translated-by: libretranslate
