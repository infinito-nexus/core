# translated-by: libretranslate
msgid "Raises AnsibleError if mem_limit is missing/invalid OR if mem_limit (MB) < min_mb."
msgstr "Shton një energji të dukshme nëse mem_limit mungon/invalid OSE nëse mem_limit (MB) < min_mb."

