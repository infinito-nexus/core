msgid "Zero the variable — all CI reverts to GitHub-hosted runners."
msgstr "Zero, i ndryshueshëm, i gjithë CI kthehet tek vrapuesit e KitHub."

# translated-by: libretranslate
msgid "Zero write-back and no permanently stored root token, satisfying \"minimize the requirement for permanently stored bootstrap credentials\"."
msgstr "Zero mbrapa shkrimi dhe nuk ka një shenjë root të ruajtur përgjithmonë, të kënaqshme \"Zvogëlo kërkesën për kredenciale të ruajtura përgjithmonë\"."

