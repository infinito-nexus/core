# translated-by: libretranslate
msgid "**Monitoring and dashboard entries:** Registers the hub with the metrics and dashboard services when those are part of the deployment."
msgstr "**Mbikqyrja dhe zërat në tabelë:** Regjistron shpërndarësin me metrikët dhe shërbimet e stendave kur ato janë pjesë e vendosjes."

# translated-by: libretranslate
msgid "**Monitoring**   You can follow logs in real time with `journalctl -f`."
msgstr "**Monitorimi** Mund t'i ndjekësh shkrimet në kohë reale `journalctl -f`."

