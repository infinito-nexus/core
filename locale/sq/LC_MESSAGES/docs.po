msgid "`web-app-funkwhale` — django header / remote-user auth backend"
msgstr "`web-app-funkwhale` ⇩ Django header / remote-user auth backend"

# translated-by: libretranslate
msgid "`web-app-hermes/meta/mcp.yml` `direction: client`, held to the 025 schema by the MCP lint suite"
msgstr "`web-app-hermes/meta/mcp.yml` `direction: client`, të mbajtur në 025 Skema nga suita MCP"

# translated-by: libretranslate
