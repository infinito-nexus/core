msgstr "Sjellja e shthurur është më e lehtë për t'u arsyetuar."

# translated-by: libretranslate
msgid "Explicit operator opt-in; the README documents the blast radius (this agent can do anything the device can)."
msgstr "Operatori i Explicit zgjedh-in; LEXME dokumenton rrezen e shpërthimit (Ky agjent mund të bëjë gjithçka që pajisja mundet)."

# translated-by: libretranslate
msgid "Explicitly out of scope for this requirement, tracked for later:"
