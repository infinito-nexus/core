msgid "`tests/lint/...`                           collision/band checks"
msgstr "`tests/lint/...` Kontrollet për përplasje/bend"

# translated-by: libretranslate
msgid "`tests/lint/ansible/roles/meta/test_unpinned_no_engine_volume.py` stays as the guard: an unpinned role must not declare an engine on-disk data volume."
msgstr "`tests/lint/ansible/roles/meta/test_unpinned_no_engine_volume.py` qëndron si roje: një rol i paprishur nuk duhet të deklarojë një motor në volumin e të dhënave."

