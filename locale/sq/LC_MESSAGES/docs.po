msgstr "Emrat bazë jode janë SPOT në default.env (me scripts/tests/deploy/swarm/utils/topology/base.sh); Vetëm SWARM_NAME Prefiksi zbatohet këtu kështu që emrat mikpritës përputhen me kontejnerët. Env merr() Mbaje SWARM_NAME importo() E zbaton në kohën e vrapimit."

# translated-by: libretranslate
msgid "Node names come from `default.env` (`INFINITO_SWARM_*_NAME`) with the `SWARM_NAME` prefix. `INFINITO_APP_VARIANTS` feeds `derive_includes` to select the active variant; in-process callers pass the map as `derive_includes(app_id, variants=...)`."
msgstr "Emrat node vijnë nga `default.env` (`INFINITO_SWARM_*_NAME`) me `SWARM_NAME` Prefiks. `INFINITO_APP_VARIANTS` Ushqehen `derive_includes` për të zgjedhur variantin aktiv; telefonuesit në proces kalojnë hartën si `derive_includes(app_id, variants=...)`."

# translated-by: libretranslate
msgid "Node.js runtime provisioning for the JavaScript unit suite."
msgstr "Node.js Koha e nisjes për suitën JavaScript."

# translated-by: libretranslate
