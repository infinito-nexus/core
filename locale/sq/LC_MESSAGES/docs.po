# translated-by: libretranslate
msgid "Tests in this directory MUST only cover SSO configuration invariants. Generic port-uniqueness and port-reference-validity rules MUST live under `tests/integration/ports/`, and domain-related checks MUST live under `tests/integration/domains/`."
msgstr "Testet në këtë directory MUST mbulojnë vetëm invariantët e konfigurimit SSO. I përgjithshëm port-unikaciness dhe prot-validiteti rregulla MUST jetojnë nën `tests/integration/ports/`, dhe kontrollet lidhur me domenin MUST jetojnë nën `tests/integration/domains/`."

