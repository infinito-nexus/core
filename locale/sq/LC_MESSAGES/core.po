# translated-by: libretranslate
msgctxt "category:sys:title"
msgid "System"
msgstr "Sistemi"

# translated-by: libretranslate
msgctxt "category:sys.front:title"
msgid "System Frontend Helpers"
msgstr "Ndihmësit e parë të sistemit"

# translated-by: libretranslate
msgctxt "role:dev-locales:description"
msgid "System configuration role for setting up and generating localesvia locale.gen and locale.conf templates"
msgstr "Roli i konfigurimit të sistemit për ngritjen dhe gjenerimin e lokaleve locale.gen dhe locale.conf Modeli"

# translated-by: libretranslate
msgctxt "role:sys-hostname:description"
msgid "System hostname configuration derived from the inventory host entry"
msgstr "Konfigurimi i emrit të host të sistemit rrjedh nga hyrja host inventarit"

# translated-by: libretranslate
msgctxt "category:sys:description"
msgid "System near components. Will be automaticly called if necessary from other roles."
msgstr "Sistemi afër përbërësit. Do të thirren automatikisht nëse është e nevojshme nga role të tjera."

# translated-by: libretranslate
msgctxt "role:update:description"
msgid "System-maintenance role for refreshing the package index and upgrading installed packages via the OS package manager"
msgstr "Roli i mbajtjes së sistemit për përmirësimin e indeksit të paketës dhe përmirësimin e paketave të instaluara nëpërmjet menazhuesit të paketave OS"

# translated-by: libretranslate
msgctxt "role:sys-cli:description"
msgid "System-wide command-line interface for managing and operating the entire self-hosted platform environment from the shell"
msgstr "Ndërfaqe në të gjithë sistemin e komandës për menaxhimin dhe operimin e krejt mjedisit të vetë-qeverisur të platformës nga guaska"

# translated-by: libretranslate
msgctxt "role:sys-pip-install:description"
msgid "System-wide pip helper for installing or upgrading a Python package via the host's system Python"
msgstr "Ndihmësi në të gjithë sistemin për instalimin apo përmirësimin e një pakete python nëpërmjet sistemit python"

# translated-by: libretranslate
msgctxt "role:sys-ctl-mtn-cert-deploy:description"
msgid "Systemd service and timer for syncing Let's Encrypt certificates into Docker Compose NGINX stacks with hot-reload"
msgstr "Shërbimi dhe kohëmatësi për sinkronizimin e çertifikatave të Kriptonit Le të futet Docker Compose NGINX stivë me ngarkesë të nxehtë"

# translated-by: libretranslate
msgctxt "role:sys-timer:description"
msgid "Systemd timer unit for starting a service on a recurring calendar schedule for automated task execution"
msgstr "Njësia e kronometrit të sistemit për nisjen e një shërbimi në një kalendar periodik për ekzekutimin e një aktiviteti automatik"

# translated-by: libretranslate
msgctxt "role:sys-ctl-cln-docker:description"
msgid "Systemd-driven cleanup service pruning anonymous Docker volumes plus images, containers, networks, and build cache"
msgstr "Të nxitura nga sistemi për të pastruar shërbimin, duke hequr volumet anonime Docker plus imazhet, kontejnerët, rrjetet dhe duke ndërtuar cache"

# translated-by: libretranslate
msgctxt "role:sys-ctl-rpr-container-hard:description"
msgid "Systemd-scheduled maintenance role for full Docker Compose stack restarts, with hard restarts for stacks like Mailu"
msgstr "Roli i mirëmbajtjes i përcaktuar sistem për t'u plotësuar Docker Compose Stivni rinisjet, me rinisje të vështira për t'u hequr si Mailu"

# translated-by: libretranslate
msgctxt "role:sys-ctl-hlth-container:description"
msgid "Systemd-timed monitor for detecting unhealthy or non-zero-exited Docker containers and raising failure alerts"
msgstr "Monitorim me kohë të sistemit për zbulimin e kontejnerëve të pashëndetshëm apo jo-zero-eksitueshëm Docker dhe ngritjen e alarmeve të dështimit"

# translated-by: libretranslate
msgctxt "role:sys-ctl-alm-email:description"
msgid "Systemd-triggered msmtp notifier for emailing operators when a monitored service unit fails"
msgstr "për"

# translated-by: libretranslate
msgctxt "role:sys-ctl-alm-telegram:description"
msgid "Systemd-triggered notifier for delivering service-failure alerts to a Telegram chat"
msgstr "për a"

# translated-by: libretranslate
msgctxt "role:dsk-gnt-claude:description"
msgid "Terminal coding agent from Anthropic, pointed at the platform's own model gateway instead of the vendor API"
msgstr "Terminal codding anthropic, vuri në dukje portën model të platformës në vend të shitësit API"

# translated-by: libretranslate
msgctxt "role:dsk-gnt-codex:description"
msgid "Terminal coding agent from OpenAI, pointed at the platform's own model gateway instead of the vendor API"
msgstr "Terminal codding agjent nga OpenAI, vuri në dukje portën model të platformës në vend të shitësit API"

# translated-by: libretranslate
msgctxt "role:dsk-gnome-terminal:description"
msgid "Terminal emulator for the GNOME desktop, giving command-line access on Arch Linux workstations"
msgstr "Emulues i terminalit për desktopin GNOME, duke dhënë akses nga komandat në Arch Linux"

# translated-by: libretranslate
msgctxt "role:dsk-micro:description"
msgid "Terminal-based text editor with modern keybindings and syntax highlighting for Pacman-based workstations"
msgstr "Modifikues teksti bazuar në terminal me detyrueset moderne dhe vënien në dukje të sintaksës për funksionimin me bazë në Pacman"

# translated-by: libretranslate
msgctxt "role:test-e2e-cli:description"
msgid "Test-harness role running end-to-end CLI test scripts for roles that declare a test environment template"
msgstr "Roli i testimit që funksionon nga fundi në fund CLI për rolet që deklarojnë një model të mjedisit të testimit"

# translated-by: libretranslate
msgctxt "logout:pace"
msgid "This usually takes a few seconds."
msgstr "Zakonisht duhen disa sekonda."

# translated-by: libretranslate
msgctxt "role:svc-opt-ssd-hdd:description"
msgid "Tiering role placing Docker volumes on SSD or HDD by workload type, with symlinks keeping paths consistent"
msgstr "Roli i vendosjes së vëllimeve Docker në SSD ose HDDD nga lloji i ngarkesës së punës, me simlinks që mbajnë shtigje të qëndrueshme"

# translated-by: libretranslate
msgctxt "role:dev-python:description"
msgid "Toolchain for Python scripting, application development, and data science on Linux"
msgstr "Mjet për skenarimin Python, zhvillimin e aplikimit dhe shkencën e të dhënave në Linux"

# translated-by: libretranslate
msgctxt "menu:Tools:title"
msgid "Tools"
msgstr "Instrumentë"

# translated-by: libretranslate
msgctxt "menu:User Management:description"
msgid "Tools for Identity and Access Management, including authentication, user provisioning, and secure access control."
msgstr "Mjete për Menaxhimin e Identitetit dhe Accesit, duke përfshirë autentifikimin, furnizimin me përdorues dhe kontrollin e sigurtë të aksesit."

# translated-by: libretranslate
msgctxt "menu:Communication:description"
msgid "Tools for communication"
msgstr "Instrumentë për komunikimin"

# translated-by: libretranslate
msgctxt "menu:Marketing:description"
msgid "Tools for email campaigns, audience engagement, automation, and digital marketing workflows."
msgstr "Mjete për fushatat elektronike, fejesën e auditorit, automatizimin dhe hyrjet dixhitale të marketingut."

# translated-by: libretranslate
msgctxt "menu:Asset Management:description"
msgid "Tools to inventory, track, and manage hardware and software assets across your organization."
msgstr "Mjete për të inventarit, për të gjurmuar dhe për të drejtuar pajisjet dhe pajisjet kompjuterike në të gjithë organizatën tuaj."

# translated-by: libretranslate
msgctxt "menu:Community:description"
msgid "Tools to manage the community"
msgstr "Mjete për të menazhuar komunitetin"

# translated-by: libretranslate
msgctxt "menu:Analytics:description"
msgid "Tools to measure, visualize, and optimize website performance and user behavior through data-driven insights."
msgstr "Mjete për të matur, përfytyruar dhe optimizuar performancën në ueb dhe sjelljen e përdoruesve nëpërmjet mendjehollësive të nxitura nga të dhënat."

# translated-by: libretranslate
msgctxt "category:web.opt:description"
msgid "Tools which help to optimize webservers"
msgstr "Instrumentë që ndihmojnë për optimizimin e serverave web"

# translated-by: libretranslate
msgctxt "role:svc-net-tor:description"
msgid "Tor daemon publishing the node as a v3 onion service"
msgstr "Tor daemon3 Shërbimi i qepës"

# translated-by: libretranslate
msgctxt "role:dsk-torbrowser:description"
msgid "Tor network client and browser launcher for anonymous, privacy-focused web browsing"
msgstr "Tor klient dhe shfletues për lundrimet anonime, private-fokuse web"

# translated-by: libretranslate
msgctxt "role:dsk-virtualbox:description"
msgid "Type-2 hypervisor for virtual machines on Pacman workstations, with kernel modules and extension pack"
msgstr "Lloji...2 hipervistor për makineri virtuale në funksionimin e Pacman, me module kokrrash dhe paketë zgjatjeje"

# translated-by: libretranslate
msgctxt "role:sys-ctl-alm-compose:description"
msgid "Unified systemd notification service dispatching service-failure alerts through both Telegram and email channels"
msgstr "Shërbimi i pakorruptuar i njoftimit për dërgimin e alarmeve të shërbimit nëpërmjet kanaleve Telegramë dhe e-mail"

# translated-by: libretranslate
msgctxt "category:update:title"
msgid "Updates & Package Management"
msgstr "Përditësimi i Menaxhimit të Paketave &"

# translated-by: libretranslate
msgctxt "logout:partial_hint"
msgid "Use the links below to sign out of the rest yourself."
msgstr "Përdor lidhjet e mëposhtme për të firmosur vetë pjesën tjetër."

# translated-by: libretranslate
msgctxt "logout:stalled_hint"
msgid "Use the links below to sign out of the services still listed."
msgstr "Përdor lidhjet e mëposhtme për të firmosur jashtë shërbimeve të renditura ende."

# translated-by: libretranslate
msgctxt "menu:User Management:title"
msgid "User Management"
msgstr "Menaxhimi i Përdoruesit"

# translated-by: libretranslate
msgctxt "category:user:description"
msgid "User accounts & access control"
msgstr "Kontroll hyrjeje për llogaritë e përdoruesit"

# translated-by: libretranslate
msgctxt "category:user:title"
msgid "Users & Access"
msgstr "Përdorues dhe hyrje"

# translated-by: libretranslate
msgctxt "role:dsk-git:description"
msgid "Version-control client for personal workstations, preconfigured with identity, signing, and merge defaults"
msgstr "Klienti i kontrollit të versionit për punët personale, i parakonfiguruar me identitetin, nënshkrimin dhe bashkimin e falimentimeve"

# translated-by: libretranslate
msgctxt "role:sys-svc-cdn:description"
msgid "Versioned asset-tree layout for CDN delivery with shared, vendor, and per-role release directories"
msgstr "Shfaqje e versionit të aseteve për shpërndarjen e CDN me të përbashkët, shitëse dhe për-role"

# translated-by: libretranslate
msgctxt "role:dsk-code:description"
msgid "Visual Studio Code workstation editor in a selectable flavor, carrying the extensions of the agents the host deploys"
msgstr "Studio vizuale Code në a nga"

# translated-by: libretranslate
msgctxt "category:web:title"
msgid "Web Infrastructure"
msgstr "Infrastruktura Web"

# translated-by: libretranslate
msgctxt "role:web-app-semaphore:description"
msgid "Web UI and API for running Ansible, Terraform/OpenTofu, and shell automation on a schedule or on demand"
msgstr "Web UI dhe API për drejtimin e Ansible, Terraform/HapTofu, dhe automatizimit në një program apo në kërkesë"

# translated-by: libretranslate
msgctxt "role:web-app-lam:description"
msgid "Web interface for administering LDAP directories: managing users, groups, and other directory objects"
msgstr "Ndërfaqe web për administrimin e directory LDAP: menazhimi i përdoruesve, grupeve dhe objekteve të tjera të directory"

# translated-by: libretranslate
msgctxt "role:web-app-fusiondirectory:description"
msgid "Web-based LDAP administration interface for managing users, groups, and directory objects"
msgstr "Ndërfaqe e administratës me bazë në web, LDAP për menaxhimin e përdoruesve, grupeve dhe objekteve të directory"

# translated-by: libretranslate
msgctxt "role:web-app-phpldapadmin:description"
msgid "Web-based LDAP client for browsing, searching, and administering directory entries in LDAP servers"
msgstr "Klient i bazuar në Internet për shfletimin, kërkimin dhe menazhimin e elementëve të directory në server-ët LDAP"

# translated-by: libretranslate
msgctxt "role:web-app-pgadmin:description"
msgid "Web-based administration and development platform for managing multiple PostgreSQL servers, with optional OAuth2 login"
msgstr "Administrata dhe platforma për zhvillimin e bazuar në ueb për menazhimin e shumëfishta PostgreSQL server me2 Futu"

# translated-by: libretranslate
msgctxt "role:web-app-phpmyadmin:description"
msgid "Web-based administration tool for MySQL and MariaDB with schema management, querying, and import/export"
msgstr "Mjet administrimi i bazuar në web për MySQL dhe MariaDB me menazhim skeme, kërkesë dhe import/eksport"

# translated-by: libretranslate
msgctxt "category:web.opt:title"
msgid "Webserver Optimation"
msgstr "Optimacioni web"

# translated-by: libretranslate
msgctxt "role:dsk-docker:description"
msgid "Workstation setup for Docker and Docker Compose with the local user in the docker group for rootless development use"
msgstr "Sistemi i punës për Docker dhe Docker Compose me në lokal për"

# translated-by: libretranslate
msgctxt "role:dev-arduino:description"
msgid "Workstation toolchain and serial-port permissions for Arduino board development on Linux"
msgstr "Mjetet e punës dhe të drejtat për zhvillimin e bordit Arduino në Linux"

# translated-by: libretranslate
msgctxt "role:pkgmgr-install:description"
msgid "Wrapper role for idempotent package installation and updates through the pkgmgr universal package manager"
msgstr "Roli i mbështjellës për instalimin e paketës së idempotentit dhe përditësohet nëpërmjet menazhuesit universal të paketave pkgmg"

# translated-by: libretranslate
msgctxt "logout:may_close"
msgid "You can close this page now."
msgstr "Mund ta mbyllësh këtë faqe tani."

# translated-by: libretranslate
msgctxt "logout:st_failed"
msgid "failed"
msgstr "dështoi"

# translated-by: libretranslate
msgctxt "role:svc-net-firewall:description"
msgid "nftables packet filter whose rules each role owns as its own table, replaced atomically and reloaded at boot"
msgstr "Kuti e dobishme filtrimi i rregullave të çdo roli që zotëron si tabelë e vet, zëvendësohet në mënyrë atomike dhe rimbushet në çizme"

