msgctxt "category:sys.ctl:title"
msgid "Control"
msgstr "Башкарууну көзөмөлдөө"

# libretranslate
msgctxt "category:sys.ctl:description"
msgid "Control layer for system lifecycle management—handling cleanup, monitoring, backups, alerting, maintenance, and repair tasks."
msgstr "Системанын жашоо циклинин башкаруусу үчүн башкаруу катмары - тазалоо, мониторинг, резервдик көчүрмөлөр, эскертүү, техникалык тейлөө жана оңдоо тапшырмаларын иштетүү."

