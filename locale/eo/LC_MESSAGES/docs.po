# libretranslate
msgid "Replaced legacy generated applications / users setup flows with cached lookup-driven runtime data, centralized service-registry semantics, and nested compose.services.* configuration paths"
msgstr "Anstataŭigita heredaĵo generis aplikojn/uzantojn aranĝo fluas kun kadraj serĉ-movitaj kurtempodatenoj, alcentrigita servo-registraj semantiko, kaj nestitaj compose.services.* konfiguracioj"

# libretranslate
