# libretranslate
msgid "You can customize the tracking script and the noscript image tracker by editing the ``matomo-tracking.js.j2`` and ``matomo.subfilter.conf.j2`` templates."
msgstr "Vi povas personecigi la spura manuskripto kaj la noskripta bildo spuranto redaktante la ``matomo-tracking.js.j2`` kaj ``matomo.subfilter.conf.j2`` ŝablonoj."

