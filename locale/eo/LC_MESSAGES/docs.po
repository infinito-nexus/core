msgid "`_shared.js` — env + login helpers (`penpotOidcLogin`, `penpotLdapLogin`, `penpotNativeLogin`, `penpotRegister`)."
msgstr "`_shared.js` Env + loginhelpantoj (`penpotOidcLogin`, `penpotLdapLogin`, `penpotNativeLogin`, `penpotRegister`)."

# libretranslate
msgid "``\"line-above\"``: marker must be on the immediately preceding non-empty line. Blank lines between marker and construct break the association."
msgstr "``\"line-above\"``: signo devas esti sur la tuj antaŭante ne-malplenan linion. Blanklinioj inter signo kaj konstrukcio rompas la asocion."

# libretranslate
msgid "``\"same-line\"``: marker must be on the construct's line."
msgstr "``\"same-line\"``: signo devas esti sur la linio de la konstruaĵo."

# libretranslate
msgid "``\"same-or-above\"`` (default): either of the above."
msgstr "``\"same-or-above\"`` (defaŭlta defaŭlto): aŭ de la supre."

# libretranslate
msgid "``#`` (Python, YAML, shell, conf, INI, …)"
msgstr "``#`` (Python, YAML, ŝelo, konf, INI,)"

# libretranslate
msgid "``#``, ``@``, ``+``, ``%`` and ``/`` introduce an axis and appear in neither a role id nor a display name, so the first of them is the seam."
msgstr "``#``, ``@``, ``+``, ``%`` kaj ``/`` lanĉas akson kaj aperas en nek rolidentigaĵo nek ekrannomo, tiel ke la unua el ili estas la junto."

# libretranslate
#, python-brace-format
msgid "``$wgAIEditingAssistantActiveProviderConnection`` is the JSON object ``{url, endpoint, model, secret}`` built from ``MEDIAWIKI_LITELLM_CONNECTION``; ``url`` is ``LITELLM_OPENAI_BASE_LOCAL_URL`` and ``secret`` is this role’s own ``credentials.litellm_api_key``. The braces are mandatory: a brace-free value is re-wrapped as ``{\"legacy\": ...}`` upstream and the provider falls back to the vendor endpoint at ``api.openai.com``."
msgstr "``$wgAIEditingAssistantActiveProviderConnection`` La JSON-objekto ``{url, endpoint, model, secret}`` konstruita el ``MEDIAWIKI_LITELLM_CONNECTION``; ``url`` estas ``LITELLM_OPENAI_BASE_LOCAL_URL`` kaj ``secret`` Tiu rolo estas propra ``credentials.litellm_api_key``. La bracesoj estas devigaj: brace-libera valoro estas re-klakita kiel ``{\"legacy\": ...}`` kontraŭflue kaj la provizanto revenas al la vendisto finpunkto ĉe la ``api.openai.com``."

# libretranslate
msgid "``$wgAIEditingAssistantActiveProvider`` is ``open-ai``."
msgstr "``$wgAIEditingAssistantActiveProvider`` estas ``open-ai``."

# libretranslate
msgid "``$wgHTTPTimeout`` is raised inside the same block because core’s 25s is below a cold local model’s first token."
msgstr "``$wgHTTPTimeout`` Ĝi estas levita ene de la sama bloko ĉar la kerno de kerno 25s estas sub malvarma loka modelo unua ĵetono."

# libretranslate
#, no-python-format
msgid "``%%`` is \"contains\" for a scalar string value and \"is a member of\" for a set value; ``==`` / ``!=`` against a set mean membership / non-membership. String comparisons (``==`` ``!=`` ``%%``) are case-insensitive; ``< > <= >=`` are numeric. A bare expression with no operator (e.g. ``nextcloud``) is shorthand for ``name %% nextcloud``."
msgstr "``%%`` estas \"contains\" Por skalara kordvaloro kaj \"estas membro de\" Por aro-valoro; ``==`` / ``!=`` Kontraŭ aro averaĝa membreco / ne-membreco. Kordo komparoj (``==`` ``!=`` ``%%``) estas kazo-insensitive; ``< > <= >=`` estas numera. nuda esprimo kun neniu funkciigisto (ekz. ``nextcloud``) Estas stenografio ``name %% nextcloud``."

# libretranslate
msgid "``'on-failure'`` or ``'on-failure:N'`` -> ``'on-failure'``"
msgstr "``'on-failure'`` aŭ aŭ ``'on-failure:N'`` > ``'on-failure'``"

