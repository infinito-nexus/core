msgid "Interactive REPL that forwards each input line to ``python -m cli`` on the host."
msgstr "Interaga REPL kiu antaŭeniras ĉiun enirlinion al ``python -m cli`` en la gastiganto."

# libretranslate
msgid "Interactive graph visualization of all Infinito.Nexus roles and their dependencies for architecture transparency"
msgstr "Interaga grafbildigo de ĉiu Infinito.Nexus roloj kaj iliaj dependencajoj por arkitekturtravidebleco"

