msgid "Integration hooks to restart NGINX and recreate Docker Compose stacks on changes."
msgstr "Integriĝo hokoj rekomenci NGINX kaj rekrei Docker Compose stakojn sur ŝanĝoj."

# libretranslate
msgid "Integration into Infinito.Nexus inventory/variable system"
msgstr "Integriĝo en Infinito.Nexus stokregistro/varia sistemo"

