msgstr "`page.context().clearCookies()` επιτρέπεται μόνο ως τελική εκκαθάριση Μετά από μια προσπάθεια κλικ και μόνο όταν η ίδια η αλυσίδα κλικ δεν θα μπορούσε να παράγει μια επαληθεύσιμη κατάσταση σύνδεσης."

# translated-by: libretranslate
msgid "`page.goto` is only permitted to put the browser on the next surface (open the dashboard, open a protected URL to trigger an auth redirect, etc.); it MUST NOT be used to *invoke* an action that the UI exposes as a click target."
msgstr "`page.goto` επιτρέπεται μόνο η τοποθέτηση του περιηγητή στην επόμενη επιφάνεια (ανοίξτε το ταμπλό, ανοίξτε ένα προστατευμένο URL για να ενεργοποιήσετε μια ανακατευθύνει auth, κλπ.); ΔΕΝ ΠΡΕΠΕΙ ΝΑ χρησιμοποιείται για *επίκληση* μια ενέργεια που ο UI εκθέτει ως στόχο κλικ."

# translated-by: libretranslate
msgid "`parser.py`, `runtime.py`, and `writer.py` MUST NOT import from `builder.py` or [`handlers/`](handlers/)."
msgstr "`parser.py`, `runtime.py`, και `writer.py` ΔΕΝ ΠΡΕΠΕΙ ΝΑ εισάγεται από `builder.py` ή [`handlers/`](handlers/)."

# translated-by: libretranslate
msgid "`password` (should come from vault/credentials)"
msgstr "`password` (θα πρέπει να προέρχονται από θησαυροφυλάκιο / credentials)"

# translated-by: libretranslate
msgid "`pip install` (Ansible task in runner)"
msgstr "`pip install` (Προσιτή εργασία στον δρομέα)"

# translated-by: libretranslate
msgid "`pip.conf` URL-rewrite"
msgstr "`pip.conf` Επανεγγραφή URL"

# translated-by: libretranslate
