msgstr "`0` / unset → τα πάντα GitHub-hosted (προκαθορισμένο)."

# translated-by: libretranslate
msgid "`2.6.2`, released 2026-08-18, is the newest non-prerelease."
msgstr "`2.6.2`, κυκλοφόρησε 2026- Ναι.08- Ναι.18, είναι το νεότερο μη-προανακυκλοφορία."

# translated-by: libretranslate
msgid "`465` when `external` and `tls`, else `25`"
msgstr "`465` όταν `external` και `tls`, αλλιώς `25`"

# translated-by: libretranslate
msgid "`5000` = site Apache (GUI at `/<site>/check_mk/`), `8000` = agent receiver (TLS agent registration)."
msgstr "`5000` = τοποθεσία Apache (GUI στο `/<site>/check_mk/`), `8000` = πράκτορας δέκτης (Εγγραφή πρακτόρων TLS)."

# translated-by: libretranslate
msgid "`8096` (HTTP web), `8920` (optional HTTPS), `7359/udp` + `1900/udp` (client/service discovery)."
msgstr "`8096` (Ιστός HTTP), `8920` (προαιρετικό HTTPS), `7359/udp` + `1900/udp` (αναζήτηση πελάτη/υπηρεσίας)."

# translated-by: libretranslate
msgid "`:/absolute/path` → restore destination (overrides the default target)"
msgstr "`:/absolute/path` → επαναφορά προορισμού (παρακάμπτει τον προκαθορισμένο στόχο)"

# translated-by: libretranslate
msgid "`:YYYYMMDDHHMMSS` → device generation (14 digits, default: newest)"
msgstr "`:YYYYMMDDHHMMSS` → παραγωγή συσκευών (14 ψηφία, προεπιλογή: νεότερος)"

# translated-by: libretranslate
msgid "`:relative` → device on-device snapshot subpath"
msgstr "`:relative` → συσκευή on-device στιγμιότυπο υποδιαδρομή"

# translated-by: libretranslate
msgid "`<owner>/<repo>` to use another source, or `false`, empty, or the current repository to skip"
msgstr "`<owner>/<repo>` να χρησιμοποιήσει άλλη πηγή, ή `false`, κενό, ή το τρέχον αποθετήριο για να παραλείψετε"

# translated-by: libretranslate
msgid "`<rule>` is a kebab-case identifier from the catalog below. Multiple rules MAY be combined comma-separated."
msgstr "`<rule>` είναι ένα αναγνωριστικό υπόθεσης κεμπάπ από τον παρακάτω κατάλογο. Πολλαπλοί κανόνες μπορούν να συνδυαστούν με κόμματα."

# translated-by: libretranslate
msgid "`<source>`: see [Source grammar](#source-grammar)"
msgstr "`<source>`: βλ. [Γραμματική πηγής](#source-grammar)"

