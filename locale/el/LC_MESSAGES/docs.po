# translated-by: libretranslate
msgid "`test-login-oidc-admin.js` — OIDC via Keycloak, administrator."
msgstr "`test-login-oidc-admin.js` — OIDC μέσω Keycloak, διευθυντής."

# translated-by: libretranslate
