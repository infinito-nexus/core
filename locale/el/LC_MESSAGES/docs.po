msgid "`all.sh` discovers applications on the host via `scripts/meta/resolve/apps.sh` and runs against the full list."
msgstr "`all.sh` ανακαλύπτει εφαρμογές στον υπολογιστή μέσω `scripts/meta/resolve/apps.sh` και τρέχει ενάντια στην πλήρη λίστα."

# translated-by: libretranslate
msgid "`all.sh` requires:"
msgstr "`all.sh` απαιτεί:"

