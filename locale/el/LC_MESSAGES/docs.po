msgstr "INFINITO_DOCKER_PLATFORM: στόχος της αρχιτεκτονικής αυτή η ανάπτυξη είχε ανατεθεί."

# translated-by: libretranslate
msgid "INFINITO_DOCKER_VOLUME: GHA-side override pointing at the runner's large-disk mount."
msgstr "INFINITO_DOCKER_VOLUME: Παράκαμψη από την πλευρά του GHA που δείχνει το μεγάλο δίσκο του δρομέα."

# translated-by: libretranslate
msgid "INFINITO_DOMAIN: ``<stack>.<INFINITO_DNS_DOMAIN>``, where the stack is ``main`` for the primary checkout and the normalised branch for a linked git worktree. Always overrides the caller env, which inside the stack container is the previous ``.env``; GitHub/act runs keep the static default and custom.env pins win."
msgstr "INFINITO_DOMAIN: ``<stack>.<INFINITO_DNS_DOMAIN>``, όπου η στοίβα είναι ``main`` για το κύριο τσεκ-άουτ και το κανονικοποιημένο κλαδί για ένα δεμένο δοκάρι. Πάντα παρακάμπτει την κλήση env, η οποία μέσα στο δοχείο στοίβα είναι η προηγούμενη ``.env``· GitHub/act τρέχει κρατήσει τη στατική προεπιλογή και custom.env Οι καρφίτσες κερδίζουν."

# translated-by: libretranslate
msgid "INFINITO_FORK_ACCOUNT: GitHub account holding the operator's fork, defaulting to the local OS username."
msgstr "INFINITO_FORK_ACCOUNT: GitHub λογαριασμό που κατέχει το πιρούνι του χειριστή, προεπιλογή στο τοπικό όνομα χρήστη OS."

# translated-by: libretranslate
msgid "INFINITO_FORK_REPOSITORY_URL: GitHub URL of the operator's fork, composed from INFINITO_FORK_ACCOUNT and INFINITO_FORK_REPOSITORY_NAME."
msgstr "INFINITO_FORK_REPOSITORY_URL: GitHub URL του πιρουνιού του χειριστή, που αποτελείται από INFINITO_FORK_ACCOUNT και INFINITO_FORK_REPOSITORY_NAME."

# translated-by: libretranslate
msgid "INFINITO_GIT_AUTHOR_NAME / INFINITO_GIT_AUTHOR_EMAIL: the identity this checkout commits under. The test container mounts the checkout but not the contributor's git configuration, so the suite cannot ask git who is about to commit; the ``.env`` carries the answer across."
msgstr "INFINITO_GIT_AUTHOR_NAME / INFINITO_GIT_AUTHOR_EMAIL: η ταυτότητα που διαπράττει το ταμείο. Ο δοκιμαστικός περιέκτης τοποθετεί το ταμείο αλλά όχι τη διαμόρφωση git του συνεισφέροντος, έτσι ώστε η σουίτα να μην μπορεί να ρωτήσει git ποιος είναι έτοιμος να δεσμευτεί? ``.env`` μεταφέρει την απάντηση."

# translated-by: libretranslate
msgid "INFINITO_GPU_COUNT: GPUs the compose services reserve, 'all' when the docker daemon registers an NVIDIA runtime, else 0."
msgstr "INFINITO_GPU_COUNT: GPUs το αποθεματικό συνθέσεων υπηρεσιών, 'all' όταν ο δαίμονας docker καταγράφει ένα χρόνο λειτουργίας NVIDIA, αλλιώς 0."

# translated-by: libretranslate
msgid "INFINITO_I18N_BATCH_SIZE / INFINITO_I18N_LANES: client settings `make i18n-tune` measured on this host, falling back to the shipped defaults."
msgstr "INFINITO_I18N_BATCH_SIZE / INFINITO_I18N_LANES: ρυθμίσεις πελάτη `make i18n-tune` μετρηθεί σε αυτόν τον υπολογιστή, να πέσει πίσω στις προεπιλεγμένες αποστολές."

# translated-by: libretranslate
msgid "INFINITO_I18N_LIBRETRANSLATE_PORT: loopback port the i18n runner forwards to its LibreTranslate, read from roles/web-svc-libretranslate/meta/services.yml."
msgstr "INFINITO_I18N_LIBRETRANSLATE_PORT: loopback θύρα η i18n δρομέας προς τα εμπρός της LibreTranslate, από roles/web-svc-libretranslate/meta/services.yml."

# translated-by: libretranslate
msgid "INFINITO_IMAGE: fully-qualified GHCR image reference assembled from owner, repo, distro and tag (GHA-only)."
msgstr "INFINITO_IMAGE: πλήρως πιστοποιημένη αναφορά εικόνας GHCR συναρμολογημένη από τον ιδιοκτήτη, repo, distro και tag (Μόνο GHA)."

# translated-by: libretranslate
msgid "INFINITO_IMAGE_REPOSITORY: lowercased repository name resolved from scripts/meta/resolve/repository/name.sh (GHA-only)."
msgstr "INFINITO_IMAGE_REPOSITORY: πεζό όνομα αποθετηρίου που λύθηκε από scripts/meta/resolve/repository/name.sh (Μόνο GHA)."

# translated-by: libretranslate
msgid "INFINITO_IS_WSL2: true when /proc/version identifies the host as WSL2."
msgstr "INFINITO_IS_WSL2: αληθής όταν /proc/version προσδιορίζει τον υπολογιστή ως WSL2."

# translated-by: libretranslate
msgid "INFINITO_OUTER_NETWORK_MTU: MTU of the compose stack's bridge network."
msgstr "INFINITO_OUTER_NETWORK_MTU: MTU του δικτύου γέφυρας της στοίβας σύνθεσης."

# translated-by: libretranslate
msgid "INFINITO_PARENT_IMAGE: distribution base image reference composed from INFINITO_PARENT_IMAGE_OWNER, INFINITO_DISTRO and INFINITO_PARENT_IMAGE_TAG."
msgstr "INFINITO_PARENT_IMAGE: αναφορά εικόνας βάσης διανομής που αποτελείται από INFINITO_PARENT_IMAGE_OWNER, INFINITO_DISTRO και INFINITO_PARENT_IMAGE_TAG."

# translated-by: libretranslate
msgid "INFINITO_PLAYWRIGHT_REPORTS_BASE_DIR: per-app Playwright reports root, derived from the var-lib SPOT (INFINITO_DIR_VAR_LIB)."
msgstr "INFINITO_PLAYWRIGHT_REPORTS_BASE_DIR: ανά εφαρμογή Ρίζα αναφορών Playwright, προερχόμενη από το var-lib SPOT (INFINITO_DIR_VAR_LIB)."

# translated-by: libretranslate
msgid "INFINITO_PLAYWRIGHT_STAGE_BASE_DIR: host dir where Playwright projects are staged per role, read from the test-e2e-playwright role vars SPOT (``TEST_E2E_PLAYWRIGHT_STAGE_BASE_DIR``)."
msgstr "INFINITO_PLAYWRIGHT_STAGE_BASE_DIR: host dir όπου τα έργα Playwright είναι σκηνοθετημένα ανά ρόλο, διαβασμένο από το test-e2e-playwright roleόλων vars SPOT (``TEST_E2E_PLAYWRIGHT_STAGE_BASE_DIR``)."

# translated-by: libretranslate
msgid "INFINITO_PULL_POLICY: GHA-side override -- always pull the published image instead of trusting whatever is cached on the runner."
msgstr "INFINITO_PULL_POLICY: Παράκαμψη του GHA -- πάντα τραβήξτε τη δημοσιευμένη εικόνα αντί να εμπιστεύεστε οτιδήποτε είναι κρυμμένο στον δρομέα."

# translated-by: libretranslate
msgid "INFINITO_RESCUE_DIAGNOSTICS_DIR: rescue snapshot folder, read from the group_vars paths SPOT (group_vars/all/05_paths.yml DIR_RESCUE_DIAGNOSTICS)."
msgstr "INFINITO_RESCUE_DIAGNOSTICS_DIR: φάκελος στιγμιότυπου διάσωσης, που διαβάζεται από το group_vars μονοπάτια SPOT (group_vars/all/05_paths.yml DIR_RESCUE_DIAGNOSTICS)."

# translated-by: libretranslate
msgid "INFINITO_RESCUE_LOCAL_DUMPS_DIR: where in-play role dumps land, read from the group_vars paths SPOT (group_vars/all/05_paths.yml DIR_RESCUE_DIAGNOSTICS)."
msgstr "INFINITO_RESCUE_LOCAL_DUMPS_DIR: όπου οι χωματερές roleόλων εντός παιχνιδιού, διαβάζονται από το group_vars μονοπάτια SPOT (group_vars/all/05_paths.yml DIR_RESCUE_DIAGNOSTICS)."

# translated-by: libretranslate
msgid "INFINITO_RUNNING_ON_ACT: true when running under nektos/act locally."
msgstr "INFINITO_RUNNING_ON_ACT: αλήθεια όταν τρέχει κάτω από nektos/act τοπικά."

# translated-by: libretranslate
msgid "INFINITO_RUNNING_ON_GITHUB: true when running on real GitHub Actions (not act)."
msgstr "INFINITO_RUNNING_ON_GITHUB: αληθής κατά την εκτέλεση των πραγματικών ενεργειών GitHub (δεν ενεργεί)."

# translated-by: libretranslate
msgid "INFINITO_SWARM_NFS_EXPORT_BASE: NFS export base inside the NFS-server sidecar, read from the provider SPOT roles/svc-storage-nfs-server/meta/services.yml."
msgstr "INFINITO_SWARM_NFS_EXPORT_BASE: Βάση εξαγωγής NFS μέσα στο NFS-server sidecar, που διαβάζεται από τον πάροχο SPOT roles/svc-storage-nfs-server/meta/services.yml."

# translated-by: libretranslate
msgid "INFINITO_SWARM_NFS_STATE_PATH: cluster-shared NFS state dir for the act-swarm test harness, derived from the export-base SPOT (INFINITO_SWARM_NFS_EXPORT_BASE) and the shared state subdir constant."
msgstr "INFINITO_SWARM_NFS_STATE_PATH: κοινή ομάδα NFS κατάσταση dir για την πράξη-θερμή ζώνη δοκιμής, που προέρχεται από τη βάση εξαγωγής SPOT (INFINITO_SWARM_NFS_EXPORT_BASE) και την κοινή κατάσταση subdir σταθερά."

# translated-by: libretranslate
msgid "INFINITO_TOR_SOCKS_PORT: node Tor SOCKS port, read from the single source of truth in svc-net-tor's meta/services.yml (services.tor.ports.local.socks). Keeps shell consumers (e.g. the Playwright rerunner) off a hard-coded port literal."
msgstr "INFINITO_TOR_SOCKS_PORT: κόμβος Tor SOCKS θύρα, διαβάζεται από την ενιαία πηγή της αλήθειας svc-net-torΣ meta/services.yml (services.tor.ports.local.socks). Διατηρεί τους καταναλωτές κέλυφος (π.χ. ο επαναληπτικός παίκτης του Playwright) από μια αυστηρά κωδικοποιημένη θύρα κυριολεκτικά."

# translated-by: libretranslate
msgid "INFINITO_WORKER_CPU * 20, with a base of 1 collapsing to 1 (the operator's sequential-fallback signal). Consumed by URL probers and upstream tag fetchers."
msgstr "INFINITO_WORKER_CPU * 20, με βάση 1 Καταρρέει σε 1 (σήμα διαδοχικής πτώσης του αερομεταφορέα). Καταναλώνεται από τους προγνώστες URL και ανάντη tag reckers."

# translated-by: libretranslate
msgid "INFINITO_WORKER_CPU: CPU-count base for the worker SPOT chain."
msgstr "INFINITO_WORKER_CPU: Βάση υπολογισμού ΚΜΕ για την εργατική αλυσίδα SPOT."

# translated-by: libretranslate
msgid "INFINITO_WORKER_FETCH: I/O-bound network-fetch worker count."
msgstr "INFINITO_WORKER_FETCH: Μετρούν οι εργαζόμενοι του δικτύου I/O."

