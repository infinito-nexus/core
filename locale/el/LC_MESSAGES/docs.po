# translated-by: libretranslate
msgid "One search-only key and explicit collection list per application; no collection/schema/key administration"
msgstr "Μία μόνο βασική και ρητή λίστα συλλογής ανά εφαρμογή· collection/schema/key χορήγησης"

# translated-by: libretranslate
