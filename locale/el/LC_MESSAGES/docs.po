# translated-by: libretranslate
msgid "This directory holds the executable local deploy flows under `scripts/tests/deploy/local/deploy/`."
msgstr "Αυτός ο κατάλογος περιέχει τις εκτελέσιμες τοπικές ροές ανάπτυξης `scripts/tests/deploy/local/deploy/`."

