# translated-by: libretranslate
msgid "**SSO Login:** \"Login with SSO\" button (when OIDC is enabled)"
msgstr "**SSO Login:** \"Влизане с SSO\" бутон (когато OIDC е включена)"

# translated-by: libretranslate
