msgstr "`CI=true` изключване на кеша на пакета (люспести в гнезда контейнери)."

# translated-by: libretranslate
msgid "`CMK_SITE_ID` (OMD site, default `cmk`), `CMK_PASSWORD` (initial `cmkadmin` password, **first run only**), `TZ`, `MAIL_*` for outbound mail."
msgstr "`CMK_SITE_ID` (OMD сайт, по подразбиране `cmk`), `CMK_PASSWORD` (първоначално `cmkadmin` парола, **само за първи път**), `TZ`, `MAIL_*` за изходяща поща."

# translated-by: libretranslate
