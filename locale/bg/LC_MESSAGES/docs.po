msgid "``\"line-above\"``: marker must be on the immediately preceding non-empty line. Blank lines between marker and construct break the association."
msgstr "``\"line-above\"``: Маркерът трябва да бъде на непосредствено предхождащата непразна линия. Празните линии между маркера и конструкцията прекъсват асоциацията."

# translated-by: libretranslate
msgid "``\"same-line\"``: marker must be on the construct's line."
msgstr "``\"same-line\"``: Маркерът трябва да е на линията на конструкцията."

# translated-by: libretranslate
msgid "``\"same-or-above\"`` (default): either of the above."
msgstr "``\"same-or-above\"`` (по подразбиране): един от горните."

