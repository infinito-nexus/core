msgstr "На ``(fqcn, version)`` двойки изисквания файл декларира, в ред."

# translated-by: libretranslate
msgid "The ``(owner/repo, version)`` ``roles/sys-lint`` pins for *tool*."
msgstr "На ``(owner/repo, version)`` ``roles/sys-lint`` пинове за *инструмент*."

# translated-by: libretranslate
msgid "The ``(owner/repo, version)`` an installer should fetch for *tool*."
msgstr "На ``(owner/repo, version)`` инсталатор трябва да донесе за *инструмент*."

