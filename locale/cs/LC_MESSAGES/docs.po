# libretranslate
msgid "**Idempotent Package Installation:** Only installs packages when necessary."
msgstr "**Instalace idempotentních balíčků:** Balíčky instalujte pouze v případě potřeby."

# libretranslate
msgid "**Idempotent Role**"
msgstr "**Idempotentní role**"

