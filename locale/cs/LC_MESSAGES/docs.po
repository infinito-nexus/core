# libretranslate
msgid "**Idempotent Execution:** Sets a fact to guarantee that the installation tasks are executed only once."
msgstr "**Idempotent Execution:** Nastavuje skutečnost, která zaručí, že úkoly instalace jsou prováděny pouze jednou."

# libretranslate
msgid "**Idempotent Execution:** Tasks are intelligently executed only once per playbook run."
msgstr "**Idempotent Execution:** Úkoly jsou inteligentně prováděny pouze jednou za sérii pravidel."

# libretranslate
msgid "**Idempotent Execution:** Utilizes a ``run_once`` flag to prevent repeated runs."
msgstr "**Idempotent Execution:** Využívá a ``run_once`` vlajka, aby se zabránilo opakovaným jízdám."

# libretranslate
msgid "**Idempotent Execution:** Utilizes a `run_once` flag to prevent repeated runs."
