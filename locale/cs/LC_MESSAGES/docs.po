# libretranslate
msgid "The PostgreSQL database is backed up by the central backup roles; the asset volume is backup-ready by convention."
msgstr "• PostgreSQL databáze je zálohována centrálními zálohovacími rolemi; objem aktiv je zálohován - připraven konvencí."

# libretranslate
msgid "The Pull Request MUST be linked to the related work item in [project.infinito.nexus](https://project.infinito.nexus/) and back."
