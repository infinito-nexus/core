msgctxt "role:web-app-lam:description"
msgid "Web interface for administering LDAP directories: managing users, groups, and other directory objects"
msgstr "Giao diện Mạng để quản lý thư mục LDAP: Quản lý người dùng, nhóm và các đối tượng thư mục khác"

