msgstr "Trình chuyển đổi màn hình nền trung tâm cho máy chủ hướng dẫn thư qua Mailu, msmtp, hoặc một trình tiếp SMTP cục bộ tùy chọn"

# translated-by: libretranslate
msgctxt "category:svc.dns:description"
