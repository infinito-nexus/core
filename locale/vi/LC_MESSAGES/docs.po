# translated-by: libretranslate
msgid "**Flexible Configuration:** Easily customize settings such as database connections, admin credentials, and server configurations via a TOML file."
msgstr "**Cấu hình dễ dàng:** Thiết lập tùy chỉnh dễ dàng như kết nối cơ sở dữ liệu, ủy nhiệm quản trị và cấu hình máy phục vụ thông qua tập tin TOML."

# translated-by: libretranslate
msgid "**Flexible Control:** Supports for `MODE_CLEANUP` for cert cleanup operations."
msgstr "**Điều khiển dễ dàng:** Hỗ trợ cho `MODE_CLEANUP` Để dọn dẹp."

# translated-by: libretranslate
msgid "**Flexible Control:** Supports for ``MODE_CLEANUP`` for cert cleanup operations."
msgstr "**Điều khiển dễ dàng:** Hỗ trợ cho ``MODE_CLEANUP`` Để dọn dẹp."

# translated-by: libretranslate
msgid "**Flexible DB:** Use platform's central MariaDB or app-local DB."
msgstr "**DB dễ bay:** Dùng nền tảng chính MariaDB hoặc app-local DB."

