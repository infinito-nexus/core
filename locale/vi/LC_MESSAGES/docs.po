msgid "`RUN apk add` (Alpine ≥3.18 HTTPS)"
msgstr "`RUN apk add` (Alpine3.18 HTTPS)"

# translated-by: libretranslate
msgid "`RUN apk add` (inner Dockerfile build, Alpine ≤3.17 HTTP)"
msgstr "`RUN apk add` (Xây dựng tập tin Docker nội bộ, Alpine3.17 HTTP)"

