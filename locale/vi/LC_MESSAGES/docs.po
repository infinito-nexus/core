# translated-by: libretranslate
msgid "Skips probing the literal HTTP(S) URL. Use for CDN roots and API base URLs that 4xx without a path."
msgstr "Name(S) URL. Dùng cho rễ CDN và API URL cơ bản 4xx không có đường."

# translated-by: libretranslate
msgid "Skips the live update warning for a pin that declares its upstream in an `update:` block."
msgstr "Bỏ qua cảnh báo cập nhật trực tiếp cho một cây kim phát hành ngược dòng của nó trong một `update:` tòa nhà."

# translated-by: libretranslate
