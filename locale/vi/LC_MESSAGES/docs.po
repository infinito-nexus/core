msgid "Do NOT introduce noisy debug logging, uncaught errors, duplicate event handlers, or endless observers into injected scripts."
msgstr "Đừng đưa việc đăng nhập vào máy gỡ lỗi ồn ào, lỗi chưa được giải quyết, bắt chước người quản lý sự kiện, hoặc vô số người quan sát vào tập lệnh tiêm."

# translated-by: libretranslate
msgid "Do NOT leave implementation warnings unresolved just because they are inconvenient."
msgstr "Đừng để lời cảnh báo không được giải quyết chỉ vì chúng bất tiện."

# translated-by: libretranslate
msgid "Do NOT reimplement server-side logic, authentication protocols, or business rules in injected JavaScript."
msgstr "Không áp dụng logic bên máy phục vụ, giao thức xác thực, hoặc quy tắc kinh doanh bằng JavaScript đã tiêm."

# translated-by: libretranslate
