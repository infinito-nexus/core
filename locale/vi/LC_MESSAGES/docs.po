# translated-by: libretranslate
msgid "You MUST NOT replace layout, spacing, sizing, positioning, z-index, overflow, animation timing, or component structure."
msgstr "Bạn không nên thay thế bố trí, khoảng cách, định vị, z- index, tràn, thời gian hoạt họa, hoặc cấu trúc thành phần."

# translated-by: libretranslate
msgid "You MUST NOT replace semantic behavior, JavaScript hooks, or framework-specific class wiring."
msgstr "Bạn không nên thay thế hành vi ngữ nghĩa, móc JavaScript, hoặc dây cáp lớp cụ thể."

# translated-by: libretranslate
msgid "You MUST NOT report the task complete until all of the following hold:"
msgstr "Bạn không nên báo cáo tác vụ hoàn tất cho đến khi tất cả những điều sau:"

# translated-by: libretranslate
msgid "You MUST NOT rewrite history on protected branches"
msgstr "Bạn không nên viết lại lịch sử về các nhánh được bảo vệ"

# translated-by: libretranslate
msgid "You MUST NOT rewrite large upstream style blocks when a focused override or token remapping is enough."
msgstr "Bạn không nên viết lại những khối kiểu chữ số ngược lớn khi mà việc ghi đè tập trung hoặc lật ngược lại hiệu suất là đủ."

# translated-by: libretranslate
msgid "You MUST NOT run more than one deploy command at the same time. Deployments MUST be executed serially, never in parallel."
msgstr "Bạn không nên chạy nhiều hơn một lệnh triển khai cùng một lúc. Việc triển khai phải được thực hiện liên tục, không bao giờ song song."

# translated-by: libretranslate
msgid "You MUST NOT run more than one unit test command at the same time. Unit tests MUST be executed serially, never in parallel."
msgstr "Bạn không nên chạy nhiều hơn một lệnh thử nghiệm đơn vị cùng một lúc. Thử nghiệm đơn vị phải được thực hiện liên tục, không bao giờ song song."

# translated-by: libretranslate
msgid "You MUST NOT skip the inter-round purge."
msgstr "Anh không nên bỏ qua việc thanh trừng."

# translated-by: libretranslate
msgid "You MUST NOT use `--no-verify` unless the user gives a direct, unambiguous instruction to bypass the hook (e.g. \"skip the hook\", \"bypass pre-commit\")."
msgstr "Bạn không nên dùng `--no-verify` Trừ khi người dùng cung cấp một hướng dẫn trực tiếp, rõ ràng để vượt qua móc câu (e.g. \"Bỏ qua móc câu\". \"Bỏ qua tiến trình sẵn\")."

# translated-by: libretranslate
msgid "You MUST NOT use `.md` files to describe implementation logic that is already visible in the code."
msgstr "Bạn không nên dùng `.md` Tập tin để mô tả logic thực hiện mà đã được hiển thị trong mã."

# translated-by: libretranslate
#, no-python-format, python-brace-format
msgid "You MUST NOT use `templates/Dockerfile.j2` unless the Dockerfile requires Jinja2 control-flow logic (e.g. `{% if %}`, `{% for %}`)."
msgstr "Bạn không nên dùng `templates/Dockerfile.j2` Trừ khi tập tin Docker yêu cầu Jinja2 Comment (e.g. `{% if %}`. `{% for %}`)."

# translated-by: libretranslate
msgid "You MUST NOT use em dashes (—) as thought breaks or clause separators. You SHOULD prefer complete sentences. Hyphens (-) MAY be used for compound words and list items."
msgstr "Bạn không nên dùng dấu gạch ngang (-) khi suy nghĩ bị phá vỡ hoặc phân chia các điều khoản. Bạn nên thích câu văn hoàn chỉnh hơn. Hyphen (-) Có thể dùng cho các từ hợp số và danh sách các mục."

# translated-by: libretranslate
msgid "You MUST NOT use the full URL as link text. Use the domain name, `here`, or the filename instead. Never use the full path."
msgstr "Bạn không nên dùng địa chỉ Mạng đầy đủ làm văn bản liên kết. Dùng tên miền, `here`, hoặc là tên tập tin. Không bao giờ sử dụng con đường đầy đủ."

# translated-by: libretranslate
msgid "You MUST NOT write tests for non-executable files such as `.yml` or `.j2`. Test the code that consumes them instead."
msgstr "Bạn không nên ghi các thử nghiệm cho tập tin không có khả năng cắt như `.yml` hay `.j2`. Kiểm tra mật mã thay thế."

# translated-by: libretranslate
msgid "You MUST NOT write tests only for non-executable files such as `.yml` or `.j2`. Test the behavior that consumes them."
msgstr "Không nên ghi các thử nghiệm chỉ cho tập tin không có khả năng cắt như `.yml` hay `.j2`. Kiểm tra hành vi ăn mòn chúng."

# translated-by: libretranslate
msgid "You MUST NOT write tests that only assert a file contains a string."
msgstr "Bạn không nên ghi những thử nghiệm chỉ xác nhận một tập tin chứa chuỗi."

# translated-by: libretranslate
msgid "You MUST NOT write unit tests for integration test logic. Integration tests verify real runtime boundaries; extracting that logic into unit tests defeats the purpose and duplicates coverage. The integration test itself is the specification."
msgstr "Bạn không nên viết bài kiểm tra hợp lý đơn vị. Thử nghiệm hợp nhất xác minh ranh giới thời gian thực; đưa logic đó vào đơn vị thử nghiệm đánh bại mục đích và sao chép bảo hiểm. Bài kiểm tra tích hợp chính là đặc điểm."

# translated-by: libretranslate
msgid "You MUST NOT write values back from those UI fields to OIDC or LDAP through injected JavaScript. Treat those fields as externally managed and read-only in the application UI."
msgstr "Bạn không nên ghi các giá trị từ các trường UI đến IDC hoặc LDAP qua JavaScript đã được tiêm. Đối xử với những lĩnh vực đó như là quản lý bên ngoài và chỉ đọc trong chương trình UI."

# translated-by: libretranslate
msgid "You MUST NOT:"
msgstr "Bạn không nên:"

# translated-by: libretranslate
msgid "You MUST `git fetch` the resolved comparison branch and inspect its recent commits and CI history."
msgstr "Bạn phải `git fetch` Chi nhánh đã quyết định và kiểm tra những điều khoản gần đây và lịch sử CN."

# translated-by: libretranslate
msgid "You MUST add code comments only when an exception, edge case, or surprising decision would otherwise confuse readers."
msgstr "Bạn phải thêm các ý kiến mật mã chỉ khi một ngoại lệ, trường hợp cạnh tranh, hoặc quyết định bất ngờ khác sẽ gây nhầm lẫn cho độc giả."

# translated-by: libretranslate
msgid "You MUST add new application defaults in the owning role:"
msgstr "Bạn phải thêm mặc định mới cho ứng dụng trong vai trò sở hữu:"

# translated-by: libretranslate
msgid "You MUST add new user defaults in the owning role:"
msgstr "Bạn phải thêm mặc định người dùng mới vào vai trò sở hữu:"

# translated-by: libretranslate
msgid "You MUST add or update integration tests for every `*.py` file you touch when the change affects behavior across module or runtime boundaries."
msgstr "Bạn nên thêm hoặc cập nhật kiểm tra tích hợp cho mỗi `*.py` tập tin bạn chạm vào khi thay đổi ảnh hưởng đến ứng xử trên mô- đun hoặc biên thời gian chạy."

# translated-by: libretranslate
msgid "You MUST add or update unit tests for every `*.py` file you touch."
msgstr "Bạn phải thêm hoặc cập nhật đơn vị thử nghiệm cho mỗi `*.py` Hãy ghi lại."

# translated-by: libretranslate
msgid "You MUST add the smallest possible theming layer on top of the role's existing CSS."
msgstr "Bạn cần phải thêm lớp nhỏ nhất có thể phân loại trên đầu của vai trò đã có."

# translated-by: libretranslate
msgid "You MUST also enumerate any failed sibling runs dispatched from the same commit via `gh run list --commit \"$(gh run view <run-id> --json headSha --jq .headSha)\" --json databaseId,name,conclusion --jq '.[] | select(.conclusion==\"failure\")'`, then repeat the job enumeration for each."
msgstr "Bạn cũng cần phải liệt kê bất kỳ anh em thất bại chạy được gửi từ cùng một cam kết thông qua `gh run list --commit \"$(gh run view <run-id> --json headSha --jq .headSha)\" --json databaseId,name,conclusion --jq '.[] | select(.conclusion==\"failure\")'`, Sau đó lặp lại cách tính công việc cho mỗi người."

# translated-by: libretranslate
msgid "You MUST analyze the Playwright assets together with the matching job logs under `/tmp/logs/<child-run-id>/logs/`."
msgstr "Bạn phải phân tích tài sản nhà soạn kịch với các bản ghi công việc phù hợp dưới `/tmp/logs/<child-run-id>/logs/`."

# translated-by: libretranslate
msgid "You MUST apply all rules from `AGENTS.md` and `docs/contributing/` to every affected file, not only code rules, but also documentation, naming, structure, and any other applicable guidelines."
msgstr "Anh phải áp dụng mọi quy tắc từ `AGENTS.md` và `docs/contributing/` cho mọi tập tin bị ảnh hưởng, không chỉ quy tắc, mà còn tài liệu hướng dẫn, tên, cấu trúc và bất kỳ hướng dẫn thích hợp khác."

# translated-by: libretranslate
msgid "You MUST apply these repo-wide rules when you add, move, or review files:"
msgstr "Bạn phải áp dụng những luật lệ này khi bạn thêm, di chuyển hoặc xem lại tập tin:"

# translated-by: libretranslate
msgid "You MUST apply this moral principle when you make decisions:"
msgstr "Bạn phải áp dụng nguyên tắc đạo đức này khi đưa ra quyết định:"

# translated-by: libretranslate
msgid "You MUST at minimum inspect and compare the start page and the login page because these pages usually expose the most important navigation, authentication, and first-load behavior."
msgstr "Bạn cần phải kiểm tra tối thiểu và so sánh trang đầu và trang đăng nhập vì những trang này thường phơi bày những hành vi định vị, xác thực và tải đầu tiên."

# translated-by: libretranslate
msgid "You MUST build filesystem paths with `path_join` instead of concatenating path segments as strings."
msgstr "Bạn phải xây dựng hệ thống tập tin bằng `path_join` Thay vì phân loại các đoạn đường dẫn thành chuỗi."

# translated-by: libretranslate
msgid "You MUST capture open development requirements for a role in its `TODO.md` file so the remaining work stays visible."
msgstr "Bạn phải nắm bắt các yêu cầu phát triển mở cho một vai trò của nó `TODO.md` Hồ sơ để các tác phẩm còn lại được hiển thị."

# translated-by: libretranslate
msgid "You MUST capture system-wide development requirements in the root `TODO.md` file so global work stays visible in one place."
msgstr "Bạn phải nắm bắt yêu cầu phát triển toàn hệ thống trong gốc `TODO.md` Tập tin để công việc toàn cầu được hiển thị ở một nơi."

# translated-by: libretranslate
msgid "You MUST check off each criterion in the requirement file as soon as it is verified. Do not batch them."
msgstr "Bạn nên kiểm tra mỗi tiêu đề trong tập tin yêu cầu ngay khi nó được kiểm tra. Đừng đánh chúng."

# translated-by: libretranslate
msgid "You MUST check that `APP_BASE_URL`, app URLs, issuer URLs, and feature toggles match the deployed role."
msgstr "Anh phải kiểm tra lại. `APP_BASE_URL`, các URL ứng dụng, URL phát hành, và tính năng bật/tắt tương ứng với vai trò đã triển khai."

# translated-by: libretranslate
msgid "You MUST check that every environment variable referenced in `playwright.spec.js` is present in the rendered `.env` (the name-alignment MUST is owned by the contrib SPOT Environment Contract)."
msgstr "Bạn phải kiểm tra rằng mỗi biến môi trường tham chiếu trong `playwright.spec.js` hiện có trong các phiên bản `.env` (Hẳn tên được sở hữu bởi hợp đồng môi trường đặc biệt)."

# translated-by: libretranslate
msgid "You MUST check that persona-specific credentials such as `biber` and `administrator` map to the intended scenarios."
msgstr "Anh nên kiểm tra giấy tờ cá nhân như `biber` và `administrator` Bản đồ đến kịch bản đã định."

# translated-by: libretranslate
msgid "You MUST check that the final JavaScript still feels like a small role-local adaptation of the target application, not a forked frontend implementation."
msgstr "Bạn phải kiểm tra rằng JavaScript cuối cùng vẫn cảm thấy giống như một thay đổi vai trò nhỏ của ứng dụng đích, không phải một giao diện điều khiển giả."

# translated-by: libretranslate
msgid "You MUST check the browser console for JavaScript errors or repeated side effects after the script is injected."
msgstr "Bạn cần kiểm tra bàn giao tiếp duyệt tìm lỗi JavaScript, hoặc hiệu ứng phụ lặp đi lặp lại sau khi văn lệnh được tiêm."

# translated-by: libretranslate
msgid "You MUST check the result with live inspection in the running application, not only by reading the JavaScript file."
msgstr "Bạn phải kiểm tra kết quả bằng cách kiểm tra trực tiếp trong ứng dụng đang chạy, không chỉ bằng cách đọc tập tin JavaScript."

# translated-by: libretranslate
msgid "You MUST choose the matching Pull Request template before you write a PR description."
msgstr "Bạn phải chọn mẫu yêu cầu khớp trước khi viết mô tả PR."

# translated-by: libretranslate
msgid "You MUST classify each failure into one of two buckets:"
msgstr "Bạn phải phân loại mỗi thất bại thành một trong hai xô:"

# translated-by: libretranslate
#, no-python-format
msgid "You MUST cluster the downloaded logs by their shared failing task via `python -m cli.meta.ci.logs.analyze /tmp/logs/<child-run-id>`, then for each cluster you MUST perform static analysis of the repository code, the job logs, the downloaded artefacts, and any relevant external code until you are at least 99% certain of the root cause before you change anything. If the error class is a Playwright failure, you MUST follow [Playwright Failures](#playwright-failures) for the asset analysis before continuing."
msgstr "Bạn phải sắp xếp các bản ghi được tải về bởi nhiệm vụ chung của họ thất bại thông qua `python -m cli.meta.ci.logs.analyze /tmp/logs/<child-run-id>`, sau đó cho mỗi cụm bạn phải thực hiện phân tích tĩnh của mã kho, các bản ghi công việc, các công việc được tải về mẫu, và bất kỳ mã bên ngoài liên quan cho đến khi bạn là ít nhất 99% chắc chắn nguyên nhân gốc trước khi bạn thay đổi bất cứ điều gì. Nếu lớp lỗi là một lỗi biên kịch, bạn phải theo [Lỗi biên kịch](#playwright-failures) phân tích tài sản trước khi tiếp tục."

# translated-by: libretranslate
msgid "You MUST combine the matching `--color-XX-*` and `--color-rgb-XX-*` tokens in a way that is both meaningful and aesthetically coherent so semantic mappings, surfaces, gradients, borders, and overlays work together as one design system."
msgstr "Bạn phải kết hợp các khớp `--color-XX-*` và `--color-rgb-XX-*` theo một cách vừa ý nghĩa vừa thẩm mỹ hợp như vậy bản đồ ngữ nghĩa, bề mặt, dốc, biên giới và bao gồm với nhau như một hệ thống thiết kế."

# translated-by: libretranslate
msgid "You MUST commit only after all required checks pass."
msgstr "Anh phải cam kết chỉ sau khi kiểm tra xong."

# translated-by: libretranslate
msgid "You MUST compare the implemented behavior against the rendered UI so missing hooks, duplicate handlers, broken selectors, and unexpected side effects become visible."
msgstr "Bạn nên so sánh hành vi được thực hiện với việc vẽ UI như vậy thiếu móc, sao chép bộ quản lý, bộ chọn bị hỏng, và các hiệu ứng phụ bất ngờ trở thành hiển thị."

# translated-by: libretranslate
#, python-brace-format
msgid "You MUST consume tunable runtime parameters via strict substitution `${VAR:?Run 'make dotenv' to generate the .env single source of truth}`; the default lives in [default.env](../../../../default.env). Inline `${VAR:-default}` forms are forbidden and enforced by [test_no_default_substitutions.py](../../../../tests/integration/infrastructure/compose/test_no_default_substitutions.py)."
msgstr "Bạn phải tiêu thụ các tham số thời gian chạy cá ngừ qua việc thay thế nghiêm ngặt `${VAR:?Run 'make dotenv' to generate the .env single source of truth}`; cuộc sống mặc định [default.env](../../../../default.env). Trực tiếp `${VAR:-default}` Hình thức bị cấm và ép buộc bởi [test_no_default_substitutions.py](../../../../tests/integration/infrastructure/compose/test_no_default_substitutions.py)."

# translated-by: libretranslate
msgid "You MUST cross-link from the implementing PR template back to the requirement file."
msgstr "Bạn phải đối chiếu từ các thực hiện mẫu PR trở lại tập tin yêu cầu."

# translated-by: libretranslate
msgid "You MUST cross-link from the requirement to any PR or issue that implements it."
msgstr "Bạn phải vượt qua các liên kết từ yêu cầu để bất kỳ PR hoặc vấn đề thực hiện nó."

# translated-by: libretranslate
msgid "You MUST debug from the live local output and local logs."
msgstr "Bạn phải gỡ lỗi từ kết xuất cục bộ và bản ghi cục bộ."

# translated-by: libretranslate
msgid "You MUST declare each external value as a Docker `ARG` without a default value so the build always requires the value to be passed explicitly."
msgstr "Bạn phải tuyên bố mỗi giá trị bên ngoài là một Docker `ARG` mà không có giá trị mặc định vì vậy việc xây dựng luôn luôn yêu cầu giá trị được truyền đi một cách rõ ràng."

# translated-by: libretranslate
msgid "You MUST define `APP_BASE_URL` consistent with the Entry Point rules in the contrib SPOT, in particular the dashboard routing rule when `services.dashboard.enabled` is set."
msgstr "Bạn phải xác định `APP_BASE_URL` phù hợp với các quy tắc mục điểm trong contrib SPOT, cụ thể là các quy tắc định bảng điều khiển khi `services.dashboard.enabled` được thiết lập."

# translated-by: libretranslate
msgid "You MUST describe only the current state of the subject. You MUST NOT carry historical context, migration notes, or comparisons to former implementations into documentation. Phrases such as \"this replaces X\", \"previously X did Y\", \"formerly known as X\", \"the legacy X\", or \"after the refactor\" MUST NOT appear in documentation. Readers arrive in the present and need to know how the subject works now, not how it used to work. Historical context belongs in commit messages, pull request descriptions, and changelogs, where it is anchored to a point in time and ages gracefully. Documentation that carries history rots as soon as the next refactor lands."
msgstr "Bạn chỉ nên mô tả tình trạng hiện tại của đối tượng. Bạn không nên mang theo bối cảnh lịch sử, ghi chú di cư hoặc so sánh với những tài liệu cũ. Từ ngữ như \"cái này thay thế X\". \"X trước đó đã làm Y\". \"cũ được gọi là X\". \"di sản X\"hoặc \"sau khi trả lại\" Không nên xuất hiện trong tài liệu. Độc giả đến hiện tại và cần biết đề tài này hoạt động thế nào, chứ không phải cách nó hoạt động. Bối cảnh lịch sử là trong việc thực hiện thông điệp, kéo những lời yêu cầu và bản ghi chép, nơi mà nó được đặt ở một điểm thời gian và thời đại duyên dáng. Tài liệu về lịch sử bị thối rữa ngay sau khi vùng đất tái định cư kế tiếp."

# translated-by: libretranslate
#, python-brace-format
msgid "You MUST determine the comparison branch automatically when possible (the PR base branch from `gh pr view --json baseRefName`, or the configured upstream from `git rev-parse --abbrev-ref @{u}`). If neither is available, you MUST ask the operator which branch to compare against before proceeding."
msgstr "Bạn phải tự động xác định chi nhánh được so sánh khi có thể (Các chi nhánh PR từ `gh pr view --json baseRefName`, hoặc cấu hình ngược dòng từ `git rev-parse --abbrev-ref @{u}`). Nếu không có thì bạn nên hỏi người điều hành chi nhánh nào để so sánh trước khi tiến hành."

# translated-by: libretranslate
msgid "You MUST determine whether each failure is specific to the current branch or also reproduces elsewhere:"
msgstr "Bạn phải xác định xem mỗi thất bại là cụ thể cho chi nhánh hiện nay hay cũng tái sinh ở những nơi khác:"

# translated-by: libretranslate
msgid "You MUST disable UI fields that are authored by OIDC or LDAP so users do not edit values locally that are managed by the identity provider or directory."
msgstr "Bạn phải tắt các trường UI được tạo bởi OIDC hay LDAP để người dùng không sửa đổi giá trị cục bộ được quản lý bởi nhà cung cấp nhân dạng hay thư mục."

# translated-by: libretranslate
msgid "You MUST document every new env var by adding the row below AND committing a one-line `# ...` comment above its key in [default.env](../../../../default.env)."
msgstr "Bạn phải tài liệu tất cả các env var mới bằng cách thêm các hàng dưới đây và cam kết một dòng `# ...` bình luận trên chìa khóa của nó trong [default.env](../../../../default.env)."

# translated-by: libretranslate
msgid "You MUST document in the test file why the check is external and what live dependency it contacts."
msgstr "Bạn phải tài liệu trong tập tin kiểm tra tại sao ngân phiếu là bên ngoài và những gì sống phụ thuộc nó liên lạc."

# translated-by: libretranslate
msgid "You MUST drive the scenarios through a real browser session against the deployed role. A green local file-lint does not satisfy this step."
msgstr "Bạn phải lái kịch bản qua một phiên chạy duyệt thật chống lại vai trò đã triển khai. Một tập tin cục bộ màu xanh lá cây không thỏa mãn bước này."

# translated-by: libretranslate
msgid "You MUST enumerate every failed job under the parent run, including matrix jobs and reusable-workflow jobs, via `gh run view <run-id> --json jobs --jq '.jobs[] | select(.conclusion==\"failure\")'`."
msgstr "Bạn phải tính toán tất cả các công việc thất bại dưới cha mẹ chạy, bao gồm công việc ma trận và công việc lưu lại có thể làm việc, thông qua `gh run view <run-id> --json jobs --jq '.jobs[] | select(.conclusion==\"failure\")'`."

# translated-by: libretranslate
msgid "You MUST evaluate whether the failure could plausibly originate from commits on the current branch."
msgstr "Bạn phải đánh giá xem sự thất bại có thể xuất phát từ những điều khoản ở chi nhánh hiện tại hay không."

# translated-by: libretranslate
msgid "You MUST extract non-trivial non-YAML code out of task files into a dedicated role asset instead of inlining it:"
msgstr "Bạn cần phải lấy mã không liên quan ra khỏi tập tin nhiệm vụ vào một tài sản đóng góp, thay vì ghép lại:"

# translated-by: libretranslate
msgid "You MUST fix code quality issues before merge"
msgstr "Bạn phải sửa lỗi mật mã trước khi hợp nhất"

# translated-by: libretranslate
msgid "You MUST fix nearby wording and semantic issues when you touch a file, and correct obvious nearby issues proactively in the same pass."
msgstr "Bạn phải sửa chữa các từ ngữ gần đó và các vấn đề ngữ pháp khi bạn chạm vào một tập tin, và sửa chữa các vấn đề gần đó một cách tích cực trong cùng một cách."

# translated-by: libretranslate
msgid "You MUST follow [Compose Loop](iteration/compose.md) for the edit-deploy-validate loop while implementing criteria."
msgstr "Bạn phải theo [Vòng lặp cấu trúc](iteration/compose.md) để chỉnh sửa vòng lặp ngày tháng và thực hiện các tiêu chuẩn."

# translated-by: libretranslate
msgid "You MUST follow the template selection guidance in [CONTRIBUTING.md](../../../CONTRIBUTING.md)."
msgstr "Bạn phải theo hướng dẫn chọn mẫu trong [CONTRIBUTING.md](../../../CONTRIBUTING.md)."

# translated-by: libretranslate
msgid "You MUST follow these ethics when you execute instructions:"
