# translated-by: libretranslate
msgid "**Single Sign-On (SSO) / OpenID Connect (OIDC):** Seamless integration with external identity providers for centralized authentication."
msgstr "**Một dấu trên (SSO) / OpenID Kết nối (OIDC):** Hợp nhất không giới hạn với các nhà cung cấp danh tính bên ngoài để trung tâm xác thực."

# translated-by: libretranslate
msgid "**Single Sign-On:** Frontend and controller share one Keycloak client and realm."
msgstr "**Ký đơn vào:** Giao diện và điều khiển chia sẻ một Keycloak Khách hàng và vương quốc."

# translated-by: libretranslate
msgid "**Single Sign-On:** Users authenticate once via Keycloak and reuse the session across the platform."
msgstr "**Ký đơn vào:** Xác thực người dùng qua Keycloak và tái sử dụng phiên họp bên kia sân ga."

# translated-by: libretranslate
msgid "**Single key, per-app subdomains:** one hidden service serves every app at `<app>.<node>.onion`, Host-routed by OpenResty."
msgstr "**Các phím đơn, phụ thuộc trên một:** một dịch vụ ẩn phục vụ mọi ứng dụng tại `<app>.<node>.onion`, host-routed bởi OpenResty."

# translated-by: libretranslate
