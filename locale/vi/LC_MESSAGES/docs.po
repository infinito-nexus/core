# translated-by: libretranslate
msgid "Skips any client that is not deployed on this host, or whose `mcp` block is disabled or unshared."
msgstr "Bỏ qua bất kỳ trình khách nào không được triển khai trên máy này, hoặc của ai `mcp` khối bị tắt hoặc không chia sẻ."

# translated-by: libretranslate
