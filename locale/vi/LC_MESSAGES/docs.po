# translated-by: libretranslate
msgid "**Single Container:** No database server, no cache, no worker, no object store. SQLite in one volume."
msgstr "**Comment** Không máy phục vụ cơ sở dữ liệu, không bộ nhớ tạm, không công nhân, không cửa hàng đối tượng. Mê cung trong một khối."

# translated-by: libretranslate
msgid "**Single Domain and Wildcard Support:** Handles both individual domains and wildcard domains (`*.example.com`)."
msgstr "**Hỗ trợ miền đơn và thẻ hoang dã:** Xử lý cả hai miền riêng lẻ và miền đại diện (`*.example.com`)."

# translated-by: libretranslate
