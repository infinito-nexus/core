# translated-by: libretranslate
msgid "This directory contains custom **Ansible filter plugins** used within the Infinito.Nexus project."
msgstr "Thư mục này chứa tùy chọn **Bổ sung lọc khả năng** được dùng trong Infinito.Nexus dự án."

# translated-by: libretranslate
msgid "This directory contains custom **Ansible lookup plugins** used within the Infinito.Nexus project."
msgstr "Thư mục này chứa tùy chọn **Xem bổ sung** được dùng trong Infinito.Nexus dự án."

# translated-by: libretranslate
msgid "This directory contains debugging guidance for contributor workflows. Its scope is how to investigate failures in CI, networking, and related development loops."
msgstr "Thư mục này chứa hướng dẫn gỡ lỗi cho luồng công việc đóng góp. Phạm vi của nó là làm thế nào để nghiên cứu thất bại trong CN, mạng và các vòng phát triển liên quan."

# translated-by: libretranslate
