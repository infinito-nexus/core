msgid "Small and medium-sized enterprises that require secure collaboration and centralized authentication."
msgstr "Những doanh nghiệp nhỏ và trung bình đòi hỏi sự hợp tác an toàn và sự xác thực tập trung."

# translated-by: libretranslate
msgid "Small cleanup reduces future friction."
msgstr "Việc dọn dẹp nhỏ làm giảm sự va chạm trong tương lai."

# translated-by: libretranslate
msgid "Small test-local callbacks or path formatters where a named function would add noise."
msgstr "Gọi ngược lại thử nghiệm nhỏ hoặc định dạng đường dẫn nơi hàm tên sẽ thêm nhiễu."

# translated-by: libretranslate
msgid "Smaller role fixes: ERPNext bypasses the v16 setup wizard per app and clears the Frappe cache after applying social-login, LDAP and email configuration; Friendica strips a trailing slash from the base URL and makes the admin-follow Playwright test idempotent; Funkwhale starts its API with gunicorn and binds the port."
msgstr "Sửa chữa vai trò nhỏ hơn: Lỗi chính tả16 đã cài đặt trợ lý cho mỗi ứng dụng và xóa bỏ bộ nhớ tạm Frappe sau khi áp dụng bộ nhớ tạm xã hội, LDAP và cấu hình email; Friendica lột bỏ một vết cắt có dấu vết từ địa chỉ URL cơ bản và làm cho việc kiểm tra phát âm theo dõi Playempotent; Funkbrale bắt đầu nó API Với cây lựu và cột cổng lại."

# translated-by: libretranslate
msgid "Smallest v1 surface; matches the upstream default Docker compose. External runner agents are a follow-up."
msgstr "V nhỏ nhất1 bề mặt; phù hợp với chế độ theo dòng mặc định Docker. Các đặc vụ bên ngoài đang theo dõi."

# translated-by: libretranslate
msgid "Smart Assist"
msgstr "Giúp đỡ thông minh"

