# translated-by: libretranslate
msgid "**Complete Dockerized Deployment**: Uses Docker Compose to run Akaunting and its associated database."
msgstr "**Hoàn toàn bị phá vỡ**: Docker Compose chạy Akaunting và cơ sở dữ liệu liên quan."

# translated-by: libretranslate
