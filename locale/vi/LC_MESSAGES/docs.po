msgid "``(name, email)``; either is empty when neither source knows it."
msgstr "``(name, email)``; hoặc là trống rỗng khi không nguồn nào biết nó."

# translated-by: libretranslate
msgid "``(payload_bytes, total_bytes)`` on success"
msgstr "``(payload_bytes, total_bytes)`` thành công"

