# translated-by: libretranslate
msgid "This directory contains scripts that resolve metadata and derived values used by the project."
msgstr "Thư mục này chứa các tập lệnh giải quyết siêu dữ liệu và định dạng các giá trị được dùng bởi dự án này."

# translated-by: libretranslate
