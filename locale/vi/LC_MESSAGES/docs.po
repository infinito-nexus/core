# translated-by: libretranslate
msgid "You MUST get **2 approvals** before merging"
msgstr "Anh phải lấy **2 Chấp thuận** trước khi trộn"

# translated-by: libretranslate
msgid "You MUST get approvals again"
msgstr "Anh phải được chấp thuận lần nữa."

