msgstr "INFINITO_DOMAIN: ``<stack>.<INFINITO_DNS_DOMAIN>``, ahol a stack van ``main`` az elsődleges pénztárhoz és egy összekapcsolt git munkafa normalizált ágához. Mindig felülírja a hívó env, amely belül a stack tartály az előző ``.env``; GitHub / act fut tartani a statikus alapértelmezett és custom.env Pins nyert."

# libretranslate
msgid "INFINITO_FORK_ACCOUNT: GitHub account holding the operator's fork, defaulting to the local OS username."
msgstr "INFINITO_FORK_ACCOUNT: GitHub számla, amely az üzemeltető villáját őrzi, a helyi OS felhasználónév hiányában."

# libretranslate
msgid "INFINITO_FORK_REPOSITORY_URL: GitHub URL of the operator's fork, composed from INFINITO_FORK_ACCOUNT and INFINITO_FORK_REPOSITORY_NAME."
msgstr "INFINITO_FORK_REPOSITORY_URL: GitHub URL az üzemeltető villa, áll INFINITO_FORK_ACCOUNT és INFINITO_FORK_REPOSITORY_NAME."

msgid "INFINITO_GPU_COUNT: GPUs the compose services reserve, 'all' when the docker daemon registers an NVIDIA runtime, else 0."
msgstr ""

msgid "INFINITO_I18N_BATCH_SIZE / INFINITO_I18N_LANES: client settings `make i18n-tune` measured on this host, falling back to the shipped defaults."
msgstr ""

msgid "INFINITO_I18N_LIBRETRANSLATE_PORT: loopback port the i18n runner forwards to its LibreTranslate, read from roles/web-svc-libretranslate/meta/services.yml."
msgstr ""

# libretranslate
msgid "INFINITO_IMAGE: fully-qualified GHCR image reference assembled from owner, repo, distro and tag (GHA-only)."
msgstr "INFINITO_IMAGE: teljes mértékben minősített GHCR képhivatkozás a tulajdonos, repo, disztró és tag (GHA- kizárólag)."

# libretranslate
msgid "INFINITO_IMAGE_REPOSITORY: lowercased repository name resolved from scripts/meta/resolve/repository/name.sh (GHA-only)."
msgstr "INFINITO_IMAGE_REPOSITORY: kisbetűs adattár neve scripts/meta/resolve/repository/name.sh (GHA- kizárólag)."

# libretranslate
msgid "INFINITO_IS_WSL2: true when /proc/version identifies the host as WSL2."
msgstr "INFINITO_IS_WSL2: igaz, amikor / proc / version azonosítja a host WSL2."

# libretranslate
msgid "INFINITO_OUTER_NETWORK_MTU: MTU of the compose stack's bridge network."
msgstr "INFINITO_OUTER_NETWORK_MTU: MTU a kompozit stack híd hálózat."

# libretranslate
msgid "INFINITO_PARENT_IMAGE: distribution base image reference composed from INFINITO_PARENT_IMAGE_OWNER, INFINITO_DISTRO and INFINITO_PARENT_IMAGE_TAG."
msgstr "INFINITO_PARENT_IMAGE: disztribúciós alapkép referenciája INFINITO_PARENT_IMAGE_OWNER, INFINITO_DISTRO és INFINITO_PARENT_IMAGE_TAG."

# libretranslate
msgid "INFINITO_PLAYWRIGHT_REPORTS_BASE_DIR: per-app Playwright reports root, derived from the var-lib SPOT (INFINITO_DIR_VAR_LIB)."
msgstr "INFINITO_PLAYWRIGHT_REPORTS_BASE_DIR: per- app Playwright jelentések gyökér, a varlib SPOT (INFINITO_DIR_VAR_LIB)."

# libretranslate
msgid "INFINITO_PLAYWRIGHT_STAGE_BASE_DIR: host dir where Playwright projects are staged per role, read from the test-e2e-playwright role vars SPOT (``TEST_E2E_PLAYWRIGHT_STAGE_BASE_DIR``)."
msgstr "INFINITO_PLAYWRIGHT_STAGE_BASE_DIR: host dir, ahol Playwright projektek rendeznek egy szerepet, olvassa el a test-e2e-playwright szerepkörök (``TEST_E2E_PLAYWRIGHT_STAGE_BASE_DIR``)."

# libretranslate
msgid "INFINITO_PULL_POLICY: GHA-side override -- always pull the published image instead of trusting whatever is cached on the runner."
msgstr "INFINITO_PULL_POLICY: GHA- oldalsó felülírás -- mindig húzza meg a közzétett képet ahelyett, hogy megbízna abban, ami a futóban van."

# libretranslate
msgid "INFINITO_RESCUE_DIAGNOSTICS_DIR: rescue snapshot folder, read from the group_vars paths SPOT (group_vars/all/05_paths.yml DIR_RESCUE_DIAGNOSTICS)."
msgstr "INFINITO_RESCUE_DIAGNOSTICS_DIR: mentési pillanatfelvétel mappa, olvasott a group_vars PONT (group_vars/all/05_paths.yml DIR_RESCUE_DIAGNOSTICS)."

# libretranslate
msgid "INFINITO_RESCUE_LOCAL_DUMPS_DIR: where in-play role dumps land, read from the group_vars paths SPOT (group_vars/all/05_paths.yml DIR_RESCUE_DIAGNOSTICS)."
msgstr "INFINITO_RESCUE_LOCAL_DUMPS_DIR: ahol in-play szerepet dob földet, olvassa a group_vars PONT (group_vars/all/05_paths.yml DIR_RESCUE_DIAGNOSTICS)."

# libretranslate
msgid "INFINITO_RUNNING_ON_ACT: true when running under nektos/act locally."
msgstr "INFINITO_RUNNING_ON_ACT: igaz, amikor fut a nektos / cselekszik helyben."

# libretranslate
msgid "INFINITO_RUNNING_ON_GITHUB: true when running on real GitHub Actions (not act)."
msgstr "INFINITO_RUNNING_ON_GITHUB: igaz, amikor fut a valódi GitHub akciók (nem cselekszik)."

# libretranslate
msgid "INFINITO_SWARM_NFS_EXPORT_BASE: NFS export base inside the NFS-server sidecar, read from the provider SPOT roles/svc-storage-nfs-server/meta/services.yml."
msgstr "INFINITO_SWARM_NFS_EXPORT_BASE: NFS exportbázis az NFS- szerver oldalkocsi belsejében, a szolgáltató SFOT-jából olvasva roles/svc-storage-nfs-server/meta/services.yml."

# libretranslate
msgid "INFINITO_SWARM_NFS_STATE_PATH: cluster-shared NFS state dir for the act-swarm test harness, derived from the export-base SPOT (INFINITO_SWARM_NFS_EXPORT_BASE) and the shared state subdir constant."
msgstr "INFINITO_SWARM_NFS_STATE_PATH: cluster- shared NFS state dir for the act-rawy test ancill from the export- base SPOT (INFINITO_SWARM_NFS_EXPORT_BASE) és a megosztott állam állandó."

# libretranslate
msgid "INFINITO_TOR_SOCKS_PORT: node Tor SOCKS port, read from the single source of truth in svc-net-tor's meta/services.yml (services.tor.ports.local.socks). Keeps shell consumers (e.g. the Playwright rerunner) off a hard-coded port literal."
msgstr "INFINITO_TOR_SOCKS_PORT: csomópont Tor SOCKS port, olvassa el az egyetlen forrásból az igazság svc-net-tors meta/services.yml (services.tor.ports.local.socks). Tart shell fogyasztók (például a Playwright-visszafutó) egy kódolt portból."

# libretranslate
msgid "INFINITO_WORKER_CPU * 20, with a base of 1 collapsing to 1 (the operator's sequential-fallback signal). Consumed by URL probers and upstream tag fetchers."
msgstr "INFINITO_WORKER_CPU * 20, 1 összeomlás 1 (az üzemben tartó folyamatos visszacsatolási jelzése). Elfogyasztja az URL szondázók és upstream címke csipeszek."

# libretranslate
msgid "INFINITO_WORKER_CPU: CPU-count base for the worker SPOT chain."
msgstr "INFINITO_WORKER_CPU: CPU- count base for the worker SPOT chain."

# libretranslate
msgid "INFINITO_WORKER_FETCH: I/O-bound network-fetch worker count."
msgstr "INFINITO_WORKER_FETCH: I / O- kötött network-fetch working count."

