# libretranslate
msgid "**Filter** domains with or without your `DOMAIN_PRIMARY`"
msgstr "**Szűrő** domainek a `DOMAIN_PRIMARY`"

# libretranslate
msgid "**Filter** domains with or without your ``DOMAIN_PRIMARY``"
