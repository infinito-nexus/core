# libretranslate
msgid "A module MAY read tool-specific environment overrides (e.g. `ACTIONLINT_VERSION`, `RUFF_PIP_SPEC`) at call time."
msgstr "A modul lehet olvasni eszközök-specifikus környezeti felülvizsgálatok (pl. `ACTIONLINT_VERSION`, `RUFF_PIP_SPEC`) a telefonban."

