msgid "Do **not** just rename mailbox folders."
msgstr "Do **nem** Csak átnevezem a postaládákat."

# libretranslate
msgid "Do NOT break native login, logout, navigation, or form flows unless the role explicitly requires that change and the new behavior is verified end to end."
msgstr "NE törje fel az anyanyelvi bejelentkezést, a kijelentkezést, a navigációt vagy a formááramlást, kivéve, ha a szerep kifejezetten megköveteli ezt a változást, és az új viselkedést a végétől a végéig ellenőrzik."

# libretranslate
msgid "Do NOT document patterns or extension points that do not exist in the code."
msgstr "NEM dokumentálhat olyan mintákat vagy kiterjesztési pontokat, amelyek nem léteznek a kódban."

# libretranslate
msgid "Do NOT expose unused variables, duplicate values, or secrets that the spec never reads."
msgstr "NE fedje fel a fel nem használt változókat, kettős értékeket vagy titkokat, amelyeket a spec soha nem olvas el."

