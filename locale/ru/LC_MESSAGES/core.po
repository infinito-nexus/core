# libretranslate
msgctxt "role:web-app-postmarks:description"
msgid "Single-user ActivityPub bookmarking site federating public bookmarks to Mastodon and the Fediverse"
msgstr "Сайт закладок ActivityPub, объединяющий публичные закладки Mastodon и Fediverse"

# libretranslate
