msgstr "Управление взаимоотношениями с клиентами (CRM) программное обеспечение для управления отношениями с клиентами, конвейерами продаж, маркетингом и поддержкой."

# libretranslate
msgctxt "category:sys.dns:title"
msgid "DNS Automation"
msgstr "Автоматизация DNS"

# libretranslate
msgctxt "category:svc.dns:title"
msgid "DNS Resolvers"
msgstr "DNS растворители"

# libretranslate
msgctxt "category:sys.dns:description"
msgid "DNS providers, records, and rDNS management (Cloudflare, Hetzner, etc.)."
msgstr "Поставщики DNS, записи и управление rDNS (Cloudflare, Hetzner и др.)."

# libretranslate
msgctxt "role:sys-dns-cloudflare-records:description"
msgid "Data-driven role for managing Cloudflare DNS records (A/AAAA, CNAME, MX, TXT, SRV) across apps and environments"
msgstr "Роль, управляемая данными для управления записями DNS Cloudflare (A/AAAA, CNAME, MX, TXT, SRV) В приложениях и средах"

# libretranslate
msgctxt "category:svc.db:description"
msgid "Database applications (DBMS, LDAP, Redis, etc.)"
msgstr "Приложения базы данных (СУБД, LDAP, Redis и т.д.)"

# libretranslate
msgctxt "category:svc.db:title"
msgid "Databases"
msgstr "Базы данных"

# libretranslate
msgctxt "role:web-app-peertube:description"
msgid "Decentralized, federated platform for peer-to-peer video hosting, streaming, and live broadcasting"
msgstr "Децентрализованная, федеративная платформа для однорангового видеохостинга, потоковой передачи и прямого вещания"

# libretranslate
msgctxt "role:web-app-pixelfed:description"
msgid "Decentralized, federated platform for photo sharing and image feeds across the fediverse"
msgstr "Децентрализованная, федеративная платформа для обмена фотографиями и передачи изображений по всему миру"

# libretranslate
msgctxt "role:web-app-friendica:description"
msgid "Decentralized, federated social-networking platform for peer-to-peer communication and community building"
msgstr "Децентрализованная, федеративная социальная сетевая платформа для одноранговой коммуникации и построения сообществ"

# libretranslate
msgctxt "role:user-administrator:description"
msgid "Dedicated administrator account with SSH key access and password-authenticated sudo for secure privilege escalation"
msgstr "Выделенная учетная запись администратора с доступом к ключам SSH и аутентифицированным паролем для безопасной эскалации привилегий"

# libretranslate
msgctxt "role:user-backup:description"
