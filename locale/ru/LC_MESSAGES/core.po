msgctxt "category:svc.storage:title"
msgid "Shared Storage"
msgstr "Совместное хранение"

# libretranslate
msgctxt "role:sys-openssl:description"
msgid "Shared host dependency ensuring the OpenSSL CLI is installed once for roles that invoke openssl commands"
msgstr "Общая зависимость хоста, обеспечивающая установку OpenSSL CLI один раз для ролей, которые вызывают команды openssl"

# libretranslate
msgctxt "role:svc-db-rabbitmq:description"
msgid "Shared message broker for async messaging with per-consumer virtual host and user isolation"
msgstr "Общий брокер сообщений для обмена сообщениями с виртуальным хостом на одного потребителя и изоляцией пользователя"

# libretranslate
msgctxt "category:svc.storage:description"
msgid "Shared persistent-storage backends used by multi-node deployments — NFSv4 server and client roles."
msgstr "Общие серверы с постоянным хранением, используемые многоузловыми развертываниями — NFSv4 Роль сервера и клиента."

# libretranslate
msgctxt "role:svc-db-mariadb:description"
msgid "Shared relational database server for applications needing central SQL storage, run in Docker"
msgstr "Общий сервер реляционной базы данных для приложений, нуждающихся в центральном хранилище SQL, запускается в Docker"

