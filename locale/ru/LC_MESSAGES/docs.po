msgid "``package.json`` and ``playwright.config.js`` are provided centrally by this role:"
msgstr "``package.json`` и ``playwright.config.js`` Эта роль обеспечивается централизованно:"

# translated-by: libretranslate
msgid "``package_name`` (string) Name of the Python package to install (e.g., ``dockreap``, ``backup-docker-to-local``)."
msgstr "``package_name`` (струна) Название пакета Python для установки (например, ``dockreap``, ``backup-docker-to-local``)."

# translated-by: libretranslate
msgid "``password`` (should come from vault/credentials)"
msgstr "``password`` (должен исходить из хранилища / учетных данных)"

