msgid "``modes``: list of DEPLOYMENT_MODE values where this overlay applies"
msgstr "``modes``: Список DEPLOYMENT_MODE значения, где применяется это наложение"

# translated-by: libretranslate
msgid "``mounts``         the raw mounts list, ``[]`` if absent"
msgstr "``mounts`` Список горных хребтов, ``[]`` если отсутствует"

