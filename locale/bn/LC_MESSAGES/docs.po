# libretranslate
msgid "Return a new path pointing to expanduser('~')."
msgstr "সামনে এগিয়ে চলুন('!'). ."

# libretranslate
msgid "Return a new path pointing to the current working directory."
msgstr "বর্তমান কাজের ডিরেক্টরীতে একটি নতুন রাস্তা ফেরত দাও ।"

# libretranslate
msgid "Return a new path with expanded ~ and ~user constructs (as returned by os.path.expanduser)"
msgstr "প্রসারিত এবং বিসকেট দিয়ে একটি নতুন পাথ ফিরিয়ে আনুন (প্রাপ্ত মান os.path.expanduser)"

# libretranslate
msgid "Return a password satisfying what the user's own declaration demands."
