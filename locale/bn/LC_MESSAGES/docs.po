# libretranslate
msgid "You MUST use `# nocheck: docker-version` directly above a `version:` key only for intentional exceptions that should not be flagged by the external image-version check."
msgstr "ব্যবহৃত `# nocheck: docker-version` উপরের দিকের ওপর `version:` শুধুমাত্র উদ্দেশ্যপ্রণোদিত ব্যতিক্রমের কী যা বাইরের ছবির-ছবির উপর নির্ভর করে না।."

# libretranslate
msgid "You MUST use `--color-01-*` and `--color-rgb-01-*` as the primary palette. They MUST cover the majority of themed surfaces."
msgstr "ব্যবহৃত `--color-01-*` এবং `--color-rgb-01-*` প্রাথমিক প্যালেট হিসেবে। তারা এমএসটি-এর বেশির ভাগ অংশ ঢেকে রাখে।."

# libretranslate
msgid "You MUST use `.md` files for commands, workflows, setup, and contributor guidance."
msgstr "ব্যবহৃত `.md` কমান্ড, কর্ম প্রবাহ, প্রস্তুতি, এবং প্রদায়ক গাইডের জন্য ফাইল।."

# libretranslate
msgid "You MUST use `chmod +x` for those scripts so they can be invoked as executables."
msgstr "ব্যবহৃত `chmod +x` সেই স্ক্রিপ্টগুলোর জন্য তাদেরকে এক্সেকিউটেবল বলা যেতে পারে।."

# libretranslate
msgid "You MUST use `dotenv_quote` for values that may contain spaces, special characters, or shell-sensitive content."
msgstr "ব্যবহৃত `dotenv_quote` হরফের মধ্যে উপস্থিত অক্ষর, অথবা বিশেষ অক্ষরের ছাঁদ সম্পর্কে সচেতন করতে পারবেন।."

# libretranslate
msgid "You MUST use `files/javascript/javascript.js` when the script is static and does not depend on templating."
msgstr "ব্যবহৃত `files/javascript/javascript.js` যখন স্ক্রিপ্টটি চালু হচ্ছে এবং এই সমস্যার উপর নির্ভর করে না।."

# libretranslate
msgid "You MUST use `javascript.js.j2` when the script depends on role variables or inventory values, and use `files/javascript/javascript.js` when the script is static."
msgstr "ব্যবহৃত `javascript.js.j2` যখন স্ক্রিপ্টটি ভূমিকার উপর নির্ভর করে অথবা আবিষ্কারক মূল্যবোধের উপর, এবং ব্যবহার `files/javascript/javascript.js` যখন স্ক্রিপ্ট চালু হবে।."

# libretranslate
msgid "You MUST use `templates/javascript.js.j2` when runtime values from the inventory or role variables must be rendered into the browser code."
msgstr "ব্যবহৃত `templates/javascript.js.j2` আবিষ্কারক অথবা ভূমিকার ক্ষেত্রে কর্মফল হিসেবে ব্যবহৃত হলে ব্রাউজার কোডে প্রয়োগ করা হবে।."

# libretranslate
msgid "You MUST use a Pull Request (PR)"
msgstr "আপনি MST অনুরোধটি ব্যবহার করেন (পি- জি- পি)"

# libretranslate
msgid "You MUST use comments to explain why something is unusual, not to restate what obvious code already does."
msgstr "আপনি এমএসটি-এর মন্তব্যকে ব্যাখ্যা করার জন্য ব্যবহার করেন, কেন কোন বিষয় অস্বাভাবিক, যা ইতোমধ্যে স্পষ্ট কোন কোড তৈরি করে।."

# libretranslate
msgid "You MUST use external tests only when the behavior depends on a live third-party system and a hermetic unit, lint, or integration test would not verify the real condition."
msgstr "আপনি MuST ব্যবহার করেন শুধুমাত্র যখন আচরণ একটি লাইভ-গঠি সিস্টেম এবং একটি মানসিক একক, ভাষাগত পরীক্ষা প্রকৃত অবস্থা যাচাই করবে না।."

# libretranslate
msgid "You MUST use role-local JavaScript only for browser-side gaps that cannot be solved cleanly through app configuration, server configuration, or CSS alone."
msgstr "MST- স্থানীয় জাভাস্ক্রীপ্ট শুধুমাত্র ব্রাউজার- এর জন্য ব্যবহার করে যা কনফিগারেশন, সার্ভার অথবা CSS- এর মধ্যে পরিষ্কার ভাবে সমাধান করা যাবে না ।."

# libretranslate
msgid "You MUST use role-local JavaScript only for browser-side integration gaps that cannot be solved cleanly through app configuration or CSS alone."
msgstr "আপনি MST-স্থানীয় জাভাস্ক্রীপ্ট ব্যবহার করে শুধুমাত্র ব্রাউজার- এর মধ্যে সম্পর্ক স্থাপন করতে পারবেন যা অ্যাপ কনফিগারেশন অথবা সি. সি. পি. ব্যবহার করে পরিষ্কার করতে পারবেন না ।."

# libretranslate
msgid "You MUST use the AI forum at [s.infinito.nexus/aihub](https://s.infinito.nexus/aihub) as the companion guidance and support resource."
msgstr "আপনি এমএসটি-এর শুভেচ্ছা ফোরাম ব্যবহার করেন [s.infinito.nexus/ মুসলমানদের ক্ষেত্রে](https://s.infinito.nexus/aihub) সঙ্গী হিসেবে পরিচালনা এবং সমর্থনের জন্য।."

# libretranslate
msgid "You MUST use the templates from [PULL_REQUEST_TEMPLATE](../../../.github/PULL_REQUEST_TEMPLATE)."
msgstr "MUST টেমপ্লেট থেকে টেমপ্লেট ব্যবহার করে [PULL_REQUEST_TEMPLATE](../../../.github/PULL_REQUEST_TEMPLATE). ."

# libretranslate
msgid "You MUST use these linting and quality tools where applicable:"
msgstr "আপনি এমটিএসকে এই ভাষা ও গুণগত মানসম্পন্ন টুল ব্যবহার করেন যেখানে প্রযোজ্য:"

# libretranslate
msgid "You MUST use these markers only when the check genuinely does not apply. You MUST NOT use them to silence legitimate issues."
msgstr "আপনার এই মার্কারগুলো শুধু তখনই ব্যবহার করা হয় যখন পরীক্ষাটি সত্যি হয় না। আপনি এমএসটি’কে বৈধ বিষয়কে চুপ করার জন্য ব্যবহার করবেন না।."

# libretranslate
msgid "You MUST verify readable contrast for normal, hover, focus, active, and disabled states."
msgstr "আপনি MSTV-টি পরীক্ষা করতে যাচ্ছেন স্বাভাবিক, ধীর, সক্রিয় এবং নিষ্ক্রিয় রাষ্ট্রসমূহের তুলনায়।."

# libretranslate
msgid "You MUST verify schema conformance per [Contributing `playwright.spec.js`](../../../contributing/artefact/files/role/playwright.specs.js.md): persona names match `<persona>: <flow>`, every skip routes through `PERSONA_<X>_BLOCKED=true` or `<NAME>_SERVICE_ENABLED=false` (never runtime detection), and every persona reaches an authenticated surface and drives a role-specific interaction."
msgstr "আপনি mUST নির্দিষ্ট করা জন্য নির্দিষ্ট [বাতিল করা `playwright.spec.js`](../../../contributing/artefact/files/role/playwright.specs.js.md): নাম যোগ করো `<persona>: <flow>`, প ্ রত ্ যেক পশ ্ চাতে ও সম ্ মুখে পরনিন ্ দাকারীর দুর ্ ভোগ , `PERSONA_<X>_BLOCKED=true` অথবা `<NAME>_SERVICE_ENABLED=false` (কর্ম সঞ্চালনার অনুরোধ পরিত্যাগ করা হবে না)এবং প্রত্যেক ব্যক্তি নিজের পরিচয় গোপন রাখতে এবং একটি সুনির্দিষ্ট যোগাযোগ গড়ে তুলতে পারে।."

# libretranslate
msgid "You MUST verify that primary actions, links, forms, cards, dialogs, navigation, and overlays still belong to the same visual system."
msgstr "আপনি এমএসটি নিশ্চিত করেছেন যে প্রাথমিক পদক্ষেপ, লিঙ্ক, ফর্ম, কার্ড, ভ্রমণ, এবং ওভারলেও একই ধরনের ভিজুয়াল সিস্টেমের অংশ।."

# libretranslate
msgid "You MUST verify that the new app behaves correctly end to end, not just whether it compiles or deploys."
msgstr "আপনি MST পরীক্ষা করতে পারেন যে নতুন অ্যাপ্লিকেশনগুলি সঠিকভাবে শেষ হবে, এটা শুধু কম্পাইল বা স্থানান্তর করা হবে কিনা।."

# libretranslate
msgid "You MUST wait for the DOM before touching elements, and guard missing elements so unrelated pages do not break."
msgstr "DST DOM এর জন্য আপনি অপেক্ষা করতে পারেন, এবং সতর্ক এলিমেন্ট হারিয়ে যাওয়ার আগে, যাতে কোনো সম্পর্ক নেই."

# libretranslate
msgid "You MUST write in English in all public channels and threads."
msgstr "আপনি সব পাবলিক চ্যানেলে এবং থ্রেডে ইংরেজি লিখেছেন।."

# libretranslate
msgid "You SHOULD add `design.font.import_url` when typography and colors should be controlled together."
msgstr "আপনি আরও যোগ করতে পারেন `design.font.import_url` যখন typables এবং রং একসাথে নিয়ন্ত্রণ করা উচিত."

# libretranslate
msgid "You SHOULD annotate non-obvious keys with a short inline comment that explains why they exist, not what they do."
msgstr "আপনি একটি সংক্ষিপ্ত ইনলাইন মন্তব্য করতে পারেন যেখানে ব্যাখ্যা করা হয়েছে, কেন তাদের অস্তিত্ব রয়েছে।."

# libretranslate
msgid "You SHOULD attach screenshots, traces, logs, and migration notes when they materially help validate the change."
msgstr "আপনি স্ক্রিনশট, চিহ্ন, লগ এবং অভিবাসনকে সংযুক্ত করতে পারেন, যখন তারা বস্তুগত সাহায্য করেন।."

# libretranslate
msgid "You SHOULD avoid creating or maintaining manual per-directory indexes when automatic indexing already covers the same pages. An additional `index.rst` inside a `docs/` subdirectory is NOT RECOMMENDED because the root index already covers those pages automatically, but it MAY be added when a focused local entry point materially improves navigation. If such a local `index.rst` is added, it SHOULD stay minimal and MUST NOT duplicate a manually curated page inventory that the automatic index already provides."
msgstr "আপনি একই ডকুমেন্টের বিভিন্ন তালিকা তৈরি বা সংরক্ষণ করতে পারেন । একটি অতিরিক্ত `index.rst` ভিতরে `docs/` যুক্তরাস্ট্র নয় কারণ মূল সূচকটি ইতোমধ্যে এই পাতাগুলোকে স্বয়ংক্রিয়ভাবে ঢেকে রেখেছে, কিন্তু নির্দিষ্ট একটি স্থানীয় এন্ট্রির সাথে যোগ করা হয়েছে। এ রকম একটি স্থানীয় `index.rst` এর সাথে আরো যোগ করা হয়েছে, এটি খুব কম থাকতে পারে এবং এমএসটি-এর একটি অনুরূপ পাতা তৈরি করতে পারে না।."

# libretranslate
msgid "You SHOULD avoid jumping straight to repeated remote CI reruns when `make act-workflow` can validate the workflow locally and the user agreed to use it."
msgstr "আপনি যদি সরাসরি দূরবর্তী CIAR ফিরে যেতে না পারেন `make act-workflow` স্থানীয় পর্যায়ে কাজের রোণ্ডুটি বৈধ করতে পারে এবং ব্যবহারকারী তা ব্যবহার করতে রাজি হয়েছে।."

# libretranslate
msgid "You SHOULD check what is actually consuming space before cleaning up:"
msgstr "পরিষ্কার করার আগে প্রকৃতপক্ষে কী পরিমাণ জায়গা সারছেন তা পরীক্ষা করে দেখুন:"

# libretranslate
msgid "You SHOULD cover edge cases: empty inputs, missing keys, and boundary values, not only the happy path."
msgstr ""

# libretranslate
msgid "You SHOULD group them by dependency family such as `tests/external/update/` or `tests/external/github/` when more than one test exists."
msgstr "আপনি তাদেরকে নির্ভরতাপূর্ণ পরিবারের মতো করে গ্রুপ তৈরি করতে পারেন `tests/external/update/` অথবা `tests/external/github/` যখন একই পরীক্ষা আসবে."

# libretranslate
msgid "You SHOULD keep each test focused on one integration boundary."
msgstr "আপনি প্রতিটি পরীক্ষা একটি সমন্বিত সীমানা উপর দৃষ্টি নিবদ্ধ রাখতে পারে."

# libretranslate
msgid "You SHOULD keep external tests focused, advisory, and easy to run on demand."
msgstr "তুমি বাইরের পরীক্ষা, উপদেষ্টা আর চাহিদার ব্যাপারে সহজ হতে পারতে।."

# libretranslate
msgid "You SHOULD keep messages concise and on-topic."
msgstr "তুমি তোমার বার্তা গোপন রাখতে পারবে আর একই সাথে হাত মিলিয়ে নিতে পারবে।."

# libretranslate
msgid "You SHOULD keep network traffic narrow and query each external dependency only as much as needed for a meaningful result."
msgstr "আপনি যদি নেটওয়ার্ক ট্রাফিকের সংকীর্ণতা বজায় রাখেন এবং বাইরের নির্ভরতার খোঁজ করেন, তা হলে সেটা অর্থপূর্ণ ফলাফলের জন্য প্রয়োজন হবে ।."

# libretranslate
msgid "You SHOULD name test methods after the behavior they verify, not the function name alone (e.g. `test_needed_false_when_disabled`)."
msgstr "অক্ষরের ব্যবহার যাচাই করার পরে, নাম যাচাই করার প্রচেষ্টা ব্যর্থ হবে (জি. `test_needed_false_when_disabled`). ."

# libretranslate
msgid "You SHOULD open a Pull Request as a **draft** while your change is still in progress. CI will not run and no reviewer time is spent until you mark it ready."
msgstr "আপনি একটি অনুরোধের মাধ্যমে একটি পুল খুলতে পারেন **খসড়া** আপনার পরিবর্তন এখনো চলছে। সিআই চালানো যাবে না... ...আর কোন রিভিউগারের সময় শেষ হবে না যতক্ষণ না তুমি এটাকে চিহ্নিত করো."

# libretranslate
msgid "You SHOULD place emojis after the headline text to visually highlight headings and improve scannability."
msgstr "শিরোনামের শিরোনামগুলো দেখার পর আপনি ইমোজিস জায়গাটি দেখতে পাবেন।."

# libretranslate
msgid "You SHOULD prefer `Dockerfile` over `Dockerfile.j2`; only use `Dockerfile.j2` when build-time templating is genuinely required."
msgstr "আপনি বেশী পছন্দ করতে পারেন `Dockerfile` শেষ `Dockerfile.j2`; শুধুমাত্র ব্যবহার `Dockerfile.j2` যখন এটা তৈরি করা হবে... ...সত্যিকারের প্রয়োজন."

# libretranslate
msgid "You SHOULD prefer `README.md` for directory-level documentation when a human-facing entry point already exists."
msgstr "আপনি বেশী পছন্দ করতে পারেন `README.md` বর্তমানে উপস্থিত কোনো মানুষ এন্ট্রির তথ্য ধারণ করার সময় সহায়িকা প্রদর্শন করা হবে।."

# libretranslate
msgid "You SHOULD prefer explicit version pinning over drifting tags when the role depends on stable, reproducible deploys."
msgstr "আপনি হয়তো স্পষ্ট সংস্করণ পছন্দ করতে পারেন, যখন কোন ভূমিকার ওপর নির্ভর করে, স্থায়ীভাবে বহন করা, পুনরায় নির্মাণ কাজ করা ।."

# libretranslate
msgid "You SHOULD prefer semantic improvements that reduce maintenance effort."
msgstr "আপনি অতিরিক্ত ব্যায়াম করতে পছন্দ করেন ।."

# libretranslate
msgid "You SHOULD prefer smaller, more focused folders over dumping many unrelated files into one directory."
msgstr "একটি ডিরেক্টরিতে অধিক সংখ্যক ফাইল বাদ দিয়ে আপনি আরো ছোট হতে পারেন ।."

# libretranslate
msgid "You SHOULD prefer targets that compose smaller scripts instead of embedding large shell fragments in the `Makefile`."
