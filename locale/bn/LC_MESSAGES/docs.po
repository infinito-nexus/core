# libretranslate
msgid "Return True iff *line* carries a marker for *rule*."
msgstr "প্রাপ্ত মান সত্য হলে *লাইন* মার্কার বহন করা হচ্ছে *নিয়ম*. ."

# libretranslate
msgid "Return True iff *rule* appears in the first *scan_lines* lines."
msgstr "প্রাপ্ত মান সত্য হলে *নিয়ম* প্রথমে দেখা যাচ্ছে *scan_lines* লাইন."

# libretranslate
msgid "Return True iff *rule* appears on any line of *lines*."
