msgid "Realm of the broker's service account (typically the same as user realm)."
msgstr "Tărâmul contului de servicii al brokerului (de obicei la fel ca domeniul de utilizare)."

# translated-by: libretranslate
msgid "Realm the client is registered in"
msgstr "Realm clientul este înregistrat în"

