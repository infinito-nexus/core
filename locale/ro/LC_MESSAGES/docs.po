msgstr "`true` sau `false`; anexe `--debug` atunci când adevărat"

# translated-by: libretranslate
msgid "`true` stops an agent after `idle_minutes` without a request; `false` keeps it running"
msgstr "`true` opreşte un agent după `idle_minutes` fără cerere; `false` O ţine tot aşa"

