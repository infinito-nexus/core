msgstr "Construiește"

# translated-by: libretranslate
msgid "Build a case-insensitive domain -> application_id index. If the same domain appears in multiple apps (case-insensitive), raises an error."
msgstr "Construiește un domeniu insensibil la caz -> application_id index. Dacă același domeniu apare în aplicații multiple (insensibil la caz), ridică o eroare."

