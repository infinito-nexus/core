msgid "Keep one inventory directory per environment."
msgstr "Păstrează un dosar de inventar pe mediu."

# translated-by: libretranslate
msgid "Keep overrides minimal"
msgstr "Menţine suprascrieri minime"

# translated-by: libretranslate
msgid "Keep plugin interfaces explicit and stable."
msgstr "Păstrați interfețele plugin explicite și stabile."

