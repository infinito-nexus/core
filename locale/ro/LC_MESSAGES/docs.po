# translated-by: libretranslate
msgid "Fixed systemd-in-container boot hangs by disabling systemd-firstboot and initializing machine-id"
msgstr "Boot-ul fix instalat în containere este atârnat prin dezactivarea sistemului de prim-boot și inițializarea mașinii-ID"

# translated-by: libretranslate
