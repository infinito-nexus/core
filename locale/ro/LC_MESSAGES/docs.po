msgstr "Construiește un context solid pentru a reda Jinja-in-strings."

# translated-by: libretranslate
msgid "Build all 12 graph variants (6 dep types × 2 directions). Accelerated version:"
msgstr "Construiește tot 12 variante grafice (6 tipuri de dep × 2 direcții). Versiunea accelerată:"

# translated-by: libretranslate
msgid "Build an Ansible inventory in which each application is a group containing the given host."
msgstr "Construiți un inventar Ansible în care fiecare aplicație este un grup care conține gazda dată."

# translated-by: libretranslate
