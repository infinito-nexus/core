msgstr "Client web-based LDAP pentru navigare, căutare, și administrarea de intrări director în servere LDAP"

# translated-by: libretranslate
msgctxt "role:web-app-pgadmin:description"
msgid "Web-based administration and development platform for managing multiple PostgreSQL servers, with optional OAuth2 login"
msgstr "Platforma web de administrare si dezvoltare pentru administrarea mai multor servere PostgreSQL, cu OAuth opţional2 autentificare"

# translated-by: libretranslate
msgctxt "role:web-app-phpmyadmin:description"
