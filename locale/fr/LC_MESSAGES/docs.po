msgstr "**Installation du paquet Certbot-NGINX :** Installe les plugins certbot nécessaires pour NGINX."

# translated-by: libretranslate
msgid "**Certificate Cleanup Tool Installation**"
msgstr "**Installation de l'outil de nettoyage du certificat**"

