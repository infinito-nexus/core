# libretranslate
msgid "Review"
msgstr "Révision"

# libretranslate
msgid "Review Focus"
msgstr "Objet de l'examen"

# libretranslate
msgid "Review Requirements 🔍"
msgstr "Exigences en matière de révision 🔍"

# libretranslate
msgid "Review the process at regular intervals and change it when it is not working."
msgstr "Revoir le processus à intervalles réguliers et le modifier lorsqu'il ne fonctionne pas."

# libretranslate
msgid "Reviewer MUST confirm both source and destination repos."
msgstr "L'examinateur DOIT confirmer la mise en pension de la source et de la destination."

# libretranslate
msgid "Reviewer MUST confirm intent for every invocation; in particular `gh auth token` MUST be declined unless the operator deliberately wants the token in the transcript."
msgstr "L'examinateur DOIT confirmer son intention pour chaque invocation; en particulier `gh auth token` DOIT être refusé à moins que l'opérateur ne veuille délibérément le jeton dans la transcription."

# libretranslate
msgid "Reviewer MUST confirm the Dockerfile path, build context, and target tag."
msgstr "L'examinateur DOIT confirmer le chemin Dockerfile, construire le contexte et la balise cible."

# libretranslate
msgid "Reviewer MUST confirm the enterprise slug and intended scope."
msgstr "L'examinateur DOIT confirmer la limace de l'entreprise et la portée prévue."

# libretranslate
msgid "Reviewer MUST confirm the environment and gating change."
msgstr "L'examinateur DOIT confirmer l'environnement et le changement de grille."

# libretranslate
msgid "Reviewer MUST confirm the key and value, especially for `editor`, `pager`, `git_protocol`."
msgstr "L'examinateur DOIT confirmer la clé et la valeur, en particulier pour `editor`, `pager`, `git_protocol`."

# libretranslate
msgid "Reviewer MUST confirm the new default repository."
msgstr "L'examinateur DOIT confirmer le nouveau dépôt par défaut."

# libretranslate
msgid "Reviewer MUST confirm the org and the specific endpoint."
msgstr "L'examinateur DOIT confirmer l'org et le paramètre spécifique."

# libretranslate
msgid "Reviewer MUST confirm the policy delta before approval."
msgstr "L'examinateur DOIT confirmer le delta de la politique avant son approbation."

# libretranslate
msgid "Reviewer MUST confirm the registry URL. If a password is passed via `--password` / `--password-stdin`, the reviewer MUST also confirm that no credential lands in the transcript."
msgstr "L'examinateur DOIT confirmer l'URL du registre. Si un mot de passe est passé via `--password` / `--password-stdin`, l'examinateur DOIT également confirmer qu'aucun titre de compétence ne figure dans la transcription."

# libretranslate
msgid "Reviewer MUST confirm the rule delta."
msgstr "L'examinateur DOIT confirmer la règle delta."

# libretranslate
msgid "Reviewer MUST confirm the source/destination owners and visibility."
msgstr "L'examinateur DOIT confirmer les propriétaires de la source/destination et la visibilité."

# libretranslate
msgid "Reviewer MUST confirm the source/destination repos and that the local working tree tolerates the sync."
msgstr "L'examinateur DOIT confirmer la repos source/destination et que l'arbre de travail local tolère la synchronisation."

# libretranslate
msgid "Reviewer MUST confirm the tag and asset payload before approval."
