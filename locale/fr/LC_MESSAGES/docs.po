msgid "**Backup Friendly:** Data isolated under `{{ CONFLUENCE_HOME }}`."
msgstr "**Aide amicale :** Données isolées `{{ CONFLUENCE_HOME }}`."

# libretranslate
msgid "**Backup Layout:** Consolidated all backups under /var/lib/infinito, parameterized the pull workflow, switched to dump-only backups, and disabled Redis backups across web applications."
msgstr "**Présentation de sauvegarde :** Consolider toutes les sauvegardes sous /var/lib/infinito, paramétrer le flux de travail de traction, passer aux sauvegardes dump-only, et désactivé Redis sauvegardes à travers les applications web."

# libretranslate
msgid "**Backup Ready:** Persistent data under ``{{ JIRA_STORAGE_PATH }}``."
msgstr "**Prêt pour la sauvegarde :** Données persistantes ``{{ JIRA_STORAGE_PATH }}``."

