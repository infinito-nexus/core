msgstr "Retourne (- Oui.1, \"commande non trouvée: ...\") quand le binaire est manquant. Retourne (- Oui.2, \"délai après ...\") lorsque l'appel dépasse ``timeout``."

# libretranslate
msgid "Returns (app_id, primary_domain) where primary_domain is normalized lower-case."
msgstr "Retourne (app_id, primary_domain) où primary_domain est normalisé en minuscules."

# libretranslate
