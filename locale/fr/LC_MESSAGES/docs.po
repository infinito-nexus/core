msgstr "**Sauvegarde et reprise après sinistre** 💾 Sauvegardes programmées et processus de récupération scriptés pour protéger vos données."

# translated-by: libretranslate
msgid "**Backup Friendly:** Data isolated under ``{{ CONFLUENCE_HOME }}``."
msgstr "**Aide amicale :** Données isolées ``{{ CONFLUENCE_HOME }}``."

