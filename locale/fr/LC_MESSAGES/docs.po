msgstr "Une illustration concrète de la composition des pièces. Rien ici n'est un nouveau mécanisme; il cartographie les décisions ci-dessus."

# libretranslate
msgid "A condition that makes the replay unprovable."
msgstr "Une condition qui rend le replay invraisemblable."

# libretranslate
