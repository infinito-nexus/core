msgid "An OIDC round-trip plus admin token request (allow ≥ 60 s)."
msgstr "Une demande OIDC aller-retour plus jeton d'administration (permettre ≥ 60 s)."

# libretranslate
msgid "An OpenAI key, to deploy and test the route"
msgstr "Une clé OpenAI, pour déployer et tester la route"

# libretranslate
msgid "An OpenRouter key"
msgstr "Une clé OpenRouter"

# libretranslate
msgid "An `ImageRef` carries: `role`, `service`, `name` (without registry), `version`, `source` (full pull ref), `registry`, and `source_file`."
msgstr "Une `ImageRef` porte: `role`, `service`, `name` (sans registre), `version`, `source` (pleine traction ref), `registry`, et `source_file`."

# libretranslate
msgid "An ``admin`` user authenticated from the ``RABBITMQ_PASSWORD`` credential."
msgstr "Une ``admin`` utilisateur authentifié de la ``RABBITMQ_PASSWORD`` Créance."

# libretranslate
msgid "An `admin` user authenticated from the `RABBITMQ_PASSWORD` credential."
msgstr "Une `admin` utilisateur authentifié de la `RABBITMQ_PASSWORD` Créance."

# libretranslate
msgid "An `swarm-zombie` run rebuilds a full DinD cluster over tens of minutes, so you MUST confirm a fix on the live cluster before redeploying."
msgstr "Une `swarm-zombie` Exécuter la reconstruction d'un cluster DinD complet sur des dizaines de minutes, donc vous DEVEZ confirmer une correction sur le cluster en direct avant de redéployer."

# libretranslate
