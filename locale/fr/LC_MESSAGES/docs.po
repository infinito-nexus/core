# translated-by: libretranslate
msgid "This role configures GNOME Shell extensions and installs the CLI GNOME Extension Manager for managing extensions."
msgstr "Ce rôle configure GNOME Shell extensions et installe le gestionnaire d'extension CLI GNOME pour la gestion des extensions."

