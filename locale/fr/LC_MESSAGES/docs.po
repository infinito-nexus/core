# libretranslate
msgid "Do NOT break native login, logout, navigation, or form flows unless the role explicitly requires that change and the new behavior is verified end to end."
msgstr "NE PAS casser les flux natifs de connexion, de déconnection, de navigation ou de forme à moins que le rôle exige explicitement que le changement et le nouveau comportement soit vérifié fin à fin."

# libretranslate
msgid "Do NOT document patterns or extension points that do not exist in the code."
msgstr "Ne PAS documenter les motifs ou les points d'extension qui n'existent pas dans le code."

# libretranslate
msgid "Do NOT expose unused variables, duplicate values, or secrets that the spec never reads."
msgstr "N'exposez PAS les variables inutilisées, les valeurs dupliquées ou les secrets que la spécification ne lit jamais."

# libretranslate
msgid "Do NOT hardcode domains or credentials that should come from role variables, inventory, or lookups."
msgstr "Ne PAS coder les domaines ou les identifiants qui devraient provenir de variables de rôle, d'inventaire ou de recherche."

# libretranslate
msgid "Do NOT introduce noisy debug logging, uncaught errors, duplicate event handlers, or endless observers into injected scripts."
msgstr "N'introduisez PAS le débogage bruyant, les erreurs non capturées, les gestionnaires d'événements dupliqués ou les observateurs sans fin dans des scripts injectés."

# libretranslate
msgid "Do NOT leave implementation warnings unresolved just because they are inconvenient."
msgstr "Ne laissez PAS les avertissements de mise en œuvre non résolus simplement parce qu'ils sont gênants."

# libretranslate
msgid "Do NOT reimplement server-side logic, authentication protocols, or business rules in injected JavaScript."
msgstr "N'implémentez PAS la logique côté serveur, les protocoles d'authentification ou les règles d'affaires dans JavaScript injecté."

# libretranslate
msgid "Do NOT rely on fragile selectors, broad text matching, or timing hacks when more stable hooks exist."
msgstr "Ne PAS compter sur des sélecteurs fragiles, des correspondances de texte larges, ou des hacks de synchronisation lorsque des crochets plus stables existent."

# libretranslate
msgid "Do NOT rerun `make compose-deploy mode=reinstall apps=<roles> full_cycle=true` just because a deploy failed or you changed code. That restarts the stack unnecessarily and burns time."
msgstr "NE PAS réexécuter `make compose-deploy mode=reinstall apps=<roles> full_cycle=true` juste parce qu'un déploiement a échoué ou que vous avez changé de code. Cela redémarre inutilement la pile et brûle le temps."

# libretranslate
msgid "Do NOT rewrite large parts of the frontend when a focused event handler, DOM adjustment, or configuration change is enough."
msgstr "NE PAS réécrire de grandes parties de la façade lorsqu'un gestionnaire d'événements ciblé, un réglage DOM ou un changement de configuration suffit."

# libretranslate
msgid "Do Not Replace"
msgstr "Ne pas remplacer"

# libretranslate
msgid "Do not define deploy_target inside the inventory file."
msgstr "Ne pas définir deploy_target dans le fichier d'inventaire."

