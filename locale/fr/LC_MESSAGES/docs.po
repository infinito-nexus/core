msgstr "Un corps qui porte `TODO`, `STUB`, `FIXME`, ou `XXX` marqueur est rejeté. Le contrat exige des flux réels et non des travaux différés."

# libretranslate
msgid "A body that contains only `skipUnlessServiceEnabled(...)` (or any combination of helper calls) without at least one `expect(...)`, `await <fn>(...)`, or equivalent real-flow step is rejected."
msgstr "Un corps qui ne contient que `skipUnlessServiceEnabled(...)` (ou toute combinaison d'appels d'aide) sans au moins un `expect(...)`, `await <fn>(...)`, ou échelon équivalent de flux réel est rejeté."

# libretranslate
msgid "A branch is ready to be opened as a pull request"
msgstr "Une branche est prête à être ouverte comme une demande de tirage"

# libretranslate
