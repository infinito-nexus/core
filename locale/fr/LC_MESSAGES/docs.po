msgid "A colon suffix on `<source>` is classified by shape:"
msgstr "Un suffixe de côlon sur `<source>` est classé par forme:"

# libretranslate
msgid "A complete digital learning environment for schools, academies, and universities."
msgstr "Un environnement d'apprentissage numérique complet pour les écoles, les académies et les universités."

# libretranslate
msgid "A computed fallback defined in `_compute(short_key, resolved, variables)`."
msgstr "Une régression calculée définie en `_compute(short_key, resolved, variables)`."

