msgid "Smoke after deploy:"
msgstr "Fumée après déploiement:"

# libretranslate
msgid "Smoke-tests the interactive console REPL"
msgstr "Teste la console interactive REPL"

# libretranslate
msgid "Smoke: visit `https://media.{{ DOMAIN_PRIMARY }}/` → Jellyfin loads → sign in via the chosen integration → reach the home/library surface."
msgstr "Fumée: visite `https://media.{{ DOMAIN_PRIMARY }}/` → Jellyfin charge → se connecter via l'intégration choisie → atteindre la surface maison/bibliothèque."

# libretranslate
msgid "Smoke: visit `https://monitoring.{{ DOMAIN_PRIMARY }}/` → (SSO) Keycloak chain → Checkmk GUI; open Setup (admin); confirm an LDAP user resolves."
msgstr "Fumée: visite `https://monitoring.{{ DOMAIN_PRIMARY }}/` → (SSO) Keycloak chaîne → Checkmk GUI; configuration ouverte (administrateur); confirme la résolution d'un utilisateur LDAP."

# libretranslate
msgid "Smoke: visit `https://openbao.{{ DOMAIN_PRIMARY }}/` → Keycloak chain → OpenBao UI; write and read a KV secret; `docker compose restart` and confirm the instance comes back unsealed."
