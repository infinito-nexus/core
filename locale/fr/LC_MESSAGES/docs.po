msgid "This role seems unused atm, adapt it to your needs as soon as you implement it and remove this message"
msgstr "Ce rôle semble inutilisé atm, l'adapter à vos besoins dès que vous le mettez en œuvre et supprimer ce message"

# translated-by: libretranslate
msgid "This role self-signed TLS provider for sys-front-tls (SAN aware). Generates and stores self-signed certificates."
msgstr "Ce rôle autosigné TLS fournisseur pour sys-front-tls (SAN au courant). Génére et stocke des certificats autosignés."

msgid "This role serves one NLLB-200 checkpoint over HTTP as an internal engine without a browser surface. The gateway [`web-svc-translate`](../web-svc-translate/) consumes it over the shared overlay network; nothing publishes it to the internet."
msgstr ""

msgid "This role serves one NLLB-200 checkpoint over HTTP as an internal engine without a browser surface. The gateway ```web-svc-translate`` <../web-svc-translate/>`__ consumes it over the shared overlay network; nothing publishes it to the internet."
