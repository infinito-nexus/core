msgstr "Déploiement d'un seul conteneur via Docker Compose"

# libretranslate
msgid "Single-int TCP ports a deployed role asks for by name under ``ports.onion``."
msgstr "Ports TCP mono-int un rôle déployé demande par nom sous ``ports.onion``."

# libretranslate
msgid "Single-int TCP ports of every deployed service flagged ``exposed: true`` in the variant-merged ``applications`` view, sorted."
msgstr "Ports TCP mono-int de chaque service déployé ``exposed: true`` dans la variante fusionnée ``applications`` vue, triée."

# libretranslate
msgid "Single-port categories (everything except `relay`)"
msgstr "Catégories de ports uniques (Tout sauf `relay`)"

# libretranslate
msgid "Single-source-of-truth resolver for a role's unified SSO surface."
msgstr "Résolveur d'une source de vérité unique pour la surface unifiée d'un rôle SSO."

# libretranslate
msgid "Single-task role with minimal overhead."
msgstr "Rôle à tâche unique avec des frais généraux minimes."

