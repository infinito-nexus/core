msgstr "``proxy_pass`` Directive; prélève un essaim ``set`` ligne (demande-temps DNS)."

# libretranslate
msgid "``proxy_resolvable``: beacon flag - the harvested aliases get attached to"
msgstr "``proxy_resolvable``: drapeau de la balise - les alias récoltés se fixent à"

