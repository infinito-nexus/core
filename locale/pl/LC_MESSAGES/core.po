# libretranslate
msgctxt "role:desk-git:description"
msgid "Version-control client for personal workstations, preconfigured with identity, signing, and merge defaults"
msgstr "Klient Version- control dla osobistych stacji roboczych, wstępnie skonfigurowany z tożsamością, podpisaniem i połączeniem domyślnych"

# libretranslate
msgctxt "role:sys-svc-cdn:description"
msgid "Versioned asset-tree layout for CDN delivery with shared, vendor, and per-role release directories"
msgstr "Układ pionowego asset- tree dla CDN dostawy z katalogami współdzielonymi, sprzedającymi i modyfikującymi"

# libretranslate
msgctxt "category:web:title"
msgid "Web Infrastructure"
msgstr "Infrastruktura sieciowa"

# libretranslate
msgctxt "role:web-app-semaphore:description"
msgid "Web UI and API for running Ansible, Terraform/OpenTofu, and shell automation on a schedule or on demand"
msgstr "Interfejs internetowy i API do uruchamiania Andible, Terraform / OpenTofu i automatyzacji powłoki na harmonogramie lub na żądanie"

# libretranslate
msgctxt "role:web-app-lam:description"
msgid "Web interface for administering LDAP directories: managing users, groups, and other directory objects"
msgstr "Interfejs internetowy do zarządzania katalogami LDAP: zarządzanie użytkownikami, grupami i innymi obiektami katalogów"

# libretranslate
msgctxt "role:web-app-fusiondirectory:description"
msgid "Web-based LDAP administration interface for managing users, groups, and directory objects"
msgstr "Interfejs administracyjny LDAP dla użytkowników, grup i obiektów katalogowych"

# libretranslate
msgctxt "role:web-app-phpldapadmin:description"
msgid "Web-based LDAP client for browsing, searching, and administering directory entries in LDAP servers"
msgstr "Internetowy klient LDAP do przeglądania, wyszukiwania i administrowania danymi katalogowymi w serwerach LDAP"

# libretranslate
msgctxt "role:web-app-pgadmin:description"
msgid "Web-based administration and development platform for managing multiple PostgreSQL servers, with optional OAuth2 login"
msgstr "Web- based administration and development platform for management multiple PostgreSQL servers, with optional OAuth2 logowanie"

# libretranslate
msgctxt "role:web-app-phpmyadmin:description"
msgid "Web-based administration tool for MySQL and MariaDB with schema management, querying, and import/export"
msgstr "Internetowe narzędzie administracyjne dla MySQL i MariaDB z zarządzaniem schematami, zapytaniami i importem / eksportem"

# libretranslate
msgctxt "category:web.opt:title"
msgid "Webserver Optimation"
msgstr "Optymalizacja serwera internetowego"

# libretranslate
msgctxt "role:desk-docker:description"
msgid "Workstation setup for Docker and Docker Compose with the local user in the docker group for rootless development use"
msgstr "Konfiguracja stacji roboczej dla Docker i Docker Composite z lokalnym użytkownikiem w grupie Docker do bezwietrznego rozwoju"

# libretranslate
msgctxt "role:dev-arduino:description"
msgid "Workstation toolchain and serial-port permissions for Arduino board development on Linux"
msgstr "Łańcuch narzędzi stacji Workstation i uprawnienia portu szeregowego dla rozwoju płyt Arduino na Linuksie"

# libretranslate
msgctxt "role:pkgmgr-install:description"
msgid "Wrapper role for idempotent package installation and updates through the pkgmgr universal package manager"
msgstr "Rolę Wrapper dla instalacji pakietów idemstrong i aktualizacje poprzez uniwersalny menedżer pakietów pkgmgr"

msgctxt "logout:may_close"
msgid "You can close this page now."
msgstr "Możesz teraz zamknąć tę stronę."

msgctxt "logout:st_failed"
msgid "failed"
msgstr "niepowodzenie"

# libretranslate
msgctxt "role:svc-net-firewall:description"
msgid "nftables packet filter whose rules each role owns as its own table, replaced atomically and reloaded at boot"
msgstr "filtr pakietów nftables, którego zasady każda rola posiada jako własny stół, zastąpiony atomicznie i przeładowany przy starcie"

msgctxt "logout:st_unconfirmed"
msgid "not confirmed"
msgstr "niepotwierdzone"

msgctxt "logout:manual"
msgid "sign out manually"
msgstr "wyloguj ręcznie"

msgctxt "logout:st_done"
msgid "signed out"
msgstr "wylogowano"

msgctxt "logout:st_pending"
msgid "signing out"
msgstr "wylogowywanie"

#, python-brace-format
msgctxt "logout:counter"
msgid "{done} of {total} services signed out"
msgstr "Wylogowano z {done} z {total} usług"

