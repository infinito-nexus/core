msgstr "**Administrator HTTP i BOSH:** Wyświetlanie admin internetowych ejabberd i wiązania BOSH / WebSocket w porcie HTTP dla interakcji opartych na przeglądarce."

# translated-by: libretranslate
msgid "**HTTP on the onion side** (TLS forced off for `.onion`), vhosts on `:80`, upstream gets `X-Forwarded-Proto: https`."
msgstr "**HTTP po stronie cebuli** (TLS zmuszony do `.onion`), vhosts on `:80`, upstream gets `X-Forwarded-Proto: https`."

# translated-by: libretranslate
msgid "**HTTP on the onion side:** TLS is forced off for `.onion` (no Let's Encrypt possible); onion v3 crypto is the transport auth."
msgstr "**HTTP po stronie cebuli:** TLS jest zmuszony do `.onion` (Nie.); cebula v3 Krypto to auth transportowy."

# translated-by: libretranslate
msgid "**HTTP on the onion side:** TLS is forced off for ``.onion`` (no Let’s Encrypt possible); onion v3 crypto is the transport auth."
msgstr "**HTTP po stronie cebuli:** TLS jest zmuszony do ``.onion`` (Nie.); cebula v3 Krypto to auth transportowy."

# translated-by: libretranslate
msgid "**HTTP serving** with MIME types, gzip compression, caching, and custom `NGINX.conf` templating."
msgstr "**Obsługa HTTP** z typów MIME, kompresji gzip, buforowania i niestandardowych `NGINX.conf` Templing."

# translated-by: libretranslate
msgid "**HTTP serving** with MIME types, gzip compression, caching, and custom ``NGINX.conf`` templating."
msgstr "**Obsługa HTTP** z typów MIME, kompresji gzip, buforowania i niestandardowych ``NGINX.conf`` Templing."

# translated-by: libretranslate
