# translated-by: libretranslate
msgid "Review"
msgstr "Przegląd"

# translated-by: libretranslate
msgid "Review Focus"
msgstr "Przegląd"

# translated-by: libretranslate
msgid "Review Requirements 🔍"
msgstr "Wymogi dotyczące przeglądu 🔍"

# translated-by: libretranslate
msgid "Review the process at regular intervals and change it when it is not working."
msgstr "Przegląd procesu w regularnych odstępach czasu i zmienić go, gdy nie działa."

# translated-by: libretranslate
msgid "Reviewer MUST confirm both source and destination repos."
msgstr "Recenzent MUSI potwierdzić zarówno źródła, jak i miejsca przeznaczenia transakcji repo."

# translated-by: libretranslate
msgid "Reviewer MUST confirm intent for every invocation; in particular `gh auth token` MUST be declined unless the operator deliberately wants the token in the transcript."
msgstr "Recenzent MUSI potwierdzić zamiar każdego wezwania; w szczególności `gh auth token` MUSI zostać odrzucony, chyba że operator umyślnie chce żeton w transkrypcie."

# translated-by: libretranslate
msgid "Reviewer MUST confirm the Dockerfile path, build context, and target tag."
msgstr "Recenzent MUSI potwierdzić ścieżkę Dockerfile, zbudować kontekst i tag docelowy."

# translated-by: libretranslate
msgid "Reviewer MUST confirm the enterprise slug and intended scope."
msgstr "Recenzent MUSI potwierdzić ślimak przedsiębiorstwa i zamierzony zakres."

# translated-by: libretranslate
msgid "Reviewer MUST confirm the environment and gating change."
msgstr "Recenzent MUSI potwierdzić środowisko i zmiany bramki."

# translated-by: libretranslate
msgid "Reviewer MUST confirm the key and value, especially for `editor`, `pager`, `git_protocol`."
msgstr "Recenzent MUSI potwierdzić klucz i wartość, szczególnie dla `editor`, `pager`, `git_protocol`."

# translated-by: libretranslate
msgid "Reviewer MUST confirm the new default repository."
msgstr "Recenzent MUSI potwierdzić nowe domyślne repozytorium."

# translated-by: libretranslate
msgid "Reviewer MUST confirm the org and the specific endpoint."
msgstr "Recenzent MUSI potwierdzić org i konkretny punkt końcowy."

# translated-by: libretranslate
msgid "Reviewer MUST confirm the policy delta before approval."
msgstr "Recenzent MUSI potwierdzić politykę delta przed zatwierdzeniem."

# translated-by: libretranslate
msgid "Reviewer MUST confirm the registry URL. If a password is passed via `--password` / `--password-stdin`, the reviewer MUST also confirm that no credential lands in the transcript."
msgstr "Recenzent MUSI potwierdzić adres URL rejestru. Jeśli hasło jest przekazywane przez `--password` / `--password-stdin`, recenzent MUSI również potwierdzić, że nie ląduje w transkrypcie."

# translated-by: libretranslate
msgid "Reviewer MUST confirm the rule delta."
msgstr "Recenzent MUSI potwierdzić zasadę delta."

# translated-by: libretranslate
msgid "Reviewer MUST confirm the source/destination owners and visibility."
msgstr "Recenzent MUSI potwierdzić właściciela źródła / przeznaczenia i widoczność."

# translated-by: libretranslate
msgid "Reviewer MUST confirm the source/destination repos and that the local working tree tolerates the sync."
msgstr "Recenzent MUSI potwierdzić repos źródła / przeznaczenia i że lokalne drzewo robocze toleruje synchronizację."

# translated-by: libretranslate
msgid "Reviewer MUST confirm the tag and asset payload before approval."
msgstr "Recenzent MUSI potwierdzić etykietę i ładunek aktywów przed zatwierdzeniem."

# translated-by: libretranslate
msgid "Reviewer MUST confirm the target registry, repository, and tag before approval."
msgstr "Recenzent MUSI potwierdzić docelowy rejestr, repozytorium i znacznik przed zatwierdzeniem."

# translated-by: libretranslate
