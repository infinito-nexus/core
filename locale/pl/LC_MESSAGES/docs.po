msgid "Ansible filter plugin that safely joins URL components from a list."
msgstr "Wtyczka filtrująca, która bezpiecznie łączy elementy URL z listy."

# translated-by: libretranslate
msgid "Ansible filter plugin: get_role"
msgstr "Wtyczka filtrująca: get_role"

