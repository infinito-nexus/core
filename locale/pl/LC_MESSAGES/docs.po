msgstr "Skróty️"

# translated-by: libretranslate
msgid "Shorten a dev-runtime image to its last two registry segments."
msgstr "Skróć obraz dev- runtime do dwóch ostatnich segmentów rejestru."

# translated-by: libretranslate
