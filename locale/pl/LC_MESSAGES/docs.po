#, python-brace-format
msgid "ACL user + key-prefix `{entity}:*`"
msgstr "Użytkownik ACL + key- prefix `{entity}:*`"

# translated-by: libretranslate
msgid "ACTION: ask user \"disable matomo, dashboard, prometheus, email, css providers? [Y/n]\"."
msgstr "DZIAŁANIE: zapytaj użytkownika \"wyłączyć matomo, deska rozdzielcza, prometeusz, e-mail, dostawcy CSS? [Y / n]\"."

# translated-by: libretranslate
msgid "ACT_PLATFORM_IMAGE: act runner platform image, resolved from the svc-runner role's ``act-runner`` service declaration."
msgstr "ACT_PLATFORM_IMAGE: act runner player image, rozwiązany z svc-runner role ``act-runner`` deklaracja obsługi."

