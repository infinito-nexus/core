msgstr "Statki wszczepione na bocznych ścianach (`templates/service.yml.j2`) dla `shared: false` opt- out path."

# translated-by: libretranslate
msgid "Short single-command invocations MAY stay inline when they do not contain meaningful control flow."
msgstr "Krótkie inwokacje z pojedynczymi poleceniami MOŻE pozostać wewnątrz, gdy nie zawierają znaczącego przepływu sterowania."

# translated-by: libretranslate
