msgstr "Czytaj `disable` ze środowiska i stosować do host_vars i inwentaryzacji."

# translated-by: libretranslate
msgid "Read `docs/contributing/tools/agents/cheatsheet.md` (relative to the Infinito.Nexus repository root) and answer from it; that document is the source of truth and this skill only routes you there."
msgstr "Czytaj `docs/contributing/tools/agents/cheatsheet.md` (względem Infinito.Nexus root repozytorium) Ten dokument jest źródłem prawdy, a ta umiejętność tylko cię tam prowadzi."

# translated-by: libretranslate
msgid "Read a fact from either the task_vars shape or the setup-module one."
msgstr "Przeczytaj fakt od albo task_vars kształt lub moduł setup-jeden."

# translated-by: libretranslate
msgid "Read a lint tool's pinned release from the ``sys-lint`` role."
msgstr "Przeczytaj narzędzie lint przymocowane zwolnienie z ``sys-lint`` rola."

# translated-by: libretranslate
msgid "Read attribute names, DNs, and the server URI from `LDAP.*`. Never hardcode `uid`, `cn`, base DNs, or LDAP URIs."
msgstr "Przeczytaj nazwy atrybutów, DN i serwer URI z `LDAP.*`. Nigdy twardego kodu `uid`, `cn`, bazy DN, lub LDAP URI."

# translated-by: libretranslate
msgid "Read database credentials from the host's databases.csv."
msgstr "Przeczytaj dane z bazy danych hosta databases.csv."

# translation-refused: libretranslate stutter
# nocheck: url
