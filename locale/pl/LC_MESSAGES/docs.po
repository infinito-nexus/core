msgid "ADR 0003, Consequences"
msgstr "ADR 0003, Konsekwencje"

# translated-by: libretranslate
msgid "ADR 0003, Exhaustive Application-ID Audit"
msgstr "ADR 0003, Exhaustive Application-ID Audyt"

