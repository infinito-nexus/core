msgid "Ansible lookup wrapper around ``utils.roles.meta_lookup.iter_roles_with_placement``."
msgstr "Andible lookup owinięcie wokół ``utils.roles.meta_lookup.iter_roles_with_placement``."

# translated-by: libretranslate
msgid "Ansible lookup: unified SSO state for a consumer role."
msgstr "Andible lookup: ujednolicone SSO wskazują na rolę konsumenta."

# translated-by: libretranslate
msgid "Ansible only auto-loads `meta/main.yml`. Every other `meta/<topic>.yml` is read by the project's own loaders (`utils/cache/applications.py`, `utils/cache/users.py`, `utils/manager/inventory.py`)."
msgstr "Tylko ładunki przenośne `meta/main.yml`. Każdy inny. `meta/<topic>.yml` jest czytany przez własne ładowarki projektu (`utils/cache/applications.py`, `utils/cache/users.py`, `utils/manager/inventory.py`)."

# translated-by: libretranslate
msgid "Ansible plugin development: [docs.ansible.com](https://docs.ansible.com/ansible/latest/dev_guide/developing_plugins.html)"
msgstr "Proste tworzenie wtyczki: [docs.ansible.com](https://docs.ansible.com/ansible/latest/dev_guide/developing_plugins.html)"

