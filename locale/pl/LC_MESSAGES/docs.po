# translated-by: libretranslate
msgid "Open `/app/erpnext` — ERPNext landing page renders (not bare Frappe desk)."
msgstr "Otwórz `/app/erpnext` - ERPNext rendery strony docelowej (nie nagie biurko Frappe)."

