msgid "Analytics tracking"
msgstr "Śledzenie analityczne"

# translated-by: libretranslate
msgid "Android SDK is never needed; safe to remove"
msgstr "Android SDK nigdy nie jest potrzebne; bezpieczne usunięcie"

# translated-by: libretranslate
msgid "Annotate ``message`` as unanswerable, quoting what was turned down."
msgstr "Anotat ``message`` jako nieodpowiadający cytat z tego, co odrzucono."

