msgid "Ansible `rescue:` blocks are forbidden (`tests/lint/ansible/structure/test_no_rescue_blocks.py`); the rare justified block (`# nocheck: rescue-<reason>`) leaves its role-specific evidence in `DIR_RESCUE_DIAGNOSTICS`, which every capture level ships as `local-dumps/`."
msgstr "Andible `rescue:` bloki są zabronione (`tests/lint/ansible/structure/test_no_rescue_blocks.py`); rzadko uzasadniony blok (`# nocheck: rescue-<reason>`) pozostawia swoiste dowody w `DIR_RESCUE_DIAGNOSTICS`, które każdy poziom przechwytywania statków jako `local-dumps/`."

# translated-by: libretranslate
msgid "Ansible collection *hetzner.hcloud*: 7.0.1 to 7.1.0"
msgstr "Kolekcja andyjska *hetzner.hcloud*: 7.0.1 do 7.1.0"

