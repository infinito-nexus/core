# translated-by: libretranslate
#, python-brace-format
msgid "Read `${TMPDIR:-/tmp}/roundtrip-<app>-<mode>.log` to see which app and mode failed, and the first error."
msgstr "Czytaj `${TMPDIR:-/tmp}/roundtrip-<app>-<mode>.log` aby sprawdzić, która aplikacja i tryb nie powiodły się, a pierwszy błąd."

