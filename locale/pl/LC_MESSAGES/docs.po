# translated-by: libretranslate
msgid "Raised when ``meta/services.yml`` is malformed."
msgstr "Wychowywane, gdy ``meta/services.yml`` jest zniekształcony."

# translated-by: libretranslate
msgid "Raised when `disable` conflicts with an existing inventory."
msgstr "Wychowywane, gdy `disable` konflikty z istniejącym wykazem."

# translated-by: libretranslate
msgid "Raised when a ``meta/packages.yml`` violates the declared shape."
msgstr "Wychowywane, gdy ``meta/packages.yml`` narusza deklarowany kształt."

# translated-by: libretranslate
msgid "Raised when a config entry is defined in schema but not set in application."
msgstr "Wychowywane, gdy pozycja konfiguracyjna jest zdefiniowana w schemie, ale nie ustawiona w aplikacji."

# translated-by: libretranslate
msgid "Raised when a meta/volumes.yml fails schema validation."
msgstr "Wychowywane, gdy meta/volumes.yml nie udaje walidacji schematów."

# translated-by: libretranslate
msgid "Raised when a required application config key is missing (strict mode). Compatible with Ansible error handling and Python ValueError."
msgstr "Wychowywane, gdy brakuje wymaganego klucza konfiguracyjnego aplikacji (tryb rygorystyczny). Kompatybilny z Andible obsługi błędów i Python ValueError."

# translated-by: libretranslate
msgid "Raised when a role's typing markers do not conform to the schema."
msgstr "Wychowywane, gdy znaczniki maszynowe roli nie są zgodne z schematem."

# translated-by: libretranslate
msgid "Raised when role-local service discovery is invalid."
msgstr "Wychowany, gdy odkrycie rolelocal usługi jest nieważne."

# translated-by: libretranslate
msgid "Raised when shared service resolution fails (e.g., missing mapping, invalid config)."
msgstr "Dorastanie w przypadku niepowodzenia restrukturyzacji i uporządkowanej likwidacji wspólnej służby (np. brak mapowania, nieprawidłowa konfiguracja)."

