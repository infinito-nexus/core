# libretranslate
msgid "Do NOT introduce noisy debug logging, uncaught errors, duplicate event handlers, or endless observers into injected scripts."
msgstr "NO introdueixis un registre de depuració sorollós, errors sense corrent, gestors d' esdeveniments duplicats, o observadors sense fi en els scripts injectats."

# libretranslate
msgid "Do NOT leave implementation warnings unresolved just because they are inconvenient."
msgstr "NO deixeu els avisos de implementació sense resoldre només perquè són incòmodes."

