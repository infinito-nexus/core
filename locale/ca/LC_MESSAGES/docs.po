msgstr "**Descripció:** Sistema de gestió de continguts per construir i gestionar llocs web, blogs i xarxes multisitives amb temes i connectors"

# libretranslate
msgid "**Description:** Core NGINX webserver with HTTP and TCP/UDP stream support and performance-tuned defaults"
msgstr "**Descripció:** Servidor web del nucli NGINX amb implementació de flux HTTP i TCP/UDP i per omissió de rendiment"

# libretranslate
msgid "**Description:** Cross-distribution installer for the Nix package manager with checksum-verified, reproducible multi-user setup"
msgstr "**Descripció:** Instal·lador de la distribució creuada per al gestor de paquets Nix amb suma de verificació, configuració de múltiples usuarisName"

# libretranslate
msgid "**Description:** Cross-distribution maintenance routine for disk reclamation across CI, container, and build environments"
msgstr "**Descripció:** Manteniment de manteniment de la distribució creuada per a la recuperació de discs a través del CI, el recipient i els entorns de construcció"

# libretranslate
msgid "**Description:** Data-driven role for managing Cloudflare DNS records (A/AAAA, CNAME, MX, TXT, SRV) across apps and environments"
msgstr "**Descripció:** Funció impulsada per gestionar els registres DNS del núvol (A/AAAA, CNAME, MX, TXT, SRV) A través de les aplicacions i entorns"

# libretranslate
msgid "**Description:** Decentralized, federated platform for peer-to-peer video hosting, streaming, and live broadcasting"
msgstr "**Descripció:** Una plataforma descentralitzada, alimentada per a l'adquisició de video-peer d'un parell, el flux i l'emissió en directe"

# libretranslate
msgid "**Description:** Decentralized, federated platform for photo sharing and image feeds across the fediverse"
msgstr "**Descripció:** Una plataforma descentralitzada, alimentada per a compartir fotos i fonts d'imatges a través de la font d'imatges a través de la font d'aliments"

# libretranslate
msgid "**Description:** Decentralized, federated social-networking platform for peer-to-peer communication and community building"
