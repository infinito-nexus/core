msgstr "**Descripció:** Collage d' orquestració per a serveis de planificació a través del gestor de tasques i nodes de treballadors"

# libretranslate
msgid "**Description:** Containerized Reveal.js slide deck for presenting the platform to admins, developers, users, and investors"
msgstr "**Descripció:** Contenidor Reveal.js Coberta de diapositiva per presentar la plataforma a administradors, desenvolupadors, usuaris i inversors"

# libretranslate
msgid "**Description:** Containerized icon server for hosting the Simple Icons brand SVG and PNG collection for web and documentation use"
msgstr "**Descripció:** Servidor d' icones contenidor per a allotjar- lo Simple Icons Col· lecció SVG i PNG per al web i la documentació"

# libretranslate
