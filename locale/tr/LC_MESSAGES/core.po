msgid "You can close this page now."
msgstr "Bu sayfayı şimdi kapatabilirsiniz."

msgctxt "logout:st_failed"
msgid "failed"
msgstr "başarısız"

# translated-by: libretranslate
msgctxt "role:svc-net-firewall:description"
msgid "nftables packet filter whose rules each role owns as its own table, replaced atomically and reloaded at boot"
msgstr "Her rolün kendi masası olarak sahip olduğu paket filtresi, atomal olarak değiştirildi ve boot at boot"

