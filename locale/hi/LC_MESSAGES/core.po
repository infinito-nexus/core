# libretranslate
msgctxt "category:sys.front.inj:description"
msgid "Composable HTML injection roles (CSS, JS, logout interceptor, analytics, dashboard iframe) for Nginx/OpenResty via sub_filter/Lua with CDN-backed assets."
msgstr "Composable HTML इंजेक्शन भूमिकाओं (सीएसएस, जेएस, लोगोट इंटरसेप्टर, एनालिटिक्स, डैशबोर्ड आईफ्रेम) Nginx / OpenResty के माध्यम से sub_filter/Lua CDN समर्थित परिसंपत्तियों के साथ।"

# libretranslate
msgctxt "role:sys-stk-full:description"
msgid "Composite stack role bundling a containerized database backend with an HTTP reverse-proxy frontend for web access"
msgstr "समग्र स्टैक भूमिका वेब एक्सेस के लिए HTTP रिवर्स-प्रोक्सी फ्रंटेंड के साथ एक कंटेनरीकृत डेटाबेस बैकेंड को बंडल करना"

# libretranslate
msgctxt "category:svc.swarm:title"
msgid "Container Orchestration"
msgstr "कंटेनर आर्केस्ट्रा"

# libretranslate
msgctxt "category:svc.registry:title"
msgid "Container Registries"
msgstr "कंटेनर रजिस्ट्री"

# libretranslate
msgctxt "role:sys-svc-container:description"
msgid "Container engine runtime with Compose for building and running application containers on Linux hosts"
msgstr "लिनक्स होस्ट पर एप्लिकेशन कंटेनरों के निर्माण और संचालन के लिए रचना के साथ कंटेनर इंजन रनटाइम"

# libretranslate
msgctxt "role:svc-swarm-node:description"
msgid "Container orchestration cluster for scheduling services across pooled manager and worker nodes"
msgstr "पूल प्रबंधक और कार्यकर्ता नोड्स भर में शेड्यूलिंग सेवाओं के लिए कंटेनर ऑर्केस्ट्रेशन क्लस्टर"

# libretranslate
msgctxt "category:svc.registry:description"
msgid "Container-registry services - local registry and pull-through cache."
msgstr "कंटेनर रजिस्ट्री सेवाएं - स्थानीय रजिस्ट्री और पुल-थ्रू कैश।"

# libretranslate
msgctxt "role:web-app-navigator:description"
msgid "Containerized Reveal.js slide deck for presenting the platform to admins, developers, users, and investors"
msgstr "कंटेनरीकृत Reveal.js व्यवस्थापक, डेवलपर्स, उपयोगकर्ताओं और निवेशकों के लिए मंच पेश करने के लिए स्लाइड डेक"

# libretranslate
msgctxt "role:web-svc-simpleicons:description"
msgid "Containerized icon server for hosting the Simple Icons brand SVG and PNG collection for web and documentation use"
msgstr "वेब और प्रलेखन उपयोग के लिए सरल प्रतीक ब्रांड एसवीजी और पीएनजी संग्रह की मेजबानी के लिए कंटेनरीकृत आइकन सर्वर"

# libretranslate
