msgstr "प्रति उपयोगकर्ता पर्यावरण सेटअप के लिए प्रावधान भूमिका, शेल डॉटफाइल्स और एसएसएच का प्रबंधन authorized_keys"

# libretranslate
msgctxt "category:svc.prx:title"
msgid "Proxy Servers"
msgstr "प्रॉक्सी सर्वर"

# libretranslate
msgctxt "role:web-svc-api:description"
msgid "Public REST API serving role data, history and translations of Infinito.Nexus for every ref of core and its forks"
msgstr "सार्वजनिक आरईएसटी एपीआई की भूमिका डेटा, इतिहास और अनुवाद की सेवा Infinito.Nexus प्रत्येक कोर और उसके कांटे के लिए"

# libretranslate
msgctxt "role:pkgmgr:description"
msgid "Python CLI package manager for cloning multiple code repositories and automating common Git operations"
msgstr "एकाधिक कोड भंडार को बंद करने और आम गिट संचालन को स्वचालित करने के लिए पायथन CLI पैकेज मैनेजर"

# libretranslate
msgctxt "role:sys-lint:description"
msgid "Release pins for the GitHub-release lint tools the toolchain installs"
msgstr "गिटहब-रिलीज लिंट टूल के लिए रिलीज पिन टूलचेन स्थापित करता है"

# libretranslate
msgctxt "category:sys.ctl.rpr:title"
msgid "Repair"
msgstr "मरम्मत"

# libretranslate
msgctxt "category:sys.ctl.rpr:description"
msgid "Repair and recovery roles—handling hard/soft recovery of Docker, Btrfs balancers, and other low-level system fixes."
msgstr "मरम्मत और वसूली की भूमिकाएं - डॉकर, Btrfs बैलेंसर्स और अन्य निम्न-स्तरीय सिस्टम फिक्स की हार्ड / सॉफ्ट रिकवरी को सौंपना।"

# libretranslate
msgctxt "role:sys-util-git-pull:description"
msgid "Reusable Git pull primitive for shallow clones, detached-safe updates, tag pinning, and reliable change detection"
msgstr "अनुकूलन उथले क्लोन, अलग-अलग सुरक्षित अपडेट, टैग पिनिंग और विश्वसनीय परिवर्तन का पता लगाने के लिए गिट पुल प्राइमिटिव"

# libretranslate
msgctxt "role:svc-ai-mcp-adapter:description"
msgid "Reusable per-provider MCP adapter exposing a narrow allowlisted read surface"
msgstr "पुन: प्रयोज्य प्रति प्रदाता MCP एडाप्टर एक संकीर्ण स्वीकार्य पढ़ने की सतह को उजागर करता है"

# libretranslate
msgctxt "role:sys-svc-proxy:description"
msgid "Reverse proxy front-end for Docker-hosted services with automatic TLS, WebSocket support, and per-app vHost templating"
msgstr "स्वचालित TLS, WebSocket समर्थन और प्रति-app vHost templating के साथ Docker-hosted सेवाओं के लिए रिवर्स प्रॉक्सी फ्रंट-एंड"

# libretranslate
msgctxt "role:sys-front-tls:description"
msgid "Reverse-proxy TLS orchestration layer selecting Let's Encrypt, self-signed, or disabled certificate providers for Nginx"
msgstr "रिवर्स-प्रॉक्सी टीएलएस ऑर्केस्ट्रेशन परत का चयन करते हैं Let's Encrypt, self-signed, या Nginx के लिए विकलांग प्रमाणपत्र प्रदाता"

# libretranslate
msgctxt "category:svc.prx:description"
msgid "Reverse-proxy roles for routing and load-balancing traffic to backend services"
msgstr "सेवाओं को वापस करने के लिए रूटिंग और लोड-बाउन्सिंग यातायात के लिए रिवर्स-प्रोक्सी भूमिकाएं"

# libretranslate
msgctxt "category:sys.ctl.cln:description"
msgid "Roles for cleaning up various system resources—old backups, unused certificates, temporary files, Docker volumes, disk caches, deprecated domains, and more."
msgstr "विभिन्न सिस्टम संसाधनों की सफाई के लिए भूमिकाएं - पुराने बैकअप, अप्रयुक्त प्रमाणपत्र, अस्थायी फाइलें, डोकर वॉल्यूम, डिस्क कैश, अलग डोमेन और अधिक।"

# libretranslate
msgctxt "category:drv:description"
msgid "Roles for installing and configuring hardware drivers—covering printers, graphics, input devices, and other peripheral support."
msgstr "हार्डवेयर ड्राइवरों को स्थापित करने और कॉन्फ़िगर करने की भूमिकाएं - प्रिंटर, ग्राफिक्स, इनपुट डिवाइस और अन्य परिधीय समर्थन को कवर करना।"

# libretranslate
msgctxt "category:web:description"
msgid "Roles for managing web infrastructure—covering static content services and deployable web applications."
msgstr "वेब इन्फ्रास्ट्रक्चर के प्रबंधन की भूमिकाएं - स्थैतिक सामग्री सेवाओं और तैनाती योग्य वेब अनुप्रयोगों को कवर करती हैं।"

# libretranslate
msgctxt "category:sys.ctl.hlth:description"
msgid "Roles for system monitoring and health checks—encompassing bot-style automated checks and core low-level monitors for logs, containers, disk usage, and more."
msgstr "सिस्टम मॉनिटरिंग और हेल्थ चेक के लिए भूमिकाएं - लॉग, कंटेनर, डिस्क उपयोग और अधिक के लिए बॉट-शैली स्वचालित चेक और कोर कम-स्तरीय मॉनिटर को शामिल करना।"

# libretranslate
msgctxt "role:sys-front-tls-selfsigned:description"
msgid "SAN-aware certificate provider generating and storing self-signed TLS certificates for the front-proxy TLS layer"
msgstr "SAN-aware प्रमाणपत्र प्रदाता फ्रंट-प्रोक्सी TLS परत के लिए स्वयं-सिग्न TLS प्रमाणपत्र उत्पन्न और संग्रहीत करता है"

# libretranslate
msgctxt "menu:Sales:title"
msgid "Sales"
msgstr "बिक्री"

# libretranslate
msgctxt "category:svc.virt:title"
msgid "Sandboxed Runtimes"
msgstr "सैंडबॉक्सड रनटाइम"

# libretranslate
msgctxt "role:svc-bkp-nfs-2-local:description"
msgid "Scheduled backup job for hard-linked differential rsync snapshots of an NFS export into the local backup tree"
msgstr "एनएफएस के हार्ड-लिंक्ड अंतर rsync स्नैपशॉट के लिए अनुसूचित बैकअप नौकरी स्थानीय बैकअप पेड़ में निर्यात करती है"

# libretranslate
msgctxt "role:sys-ctl-cln-certs:description"
msgid "Scheduled cleanup tool for revoking and deleting unused Let's Encrypt certificates"
msgstr "बिना इस्तेमाल किए जाने वाले Revoking और हटाने के लिए अनुसूचित सफाई उपकरण Let's Encrypt Certificate"

# libretranslate
msgctxt "role:svc-bkp-secrets-2-local:description"
msgid "Scheduled deduplicating backup of host secrets, CA, ACME credentials, and node identity to the local backup directory"
msgstr "मेजबान रहस्यों, सीए, एसीएमई क्रेडेंशियल्स, और स्थानीय बैकअप निर्देशिका के लिए नोड पहचान की अनुसूची"

# libretranslate
msgctxt "role:svc-bkp-volume-2-local:description"
msgid "Scheduled deduplicating backup system for Docker container volumes to a local directory, with consistent SQL dumps"
msgstr "एक स्थानीय निर्देशिका के लिए डोकर कंटेनर वॉल्यूम के लिए अनुसूचित डीडुप्लिकेट बैकअप सिस्टम, लगातार SQL डंप के साथ"

# libretranslate
msgctxt "role:sys-ctl-hlth-csp:description"
msgid "Scheduled health check crawling configured domains for CSP-blocked resources via a Puppeteer-based Node.js checker"
msgstr "अनुसूचित स्वास्थ्य जांच क्रॉलिंग ने एक पिल्ला आधारित के माध्यम से सीएसपी अवरुद्ध संसाधनों के लिए डोमेन को कॉन्फ़िगर किया Node.js चेकर"

# libretranslate
msgctxt "role:sys-ctl-hlth-btrfs:description"
msgid "Scheduled health check for Btrfs filesystems that alerts on non-zero device error counters"
msgstr "Btrfs फ़ाइल सिस्टम के लिए अनुसूचित स्वास्थ्य जांच जो गैर-zero डिवाइस त्रुटि काउंटर पर अलर्ट करता है"

# libretranslate
msgctxt "role:sys-ctl-hlth-disc-space:description"
msgid "Scheduled health check for filesystem disk usage, alerting when any mount exceeds its warning threshold"
msgstr "फ़ाइल सिस्टम डिस्क उपयोग के लिए अनुसूचित स्वास्थ्य जांच, जब कोई माउंट अपनी चेतावनी सीमा से अधिक हो जाता है तो चेतावनी देते हुए"

# libretranslate
msgctxt "role:sys-ctl-hlth-journalctl:description"
msgid "Scheduled health check scanning the systemd journal for daily errors and alerting on matches"
msgstr "अनुसूचित स्वास्थ्य जांच दैनिक त्रुटियों के लिए व्यवस्थित जर्नल को स्कैन करना और मैचों पर चेतावनी देना"

# libretranslate
msgctxt "role:sys-ctl-hlth-webserver:description"
msgid "Scheduled health check verifying each NGINX domain returns its expected HTTP status and alerting on deviations"
msgstr "अनुसूचित स्वास्थ्य जांच प्रत्येक NGINX डोमेन को सत्यापित करने के लिए इसकी अपेक्षित HTTP स्थिति और विचलन पर चेतावनी देता है"

# libretranslate
msgctxt "role:sys-ctl-cln-faild-bkps:description"
msgid "Scheduled maintenance service for detecting and removing failed Docker backups while keeping recent sets intact"
msgstr "हाल के सेट बरकरार रखते हुए असफल डोकर बैकअप का पता लगाने और हटाने के लिए अनुसूचित रखरखाव सेवा"

# libretranslate
msgctxt "role:sys-ctl-cln-anon-volumes:description"
msgid "Scheduled maintenance task for reclaiming disk space by removing unused anonymous Docker volumes and their symlinks"
msgstr "अप्रयुक्त अनाम डोकर वॉल्यूम और उनके सिम्बलिंक को हटाकर डिस्क स्थान को पुनः प्राप्त करने के लिए अनुसूचित रखरखाव कार्य"

# libretranslate
msgctxt "role:svc-bkp-remote-2-local:description"
msgid "Scheduled pull-style backup replicating remote hosts onto this host over SSH and rsync as hard-linked snapshots"
msgstr "अनुसूचित पुल-शैली बैकअप ने इस होस्ट पर रिमोट होस्ट को SSH और rsync पर हार्ड-लिंक्ड स्नैपशॉट के रूप में दोहराया"

# libretranslate
msgctxt "role:sys-ctl-cln-bkps:description"
msgid "Scheduled systemd maintenance service for pruning outdated backup versions when disk usage exceeds a threshold"
msgstr "जब डिस्क उपयोग एक थ्रेसहोल्ड से अधिक हो जाता है तो छंटनी पुराने बैकअप संस्करणों के लिए व्यवस्थित रखरखाव सेवा"

# libretranslate
msgctxt "role:sys-ctl-rpr-btrfs-balancer:description"
msgid "Scheduled systemd service and timer for rebalancing Btrfs file systems to keep storage allocation optimal"
msgstr "अनुसूचित प्रणालीबद्ध सेवा और टाइमर भंडारण आवंटन इष्टतम रखने के लिए Btrfs फ़ाइल सिस्टम को बदलने के लिए"

# libretranslate
msgctxt "role:sys-ctl-mtn-cert-renew:description"
msgid "Scheduled systemd-timer job renewing Let's Encrypt SSL/TLS certificates via Certbot and reloading NGINX afterward"
msgstr "अनुसूचित प्रणालीबद्ध टाइमर नौकरी नवीनीकरण Let's Encrypt SSL/TLS प्रमाण पत्र के माध्यम से Certbot और reloading NGINX बाद में"

# libretranslate
msgctxt "role:svc-runner:description"
msgid "Self-hosted CI runner infrastructure for executing GitHub Actions workflow jobs in ephemeral Docker containers"
msgstr "स्व-होस्टेड CI धावक बुनियादी ढांचे को निष्पादित करने के लिए GitHub एक्शन वर्कफ़्लो जॉब्स ephemeral Docker Containers"

# libretranslate
msgctxt "role:web-app-gitlab:description"
msgid "Self-hosted DevOps platform for Git source-code management, CI/CD pipelines, and issue tracking"
msgstr "गिट स्रोत-कोड प्रबंधन, सीआई / सीडी पाइपलाइनों और मुद्दे ट्रैकिंग के लिए स्व-होस्टेड देवऑप्स प्लेटफॉर्म"

# libretranslate
msgctxt "role:web-app-fediwall:description"
msgid "Self-hosted Fediverse wall for showing recent public posts by hashtag or account in a live masonry grid"
msgstr "एक लाइव चिनाई ग्रिड में हैशटैग या खाता द्वारा हाल के सार्वजनिक पदों को दिखाने के लिए स्व-होस्टेड फेडिवर्स वॉल"

# libretranslate
msgctxt "category:svc.runner:description"
msgid "Self-hosted GitHub Actions runner deployment and configuration"
msgstr "स्व-होस्टेड गिटहब एक्शन धावक तैनाती और विन्यास"

# libretranslate
msgctxt "role:web-app-littlejs:description"
msgid "Self-hosted HTML5 game sandbox for browsing and running lightweight engine demos and games in the browser"
msgstr "Self-hosted HTML5 ब्राउज़र में ब्राउज़िंग और चलने वाले हल्के इंजन डेमो और गेम के लिए गेम सैंडबॉक्स"

# libretranslate
msgctxt "role:svc-db-openldap:description"
msgid "Self-hosted LDAP directory service for centralized user, group, and schema management with TLS-secured access"
msgstr "TLS-सिक्योर्ड एक्सेस के साथ केंद्रीकृत उपयोगकर्ता, समूह और स्कीमा प्रबंधन के लिए स्व-होस्टेड LDAP डायरेक्टरी सेवा"

# libretranslate
msgctxt "role:web-app-minio:description"
msgid "Self-hosted S3-compatible object storage for files, media, backups, and AI artifacts"
msgstr "स्व-होस्टेड एस3फ़ाइलों, मीडिया, बैकअप और एआई कलाकृतियों के लिए संगत वस्तु भंडारण"

# libretranslate
msgctxt "role:web-app-yourls:description"
msgid "Self-hosted URL shortener for creating, tracking, and managing short links with built-in click analytics"
msgstr "अंतर्निहित क्लिक एनालिटिक्स के साथ लघु लिंक बनाने, ट्रैकिंग और प्रबंधित करने के लिए स्व-होस्टेड यूआरएल शॉर्टर"

# libretranslate
msgctxt "role:web-app-jitsi:description"
msgid "Self-hosted WebRTC platform for end-to-end-encryptable video conferencing with federated authentication"
msgstr "अंतिम-टू-एंड-एंक्रिप्टेबल वीडियो कॉन्फ्रेंसिंग के लिए स्व-होस्टेड वेबआरटीसी प्लेटफॉर्म"

# libretranslate
msgctxt "role:web-app-mini-qr:description"
msgid "Self-hosted browser tool for generating QR codes from text or URLs with privacy-friendly local rendering"
msgstr "गोपनीयता के अनुकूल स्थानीय प्रतिपादन के साथ पाठ या यूआरएल से क्यूआर कोड उत्पन्न करने के लिए स्व-होस्टेड ब्राउज़र टूल"

# libretranslate
msgctxt "role:web-app-openwebui:description"
msgid "Self-hosted chat interface for interacting with local and private AI models via backends such as Ollama"
msgstr "स्थानीय और निजी एआई मॉडल के साथ बातचीत करने के लिए स्व-होस्टेड चैट इंटरफ़ेस जैसे ओलमा"

# libretranslate
msgctxt "role:web-app-nextcloud:description"
msgid "Self-hosted cloud platform for file sync, sharing, real-time collaboration, and team workspaces under your own domain"
msgstr "अपने स्वयं के डोमेन के तहत फ़ाइल सिंक, शेयरिंग, रीयल-टाइम सहयोग और टीम वर्कस्पेस के लिए सेल्फ-होस्टेड क्लाउड प्लेटफॉर्म"

# libretranslate
msgctxt "menu:Cloud:description"
msgid "Self-hosted cloud solutions for file synchronization, collaboration, and data sharing."
msgstr "फ़ाइल सिंक्रनाइज़ेशन, सहयोग और डेटा साझा करने के लिए स्व-होस्टेड क्लाउड समाधान।"

# libretranslate
msgctxt "role:web-app-bluesky:description"
msgid "Self-hosted decentralized social network on the open AT Protocol, with its own Personal Data Server"
msgstr "अपने स्वयं के व्यक्तिगत डेटा सर्वर के साथ ओपन एटी प्रोटोकॉल पर स्व-होस्टेड विकेन्द्रीकृत सोशल नेटवर्क"

# libretranslate
msgctxt "role:web-app-penpot:description"
msgid "Self-hosted design and prototyping platform for UI/UX work, real-time collaboration, and developer handoff"
msgstr "यूआई / यूएक्स कार्य, रीयल-टाइम सहयोग और डेवलपर हैंडऑफ़ के लिए स्व-होस्टेड डिज़ाइन और प्रोटोटाइपिंग प्लेटफॉर्म"

# libretranslate
msgctxt "role:web-app-magento:description"
msgid "Self-hosted e-commerce platform for catalog management, checkout, promotions, and multi-store online retail"
msgstr "कैटलॉग प्रबंधन, चेकआउट, प्रोन्नति और बहु-स्टोर ऑनलाइन खुदरा के लिए स्व-होस्टेड ई-कॉमर्स प्लेटफॉर्म"

# libretranslate
msgctxt "role:web-app-xwiki:description"
msgid "Self-hosted enterprise wiki and knowledge-management platform with collaboration and app-based extensibility"
msgstr "सहयोग और अनुप्रयोग आधारित व्यापकता के साथ स्व-होस्टेड उद्यम विकि और ज्ञान प्रबंधन मंच"

# libretranslate
msgctxt "role:web-app-bookwyrm:description"
msgid "Self-hosted federated reading platform for book reviews and reading tracking across the Fediverse"
msgstr "पुस्तक समीक्षाओं और Fediverse में ट्रैकिंग पढ़ने के लिए स्व-होस्टेड फेडरेटेड रीडिंग प्लेटफॉर्म"

# libretranslate
msgctxt "role:web-app-mastodon:description"
msgid "Self-hosted federated social network for microblogging, real-time timelines, and community moderation"
msgstr "माइक्रोब्लॉगिंग, रीयल-टाइम टाइमलाइन और सामुदायिक मॉडरेशन के लिए स्व-होस्टेड सोशल नेटवर्क"

# libretranslate
msgctxt "role:web-app-keycloak:description"
msgid "Self-hosted identity and access management platform for single sign-on, multi-factor authentication, and user federation"
