msgstr "रन `python -m cli.meta.ci.slots --matrix` पूरे बजट को देखने के लिए।."

# libretranslate
msgid "Run a SQL query against a role's database via `container exec`."
msgstr "किसी भूमिका के डेटाबेस के माध्यम से SQL क्वेरी चलाएं `container exec`।."

# libretranslate
msgid "Run a command with stdout/stderr passthrough."
msgstr "Stdout / stderr पासथ्रू के साथ एक कमांड चलाएं।."

# libretranslate
msgid "Run a subprocess and stream stdout/stderr live to the terminal."
msgstr "एक सबप्रोसेस चलाएं और स्टडआउट / स्टडर को स्ट्रीम करें।."

# libretranslate
msgid "Run a subprocess command and either stream output or capture it. Raise SystemExit on a return code outside `ok_returncodes`."
msgstr "एक सबप्रोसेस कमांड चलाएं और या तो आउटपुट स्ट्रीम करें या इसे कैप्चर करें। सिस्टम बाहर एक वापसी कोड पर बाहर निकलें `ok_returncodes`।."

# libretranslate
msgid "Run an existing shell helper, return stripped stdout. Empty string on failure. Helpers run with `cwd` as their working directory."
msgstr "एक मौजूदा शेल हेल्पर चलाएं, स्ट्रिप्ड स्टडआउट वापस करें। असफलता पर खाली स्ट्रिंग। सहायक उपकरण `cwd` उनकी कार्य निर्देशिका के रूप में।."

# libretranslate
msgid "Run ansible-playbook with the given parameters and execution modes."
msgstr "दिए गए मापदंडों और निष्पादन मोड के साथ दृश्य-प्लेबुक चलाएं।."

# libretranslate
msgid "Run argv and return (returncode, combined stdout+stderr)."
msgstr "रन argv और वापसी (रिटर्नकोड, संयुक्त stdout + stderr)।."

# libretranslate
msgid "Run cancellation on PR close, branch delete, or a superseding commit"
msgstr "पीआर क्लोज़, ब्रांच डिलीट, या सुपरसेडिंग प्रतिबद्धता पर रद्द करना"

# libretranslate
