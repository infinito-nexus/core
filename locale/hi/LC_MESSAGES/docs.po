msgid "INFINITO_FORK_REPOSITORY_URL: GitHub URL of the operator's fork, composed from INFINITO_FORK_ACCOUNT and INFINITO_FORK_REPOSITORY_NAME."
msgstr "INFINITO_FORK_REPOSITORY_URL: ऑपरेटर के फोर्क का गिटहब यूआरएल, जो ऑपरेटर के फोर्क से बना है INFINITO_FORK_ACCOUNT और INFINITO_FORK_REPOSITORY_NAME।"

msgid "INFINITO_GHCR_MIRROR: whether image references are rewritten to the GHCR mirror."
