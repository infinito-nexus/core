msgstr "पंक्तियाँ एक रन अपने पूरे हिस्से में खर्च कर सकते हैं।"

# libretranslate
msgid "Deploy runs inside the `infinito` container; host Node/Python/Go/Ruby toolchains go unused"
msgstr "Deploy अंदर चलाता है `infinito` कंटेनर; मेजबान Node/Python/Go/Ruby टूलचेन अप्रयुक्त हो जाते हैं"

