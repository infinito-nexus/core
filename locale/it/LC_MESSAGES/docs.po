msgstr "Non accade generazione automatica di fallback."

# translated-by: libretranslate
msgid "No automatic queueing"
msgstr "Nessuna coda automatica"

# translated-by: libretranslate
msgid "No blanket device grant, no shared host"
msgstr "Nessuna sovvenzione di dispositivo di coperta, nessun host condiviso"

