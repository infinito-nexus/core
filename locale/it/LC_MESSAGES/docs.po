msgid "`tests/lint/...`                           collision/band checks"
msgstr "`tests/lint/...` controllo collisione/banda"

# translated-by: libretranslate
msgid "`tests/lint/ansible/roles/meta/test_unpinned_no_engine_volume.py` stays as the guard: an unpinned role must not declare an engine on-disk data volume."
msgstr "`tests/lint/ansible/roles/meta/test_unpinned_no_engine_volume.py` rimane come guardia: un ruolo non piegato non deve dichiarare un motore su-disco volume di dati."

