msgstr "``custom.env`` è il file di override non tracciato dell'operatore; i suoi valori vincono su valori di default statici e di controllo."

# translated-by: libretranslate
msgid "``database_name``: The name of the initial database to create."
msgstr "``database_name``: Il nome del database iniziale da creare."

# translated-by: libretranslate
msgid "``database_password``: The password for the database user."
msgstr "``database_password``: La password per l'utente del database."

