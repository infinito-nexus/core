msgid "Do not define deploy_target inside the inventory file."
msgstr "Non definire deploy_target nel file dell'inventario."

# translated-by: libretranslate
msgid "Do not implement functionality until it is required. Avoid speculative abstractions, optional hooks, and future-proofing that no current requirement justifies."
msgstr "Non implementare funzionalità fino a quando non è necessario. Evitare astrazioni speculative, ganci opzionali, e la prova futura che nessun requisito corrente giustifica."

# translated-by: libretranslate
