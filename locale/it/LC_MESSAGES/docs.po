msgid "``discourse``: the WP->Discourse post round-trip scenario. Disabling Discourse skips it; front-page reachability and CSP baselines stay active."
msgstr "``discourse``: il WP->Discourse post cicloturismo. Disabilitazione Discourse skips; raggiungibilità front-page e basi CSP rimangono attive."

# translated-by: libretranslate
msgid "``docker_name``    the explicit ``name:`` field (alias for ``name``"
msgstr "``docker_name`` l'esplicito ``name:`` campo (alias per ``name``"

# translated-by: libretranslate
msgid "``domains``: canonical and alias domains"
msgstr "``domains``: domini canonici e alias"

