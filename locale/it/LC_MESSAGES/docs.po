msgstr "Restituisce la coppia vincente `make i18n-tune` registrato, vuoto quando assente."

# translated-by: libretranslate
msgid "Return type"
msgstr "Tipo di ritorno"

# translated-by: libretranslate
msgid "Return up to ``LIMIT`` distinct URLs found in one member of ``archive``."
msgstr "Ritorna fino a ``LIMIT`` URLs distinti trovati in un membro di ``archive``."

# translated-by: libretranslate
msgid "Return what *app_id* declares for *domain*, or an empty list."
msgstr "Ritorna cosa *app_id* Dichiarazioni per *dominio*o una lista vuota."

