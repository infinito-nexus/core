msgid "You MUST NOT use `--no-verify` unless the user gives a direct, unambiguous instruction to bypass the hook (e.g. \"skip the hook\", \"bypass pre-commit\")."
msgstr ""

# translated-by: libretranslate
msgid "You MUST NOT use `.md` files to describe implementation logic that is already visible in the code."
msgstr "Non usare `.md` file per descrivere la logica di implementazione che è già visibile nel codice."

# translation-refused: libretranslate protected-span
# nocheck: url
# translation-rejected: Non usare `templates/Dockerfile.j2` a meno che il
