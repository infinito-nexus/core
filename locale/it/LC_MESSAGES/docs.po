msgid "``key_bits`` (int): RSA key size"
msgstr "``key_bits`` (In questo caso): Dimensioni chiave RSA"

# translated-by: libretranslate
msgid "``key_host`` (string): host path to Root CA private key"
msgstr "``key_host`` (stringa): percorso host per Root CA chiave privata"

