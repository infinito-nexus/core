#, no-python-format, python-brace-format
msgid "You MUST NOT use `templates/Dockerfile.j2` unless the Dockerfile requires Jinja2 control-flow logic (e.g. `{% if %}`, `{% for %}`)."
msgstr ""

# translated-by: libretranslate
msgid "You MUST NOT use em dashes (—) as thought breaks or clause separators. You SHOULD prefer complete sentences. Hyphens (-) MAY be used for compound words and list items."
msgstr "Non è necessario utilizzare i trattini (—) come interruzioni di pensiero o separatori di clausola. Dovresti preferire frasi complete. Hyphens (- No.) MAY essere utilizzato per le parole composte e gli elementi di elenco."

# translated-by: libretranslate
msgid "You MUST NOT use the full URL as link text. Use the domain name, `here`, or the filename instead. Never use the full path."
msgstr "Non è necessario utilizzare l'URL completo come testo di collegamento. Utilizzare il nome di dominio, `here`, o il nome del file invece. Non usare mai il percorso completo."

# translated-by: libretranslate
msgid "You MUST NOT write tests for non-executable files such as `.yml` or `.j2`. Test the code that consumes them instead."
msgstr "Non devi scrivere test per file non eseguibili come `.yml` o `.j2`. Testare il codice che li consuma invece."

# translated-by: libretranslate
msgid "You MUST NOT write tests only for non-executable files such as `.yml` or `.j2`. Test the behavior that consumes them."
msgstr "Non devi scrivere test solo per file non eseguibili come `.yml` o `.j2`. Testare il comportamento che li consuma."

# translated-by: libretranslate
msgid "You MUST NOT write tests that only assert a file contains a string."
msgstr "È necessario NON scrivere test che affermano solo un file contiene una stringa."

# translated-by: libretranslate
msgid "You MUST NOT write unit tests for integration test logic. Integration tests verify real runtime boundaries; extracting that logic into unit tests defeats the purpose and duplicates coverage. The integration test itself is the specification."
msgstr "È necessario NON scrivere test unità per l'integrazione logica test. I test di integrazione verificano i confini in tempo reale; l'estrazione di tale logica nei test unitari sconfigge lo scopo e duplica la copertura. Il test di integrazione è la specifica."

# translated-by: libretranslate
msgid "You MUST NOT write values back from those UI fields to OIDC or LDAP through injected JavaScript. Treat those fields as externally managed and read-only in the application UI."
msgstr "Non devi scrivere i valori da quei campi dell'interfaccia utente a OIDC o LDAP tramite JavaScript iniettato. Tratta questi campi come gestita esternamente e sola lettura nell'applicazione UI."

# translated-by: libretranslate
msgid "You MUST NOT:"
msgstr "Non devi:"

