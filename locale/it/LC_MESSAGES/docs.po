msgid "Assemble the healthcheck mapping."
msgstr "Assemblare la mappatura del controllo sanitario."

# translated-by: libretranslate
msgid "Assemble the shared context for a network lookup."
msgstr "Assemblare il contesto condiviso per una ricerca di rete."

# translated-by: libretranslate
msgid "Assertion at the gate"
msgstr "Asserzione al cancello"

