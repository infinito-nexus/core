# translated-by: libretranslate
msgid "This role configures GNOME Shell extensions and installs the CLI GNOME Extension Manager for managing extensions."
msgstr "Jukumu hili linajumuisha GNOME Shell Upanuzi na kufunga Meneja wa Upanuzi wa CLI GNOME kwa kusimamia upanuzi."

msgid "This role configures Nginx to perform 301 redirects based on a list of source→target domain mappings. Each source is served on every network sibling, and each sibling redirects to the target's sibling in the same network."
msgstr ""

msgid "This role configures Nginx to perform 301 redirects based on a list of source→target domain mappings. Each source is served on every network sibling, and each sibling redirects to the target’s sibling in the same network."
msgstr ""

# translated-by: libretranslate
msgid "This role configures a basic user environment (shell dotfiles and SSH authorized_keys) for a user selected via ``user_key``."
msgstr "Jukumu hili linaweka mazingira ya msingi ya mtumiaji (Dotfiles ya shell na SSH authorized_keys) Kwa watumiaji waliochaguliwa kupitia ``user_key``..."

# translated-by: libretranslate
