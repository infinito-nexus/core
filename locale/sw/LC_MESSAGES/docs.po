msgid "You MUST at minimum inspect and compare the start page and the login page because these pages usually expose the most important navigation, authentication, and first-load behavior."
msgstr "Lazima kukagua na kulinganisha ukurasa wa mwanzo na ukurasa wa kuingia kwa sababu kurasa hizi kwa kawaida zinaonyesha urambazaji muhimu zaidi, uthibitishaji, na tabia ya mzigo wa kwanza."

# translated-by: libretranslate
msgid "You MUST build filesystem paths with `path_join` instead of concatenating path segments as strings."
msgstr "Unahitaji kujenga njia ya faili `path_join` Badala ya kuwa na njia za mkato."

# translated-by: libretranslate
msgid "You MUST check that `APP_BASE_URL`, app URLs, issuer URLs, and feature toggles match the deployed role."
msgstr "Unapaswa kuangalia hii `APP_BASE_URL`, URL za programu, URL za suala, na toggles za kipengele zinalingana na jukumu lililotumika."

# yanarejelewa katika `playwright.spec.js` Je, ipo katika hali gani? `.env`
