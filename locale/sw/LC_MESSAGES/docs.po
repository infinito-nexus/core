# translated-by: libretranslate
msgid "Idempotent: subsequent role runs reuse the populated cache volume."
msgstr "Idempotent: jukumu la baadaye linatumia tena kiasi cha cache cha watu."

# translated-by: libretranslate
msgid "Idempotently configures `origin`, `fork`, `main`-tracking, and the push-routing keys above."
msgstr "Kuundwa kwa utaratibu `origin`, Kwa hivyo, `fork`, Kwa hivyo, `main`Kuendeleza mwelekeo wa mbele, upande wa nyuma na nyuma."

# translated-by: libretranslate
msgid "Identify the integration boundary (e.g. lookup plugin + `group_vars` variable loading)."
msgstr "Kutambua mipaka ya ushirikiano (Kwa mfano, tazama Plugin + `group_vars` Ufuatiliaji wa Ufuatiliaji)..."

# translated-by: libretranslate
msgid "Identify the module under test (e.g. `plugins/lookup/service.py`)."
msgstr "Chagua moduli chini ya mtihani (ya g. `plugins/lookup/service.py`)..."

