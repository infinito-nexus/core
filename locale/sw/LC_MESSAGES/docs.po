# translated-by: libretranslate
msgid "Baserow documents a native built-in MCP server."
msgstr "Baserow nyaraka asili kujengwa katika MCP server."

# translated-by: libretranslate
msgid "Baserow requires Django `SECRET_KEY` for correct backend operation (e.g., JWT, sessions). This role reads it from `credentials.secret_key` and writes it into the container environment file."
msgstr "Kocha amtaka Django `SECRET_KEY` Kufanya kazi sahihi ya backend (Kwa mfano, JWT, mikutano). Sehemu hii inasomeka kutoka `credentials.secret_key` na kuiandika katika faili ya mazingira ya chombo."

# translated-by: libretranslate
