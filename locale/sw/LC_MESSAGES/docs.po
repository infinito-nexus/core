# gained=['"Routing"']
# cha "Routing". Wakati huduma hii inatumiwa, ndoano ya mlango wa mbele ya
# simu inauliza ni nani wa mifano inayofaa anapaswa kujibu, kupitisha haraka
# kama hali na akaases za kuishi kama chaguo la moja. `choice` swali la.
