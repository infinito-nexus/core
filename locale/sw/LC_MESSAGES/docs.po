msgstr "Utambulisho na Usimamizi wa Upatikanaji 🔐"

# translated-by: libretranslate
msgid "Identity and hard boundary"
msgstr "Utambulisho na mipaka ngumu"

# translated-by: libretranslate
msgid "Identity integration"
msgstr "Ushirikiano wa utambulisho"

# translated-by: libretranslate
msgid "Identity is per provider, never the deployment administrator"
msgstr "Utambulisho ni kwa kila mtoa huduma, sio msimamizi wa kupelekwa"

