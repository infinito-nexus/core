msgstr "Juu ya Mlima wa Mizeituni `saml.config.php` Ndani ya `compose.yml.j2` (Mfano wa ldapauth)..."

# translated-by: libretranslate
msgid "Mounts NGINX configuration and Let’s Encrypt directories"
msgstr "Mounts NGINX Configuration na Hebu Kuficha directories"

# translated-by: libretranslate
msgid "Move duplicated helpers into `utils/`."
msgstr "Kutoa msaada wa duplicate `utils/`..."

# translated-by: libretranslate
msgid "Move init_database.yml to an own role"
msgstr "Hatua ya init_database.yml Kuwa na jukumu mwenyewe"

