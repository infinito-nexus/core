msgid "You SHOULD keep each test focused on one integration boundary."
msgstr "Unapaswa kuweka kila jaribio lililozingatia mipaka moja ya ushirikiano."

# translated-by: libretranslate
msgid "You SHOULD keep external tests focused, advisory, and easy to run on demand."
msgstr "Unapaswa kuweka vipimo vya nje vinavyozingatia, ushauri, na rahisi kuendesha mahitaji."

