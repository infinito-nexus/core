msgstr "Lazima uchukue mahitaji ya maendeleo ya mfumo katika mizizi `TODO.md` Kazi ya kimataifa inaonekana katika sehemu moja."

# translated-by: libretranslate
msgid "You MUST check off each criterion in the requirement file as soon as it is verified. Do not batch them."
msgstr "Unapaswa kuangalia kila kigezo katika faili ya mahitaji mara tu itakapothibitishwa. Usiwafanyie wepesi."

# translated-by: libretranslate
msgid "You MUST check that `APP_BASE_URL`, app URLs, issuer URLs, and feature toggles match the deployed role."
