msgid "One search-only key and explicit collection list per application; no collection/schema/key administration"
msgstr "Orodha moja ya utafutaji tu muhimu na ya wazi ya ukusanyaji kwa kila maombi; hakuna collection/schema/key Utawala wa Utawala"

# translated-by: libretranslate
msgid "One selection token as a :class:`Pin`."
msgstr "Chagua moja kama A :class:`Pin`..."

