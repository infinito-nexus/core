msgid "Public reads or restricted account; no upload, comment, follow, federation, moderation, or administration mutation"
msgstr "Umma kusoma au akaunti vikwazo; hakuna upload, maoni, kufuata, shirikisho, kiasi au mabadiliko ya utawala"

# translated-by: libretranslate
msgid "Public reads unless a proven per-user API exists; no content, follow, federation, moderation, or account mutation"
msgstr "Umma kusoma isipokuwa kuthibitishwa kwa mtumiaji API Hakuna maudhui, kufuata, shirikisho, moderation au mabadiliko ya akaunti"

# translated-by: libretranslate
msgid "Public repo (this repo, `ubuntu-latest`)"
msgstr "Maoni ya Umma (Kwa njia hii, `ubuntu-latest`)"

# translated-by: libretranslate
msgid "Public vhost"
