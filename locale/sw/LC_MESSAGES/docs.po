# translated-by: libretranslate
msgid "**No external database** - self-contained SQLite under ``/config``."
msgstr "**Hakuna database ya nje** - Kujitegemea mwenyewe chini ya ``/config``..."

# translated-by: libretranslate
msgid "**No external database.** OpenBao's integrated raft storage owns all state on one persistent volume."
msgstr "**Hakuna database ya nje.** Hifadhi ya raft ya OpenBao inamiliki hali zote kwa kiasi kimoja."

# translated-by: libretranslate
msgid "**No external database:** Self-contained on a single persistent volume."
msgstr "**Hakuna database ya nje:** Kujitegemea kwa kiasi kimoja cha kudumu."

