# translated-by: libretranslate
msgid "Publish flows as HTTP endpoints for easy integration"
msgstr "Chapisha mtiririko kama mwisho wa HTTP kwa ushirikiano rahisi"

# translated-by: libretranslate
msgid "Publishes `openrouter/auto`."
msgstr "Waandishi wa `openrouter/auto`..."

# translated-by: libretranslate
msgid "Publishes the `anthropic/*` models."
msgstr "Anaandika kuwa `anthropic/*` ya mifano."

