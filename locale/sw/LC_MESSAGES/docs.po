# translated-by: libretranslate
msgid "**\"Waits for feedback\"** = the agent polls the PR through the git-forge MCP server (025); the human review gate stays human."
msgstr "**\"kusubiri kwa ajili ya maoni\"** = wakala kura PR kupitia git-forge MCP server (025); Mlango wa ukaguzi wa binadamu bado ni binadamu."

