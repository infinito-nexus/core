msgstr "inneall bunachar sonraí veicteoir lárnach a stóráil agus a chuardach in aghaidh an-tomhaltóir embeddings roinnte ar fud an chairn"

# translated-by: libretranslate
msgctxt "role:sys-svc-rdbms:description"
msgid "Centralized MariaDB or PostgreSQL database service shared across applications via Docker Compose"
msgstr "Lárnaigh MariaDB nó PostgreSQL seirbhís bunachar sonraí roinnte ar fud na n-iarratas Docker Compose"

# translated-by: libretranslate
msgctxt "role:sys-svc-certs:description"
msgid "Certbot-driven ACME service for Let's Encrypt single-domain and wildcard TLS certificates on NGINX domains"
msgstr "Seirbhís ACME Certbot-tiomáinte do A ligean ar Criptithe aonair-domain agus wildcard teastais TLS ar fearainn NGINX"

# translated-by: libretranslate
msgctxt "logout:checking"
msgid "Checking your other sessions…"
msgstr "Seiceáil do sheisiúin eile..."

