msgstr "Úsáid MUST tú `# nocheck: docker-version` go díreach os cionn `version:` eochair ach amháin le haghaidh eisceachtaí d'aon ghnó nár chóir a bhratach ag an seiceáil íomhá-leagan seachtrach."

# translated-by: libretranslate
msgid "You MUST use `--color-01-*` and `--color-rgb-01-*` as the primary palette. They MUST cover the majority of themed surfaces."
msgstr "Úsáid MUST tú `--color-01-*` agus `--color-rgb-01-*` mar an pailéad bunscoile. Clúdaíonn siad an chuid is mó de na dromchlaí téamaí."

# translated-by: libretranslate
msgid "You MUST use `.md` files for commands, workflows, setup, and contributor guidance."
msgstr "Úsáid MUST tú `.md` comhaid le haghaidh orduithe, sreabhadh oibre, thus, agus treoir rannchuiditheora."

# translated-by: libretranslate
msgid "You MUST use `chmod +x` for those scripts so they can be invoked as executables."
msgstr "Úsáid MUST tú `chmod +x` do na scripteanna ionas gur féidir iad agairt mar executables."

# translated-by: libretranslate
msgid "You MUST use `dotenv_quote` for values that may contain spaces, special characters, or shell-sensitive content."
