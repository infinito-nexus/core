# translated-by: libretranslate
msgid "`INFINITO_VERSION_ENV_NAME` (default: `INFINITO_VERSION`)"
msgstr "`INFINITO_VERSION_ENV_NAME` (cineál gas: in airde `INFINITO_VERSION`)"

