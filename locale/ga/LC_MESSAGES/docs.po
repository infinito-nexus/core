msgstr "**Domhanda Matomo Rianú** Áirítear leis an ról chumraíocht rianú Matomo agus instealladh an script rianú comhfhreagrach isteach i do HTML."

# translated-by: libretranslate
msgid "**Global Theming**"
msgstr "**Téitheoir Domhanda**"

