msgstr "INFINITO_DOCKER_VOLUME: GHA-taobh override dírithe ar an dara háit mór-dílis mount."

# libretranslate
msgid "INFINITO_DOMAIN: ``<stack>.<INFINITO_DNS_DOMAIN>``, where the stack is ``main`` for the primary checkout and the normalised branch for a linked git worktree. Always overrides the caller env, which inside the stack container is the previous ``.env``; GitHub/act runs keep the static default and custom.env pins win."
msgstr "INFINITO_DOMAIN: ``<stack>.<INFINITO_DNS_DOMAIN>``, áit a bhfuil an chairn ``main`` don phríomhsheiceáil agus don bhrainse gnáthaithe do chrann oibre git nasctha. I gcónaí overrides an env caller, a bhfuil taobh istigh an coimeádán Stack an roimhe seo ``.env``; Ritheann GitHub / gníomhú a choinneáil ar an réamhshocraithe statach agus custom.env bioráin bhuachan."

# libretranslate
msgid "INFINITO_FORK_ACCOUNT: GitHub account holding the operator's fork, defaulting to the local OS username."
msgstr "INFINITO_FORK_ACCOUNT: GitHub cuntas a bhfuil forc an oibreora, ag mainneachtain an ainm úsáideora OS áitiúil."

# libretranslate
msgid "INFINITO_FORK_REPOSITORY_URL: GitHub URL of the operator's fork, composed from INFINITO_FORK_ACCOUNT and INFINITO_FORK_REPOSITORY_NAME."
