# libretranslate
msgid "**Idempotent provisioning** ACL users reconciled on every deploy via `ACL SETUSER`."
msgstr "**Soláthar níos fearr** ACL úsáideoirí réiteach ar gach imscaradh via `ACL SETUSER`."

# libretranslate
msgid "**Idempotent provisioning** ACL users reconciled on every deploy via ``ACL SETUSER``."
