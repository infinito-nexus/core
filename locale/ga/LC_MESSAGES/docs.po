msgid "``package.json`` and ``playwright.config.js`` are provided centrally by this role:"
msgstr "``package.json`` agus ``playwright.config.js`` a sholáthar go lárnach leis an ról seo:"

# translated-by: libretranslate
msgid "``package_name`` (string) Name of the Python package to install (e.g., ``dockreap``, ``backup-docker-to-local``)."
msgstr "``package_name`` (teaghrán) Ainm an phacáiste Python a shuiteáil (e.g., ``dockreap``, ``backup-docker-to-local``)."

