msgid "Recursively encrypt all leaves (plain text values) under the credentials section."
msgstr "Athchóirigh gach duilleoga (luachanna téacs plain) faoin alt dintiúir."

# translated-by: libretranslate
msgid "Recursively encrypt values in the data."
msgstr "Luachanna criptithe Athchúrsach sna sonraí."

