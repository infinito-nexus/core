msgid "Alternatively, disable IPv6 only in Docker via `/etc/docker/daemon.json`:"
msgstr "Nó, IPv dhíchumasú6 ach amháin i Docker via `/etc/docker/daemon.json`:"

# libretranslate
msgid "Alternatives weighed 🔀"
msgstr "Roghanna eile a mheá"

# libretranslate
msgid "Always Category-Keyed Maps 🗂️"
msgstr "Léarscáileanna Catagóir-Keyed i gcónaí"

# libretranslate
msgid "Always create the new domain and user in Mailu first."
msgstr "Cruthaigh an bhfearann agus an t-úsáideoir nua i Mailu ar dtús."

# libretranslate
msgid "Always overwrite `image`/`version` from the mirror"
msgstr "Scríobh i gcónaí `image`/ Baile`version` as an scáthán"

# libretranslate
msgid "Always purge the Cloudflare cache after significant changes to your website or OpenResty/NGINX configuration."
msgstr "I gcónaí purge an taisce Cloudflare tar éis athruithe suntasacha ar do láithreán gréasáin nó OpenResty / NGINX chumraíocht."

# libretranslate
msgid "Always resolve tokens as: **``users → token store → empty``**"
msgstr "I gcónaí a réiteach comharthaí mar: **``users → token store → empty``**"

# libretranslate
