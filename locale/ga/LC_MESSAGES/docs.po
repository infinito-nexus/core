# libretranslate
msgid "INFINITO_CA_BUNDLE_CANDIDATES: where the distributions keep the extracted CA bundle, read from the group_vars paths SPOT (group_vars/all/05_paths.yml CA_BUNDLE_CANDIDATES)."
msgstr "INFINITO_CA_BUNDLE_CANDIDATES: i gcás na dáiltí a choinneáil ar an bundle CA bhaintear, léamh as an group_vars paisinéara (group_vars/all/05_paths.yml CA_BUNDLE_CANDIDATES)."

# libretranslate
msgid "INFINITO_CA_CERT_HOST: host path of the self-signed root CA cert."
msgstr "INFINITO_CA_CERT_HOST: cosán óstach ar an gcóras féin-sínithe CA."

# libretranslate
msgid "INFINITO_CONTAINER: compose service container name derived from INFINITO_DISTRO. Always overrides whatever the static-env default was."
msgstr "INFINITO_CONTAINER: déan ainm coimeádán seirbhíse a dhíorthaítear ó INFINITO_DISTRO. I gcónaí overrides is cuma cad a bhí an réamhshocraithe statach-env."

# libretranslate
msgid "INFINITO_DIR_BACKUPS: local backup root, derived from the var-lib SPOT (INFINITO_DIR_VAR_LIB); mirrors group_vars/all/05_paths.yml DIR_BACKUPS."
msgstr "INFINITO_DIR_BACKUPS: fréamh cúltaca áitiúil, a dhíorthaítear ón var-lib SPOT (INFINITO_DIR_VAR_LIB); scátháin group_vars/all/05_paths.yml DIR_BACKUPS."

# libretranslate
