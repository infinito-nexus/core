# translated-by: libretranslate
msgid "Then generate all graphs purely from memory"
msgstr "Ansin a ghiniúint gach graif amháin ó chuimhne"

# translated-by: libretranslate
msgid "Then refactor only the roles confirmed by the user."
msgstr "Ansin refactor ach na róil deimhnithe ag an úsáideoir."

