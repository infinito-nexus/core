# libretranslate
msgid "**HTTP serving** with MIME types, gzip compression, caching, and custom `NGINX.conf` templating."
msgstr "**HTTP ag freastal** le cineálacha MIME, comhbhrú gzip, caching, agus saincheaptha `NGINX.conf` templating."

# libretranslate
msgid "**HTTP serving** with MIME types, gzip compression, caching, and custom ``NGINX.conf`` templating."
msgstr "**HTTP ag freastal** le cineálacha MIME, comhbhrú gzip, caching, agus saincheaptha ``NGINX.conf`` templating."

