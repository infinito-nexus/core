# libretranslate
msgid "**Idempotent Design**: Ensures that repeat runs of the playbook do not result in unwanted changes."
msgstr "**Dearadh Lánchumhachtach**: Cinntíonn nach mbíonn athruithe nach dteastaíonn mar thoradh ar arís ar an leabhar súgartha."

# libretranslate
msgid "**Idempotent Design:** Ensures safe re-runs and minimal unnecessary restarts."
msgstr "**Dearadh Idempotent:** Cinntíonn ath-ritheann sábháilte agus atosú íosta gan ghá."

# libretranslate
