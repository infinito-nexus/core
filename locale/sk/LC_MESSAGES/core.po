msgstr "Central mail orchestračná vrstva smerovanie hostiteľskej pošty cez Mailu, msmtp, alebo voliteľné miestne SMTP relé"

# translated-by: libretranslate
msgctxt "category:svc.dns:description"
msgid "Central recursive/forwarding DNS resolver engines (Unbound, etc.)"
msgstr "Centrálne rekurzívne/prevádzacie motory DNS resolver (Unboundatď.)"

# translated-by: libretranslate
msgctxt "role:svc-dns-unbound:description"
