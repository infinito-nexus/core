msgstr "Kontrola prístupu k užívateľským účtom"

# translated-by: libretranslate
msgctxt "category:user:title"
msgid "Users & Access"
msgstr "Prístup užívateľov"

# translated-by: libretranslate
msgctxt "role:dsk-git:description"
