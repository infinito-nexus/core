msgstr "Workstation toolchain and serial-port authors for Arduino board development on Linux"

# translated-by: libretranslate
msgctxt "role:pkgmgr-install:description"
msgid "Wrapper role for idempotent package installation and updates through the pkgmgr universal package manager"
msgstr "Wrapper role pre nemennú inštaláciu balíčka a aktualizácie prostredníctvom pkgmgr univerzálny správca balíčkov"

