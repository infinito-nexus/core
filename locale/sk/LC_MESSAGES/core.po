# translated-by: libretranslate
msgctxt "role:svc-db-typesense:description"
msgid "Central Dockerized search engine shared by multiple apps with per-consumer scoped API keys"
msgstr "Centrálny dockerizovaný vyhľadávač zdieľaný viacerými aplikáciami s klávesami API s rozlíšením na zákazníka"

# translated-by: libretranslate
msgctxt "role:svc-ai-tika:description"
msgid "Central document extraction engine that turns uploaded files into text for retrieval-augmented chat"
msgstr "Centrálny vyťahovací nástroj dokumentov, ktorý sa zmení na nahrané súbory do textu pre načítaný chat"

# translated-by: libretranslate
msgctxt "menu:Help:description"
msgid "Central help resources, including documentation, support tools, and guidance."
msgstr "Ústredné zdroje pomoci vrátane dokumentácie, podporných nástrojov a usmernení."

# translated-by: libretranslate
msgctxt "role:svc-db-memcached:description"
msgid "Central in-memory caching engine with per-consumer key-prefix isolation, usable centrally or as an embedded sidecar"
msgstr "Centrálny in-pamäťový caching motor s izoláciou kľúča na spotrebiteľa, použiteľný centrálne alebo ako zabudovaný postranný vozík"

# translated-by: libretranslate
msgctxt "role:sys-service-loader:description"
msgid "Central loader role for ordered shared-service preloading and queued post-load role inclusions across the deployment"
msgstr "Úloha centrálneho nakladača pre objednané prednahrávanie zdieľaných služieb a zaradenie rolí po načítaní v čakacom rade v celom nasadení"

