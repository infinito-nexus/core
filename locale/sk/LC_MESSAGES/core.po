msgstr "Systemed-riadený čistenie služby prerezávanie anonymné Docker objemy plus obrázky, kontajnery, siete, a vybudovať vyrovnávaciu pamäť"

# translated-by: libretranslate
msgctxt "role:sys-ctl-rpr-container-hard:description"
msgid "Systemd-scheduled maintenance role for full Docker Compose stack restarts, with hard restarts for stacks like Mailu"
msgstr "Systémovo plánovaná údržbová rola pre plné Docker Compose stack reštarty, s tvrdými reštartmi pre zásobníky ako Mailu"

# translated-by: libretranslate
msgctxt "role:sys-ctl-hlth-container:description"
msgid "Systemd-timed monitor for detecting unhealthy or non-zero-exited Docker containers and raising failure alerts"
msgstr "Systémovo načasovaný monitor na odhaľovanie nezdravých alebo nenulových kontajnerov s dockermi a zvyšovanie upozornení na poruchy"

# translated-by: libretranslate
msgctxt "role:sys-ctl-alm-email:description"
msgid "Systemd-triggered msmtp notifier for emailing operators when a monitored service unit fails"
msgstr "Oznamovateľ systému spúšťaného msmtp na e-mail operátorom, ak monitorovaná jednotka služby zlyhá"

# translated-by: libretranslate
msgctxt "role:sys-ctl-alm-telegram:description"
msgid "Systemd-triggered notifier for delivering service-failure alerts to a Telegram chat"
msgstr "Oznamovateľ so systémovým spúšťaním na doručovanie upozornení na zlyhanie služby na telegramový chat"

# translated-by: libretranslate
msgctxt "role:dsk-gnt-claude:description"
msgid "Terminal coding agent from Anthropic, pointed at the platform's own model gateway instead of the vendor API"
msgstr "Terminálny kódovací agent z Antropic, ukázal na vlastnú bránu modelu platformy namiesto dodávateľa API"

# translated-by: libretranslate
msgctxt "role:dsk-gnt-codex:description"
msgid "Terminal coding agent from OpenAI, pointed at the platform's own model gateway instead of the vendor API"
msgstr "Terminálny kódovací agent z OpenAI, ukázal na vlastnú bránu modelu platformy namiesto dodávateľa API"

# translated-by: libretranslate
msgctxt "role:dsk-gnome-terminal:description"
msgid "Terminal emulator for the GNOME desktop, giving command-line access on Arch Linux workstations"
msgstr "Emulátor terminálu pre pracovnú plochu GNOME, ktorý poskytuje prístup do príkazového riadku na pracovných staniciach Arch Linux"

# translated-by: libretranslate
msgctxt "role:dsk-micro:description"
msgid "Terminal-based text editor with modern keybindings and syntax highlighting for Pacman-based workstations"
msgstr "Terminálny textový editor s moderným kľúčom a zvýraznením syntaxe pre Pacmanove pracovné stanice"

# translated-by: libretranslate
msgctxt "role:test-e2e-cli:description"
msgid "Test-harness role running end-to-end CLI test scripts for roles that declare a test environment template"
msgstr "Test-harness role beží end-to-end Cli test skripty rolí, ktoré deklarujú skúšobné prostredie šablóny"

# translated-by: libretranslate
msgctxt "logout:pace"
msgid "This usually takes a few seconds."
msgstr "To zvyčajne trvá niekoľko sekúnd."

# translated-by: libretranslate
msgctxt "role:svc-opt-ssd-hdd:description"
msgid "Tiering role placing Docker volumes on SSD or HDD by workload type, with symlinks keeping paths consistent"
msgstr "Umiestňovanie Dockerových objemov na SSD alebo HDD podľa typu pracovného zaťaženia, pričom symlinky udržiavajú konzistentné trasy"

# translated-by: libretranslate
msgctxt "role:dev-python:description"
msgid "Toolchain for Python scripting, application development, and data science on Linux"
msgstr "Toolchain pre Python skriptovanie, vývoj aplikácií, a dát vedy o Linux"

# translated-by: libretranslate
msgctxt "menu:Tools:title"
msgid "Tools"
msgstr "Nástroje"

# translated-by: libretranslate
msgctxt "menu:User Management:description"
msgid "Tools for Identity and Access Management, including authentication, user provisioning, and secure access control."
msgstr "Nástroje na riadenie identity a prístupu vrátane autentifikácie, zabezpečenia používateľov a bezpečnej kontroly prístupu."

