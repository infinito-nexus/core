msgstr "A `required: false` successful message after an user action (role log line plus, v CI, GitHub akcie varovanie anotácie cez `utils.annotations.message.warning`), preskočte doplnok zostávajúce kroky, a nechajte hrať pokračovať."

# translated-by: libretranslate
msgid "A `required: true` addon whose install step fails MUST fail the play (no `failed_when: false` swallowing the error)."
msgstr "A `required: true` addon ktorého inštalácia zlyhá MUSÍ zlyhať hru (no `failed_when: false` prehltnutie chyby)."

# translated-by: libretranslate
