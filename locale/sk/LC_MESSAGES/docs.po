msgid "You MUST keep explanations simple and explicit."
msgstr "Musíte mať vysvetlenie jednoduché a explicitné."

# translated-by: libretranslate
msgid "You MUST keep external tests outside the default `make test` flow so normal validation stays reproducible without third-party network access."
msgstr "Musíte udržať externé testy mimo predvolené `make test` tok, takže bežná validácia zostáva reprodukovateľná bez prístupu tretích strán do siete."

# translated-by: libretranslate
msgid "You MUST keep helper-only logic, plumbing, and intermediate steps in `scripts/` or other implementation files."
msgstr "Musíte udržať logiku, inštalatér, a medzikroky v `scripts/` alebo iné realizačné súbory."

# translated-by: libretranslate
msgid "You MUST keep public targets stable, named clearly, and documented."
msgstr "Musíte udržať verejné ciele stabilné, pomenované jasne a zdokumentované."

# translated-by: libretranslate
msgid "You MUST keep refactoring changes small enough to review and validate."
msgstr "Musíte udržať refaktoring zmeny dostatočne malé na preskúmanie a overenie."

# translated-by: libretranslate
msgid "You MUST keep role-local or component-specific shell helpers in their owning area, such as `roles/.../files/`, when they belong to a single role."
msgstr "Musíte udržať role-miestne alebo komponenty-špecifické shell pomocníkov vo svojej vlastnej oblasti, ako je `roles/.../files/`, keď patria k jednej úlohe."

# translated-by: libretranslate
msgid "You MUST keep semver-like image versions current when the upstream image publishes matching newer tags."
msgstr "Musíte mať Semver-like verzie obrazu aktuálne, keď predný obrázok publikuje zodpovedajúce novšie značky."

