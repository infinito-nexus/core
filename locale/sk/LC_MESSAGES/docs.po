msgid "Operations 🛠️"
msgstr "Operácie 🛠️"

# translated-by: libretranslate
#, no-python-format
msgid "Operator decision: 100% open source, matches the platform; OIDC handled via the oauth2-proxy gate."
msgstr "Rozhodnutie prevádzkovateľa: 100% open source, zodpovedá platforme; OIDC manipuluje cez oauth2-Približná brána."

# translated-by: libretranslate
msgid "Operator decision: Keycloak SSO at the proxy, Checkmk trusts the proxy-supplied user, LDAP supplies the user record/roles/contact groups."
msgstr "Rozhodnutie prevádzkovateľa: Keycloak SSO na splnomocnení, Checkmk dôveruje proxy-dodáva užívateľ, LDAP dodáva užívateľovi record/roles/contact skupiny."

# translated-by: libretranslate
msgid "Operator decision: LDAP gives every client (incl. native apps) a platform identity; the OIDC plugin adds one-click web sign-in."
msgstr "Rozhodnutie prevádzkovateľa: LDAP dáva každému klientovi (vrátane natívnych aplikácií) identita platformy; modul OIDC pridáva jedno kliknutie na prihlásenie webu."

# translated-by: libretranslate
msgid "Operator decision: enable remote-host agent registration in v1."
msgstr "Rozhodnutie prevádzkovateľa: povoliť registráciu vzdialeného hostiteľa v v1."

# translated-by: libretranslate
msgid "Operator decision: self-contained v1; libraries added in-app."
msgstr "Rozhodnutie prevádzkovateľa: samostatné v1; do aplikácie boli pridané knižnice."

# translated-by: libretranslate
msgid "Operator decision: smallest, host-portable surface."
msgstr "Rozhodnutie prevádzkovateľa: najmenší, prenosný povrch."

# translated-by: libretranslate
msgid "Operator fork env handlers (INFINITO_FORK_*)."
msgstr "Operátori vidlíc (INFINITO_FORK_*)."

# translated-by: libretranslate
msgid "Operator messages MAY use the portable conversation shortcuts from the `shortcuts` skill (set up via `make install-skills`); agents MUST expand any matching shortcut before acting. The repository's own agent workflows live in the `i8-` skills catalogued in [cheatsheet.md](docs/contributing/tools/agents/cheatsheet.md)."
msgstr "Správy operátora MÔŽU používať prenosné konverzačné skratky z `shortcuts` zručnosti (nastavenie prostredníctvom `make install-skills`); Agenti MUSÍ pred konaním rozšíriť všetky zodpovedajúce skratky. Vlastné agent pracovných tokov úložiska žiť v `i8-` zručnosti v katalógu [cheatsheet.md](docs/contributing/tools/agents/cheatsheet.md)."

