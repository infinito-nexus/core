msgstr "Testy v tomto adresári MUSÍ zahŕňať len čisto funkčné správanie `utils.cert_utils` a `utils.tls_common`. Vyhľadávanie-plugin integrácie, ktorá závisí na týchto modulov MUSÍ žiť pod `tests/unit/python/plugins/lookup/`."

# translated-by: libretranslate
msgid "Tests in this directory MUST only cover variable definition / consumption checks. Four orthogonal scopes live here:"
msgstr "Testy v tomto adresári MUSIA zahŕňať iba variabilnú definíciu / kontrolu spotreby. Tu žijú štyri ortogonálne zábery:"

