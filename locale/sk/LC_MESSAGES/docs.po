# translated-by: libretranslate
msgid "Dive into a world of rhythm and sound with `Funkwhale <https://www.funkwhale.audio/>`__, an innovative self-hosted music sharing platform that celebrates creativity and community. Experience an energetic soundscape and seamless music streaming that amplifies your passion for tunes."
msgstr "Ponorte sa do sveta rytmu a zvuku s `Funkwhale <https://www.funkwhale.audio/>`__, inovatívne self-hosted hudobné zdieľanie platformu, ktorá oslavuje tvorivosť a komunitu. Zažite energickú soundscape a bezproblémovú hudbu, ktorá zosilňuje vašu vášeň pre melódie."

# translated-by: libretranslate
msgid "Do **not** just rename mailbox folders."
msgstr "Do **nie** len premenovať priečinky schránky."

# translated-by: libretranslate
msgid "Do NOT break native login, logout, navigation, or form flows unless the role explicitly requires that change and the new behavior is verified end to end."
msgstr "NEDOTÝKAJTE sa prirodzeného prihlásenia, odhlásenia, navigácie alebo tokov foriem, ak úloha výslovne nevyžaduje zmenu a nové správanie je overené koniec."

# translated-by: libretranslate
msgid "Do NOT document patterns or extension points that do not exist in the code."
msgstr "NEPODÁVAJTE vzory alebo body rozšírenia, ktoré v kóde neexistujú."

# translated-by: libretranslate
msgid "Do NOT expose unused variables, duplicate values, or secrets that the spec never reads."
msgstr "NEPODÁVAJTE nepoužité premenné, duplicitné hodnoty alebo tajomstvá, ktoré špecifikácia nikdy nečíta."

# translated-by: libretranslate
msgid "Do NOT hardcode domains or credentials that should come from role variables, inventory, or lookups."
msgstr "NEPODÁVAJTE hardcode domény alebo poverovacie listiny, ktoré by mali pochádzať z rolových premenných, inventára alebo vyhľadávačov."

# translated-by: libretranslate
msgid "Do NOT introduce noisy debug logging, uncaught errors, duplicate event handlers, or endless observers into injected scripts."
msgstr "NEPODÁVAJTE hlučné logovanie ladenia, neodchytené chyby, duplicitné spracovávače udalostí alebo nekonečných pozorovateľov do vstrekovaných skriptov."

# translated-by: libretranslate
msgid "Do NOT leave implementation warnings unresolved just because they are inconvenient."
msgstr "NEnechávajte upozornenia na implementáciu nevyriešené len preto, že sú nepohodlné."

# translated-by: libretranslate
msgid "Do NOT reimplement server-side logic, authentication protocols, or business rules in injected JavaScript."
msgstr "NEPODÁVAJTE logiku servera, autentifikačné protokoly alebo obchodné pravidlá v injekčnom JavaScripte."

# translated-by: libretranslate
msgid "Do NOT rely on fragile selectors, broad text matching, or timing hacks when more stable hooks exist."
msgstr "NEPODÁVAJTE sa na krehké voliče, širokú textovú zhodu alebo časovanie hackov, ak existujú stabilnejšie háčiky."

# translated-by: libretranslate
msgid "Do NOT rerun `make compose-deploy mode=reinstall apps=<roles> full_cycle=true` just because a deploy failed or you changed code. That restarts the stack unnecessarily and burns time."
msgstr "NEPODÁVAJTE `make compose-deploy mode=reinstall apps=<roles> full_cycle=true` len preto, že nasadenie zlyhalo alebo ste zmenili kód. To zbytočne reštartuje hromadu a páli čas."

# translated-by: libretranslate
msgid "Do NOT rewrite large parts of the frontend when a focused event handler, DOM adjustment, or configuration change is enough."
msgstr "NEPODÁVAJTE veľké časti frontendu, keď stačí zaostrený manipulátor udalostí, nastavenie DOM alebo zmena konfigurácie."

# translated-by: libretranslate
msgid "Do Not Replace"
msgstr "Nenahradiť"

# translated-by: libretranslate
msgid "Do not define deploy_target inside the inventory file."
msgstr "Nedefinovať deploy_target vo vnútri inventára."

# translated-by: libretranslate
msgid "Do not implement functionality until it is required. Avoid speculative abstractions, optional hooks, and future-proofing that no current requirement justifies."
msgstr "Neimplementujte funkciu, kým nie je potrebná. Vyhýbajte sa špekulatívnym abstrakciam, voliteľným hákom a budúcej ochrane, ktorú neospravedlňuje žiadna súčasná požiadavka."

