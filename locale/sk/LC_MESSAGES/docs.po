msgid "You MUST keep `services.javascript.enabled` enabled in the role configuration or override it in the inventory when JavaScript injection should run."
msgstr "Musíš si nechať `services.javascript.enabled` povolené v konfigurácii role alebo ju prepísať v inventári, kedy má spustiť injekcia JavaScript."

# translated-by: libretranslate
msgid "You MUST keep a shebang at the top of executable shell scripts."
msgstr "Musíte mať šabľu na vrchu spustiteľných skriptov."

