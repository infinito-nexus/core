msgid "`LDAP.BIND_CREDENTIAL` (Vault)"
msgstr "`LDAP.BIND_CREDENTIAL` (Vault)"

# translated-by: libretranslate
msgid "`LDAP.FILTERS.USERS` provides reusable LDAP search filters:"
msgstr "`LDAP.FILTERS.USERS` poskytuje opakovane použiteľné LDAP vyhľadávacie filtre:"

# translated-by: libretranslate
msgid "`LDAP.RBAC` controls how application roles are represented:"
msgstr "`LDAP.RBAC` kontroluje, ako sú zastúpené úlohy aplikácie:"

