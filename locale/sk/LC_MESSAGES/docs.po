msgstr "[yum](https://man7.org/linux/man-pages/man8/yum.8.html)"

# translated-by: libretranslate
msgid "__Gap-first:__ propose the lowest unoccupied contiguous span of size `--length N` within the band."
msgstr "Gap-first: navrhnúť najnižšie neobsadené susediace rozpätie veľkosti `--length N` v kapele."

# translated-by: libretranslate
msgid "__Gap-first:__ propose the lowest unoccupied port in the band."
msgstr "Gap-first: navrhnúť najnižší neobsadený port v pásme."

# translated-by: libretranslate
msgid "__Gap-first:__ propose the lowest unoccupied sub-block."
msgstr "Gap-first: navrhnúť najnižší neobsadený podblok."

# translated-by: libretranslate
msgid "__Increment fallback:__ if all sub-blocks of the active `/24` blocks are used, propose the next `/24` block in the established sequence (currently `192.168.101–105` for `/28`, `192.168.200–203` for `/24`)."
msgstr "Increment fallback: ak všetky podbloky aktívneho `/24` sa používajú bloky, navrhnúť nasledujúci `/24` blok v stanovenej sekvencii (v súčasnosti `192.168.101–105` namiesto `/28`, `192.168.200–203` namiesto `/24`)."

# translated-by: libretranslate
msgid "__Increment fallback:__ if no internal gap fits, propose `max(end) + 1` to `max(end) + N` (clamped to the band's upper bound)."
msgstr "Increment fallback: ak žiadna vnútorná medzera nepasuje, navrhnúť `max(end) + 1` do `max(end) + N` (pripnutý k hornej hranici kapely)."

# translated-by: libretranslate
msgid "__Increment fallback:__ if the band has no internal gaps, propose `max(used) + 1` (clamped to the band's upper bound)."
msgstr "Increment fallback: ak pásmo nemá žiadne vnútorné medzery, navrhnúť `max(used) + 1` (pripnutý k hornej hranici kapely)."

# translated-by: libretranslate
msgid "__MTU drops mid-handshake__, MITM cert mismatch, CA bundle missing, server-side issue"
msgstr "MTU kvapky uprostred-handshake__, MITM cert nesúlad, CA zväzok chýba, server-side problém"

# translated-by: libretranslate
msgid "__No established sequence:__ if the requested prefix size has no umbrella block established yet (e.g. `--clients 1000` → `/22` and no `/22` is in use), exit non-zero with a clear error suggesting that the operator pass `--block <cidr>` to bootstrap a new umbrella block manually."
msgstr "Nie je stanovená sekvencia: ak požadovaná veľkosť predpony ešte nemá vytvorený blok dáždnika (napr. `--clients 1000` → `/22` a nie `/22` sa používa), exit non-nula s jasnou chybou naznačujúcou, že prevádzkovateľ prejsť `--block <cidr>` aby ručne zachytil nový dáždnikový blok."

# translated-by: libretranslate
