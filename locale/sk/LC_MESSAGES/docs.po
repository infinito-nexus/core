msgstr "stderr prints per-suggestion capacity and a human-readible summary noting which umbrella(r) boli skenované."

# translated-by: libretranslate
msgid "__stdout__ prints a machine-readable list (one port per line for single-port categories, one `<start>-<end>` pair per line for `relay`)."
msgstr "stdout vytlačí strojovo čitateľný zoznam (jeden prístav na riadok pre jednotlivé kategórie prístavov, jeden `<start>-<end>` pár na riadok pre `relay`)."

