msgstr "INFINITO_FORK_REPOSITORY_URL: GitHub URL vidličky operátora, zložené z INFINITO_FORK_ACCOUNT a INFINITO_FORK_REPOSITORY_NAME."

# translated-by: libretranslate
msgid "INFINITO_GIT_AUTHOR_NAME / INFINITO_GIT_AUTHOR_EMAIL: the identity this checkout commits under. The test container mounts the checkout but not the contributor's git configuration, so the suite cannot ask git who is about to commit; the ``.env`` carries the answer across."
msgstr "INFINITO_GIT_AUTHOR_NAME / INFINITO_GIT_AUTHOR_EMAIL: totožnosť, pod ktorou sa táto kontrola zaväzuje. Testovací kontajner upevňuje pokladňu, ale nie konfiguráciu git prispievateľa, takže apartmán sa nemôže spýtať git, kto sa chystá spáchať; ``.env`` nesie odpoveď naprieč."

# translated-by: libretranslate
msgid "INFINITO_GPU_COUNT: GPUs the compose services reserve, 'all' when the docker daemon registers an NVIDIA runtime, else 0."
msgstr "INFINITO_GPU_COUNT: GPU tvoria rezervu služieb, 'all' keď démon docker zaregistruje bežiaci čas NVIDIA, inak 0."

# translated-by: libretranslate
msgid "INFINITO_I18N_BATCH_SIZE / INFINITO_I18N_LANES: client settings `make i18n-tune` measured on this host, falling back to the shipped defaults."
msgstr "INFINITO_I18N_BATCH_SIZE / INFINITO_I18N_LANES: nastavenie klienta `make i18n-tune` merané na tomto hostiteľa, pád späť na dodávané predvolené."

# translated-by: libretranslate
