msgstr "**stredné PostgreSQL:** ``SEMAPHORE_DB_DIALECT=postgres`` proti spoločnému ``svc-db-postgres`` (alebo na jednostupňový motor, ak nie je zdieľaný), s centralizovanou zálohou a monitorovaním."

# translated-by: libretranslate
msgid "**Central RDBMS Integration**"
msgstr "**Centrálna integrácia RDBMS**"

# translated-by: libretranslate
