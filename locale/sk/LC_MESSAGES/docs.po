msgstr "Testy, ktoré tvrdia, že súbor obsahuje reťazec, názov úlohy, názov premennej alebo fragment šablóny, nie sú povolené."

# translated-by: libretranslate
msgid "Tests that statically analyze Ansible config or task YAML files without exercising runtime boundaries MUST live under `tests/lint/ansible/` instead."
msgstr "Testy, ktoré staticky analyzujú Ansible config alebo úlohu YAML súbory bez výkonu časových hraníc MUSÍ žiť pod `tests/lint/ansible/` miesto toho."

