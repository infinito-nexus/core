# translated-by: libretranslate
msgid "**Single Sign-On (SSO) / OpenID Connect (OIDC):** Seamless integration with external identity providers for centralized authentication."
msgstr "**Jediný podpis (SSO) / OpenID Connect (OIDC):** Bezproblémová integrácia s externými poskytovateľmi identity pre centralizovanú autentifikáciu."

# translated-by: libretranslate
msgid "**Single Sign-On:** Frontend and controller share one Keycloak client and realm."
msgstr "**Jeden podpis:** Rozhranie a regulátor zdieľať jeden Keycloak klient a ríša."

