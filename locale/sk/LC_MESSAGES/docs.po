# translated-by: libretranslate
msgid "**CSP & Canonical Domains:** Hooks into platform CSP/SSL/domain management to keep policies strict and URLs stable."
msgstr "**CSP & Kanonické domény:** Háčiky na plošinu CSP/SSL/domain riadenie, aby politiky prísne a URL stabilné."

