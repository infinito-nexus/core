# translated-by: claude
msgctxt "role:web-app-workspace:description"
msgid "Browser IDE (openvscode-server) with the Claude Code extension, one per agent and user, sandboxed by svc-virt-kata"
msgstr "Browser-IDE (openvscode-server) mit der Erweiterung Claude Code, eine pro Agent und Benutzer, isoliert durch svc-virt-kata"

# translated-by: libretranslate
msgctxt "role:web-app-seaweedfs:description"
msgid "Browser administration interface for the SeaweedFS object store, serving the filer and master consoles behind SSO"
msgstr "Browser Administration Interface für die SeaweedFS Objektspeicher, der den Filer und die Masterkonsolen hinter SSO bedient"

# translated-by: claude
msgctxt "role:web-app-map-animator:description"
msgid "Browser editor for keyframe camera animations on a VersaTiles map, with a render server that turns them into videos"
msgstr "Browser-Editor für Keyframe-Kameraanimationen auf einer VersaTiles-Karte, mit einem Render-Server, der sie in Videos umwandelt"

# translated-by: libretranslate
msgctxt "role:web-app-roulette-wheel:description"
msgid "Browser-based spinning wheel app for decision making, random selection, and gamification"
msgstr "Browserbasierte Spinnrad-App für Entscheidungsfindung, Zufallsauswahl und Gamification"

# translated-by: libretranslate
msgctxt "role:web-app-litellm:description"
msgid "Browser-facing admin interface for the shared LLM gateway, published on its own domain behind the front proxy"
msgstr "Browserseitige Admin-Schnittstelle für das freigegebene LLM-Gateway, veröffentlicht auf einer eigenen Domain hinter dem Front-Proxy"

# translated-by: libretranslate
msgctxt "role:dev-fakeroot:description"
