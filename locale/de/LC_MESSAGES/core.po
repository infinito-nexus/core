msgstr "Automatisierter Wiederherstellungsdienst Neustart ausgeschiedener oder ungesunder Docker Compose-Stacks und Lösung von Portkonflikten"

# translated-by: libretranslate
msgctxt "role:sys-dns-hetzner-rdns:description"
msgid "Automation role for reverse DNS (PTR) records on Hetzner Cloud servers, primary IPs, floating IPs, and load balancers"
msgstr "Automatisierungsrolle für Reverse DNS (PTR)-Datensätze auf Hetzner Cloud-Servern, primären IPs, Floating IPs und Load Balancern"

