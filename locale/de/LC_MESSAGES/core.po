msgstr "Nutzer & Access"

# translated-by: claude
msgctxt "menu:Administration:description"
msgid "Users, servers, infrastructure and development."
msgstr "Benutzer, Server, Infrastruktur und Entwicklung."

# translated-by: libretranslate
msgctxt "role:dsk-git:description"
msgid "Version-control client for personal workstations, preconfigured with identity, signing, and merge defaults"
msgstr "Versionskontrollclient für persönliche Workstations, vorkonfiguriert mit Identität, Signatur und Merge-Standards"

# translated-by: libretranslate
msgctxt "role:sys-svc-cdn:description"
msgid "Versioned asset-tree layout for CDN delivery with shared, vendor, and per-role release directories"
msgstr "Versioniertes Asset-Tree-Layout für CDN-Lieferung mit freigegebenen, Vendor- und Pro-Role-Release-Verzeichnissen"

# translated-by: claude
msgctxt "menu:Meetings:description"
msgid "Video conferences and live events."
msgstr "Videokonferenzen und Live-Veranstaltungen."

# translated-by: claude
msgctxt "rbac:web-app-penpot:viewer:description"
msgid "Views and comments on the files of the shared platform team without editing them"
msgstr "Sieht und kommentiert die Dateien des gemeinsamen Plattform-Teams, ohne sie zu bearbeiten"

# translated-by: libretranslate
msgctxt "role:dsk-code:description"
msgid "Visual Studio Code workstation editor in a selectable flavor, carrying the extensions of the agents the host deploys"
msgstr "Visual Studio Code Workstation Editor in einem wählbaren Geschmack, der die Erweiterungen der Agenten trägt, die der Host bereitstellt"

# translated-by: libretranslate
msgctxt "category:web:title"
msgid "Web Infrastructure"
msgstr "Webinfrastruktur"

# translated-by: libretranslate
msgctxt "role:web-app-semaphore:description"
msgid "Web UI and API for running Ansible, Terraform/OpenTofu, and shell automation on a schedule or on demand"
msgstr "Web-Benutzeroberfläche und API zum Ausführen von Ansible, Terraform/OpenTofu und Shell-Automatisierung nach einem Zeitplan oder bei Bedarf"

# translated-by: libretranslate
msgctxt "role:web-app-lam:description"
msgid "Web interface for administering LDAP directories: managing users, groups, and other directory objects"
msgstr "Web-Schnittstelle zur Verwaltung von LDAP-Verzeichnissen: Verwaltung von Benutzern, Gruppen und anderen Verzeichnisobjekten"

# translated-by: libretranslate
msgctxt "role:web-app-fusiondirectory:description"
msgid "Web-based LDAP administration interface for managing users, groups, and directory objects"
msgstr "Webbasierte LDAP-Verwaltungsschnittstelle zur Verwaltung von Benutzern, Gruppen und Verzeichnisobjekten"

# translated-by: libretranslate
msgctxt "role:web-app-phpldapadmin:description"
msgid "Web-based LDAP client for browsing, searching, and administering directory entries in LDAP servers"
msgstr "Webbasierter LDAP-Client zum Durchsuchen, Suchen und Verwalten von Verzeichniseinträgen in LDAP-Servern"

# translated-by: libretranslate
msgctxt "role:web-app-pgadmin:description"
msgid "Web-based administration and development platform for managing multiple PostgreSQL servers, with optional OAuth2 login"
msgstr "Webbasierte Verwaltungs- und Entwicklungsplattform zur Verwaltung mehrerer PostgreSQL-Server mit optionaler OAuth2-Anmeldung"

# translated-by: libretranslate
msgctxt "role:web-app-phpmyadmin:description"
msgid "Web-based administration tool for MySQL and MariaDB with schema management, querying, and import/export"
msgstr "Webbasiertes Administrationstool für MySQL und MariaDB mit Schemaverwaltung, Abfrage und Import/Export"

# translated-by: libretranslate
msgctxt "category:web.opt:title"
msgid "Webserver Optimation"
msgstr "Webserveroptimierung"

# translated-by: claude
msgctxt "menu:Knowledge & Content:description"
msgid "Websites, documentation and learning."
msgstr "Websites, Dokumentation und Lernen."

# translated-by: libretranslate
msgctxt "role:dsk-docker:description"
msgid "Workstation setup for Docker and Docker Compose with the local user in the docker group for rootless development use"
msgstr "Workstation Setup für Docker und Docker Compose mit dem lokalen Benutzer in der Docker-Gruppe für die wurzellose Entwicklung"

# translated-by: libretranslate
msgctxt "role:dev-arduino:description"
msgid "Workstation toolchain and serial-port permissions for Arduino board development on Linux"
msgstr "Workstation-Toolchain und Serial-Port-Berechtigungen für die Arduino-Board-Entwicklung unter Linux"

# translated-by: libretranslate
msgctxt "role:pkgmgr-install:description"
msgid "Wrapper role for idempotent package installation and updates through the pkgmgr universal package manager"
msgstr "Wrapper Rolle für idempotente Paketinstallation und Updates über den pkgmgr Universal Package Manager"

# translated-by: claude
msgctxt "access_request:review_same_approver"
msgid "You already confirmed this request. A different approver must confirm it."
msgstr "Sie haben diese Anfrage bereits bestätigt. Eine andere genehmigende Person muss sie bestätigen."

msgctxt "logout:may_close"
msgid "You can close this page now."
msgstr "Sie können diese Seite jetzt schließen."

# translated-by: claude
msgctxt "access_request:forbidden_title"
msgid "You do not have access to this application"
msgstr "Sie haben keinen Zugriff auf diese Anwendung"

# translated-by: claude
msgctxt "access_request:review_not_allowed"
msgid "You may not approve roles of this application."
msgstr "Sie dürfen Rollen dieser Anwendung nicht genehmigen."

# translated-by: claude
#, python-brace-format
msgctxt "access_request:mail_granted_subject"
msgid "Your access request for {application} was granted"
msgstr "Ihre Zugriffsanfrage für {application} wurde genehmigt"

# translated-by: claude
#, python-brace-format
msgctxt "access_request:mail_partial_subject"
msgid "Your access request for {application} was partly granted"
msgstr "Ihre Zugriffsanfrage für {application} wurde teilweise genehmigt"

# translated-by: claude
#, python-brace-format
msgctxt "access_request:mail_rejected_subject"
msgid "Your access request for {application} was rejected"
msgstr "Ihre Zugriffsanfrage für {application} wurde abgelehnt"

# translated-by: claude
msgctxt "access_request:forbidden_text"
msgid "Your account holds none of the roles this application requires."
msgstr "Ihr Konto besitzt keine der Rollen, die diese Anwendung erfordert."

# translated-by: claude
msgctxt "access_request:review_waiting_second"
msgid "Your approval is recorded. A second approver must confirm before the roles take effect."
msgstr "Ihre Genehmigung ist erfasst. Eine zweite genehmigende Person muss bestätigen, bevor die Rollen wirksam werden."

# translated-by: claude
msgctxt "access_request:form_updated"
msgid "Your open request for this application was updated."
msgstr "Ihre offene Anfrage für diese Anwendung wurde aktualisiert."

# translated-by: claude
msgctxt "access_request:form_created"
msgid "Your request was sent to the approvers."
msgstr "Ihre Anfrage wurde an die Genehmigenden gesendet."

# translated-by: claude
msgctxt "access_request:signin_text"
msgid "Your session expired. Sign in again to continue."
msgstr "Ihre Sitzung ist abgelaufen. Melden Sie sich erneut an, um fortzufahren."

# translated-by: claude
msgctxt "rbac:web-app-zammad:administrator:description"
msgid "Zammad administrator (full admin panel access)"
msgstr "Zammad-Administrator (voller Zugriff auf das Admin-Panel)"

# translated-by: claude
msgctxt "rbac:web-app-zammad:agent:description"
msgid "Zammad agent (helpdesk staff, can answer tickets)"
msgstr "Zammad-Agent (Helpdesk-Personal, kann Tickets beantworten)"

