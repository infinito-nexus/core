# translated-by: claude
msgctxt "rbac:web-app-mediawiki:interface-admin:description"
msgid "Can edit the sitewide CSS and JavaScript pages of the wiki"
msgstr "Kann die seitenweiten CSS- und JavaScript-Seiten des Wikis bearbeiten"

# translated-by: claude
msgctxt "rbac:web-app-mediawiki:bureaucrat:description"
msgid "Can grant and revoke the wiki's user groups and rename accounts"
msgstr "Kann die Benutzergruppen des Wikis vergeben und entziehen sowie Konten umbenennen"

# translated-by: claude
msgctxt "rbac:web-app-mastodon:moderator:description"
msgid "Can handle reports, limit and suspend accounts and moderate posts without access to the server settings"
msgstr "Kann Meldungen bearbeiten, Konten einschränken und sperren sowie Beiträge moderieren, ohne Zugriff auf die Servereinstellungen"

# translated-by: claude
msgctxt "rbac:web-app-matomo:admin:description"
msgid "Can manage the settings and the access of other users on every tracked website"
msgstr "Kann die Einstellungen und den Zugriff anderer Benutzer auf jeder erfassten Website verwalten"

# translated-by: claude
msgctxt "rbac:web-app-discourse:moderator:description"
msgid "Can moderate topics, posts and users without access to the site settings"
msgstr "Kann Themen, Beiträge und Benutzer moderieren, ohne Zugriff auf die Seiteneinstellungen"

# translated-by: claude
msgctxt "rbac:web-app-semaphore:operator:description"
msgid "Can pause and resume the deployed applications through the stop and start templates of the Infinito.Nexus project"
msgstr "Kann die bereitgestellten Anwendungen über die Stopp- und Start-Vorlagen des Infinito.Nexus-Projekts pausieren und fortsetzen"

# translated-by: claude
msgctxt "rbac:web-app-wordpress:editor:description"
msgid "Can publish and manage all posts, including those by other users"
msgstr "Kann alle Beiträge veröffentlichen und verwalten, auch die anderer Benutzer"

# translated-by: claude
msgctxt "rbac:web-app-jenkins:viewer:description"
msgid "Can read jobs, builds and their logs"
msgstr "Kann Jobs, Builds und deren Logs lesen"

# translated-by: claude
msgctxt "rbac:web-app-wordpress:subscriber:description"
msgid "Can read posts and leave comments but cannot write or manage content"
msgstr "Kann Beiträge lesen und kommentieren, aber keine Inhalte schreiben oder verwalten"

# translated-by: claude
msgctxt "rbac:web-app-matomo:write:description"
msgid "Can read the reports and manage goals, segments and annotations of every tracked website"
msgstr "Kann die Berichte lesen sowie Ziele, Segmente und Anmerkungen jeder erfassten Website verwalten"

# translated-by: claude
msgctxt "rbac:web-app-matomo:view:description"
msgid "Can read the reports of every tracked website"
msgstr "Kann die Berichte jeder erfassten Website lesen"

# translated-by: claude
msgctxt "rbac:web-app-baserow:user:description"
msgid "Can sign in to Baserow and work in their own and shared workspaces, without instance administration"
msgstr "Kann sich bei Baserow anmelden und in eigenen und geteilten Workspaces arbeiten, ohne Instanzadministration"

# translated-by: claude
msgctxt "rbac:web-app-openproject:user:description"
msgid "Can sign in to OpenProject and work in the projects they are a member of"
msgstr "Kann sich bei OpenProject anmelden und in den Projekten arbeiten, in denen er Mitglied ist"

# translated-by: claude
msgctxt "rbac:web-app-semaphore:user:description"
msgid "Can sign in to Semaphore through LDAP and work in the projects they are a member of"
msgstr "Kann sich über LDAP bei Semaphore anmelden und in den Projekten arbeiten, in denen er Mitglied ist"

# translated-by: claude
msgctxt "rbac:web-app-snipe-it:user:description"
msgid "Can sign in to Snipe-IT and view assets, licenses, accessories, consumables and components without administrative rights"
msgstr "Kann sich bei Snipe-IT anmelden und Assets, Lizenzen, Zubehör, Verbrauchsmaterial und Komponenten ohne Administratorrechte ansehen"

# translated-by: claude
msgctxt "rbac:web-app-taiga:user:description"
msgid "Can sign in to Taiga and work in the projects that invite them, without instance administration"
msgstr "Kann sich bei Taiga anmelden und in den Projekten arbeiten, die ihn einladen, ohne Instanzadministration"

# translated-by: claude
msgctxt "rbac:web-app-homeassistant:user:description"
msgid "Can sign in to the hub through the directory and use it without administrator rights"
msgstr "Kann sich über das Verzeichnis beim Hub anmelden und ihn ohne Administratorrechte nutzen"

# translated-by: claude
msgctxt "rbac:web-app-wordpress:author:description"
msgid "Can write and manage own posts"
msgstr "Kann eigene Beiträge schreiben und verwalten"

# translated-by: claude
msgctxt "rbac:web-app-wordpress:contributor:description"
msgid "Can write and submit posts for review but cannot publish"
msgstr "Kann Beiträge schreiben und zur Prüfung einreichen, aber nicht veröffentlichen"

# translated-by: libretranslate
msgctxt "role:svc-db-typesense:description"
msgid "Central Dockerized search engine shared by multiple apps with per-consumer scoped API keys"
msgstr "Zentrale dockerisierte Suchmaschine, die von mehreren Apps mit API-Schlüsseln pro Verbraucher geteilt wird"

# translated-by: libretranslate
msgctxt "role:svc-ai-tika:description"
msgid "Central document extraction engine that turns uploaded files into text for retrieval-augmented chat"
msgstr "Zentrale Dokumentenextraktionsmaschine, die hochgeladene Dateien in Text für den Retrieval-Augmented-Chat verwandelt"

# translated-by: libretranslate
msgctxt "menu:Help:description"
msgid "Central help resources, including documentation, support tools, and guidance."
msgstr "Zentrale Hilferessourcen, einschließlich Dokumentation, Support-Tools und Anleitung."

# translated-by: libretranslate
msgctxt "role:svc-db-memcached:description"
msgid "Central in-memory caching engine with per-consumer key-prefix isolation, usable centrally or as an embedded sidecar"
