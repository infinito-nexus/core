# translated-by: claude
msgctxt "rbac:web-app-joomla:author:description"
msgid "Author in Joomla, maps onto the built-in `Author` user group (id 3) and may create and edit own articles in the frontend."
msgstr "Autor in Joomla, entspricht der eingebauten Benutzergruppe `Author` (id 3) und darf eigene Artikel im Frontend erstellen und bearbeiten."

# translated-by: claude
msgctxt "role:svc-dns-knot:description"
msgid "Authoritative Knot DNS for the Semaphore workspace subzone, a DNSSEC-signing primary with TSIG-fed secondaries"
msgstr "Autoritatives Knot DNS für die Workspace-Subzone von Semaphore, ein DNSSEC-signierender Primärserver mit über TSIG versorgten Sekundärservern"

# translated-by: libretranslate
msgctxt "role:sys-ctl-rpr-container-soft:description"
