# translated-by: claude
msgctxt "rbac:web-app-bookwyrm:moderator:description"
msgid "BookWyrm moderator (moderates users, posts, federation and invites)"
msgstr "BookWyrm-Moderator (moderiert Benutzer, Beiträge, Föderation und Einladungen)"

# translated-by: claude
msgctxt "rbac:web-app-bookwyrm:owner:description"
