msgstr "INFINITO_DOMAIN: ``<stack>.<INFINITO_DNS_DOMAIN>``, wobei der Stapel ``main`` für die primäre Kasse und den normalisierten Zweig für einen verknüpften Git-Worktree. Überschreibt immer den Anrufer env, der im Stapelcontainer der vorherige ist ``.env``; GitHub/act-Läufe halten den statischen Standard und custom.env Pins gewinnen."

# translated-by: libretranslate
msgid "INFINITO_FORK_ACCOUNT: GitHub account holding the operator's fork, defaulting to the local OS username."
msgstr "INFINITO_FORK_ACCOUNT: GitHub-Konto mit der Gabel des Betreibers, standardmäßig auf den lokalen OS-Benutzernamen."

# translated-by: libretranslate
msgid "INFINITO_FORK_REPOSITORY_URL: GitHub URL of the operator's fork, composed from INFINITO_FORK_ACCOUNT and INFINITO_FORK_REPOSITORY_NAME."
msgstr "INFINITO_FORK_REPOSITORY_URL: GitHub URL des Operators, zusammengesetzt aus INFINITO_FORK_ACCOUNT und INFINITO_FORK_REPOSITORY_NAME."

# translated-by: libretranslate
msgid "INFINITO_GIT_AUTHOR_NAME / INFINITO_GIT_AUTHOR_EMAIL: the identity this checkout commits under. The test container mounts the checkout but not the contributor's git configuration, so the suite cannot ask git who is about to commit; the ``.env`` carries the answer across."
msgstr "INFINITO_GIT_AUTHOR_NAME / INFINITO_GIT_AUTHOR_EMAIL: die Identität, die dieser Checkout verpflichtet. Der Testcontainer montiert den Checkout, aber nicht die Git-Konfiguration des Mitwirkenden, so dass die Suite Git nicht fragen kann, wer im Begriff ist zu begehen; ``.env`` trägt die Antwort über."

# translated-by: libretranslate
msgid "INFINITO_GPU_COUNT: GPUs the compose services reserve, 'all' when the docker daemon registers an NVIDIA runtime, else 0."
msgstr "INFINITO_GPU_COUNT: GPUs die Compose Services Reserve, 'all' wenn der Docker-Daemon eine NVIDIA-Laufzeit registriert, andernfalls 0."

# translated-by: libretranslate
msgid "INFINITO_I18N_BATCH_SIZE / INFINITO_I18N_LANES: client settings `make i18n-tune` measured on this host, falling back to the shipped defaults."
msgstr "INFINITO_I18N_BATCH_SIZE / INFINITO_I18N_LANES: Kundeneinstellungen `make i18n-tune` auf diesem Host gemessen und auf die versendeten Standardwerte zurückgegriffen."

# translated-by: libretranslate
msgid "INFINITO_I18N_LIBRETRANSLATE_PORT: loopback port the i18n runner forwards to its LibreTranslate, read from roles/web-svc-libretranslate/meta/services.yml."
msgstr "INFINITO_I18N_LIBRETRANSLATE_PORT: Loopback-Port i18n Runner Forwards zu seinem LibreTranslate, gelesen von roles/web-svc-libretranslate/meta/services.yml."

# translated-by: libretranslate
msgid "INFINITO_IMAGE: fully-qualified GHCR image reference assembled from owner, repo, distro and tag (GHA-only)."
msgstr "INFINITO_IMAGE: Vollqualifizierte GHCR-Bildreferenz aus Eigentümer, Repo, Distribution und Tag (nur GHA)."

# translated-by: libretranslate
