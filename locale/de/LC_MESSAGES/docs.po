msgid "``(\"SKIPPED\", reason)`` when ping is unavailable or lacks CAP_NET_RAW"
msgstr "``(\"SKIPPED\", reason)`` Wenn Ping nicht verfügbar ist oder fehlt CAP_NET_RAW"

# translated-by: libretranslate
msgid "``('', '')`` when the role has no instructions to replay or this sweep deploys no variant that could carry them."
msgstr "``('', '')`` Wenn die rolle keine anweisungen zur wiedergabe hat oder dieser swick keine variante einsetzt, die sie tragen könnte."

# translated-by: libretranslate
msgid "``(1-based line number, text)`` for every line inside a ``## Credits`` section, ending at the next heading of any level."
msgstr "``(1-based line number, text)`` Für jede Linie innerhalb eines ``## Credits`` Abschnitt, der mit der nächsten Überschrift einer beliebigen Ebene endet."

# translated-by: libretranslate
msgid "``(None, None)`` when every probe size is dropped"
msgstr "``(None, None)`` Wenn jede Sondengröße fallen gelassen wird"

