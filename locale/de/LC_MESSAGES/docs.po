# translated-by: libretranslate
msgid "**Fails gracefully** with an optional debug message if the Git repository is unreachable."
msgstr "**Fails gracefully** mit einer optionalen Debug-Nachricht, wenn das Git-Repository nicht erreichbar ist."

# translated-by: libretranslate
msgid "**Failure Notification**"
msgstr "**Ausfallmeldung**"

# translated-by: libretranslate
