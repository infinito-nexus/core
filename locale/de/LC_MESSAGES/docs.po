msgstr "INFINITO_IMAGE_REPOSITORY: Lowercased Repository Name aufgelöst von scripts/meta/resolve/repository/name.sh (nur GHA)."

# translated-by: libretranslate
msgid "INFINITO_IS_WSL2: true when /proc/version identifies the host as WSL2."
msgstr "INFINITO_IS_WSL2: wahr, wenn /proc/version den Host als WSL2 identifiziert."

# translated-by: libretranslate
msgid "INFINITO_OUTER_NETWORK_MTU: MTU of the compose stack's bridge network."
msgstr "INFINITO_OUTER_NETWORK_MTU: MTU des Brückennetzwerks des Compose-Stacks."

# translated-by: libretranslate
