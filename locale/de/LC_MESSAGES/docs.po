msgid "The ONLY clean-skip mechanism is an EXPLICIT role-declared opt-out via env flag rendered in `templates/playwright.env.j2`:"
msgstr "Der EINZIGE Clean-Skip-Mechanismus ist ein EXPLICIT-Rolle-deklariertes Opt-out über ein in `templates/playwright.env.j2`:"

# translated-by: libretranslate
