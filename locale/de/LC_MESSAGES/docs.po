# translated-by: libretranslate
msgid "**Local `act` runs**: append `--env INFINITO_PLAYWRIGHT_KEEP=true` to the `act` command."
msgstr "**Lokal `act` Runs**: Anhang `--env INFINITO_PLAYWRIGHT_KEEP=true` zum `act` Kommando."

# translated-by: libretranslate
msgid "**Local caching:** Models are cached locally to avoid repeated downloads."
msgstr "**Lokales Caching:** Modelle werden lokal zwischengespeichert, um wiederholte Downloads zu vermeiden."

# translated-by: libretranslate
