# translated-by: libretranslate
msgid "`DOCKER_IN_CONTAINER` (`systemd-detect-virt`) toggles DinD behavior."
msgstr "`DOCKER_IN_CONTAINER` (`systemd-detect-virt`) maina Dind uzvedību."

# translated-by: libretranslate
msgid "`DOMAIN_PRIMARY` defined once; `LDAP_DN_BASE`, CA identity, contact email derive from it"
msgstr "`DOMAIN_PRIMARY` vienreiz definēti; `LDAP_DN_BASE`, CA identitāte, kontaktinformācija izriet no tā"

