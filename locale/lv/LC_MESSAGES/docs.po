msgstr "**Direktorijas pārvaldība:** Izveido nodrošinātu `/etc/certbot` mape ar atbilstošām atļaujām."

# translated-by: libretranslate
msgid "**Credential Directory Management:** Creates a secured ``/etc/certbot`` directory with proper permissions."
msgstr "**Direktorijas pārvaldība:** Izveido nodrošinātu ``/etc/certbot`` mape ar atbilstošām atļaujām."

# translated-by: libretranslate
