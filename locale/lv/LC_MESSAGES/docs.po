msgstr "`AIEditingAssistant` paplašinājums"

# translated-by: libretranslate
msgid "`Apache Tika <https://tika.apache.org/>`__ turns an uploaded file into plain text and metadata. It reads PDF, the Office formats, mail, archives and images."
msgstr "`Apache Tika <https://tika.apache.org/>`__ pārvērš augšupielādētu failu vienkāršā tekstā un metadatos. Tajā lasāms PDF, Office formāti, pasts, arhīvi un attēli."

# translated-by: libretranslate
msgid "`ApplicationsLookup` reads `services.email` for the target `application_id`. Unknown applications MUST yield an empty dict."
msgstr "`ApplicationsLookup` lasītājs `services.email` mērķim `application_id`. Nezināmiem pieteikumiem jābūt ar tukšu diktātu."

# translated-by: libretranslate
msgid "`Authorization: Bearer <token>`, a Moodle web-service token"
msgstr "`Authorization: Bearer <token>`, a Moodle tīmekļa servisa marķierierīce"

