# translated-by: libretranslate
msgid "**Description:** Docker Compose stack for containerized relational databases with backup, user, and permission management"
msgstr "**Apraksts:** Docker Komponējiet steku konteinerizētām relāciju datubāzēm ar dublējumu, lietotāju un atļauju pārvaldību"

# translated-by: libretranslate
msgid "**Description:** Document server backend for real-time in-browser editing of documents, spreadsheets, and presentations"
msgstr "**Apraksts:** Dokumentu servera aizmugure reāllaika pārlūka dokumentu, izklājlapu un prezentāciju rediģēšanai"

# translated-by: libretranslate
msgid "**Description:** Driver integration for dynamic keyboard color and RGB lighting control on MSI laptops"
msgstr "**Apraksts:** Draivera integrācija dinamiskai tastatūras krāsu un RGB apgaismojuma kontrolei uz MSI klēpjdatoriem"

# translated-by: libretranslate
msgid "**Description:** Embodied robot platform for Hermes on a dedicated, network-segmented single-tenant device"
msgstr "**Apraksts:** Iebūvēta robotu platforma Hermes uz īpašas, tīkla segmenta viena tenanta ierīces"

# translated-by: libretranslate
msgid "**Description:** End-of-play convergence of every deployed MCP client against the complete provider set"
msgstr "**Apraksts:** Katra izvietotā MCP klienta pašreizējā konverģence pret visu pakalpojumu sniedzēju komplektu"

# translated-by: libretranslate
msgid "**Description:** Engine-agnostic wiring layer for shared cache, queue, search, and vector engines with per-consumer provisioning"
msgstr "**Apraksts:** Dzinēja-agnostikas vadu slānis kopīgai kešatmiņai, rindām, meklēšanai un vektoru dzinējiem, nodrošinot katram patērētājam"

# translated-by: libretranslate
msgid "**Description:** Enterprise wiki and team collaboration platform for creating, organizing, and sharing content"
msgstr "**Apraksts:** Biznesa viki un komandas sadarbības platforma satura radīšanai, organizēšanai un kopīgošanai"

# translated-by: libretranslate
msgid "**Description:** Extensible Vim-based command-line text editor for terminal-driven code and configuration editing"
msgstr "**Apraksts:** Uz Vim bāzēts paplašināms komandrindas teksta redaktors ar termināli darbināmu kodu un konfigurācijas rediģēšanai"

# translated-by: libretranslate
msgid "**Description:** Federated chess server for playing and following rule-validated games over ActivityPub across the Fediverse"
msgstr "**Apraksts:** Federēts šaha serveris, lai spēlētu un pēc noteikumiem apstiprinātas spēles virs ActivityPub visā Fediverse"

# translated-by: libretranslate
msgid "**Description:** Federated, end-to-end-encrypted messaging platform with a web client and protocol bridges to external chat networks"
msgstr "**Apraksts:** Transponēta ziņojumapmaiņas platforma “no gala līdz galam” ar tīmekļa klientu un protokola tiltiem uz ārējiem tērzēšanas tīkliem"

# translated-by: libretranslate
msgid "**Description:** Federated, self-hosted platform for organizing events and building communities and groups"
msgstr "**Apraksts:** Federēta, pašorganizēta platforma pasākumu organizēšanai un kopienu un grupu veidošanai"

# translated-by: libretranslate
msgid "**Description:** Federation bridge connecting ActivityPub (Fediverse), the AT Protocol (Bluesky), and the IndieWeb"
msgstr "**Apraksts:** Federācijas tilts, kas savieno ActivityPub (Atšķirīgs), AT protokols (Bluesky), un IndieWeb"

# translated-by: libretranslate
msgid "**Description:** Free and open-source TURN/STUN relay server for NAT traversal in WebRTC and real-time communication"
msgstr "**Apraksts:** Bezmaksas un atvērtā pirmkoda TURN/STUN releja serveris NAT traversālai izmantošanai WebRTC un reālā laika sakariem"

# translated-by: libretranslate
msgid "**Description:** Free and open-source desktop application for live video streaming and screen recording"
msgstr "**Apraksts:** Bezmaksas un atvērtā pirmkoda darbvirsmas lietojumprogramma video tiešraidei un ekrāna ierakstīšanai"

# translated-by: libretranslate
msgid "**Description:** Free and open-source desktop application for personal and small-business accounting and financial management"
msgstr "**Apraksts:** Bezmaksas un atvērtā pirmkoda lietojumprogramma personīgajai un mazo uzņēmumu grāmatvedībai un finanšu pārvaldībai"

# translated-by: libretranslate
msgid "**Description:** Front-end JS injection notifying parent windows of iframe location changes and forcing external links into new tabs"
msgstr "**Apraksts:** Priekšējā JS injekcija, paziņojot vecāka logus iframe atrašanās vietas izmaiņas un piespiežot ārējās saites uz jaunām cilnēm"

# translated-by: libretranslate
msgid "**Description:** Front-layer base for web apps: HTTPS foundation, optional Cloudflare setup, and reverse-proxy handler wiring"
msgstr "**Apraksts:** Priekšējā slāņa bāze tīmekļa lietotnēm: HTTPS fonds, izvēles Cloudflare iestatīšana un reversā-proxy apstrādātāja instalācija"

