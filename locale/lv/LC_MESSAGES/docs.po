# translated-by: libretranslate
msgid "**Simplified Setup:** Minimizes manual installation steps for environments where fakeroot is required."
msgstr "**Vienkāršota iestatīšana:** Samazina manuālās uzstādīšanas soļus vidēm, kurās ir nepieciešama viltus root."

# translated-by: libretranslate
msgid "**Simplified Variable Management:** Preconfigured templates minimize manual intervention."
msgstr "**Vienkāršota mainīgo lielumu pārvaldība:** Iepriekš konfigurētas sagataves samazina manuālu iejaukšanos."

# translated-by: libretranslate
msgid "**Single Container:** No database server, no cache, no worker, no object store. SQLite in one volume."
msgstr "**Viens konteiners:** Nav datu bāzes servera, nav kešatmiņas, nav strādnieka, nav objektu veikala. SQLite vienā sējumā."

# translated-by: libretranslate
msgid "**Single Domain and Wildcard Support:** Handles both individual domains and wildcard domains (`*.example.com`)."
msgstr "**Viena domēna un savvaļas karšu atbalsts:** Sniedz gan atsevišķus domēnus, gan wildcard domēnus (`*.example.com`)."

# translated-by: libretranslate
