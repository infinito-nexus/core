# translated-by: libretranslate
msgid "**\"Waits for feedback\"** = the agent polls the PR through the git-forge MCP server (025); the human review gate stays human."
msgstr "**\"Gaida atsauksmes\"** = aģents aptaujā PR caur git-forge MCP serveri (025); cilvēka pārskata vārti paliek cilvēku."

