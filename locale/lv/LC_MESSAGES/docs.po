msgstr "Kopienas izdevuma licencēšanas bloķētājs. Uzņēmuma variants piegādā izdevumu un licenci skaidri un izmanto ierobežotu OAuth pieteikumu."

# translated-by: libretranslate
msgid "The Context Agent app exposes an MCP endpoint below the Nextcloud AppAPI proxy and uses app-password authentication."
msgstr "Konteksta aģenta lietotne atklāj MCP vērtību zem Nextcloud AppAPi starpniekserveris un izmanto lietotnes paroli autentifikāciju."

