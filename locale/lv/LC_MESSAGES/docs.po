# translated-by: libretranslate
msgid "When mutating tools cannot be disabled, the integration MUST require explicit operator opt-in before `mcp.enabled=true`."
msgstr "Ja nevar atslēgt mutatis mutandis lietojamos rīkus, integrācijas procesā pirms `mcp.enabled=true`."

