msgid "Turn a bare list or a spec mapping into a :class:`PackageSpec`."
msgstr "Pārvērst kailu sarakstu vai spec kartēšanu uz :class:`PackageSpec`."

# translated-by: libretranslate
msgid "Turn a run's deploy jobs back into selection tokens."
msgstr "Pārvērst palaist ir izvietot darbavietas atpakaļ atlases žetonos."

