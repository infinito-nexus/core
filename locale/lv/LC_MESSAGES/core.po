# libretranslate
msgctxt "role:svc-db-qdrant:description"
msgid "Central vector database engine for storing and searching per-consumer embeddings shared across the stack"
msgstr "Centrālā vektoru datubāzes dzinējs, lai uzglabātu un meklētu katra patērētāja iegultos koplietojamajā stekā"

# libretranslate
msgctxt "role:sys-svc-rdbms:description"
