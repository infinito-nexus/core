# translated-by: libretranslate
msgid "**Backup Friendly:** Data isolated under ``{{ CONFLUENCE_HOME }}``."
msgstr "**Varmuuskopiointi:** Eristetyt tiedot ``{{ CONFLUENCE_HOME }}``."

