# libretranslate
msgid "**Backup Layout:** Consolidated all backups under /var/lib/infinito, parameterized the pull workflow, switched to dump-only backups, and disabled Redis backups across web applications."
msgstr "**Varmuuskopiointi:** Konsolidoitu kaikki varmuuskopioita alle /var/lib/infinito, parametrisoi vedon työnkulun, siirtyi dump-vain varmuuskopioita, ja disabled Redis varmuuskopioita web-sovelluksissa."

# libretranslate
msgid "**Backup Ready:** Persistent data under ``{{ JIRA_STORAGE_PATH }}``."
msgstr "**Varmuuskopiointi valmis:** Pysyvät tiedot ``{{ JIRA_STORAGE_PATH }}``."

# libretranslate
