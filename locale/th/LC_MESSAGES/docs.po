msgid "Return ``restored`` without the space runs the translator opened."
msgstr "กลับค่า ``restored`` ไม่มีพื้นที่ให้ล่ามเปิด."

# translated-by: libretranslate
msgid "Return ``round(base * factor)`` as an int."
msgstr "กลับค่า ``round(base * factor)`` เหมือนอินทร."

# translated-by: libretranslate
msgid "Return ``services.<service_key>.<config_key>`` for ``application_id``."
msgstr "กลับค่า ``services.<service_key>.<config_key>`` สําหรับ ``application_id``."

# translated-by: libretranslate
msgid "Return ``source`` in English and every language that translates any of it."
msgstr "กลับค่า ``source`` ในภาษาอังกฤษและทุกภาษาที่แปลได้."

# translated-by: libretranslate
msgid "Return ``text`` escaped for HTML with its protected spans tokenised."
msgstr "กลับค่า ``text`` หลบหนีสําหรับ HTML ด้วยเครื่องหมายเครื่องหมายป้องกัน."

# translated-by: libretranslate
msgid "Return ``text`` reduced to its letters and digits, lower case."
msgstr "กลับค่า ``text`` ลด เหลือ ตัว อักษร และ ตัว เลข."

# translated-by: libretranslate
msgid "Return ``text`` with every protected span removed."
msgstr "กลับค่า ``text`` กับทุกช่วงการป้องกัน เอาออกไป."

# translated-by: libretranslate
#, python-brace-format
msgid "Return ``{(consumer, provider): {bond, service_key, enabled}}``."
msgstr "กลับค่า ``{(consumer, provider): {bond, service_key, enabled}}``."

# translated-by: libretranslate
#, python-brace-format
msgid "Return ``{(role, variant index): {provider role, ...}}`` across every variant."
msgstr "กลับค่า ``{(role, variant index): {provider role, ...}}`` ในทุกๆเรื่อง."

