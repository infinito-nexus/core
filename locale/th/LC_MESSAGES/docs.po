msgid "Return a dict[semantic_name -> canonical entry]."
msgstr "คืนค่าเป็น disc[semantic_name -> รายการรายการ]."

# translated-by: libretranslate
msgid "Return a linked (private, public) VAPID keypair, cached per instance."
msgstr "คืนส่วนเชื่อมโยง (ส่วนตัว, สาธารณะ) แป้น APID, แคชต่อตัว."

