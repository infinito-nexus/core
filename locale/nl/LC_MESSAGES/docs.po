msgid "**Redis Caching:**   Improve application performance with built‑in Redis caching support."
msgstr "**Redis Caching:** Verbeteren van de prestaties van toepassingen met ingebouwde Redis Caching ondersteuning."

# translated-by: libretranslate
msgid "**Redis Integration:** Adds Redis support for caching and session handling."
msgstr "**Redis-integratie:** Voegt toe Redis ondersteuning voor caching en sessiebehandeling."

# translated-by: libretranslate
msgid "**Redis** session storage for oauth2-proxy"
