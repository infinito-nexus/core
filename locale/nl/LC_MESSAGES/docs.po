msgstr "De recensent moet de registratie-URL bevestigen. Als een wachtwoord wordt doorgegeven via `--password` ' `--password-stdin`, de recensent moet ook bevestigen dat er geen geloofwaardigheid in het transcript."

# translated-by: libretranslate
msgid "Reviewer MUST confirm the rule delta."
msgstr "De recensent moet de regel delta bevestigen."

# translated-by: libretranslate
msgid "Reviewer MUST confirm the source/destination owners and visibility."
msgstr "De beoordelaar MOET de bron/bestemmingseigenaren en zichtbaarheid bevestigen."

# translated-by: libretranslate
msgid "Reviewer MUST confirm the source/destination repos and that the local working tree tolerates the sync."
msgstr "De recensent moet de bron/bestemmingsrepo's bevestigen en de lokale werkboom de synchronisatie tolereert."

# translated-by: libretranslate
msgid "Reviewer MUST confirm the tag and asset payload before approval."
msgstr "De beoordelaar MOET vóór goedkeuring het label en de lading van de activa bevestigen."

# translated-by: libretranslate
msgid "Reviewer MUST confirm the target registry, repository, and tag before approval."
msgstr "De beoordelaar MOET het doelregister, de repository en het label bevestigen vóór goedkeuring."

# translated-by: libretranslate
msgid "Reviewer MUST confirm the team and intended change."
msgstr "De beoordelaar MOET het team en de voorgenomen wijziging bevestigen."

# translated-by: libretranslate
msgid "Reviewer MUST confirm the workflow ref and inputs payload."
msgstr "De recensent moet de workflow ref en input payload bevestigen."

# translated-by: libretranslate
msgid "Reviewer MUST confirm the working tree is clean (or stashed) before approving."
msgstr "De beoordelaar moet bevestigen dat de werkboom schoon is (of opgeslagen) vóór goedkeuring."

# translated-by: libretranslate
