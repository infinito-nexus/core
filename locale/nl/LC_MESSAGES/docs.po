msgstr "Deze rol wordt uitgebreid sys-stk-backend door een HTTP reverse proxy toe te voegen via sys-stk-front-proxy."

# translated-by: libretranslate
msgid "This role extracts the local pyproject.toml version and writes it as an environment variable in /etc/environment on the target host."
msgstr "Deze rol haalt de lokale pyproject.toml versie en schrijft het als een omgevingsvariabele in /etc/environment op de doelhost."

