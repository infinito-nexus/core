msgid "Inside the local lane nothing is parallel. `iteration/compose.md` requires deploys to be serial, and a second deploy or a `make test` started next to a running one is the SIGKILL that costs the whole round."
msgstr "Binnen de lokale rijstrook is niets parallel. `iteration/compose.md` vereist inzet moet seriële, en een tweede inzet of een `make test` gestart naast een running one is de SIGKILL die de hele ronde kost."

# translated-by: libretranslate
msgid "Inspect LDAP Entries 🩺"
msgstr "LDAP-vermeldingen inspecteren 🩺"

# translated-by: libretranslate
msgid "Inspect Live State 🔍"
msgstr "Live-staat inspecteren 🔍"

# translated-by: libretranslate
msgid "Inspect The Keycloak ↔ LDAP Federation 🩺"
msgstr "Inspecteer de Keycloak ↔ LDAP Federatie 🩺"

# translated-by: libretranslate
