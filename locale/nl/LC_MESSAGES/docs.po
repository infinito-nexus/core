# translated-by: libretranslate
msgid "**Prefers Python 3.11+:** Installs Python 3.11+ where available and makes it the default via `/usr/local/bin/python3` and `/usr/local/bin/pip3`."
msgstr "**Prefereert Python 3.11+:** Installeert Python 3.11+ indien beschikbaar en maakt het standaard via `/usr/local/bin/python3` en `/usr/local/bin/pip3`."

# translated-by: libretranslate
