msgstr "Evaluatievereisten 🔍"

# translated-by: libretranslate
msgid "Review the process at regular intervals and change it when it is not working."
msgstr "Bekijk het proces regelmatig en verander het wanneer het niet werkt."

# translated-by: libretranslate
msgid "Reviewer MUST confirm both source and destination repos."
msgstr "De beoordelaar MOET zowel bron- als bestemmingsrepo's bevestigen."

# translated-by: libretranslate
msgid "Reviewer MUST confirm intent for every invocation; in particular `gh auth token` MUST be declined unless the operator deliberately wants the token in the transcript."
msgstr "De beoordelaar MOET de intentie voor elke aanroeping bevestigen, met name `gh auth token` MOETEN worden geweigerd, tenzij de operator bewust het token in het transcript wenst."

# translated-by: libretranslate
msgid "Reviewer MUST confirm the Dockerfile path, build context, and target tag."
msgstr "Reviewer MOET het pad van Dockerfile bevestigen, context en target-tag bouwen."

# translated-by: libretranslate
msgid "Reviewer MUST confirm the enterprise slug and intended scope."
msgstr "De beoordelaar MOET de ondernemingslak en het beoogde toepassingsgebied bevestigen."

# translated-by: libretranslate
msgid "Reviewer MUST confirm the environment and gating change."
msgstr "De beoordelaar MOET het milieu bevestigen en veranderingen invoegen."

# translated-by: libretranslate
msgid "Reviewer MUST confirm the key and value, especially for `editor`, `pager`, `git_protocol`."
msgstr "De beoordelaar MOET de sleutel en de waarde bevestigen, vooral voor `editor`, `pager`, `git_protocol`."

# translated-by: libretranslate
msgid "Reviewer MUST confirm the new default repository."
msgstr "De beoordelaar MOET de nieuwe standaard repository bevestigen."

# translated-by: libretranslate
msgid "Reviewer MUST confirm the org and the specific endpoint."
msgstr "De beoordelaar MOET de org en het specifieke eindpunt bevestigen."

