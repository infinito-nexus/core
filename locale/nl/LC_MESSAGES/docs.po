msgid "`true` or `false`; appends `--debug` when true"
msgstr "`true` of `false`; bijlagen `--debug` wanneer waar"

# translated-by: libretranslate
msgid "`true` stops an agent after `idle_minutes` without a request; `false` keeps it running"
msgstr "`true` stopt een agent na `idle_minutes` zonder verzoek; `false` laat het draaien"

