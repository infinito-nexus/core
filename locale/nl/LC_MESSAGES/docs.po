# translated-by: libretranslate
msgid "Inspect systemd service status: `systemctl is-active actions.runner.*`."
msgstr "Gesysteemde servicestatus inspecteren: `systemctl is-active actions.runner.*`."

# translated-by: libretranslate
msgid "Inspect the host MTUs:"
msgstr "Controleer de host MTU's:"

# translated-by: libretranslate
