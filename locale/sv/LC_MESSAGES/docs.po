msgid "`INFINITO_DNS_HOSTS` can still override the generated list explicitly"
msgstr "`INFINITO_DNS_HOSTS` kan fortfarande åsidosätta den genererade listan uttryckligen"

# translated-by: libretranslate
msgid "`INFINITO_VERSION_ENV_NAME` (default: `INFINITO_VERSION`)"
msgstr "`INFINITO_VERSION_ENV_NAME` (Default: `INFINITO_VERSION`)"

