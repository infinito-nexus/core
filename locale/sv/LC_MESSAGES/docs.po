msgid "An empty body is rejected."
msgstr "En tom kropp avvisas."

# translated-by: libretranslate
msgid "An empty mapping or list returns the empty string so the surrounding template stays valid YAML (no orphan ``depends_on:`` keyword)."
msgstr "En tom kartläggning eller lista returnerar den tomma strängen så den omgivande mallen förblir giltig YAML (Ingen föräldralös ``depends_on:`` nyckelord)."

