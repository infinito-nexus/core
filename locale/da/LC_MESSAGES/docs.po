msgid "Reviewer MUST confirm the Dockerfile path, build context, and target tag."
msgstr "Anmelder SKAL bekræfte Dockerfile sti, bygge sammenhæng, og målmærke."

# libretranslate
msgid "Reviewer MUST confirm the enterprise slug and intended scope."
msgstr "Anmelderen skal bekræfte virksomhedens kugle og det tilsigtede omfang."

# libretranslate
msgid "Reviewer MUST confirm the environment and gating change."
msgstr "Anmelderen skal bekræfte miljøet og gating forandring."

# libretranslate
msgid "Reviewer MUST confirm the key and value, especially for `editor`, `pager`, `git_protocol`."
msgstr "Anmelderen skal bekræfte nøglen og værdien, især for `editor`, `pager`, `git_protocol`."

