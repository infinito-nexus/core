msgid "__Increment fallback:__ if no internal gap fits, propose `max(end) + 1` to `max(end) + N` (clamped to the band's upper bound)."
msgstr "Hvis intet internt hul passer, foreslår du `max(end) + 1` til `max(end) + N` (fastspændt til bandets øvre grænse)."

# translated-by: libretranslate
msgid "__Increment fallback:__ if the band has no internal gaps, propose `max(used) + 1` (clamped to the band's upper bound)."
msgstr "Hvis båndet ikke har nogen interne huller, foreslår du `max(used) + 1` (fastspændt til bandets øvre grænse)."

