msgid "``\"same-line\"``: marker must be on the construct's line."
msgstr "``\"same-line\"``: Mærket skal være på konstruktionens linje."

# translated-by: libretranslate
msgid "``\"same-or-above\"`` (default): either of the above."
msgstr "``\"same-or-above\"`` (standard): en af ovennævnte."

