msgstr "De skal bruge: `dotenv_quote` for værdier, der kan indeholde mellemrum, særlige tegn eller shellfølsomt indhold."

# translated-by: libretranslate
msgid "You MUST use `files/javascript/javascript.js` when the script is static and does not depend on templating."
msgstr "De skal bruge: `files/javascript/javascript.js` når scriptet er statisk og ikke afhænger af templating."

