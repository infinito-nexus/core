msgstr "Du SKAL bruge role- local JavaScript kun til browser- side huller, der ikke kan løses rent gennem app konfiguration, server konfiguration, eller CSS alene."

# translated-by: libretranslate
msgid "You MUST use role-local JavaScript only for browser-side integration gaps that cannot be solved cleanly through app configuration or CSS alone."
msgstr "Du SKAL bruge role- local JavaScript kun til browser- side integration huller, der ikke kan løses rent gennem app konfiguration eller CSS alene."

# translated-by: libretranslate
msgid "You MUST use the AI forum at [s.infinito.nexus/aihub](https://s.infinito.nexus/aihub) as the companion guidance and support resource."
msgstr "Du SKAL bruge AI forum på [s.infinito.nexus/ aihub](https://s.infinito.nexus/aihub) som ledsagende vejledning og støtteressource."

# translated-by: libretranslate
msgid "You MUST use the app's own configuration before the role stylesheet. An in-house theming, theme or custom CSS option outranks injected CSS."
msgstr "Du SKAL bruge appens egen konfiguration før rollestylesheet. En in-house theming, tema eller brugerdefineret CSS option hartanks injiceret CSS."

