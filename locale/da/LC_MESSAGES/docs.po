msgstr "[x] Applikationslæseren læser `meta/addons/` for hver rolle og eksponering `applications.<role_id>.addons.<addon_id>` gennem `lookup('config', application_id, 'addons.<addon_id>')`."

# libretranslate
msgid "[x] The asset-storage volume is backed up via the existing backup role(s)."
msgstr "[x] Asset- storage volumen bakkes op via den eksisterende backup rolle(s)."

