msgstr "De skal bruge: `javascript.js.j2` når scriptet afhænger af rollevariabler eller lagerværdier, og brug `files/javascript/javascript.js` når scriptet er statisk."

# translated-by: libretranslate
msgid "You MUST use `templates/javascript.js.j2` when runtime values from the inventory or role variables must be rendered into the browser code."
msgstr "De skal bruge: `templates/javascript.js.j2` når runtime værdier fra opgørelsen eller rollevariabler skal omskrives til browserkoden."

# translated-by: libretranslate
msgid "You MUST use a Pull Request (PR)"
msgstr "Du skal bruge en Pull Request (PR)"

# translated-by: libretranslate
msgid "You MUST use comments to explain why something is unusual, not to restate what obvious code already does."
msgstr "Du SKAL bruge kommentarer til at forklare, hvorfor noget er usædvanligt, ikke at gentage, hvad indlysende kode allerede gør."

