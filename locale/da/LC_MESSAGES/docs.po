# libretranslate
msgid "Review the process at regular intervals and change it when it is not working."
msgstr "Gennemgå processen med regelmæssige mellemrum og ændre den, når den ikke fungerer."

# libretranslate
msgid "Reviewer MUST confirm both source and destination repos."
msgstr "Anmelderen skal bekræfte både kilde- og destinationsrepoer."

# libretranslate
msgid "Reviewer MUST confirm intent for every invocation; in particular `gh auth token` MUST be declined unless the operator deliberately wants the token in the transcript."
msgstr "Anmelderen skal bekræfte intentionen for hver optagelse; især `gh auth token` SKAL afvises, medmindre operatøren forsætligt ønsker token i udskriften."

