# libretranslate
msgid "__stderr__ prints per-suggestion capacity and a human-readable summary noting which umbrella block(s) were scanned."
msgstr "_ _ stderr _ _ prints per- suggestion kapacitet og en human- læsbar resumé bemærke, hvilken paraply blok(s) blev scannet."

