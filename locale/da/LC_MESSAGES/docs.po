msgstr "Anmelderen skal bekræfte målregistret, arkivet og mærket før godkendelsen."

# libretranslate
msgid "Reviewer MUST confirm the team and intended change."
msgstr "Anmelderen skal bekræfte holdet og den påtænkte ændring."

# libretranslate
msgid "Reviewer MUST confirm the workflow ref and inputs payload."
msgstr "Anmelderen skal bekræfte arbejdsstrømmen ref og indgange nyttelast."

# libretranslate
msgid "Reviewer MUST confirm the working tree is clean (or stashed) before approving."
msgstr "Anmelderen skal bekræfte, at træet er rent. (eller opbevaret) før godkendelse."

