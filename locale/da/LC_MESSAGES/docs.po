msgstr "Denne rolle installerer kaffe-ng og anbefaler det til autostart for at forhindre skærmsøvn på GNOME."

# translated-by: libretranslate
msgid "This role installs distro-specific equivalents of core build tooling so systems are ready for compiling software from source. After deploying this role, all common build dependencies are available on the system."
msgstr "Denne rolle installerer distrospecifikke ækvivalenter af kerne bygge værktøj, så systemer er klar til at kompilere software fra kilden. Efter at have anvendt denne rolle, alle fælles bygge afhængigheder er tilgængelige på systemet."

msgid "This role installs one PHP ini (`FILE_PHP_HARDENING_INI`), one interim PHP ini (`FILE_PHP_MEMORY_UNLIMITED_INI`) and one PHP-FPM pool drop-in (`FILE_PHP_FPM_HARDENING_CONF`). A PHP role opts in by declaring a `type: config` entry with that file as `source` and a file inside the scan dir of its image as `target`, e.g. `conf.d/zz-infinito-hardening.ini` or, for the pool, `php-fpm.d/zz-infinito-hardening.conf`. Only roles whose image still ships a PHP release without the CVE-2026-109618 fix also mount `FILE_PHP_MEMORY_UNLIMITED_INI`, as `conf.d/zz-infinito-memory-unlimited.ini`."
msgstr ""

msgid "This role installs one PHP ini (``FILE_PHP_HARDENING_INI``), one interim PHP ini (``FILE_PHP_MEMORY_UNLIMITED_INI``) and one PHP-FPM pool drop-in (``FILE_PHP_FPM_HARDENING_CONF``). A PHP role opts in by declaring a ``type: config`` entry with that file as ``source`` and a file inside the scan dir of its image as ``target``, e.g. ``conf.d/zz-infinito-hardening.ini`` or, for the pool, ``php-fpm.d/zz-infinito-hardening.conf``. Only roles whose image still ships a PHP release without the CVE-2026-109618 fix also mount ``FILE_PHP_MEMORY_UNLIMITED_INI``, as ``conf.d/zz-infinito-memory-unlimited.ini``."
msgstr ""

