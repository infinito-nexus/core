msgstr "Denne rolle omfatter sys-stk-backend ved at tilføje en HTTP reverse proxy via sys-stk-front-proxy."

# translated-by: libretranslate
msgid "This role extracts the local pyproject.toml version and writes it as an environment variable in /etc/environment on the target host."
msgstr "Denne rolle udtrækker den lokale pyproject.toml version og skriver det som en miljøvariabel i / etc / miljø på målet vært."

# translated-by: libretranslate
msgid "This role focuses on **safe automation and scheduling**, while the linked project contains the actual cleanup implementation."
msgstr "Denne rolle fokuserer på **sikker automatisering og planlægning**, mens det tilknyttede projekt indeholder den faktiske oprydning gennemførelse."

# translated-by: libretranslate
msgid "This role force-installs the following Chromium browser extensions via managed Enterprise Policies. They are declared in ``meta/addons/`` and rendered into the CRX install list."
msgstr "Denne rolle styrker: Chromium browser udvidelser via forvaltede virksomhedspolitikker. De er angivet i ``meta/addons/`` og omdannet til CRX installationslisten."

# translated-by: libretranslate
