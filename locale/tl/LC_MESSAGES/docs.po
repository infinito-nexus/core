msgstr "Ilakip ang imbentaryo ng punong - abala sa mga deklarasyon ng cache."

# translated-by: libretranslate
msgid "Apply every update in *updates* to disk. Returns the list of config files that were actually modified."
msgstr "Ikapit ang bawat update sa *mga update* hanggang disk. Ibalik ang listahan ng mga talaksang pagkaayos na aktuwal na binago."

# translated-by: libretranslate
msgid "Apply image mirror overrides to host_vars."
msgstr "Ang paglagay ng salamin sa larawan ay nangingibabaw sa host_vars."

# translated-by: libretranslate
msgid "Apply include/exclude/legacy role filters in the same order as before::"
msgstr "Pagkakapit include/exclude/legacy papel na mga filter na katulad ng dati:"

