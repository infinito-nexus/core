msgstr "Tunible sa pamamagitan ng mga kwarg: cpu_divisor, hard_cap, ci_cap, per_worker_gb, ram_fraction."

# translated-by: libretranslate
msgid "Turn a bare list or a spec mapping into a :class:`PackageSpec`."
msgstr "Gilingin ang bagong listahan o isang spec na pagsasamapa :class:`PackageSpec`."

