msgstr "Ibalik ang mga aplikasyon ng round na nilagyan ng iba't ibang kulay nito."

# translated-by: libretranslate
msgid "Return the round-trip document at ``path``, empty when it does not exist."
msgstr "Ibalik ang dokumentong round-trip sa ``path``, walang laman kung hindi ito umiiral."

