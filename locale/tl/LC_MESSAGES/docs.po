msgstr "Ibalik ang bukod - tanging talaan ng panlabas na asset hosts."

# translated-by: libretranslate
msgid "Return the sorted, de-duplicated list of host-bound ports in use for ``<scope>.<category>``."
msgstr "Ibalik ang ibinukod, de-duplicated na listahan ng mga host-bound ports na ginagamit para sa ``<scope>.<category>``."

# translated-by: libretranslate
msgid "Return the subset of `siblings` whose names appear in `group_names`."
msgstr "Ibalik ang subset ng `siblings` na may mga pangalan na lumilitaw `group_names`."

