msgid "Apply plugin-specific configuration keys and run any role-local hook."
msgstr "Pahiran ng plagin-specific configuration keys at patakbuhin ang anumang papel-local hook."

# translated-by: libretranslate
msgid "Apply schema into inventory for:"
msgstr "Ipahid ang schema sa imbentaryo para sa:"

