msgid "Recover"
msgstr "Muling Pagbangon"

# translated-by: libretranslate
msgid "Recover a manual CI run's inputs from its run name."
msgstr "I-cover ang isang manwal na CI run's input mula sa kanyang run na pangalan."

# translated-by: libretranslate
msgid "Recover drill between the sync and async pass of the first round."
msgstr "Recover drill sa pagitan ng sync at async passes ng unang round."

# translated-by: libretranslate
msgid "Recoverer classes: one per svc-bkp-* recovery type."
msgstr "Mga klase sa recoverer: isa sa bawat svc-bkp-* uri ng pagpapagaling."

