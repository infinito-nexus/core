msgid "``subject`` (mapping): DN fields (C/O/OU/CN)"
msgstr "``subject`` (Paggawa ng mapa): Mga bukid ng DN (C/O/OU/CN)"

# translated-by: libretranslate
msgid "``supported_transports`` / ``supported_auths``: what a client can present."
msgstr "``supported_transports`` / ``supported_auths``: kung ano ang maaaring iharap ng isang kliyente."

# translated-by: libretranslate
msgid "``svc-db-openldap`` — for LDAP group synchronization"
msgstr "``svc-db-openldap`` — para sa pagsasama ng grupo ng LDAP"

