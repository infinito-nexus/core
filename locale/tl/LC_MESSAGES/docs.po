msgstr "Walang drop/up, walang entity linis. Hinihiling ng isang premiseize/reinstalled run na nagkatawang-tao sa imbentaryo."

# translated-by: libretranslate
msgid "No external DB consumer (like Checkmk)."
msgstr "Walang panlabas na DB mamimili (tulad ng Checkmk)."

# translated-by: libretranslate
msgid "No external DB consumer (unlike the Semaphore role, which is tracked on a separate branch/PR)."
msgstr "Walang panlabas na DB mamimili (Di - gaya ng papel na Semaphore, na sinusubaybayan sa isang hiwalay na sangay/PR)."

# translated-by: libretranslate
msgid "No external DB; internal SQLite under `/config`."
msgstr "Walang panlabas na DB; panloob na SQLite sa ilalim ng `/config`."

# translated-by: libretranslate
msgid "No external dependencies"
msgstr "Walang panlabas na mga dependensiya"

# translated-by: libretranslate
msgid "No fixed team is always required"
msgstr "Walang tiyak na koponan ang laging kinakailangan"

# translated-by: libretranslate
msgid "No git commit until every Acceptance Criterion is checked off (`- [x]`)."
msgstr "Hindi gumagawa ng git hanggang sa ang bawat Acceptance Criterion ay masuri (`- [x]`)."

