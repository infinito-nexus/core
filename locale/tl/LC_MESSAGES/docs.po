msgid "Return the summed min_storage of app_ids and their transitive dependencies."
msgstr "Ibalik ang buod min_storage ng app_ids at ang kanilang mga dependensiya."

# translated-by: libretranslate
msgid "Return the tags of *image* from its registry's v2 API."
msgstr "Ibalik ang mga tag ng *Larawan* mula sa v ng register nito2 API."

