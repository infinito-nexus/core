msgstr "**Snapshot-aware:** rsync `--link-dest` laban sa naunang lokal na litrato na nag - aalis ng mga di - nagbabagong talaksan."

# translated-by: libretranslate
msgid "**Snapshot-aware:** rsync `--link-dest` against the previous snapshot keeps storage growth proportional to actual change."
msgstr "**Snapshot-aware:** rsync `--link-dest` laban sa naunang litrato ay nagpapanatili sa pag - iimbak na kasukat ng aktuwal na pagbabago."

# translated-by: libretranslate
