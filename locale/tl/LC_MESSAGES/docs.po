# translated-by: libretranslate
msgid "Applies default timeout values for systemd manager behavior."
msgstr "Ituon ang default timeout na mga pamantayan para sa sistemadong paggawi ng manedyer."

# translated-by: libretranslate
msgid "Applies global cleanup of unused domain configs."
msgstr "Pinalulubha pa ang pangglobong paglilinis ng di - ginagamit na mga sakop."

# translated-by: libretranslate
msgid "Applies to every call that fetches over the network, the distribution's own repositories included: their metadata is served by mirror pools that degrade independently of the package manager's internal retries."
msgstr "Alinsunod sa bawat tawag na kumukuha sa network, kabilang sa mga repositoryo ng distribusyon ang sariling mga repositoryo: ang kanilang metadata ay pinaglilingkuran ng mga pool ng salamin na nagreresulta sa mga panloob na restorasyon ng manedyer ng pakete."

# translated-by: libretranslate
msgid "Applies to: **`main` (default branch)**"
msgstr "Mga Mungkahi sa: **`main` (default na sangay)**"

