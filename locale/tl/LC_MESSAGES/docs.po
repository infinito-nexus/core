msgstr "`templates/package.json.j2`: `@playwright/test` bersyong hango sa `meta/services.yml.playwright.version`"

# translated-by: libretranslate
msgid "`templates/playwright.env.j2` acts as the stable marker for discovery and as the source of environment configuration."
msgstr "`templates/playwright.env.j2` ay nagsisilbing matatag na palatandaan ng pagtuklas at bilang pinagmumulan ng kaayusan sa kapaligiran."

