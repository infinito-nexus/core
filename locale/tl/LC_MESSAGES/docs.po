# translated-by: libretranslate
msgid "No personal account footprint appears in audit logs."
msgstr "Walang personal na account footprint ang lumilitaw sa mga audit log."

# translated-by: libretranslate
msgid "No positional terms are accepted. Predicate logic delegates to ``utils.roles.applications.services.sso.get_sso_config`` so callers share one source of truth with ``lookup('sso', ..., 'is_proxy_gated')`` and ``plugins/lookup/compose_volumes.py``."
msgstr "Walang mga termino sa posisyon ang tinatanggap. Ituro sa mga delegado ang lohika ``utils.roles.applications.services.sso.get_sso_config`` Kaya ibinabahagi ng mga tumatawag sa telepono ang isang pinagmumulan ng katotohanan ``lookup('sso', ..., 'is_proxy_gated')`` at ``plugins/lookup/compose_volumes.py``."

# translated-by: libretranslate
msgid "No prior server-side Tor art in the repo (`desk-torbrowser` is desktop client only)"
msgstr "Walang naunang server-side Tor na sining sa repo (`desk-torbrowser` ang kliyente sa desktop lamang)"

# translated-by: libretranslate
msgid "No privileged mode, no host network, pid, ipc or user namespace, no host bind mount, no container-engine socket."
msgstr "Walang pribilehiyong mode, walang host network, pid, ipc o user namespace, walang host found mount, walang container-engine saket."

# translated-by: libretranslate
msgid "No role under `roles_path` declares this application_id."
msgstr "Walang papel na ginagampanan `roles_path` ang sabi nito application_id."

# translated-by: libretranslate
msgid "No stable release; higher breakage risk; not suitable for production servers"
msgstr "Walang matatag na paglabas; mas mataas na panganib sa paghihiwalay; hindi angkop sa mga server ng produksiyon"

# translated-by: libretranslate
msgid "No stub tests 🚫"
