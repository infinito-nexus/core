msgid "Introduce SSO or mail integration for an existing `web-*` role"
msgstr "Introduce SO o mail integration para sa isang umiiral `web-*` papel"

# translated-by: libretranslate
msgid "Introduce a new infrastructure, shared abstraction, or automation building block"
msgstr "Ituro ang isang bagong imprastraktura, kabahaging abstraksiyon, o automation building block"

# translated-by: libretranslate
msgid "Introduced *docs/guides/developer/CONTRIBUTION_WORKFLOW.md* with fork-based workflow, mandatory green fork CI before PRs, and merge policy guidance"
msgstr "Ipinakilala *docs/guides/developer/CONTRIBUTION_WORKFLOW.md* na may fork-based workflow, sapilitan green fork CI bago ang PR, at pagsamahin ang patnubay ng patakaran"

# translated-by: libretranslate
msgid "Introduced *entity_name* derived from *application_id* **Changed**"
msgstr "Ipinakilala *entity_name* hango sa *application_id* **Nagbago**"

# translated-by: libretranslate
msgid "Introduced `sed_escape` filter to prevent sed injection and config corruption"
msgstr "Ipinakilala `sed_escape` filter upang maiwasan ang pag - iiniksiyon at pag - aalis ng katiwalian"

# translated-by: libretranslate
msgid "Introduced a layered Docker architecture: Infinito.Nexus now builds on pre-built pkgmgr base images, with a clear separation between base tooling, application source, and runtime logic."
msgstr "Ilathala ang isang mahabang arkitektura ng Docker: Infinito.Nexus ngayon ay nagtatayo sa pre-build pkgmgr base imahe, na may malinaw na paghihiwalay sa pagitan ng base kagamitan, application source, at runtime logic."

