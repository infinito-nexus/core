msgid "Realm of the broker's service account (typically the same as user realm)."
msgstr "Realm ng kuwenta sa paglilingkod ng broker (Karaniwan nang katulad ng daigdig ng gumagamit)."

# translated-by: libretranslate
msgid "Realm the client is registered in"
msgstr "Ang kliyente ay nakarehistro"

