# translated-by: libretranslate
msgid "A matching `SYSTEM_EMAIL_<KEY>` variable defined anywhere in Ansible variable scope (inventory, group vars, host vars)."
msgstr "Збігання `SYSTEM_EMAIL_<KEY>` змінна, визначена в будь-якому місці в діапазоні змінної (інвентаризація, групові вари, хостові вари)й."

# translated-by: libretranslate
