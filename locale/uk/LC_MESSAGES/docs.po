# translated-by: libretranslate
msgid "Reading, merging and writing the gettext catalogs under ``locale/``."
msgstr "Читання, злиття та написання каталогів gettext під ``locale/``й."

# translated-by: libretranslate
msgid "Reads"
msgstr "Читачі"

# translated-by: libretranslate
msgid "Reads 'applications' and 'group_names' from Ansible variables and discovers service providers from the role-local services metadata."
msgstr "Читачі 'applications' і 'group_names' від нездатних змінних та виявляє постачальників послуг з метаданих послуг."

