msgid "`akaunting`, `decidim`, `fider`, `listmonk`, `pretix`, `snipe-it`, `taiga`, `penpot`, `joomla`, `suitecrm`, `kix`, `opencloud`, `opentalk`, `jitsi`, `bigbluebutton`, `erpnext` show no first-party AI surface with a configurable endpoint; revisit when upstream adds one"
msgstr "`akaunting`, й `decidim`, й `fider`, й `listmonk`, й `pretix`, й `snipe-it`, й `taiga`, й `penpot`, й `joomla`, й `suitecrm`, й `kix`, й `opencloud`, й `opentalk`, й `jitsi`, й `bigbluebutton`, й `erpnext` показати не перша сторона поверхні AI з можливістю настроювання кінцевої точки; перевізити, коли потік додає один"

# translated-by: libretranslate
msgid "`algorithm:` defaults to `plain` when omitted."
msgstr "`algorithm:` За замовчуванням `plain` при в'язанні."

# translated-by: libretranslate
msgid "`alicloudkms`, `awskms`, `azurekeyvault`, `gcpckms`, `kmip`, `ocikms`, `ovhcloud`, `pkcs11`, **`static`**, `tcloudpublic`, `transit`. From v2.7.0 many become external plugins; `static` and `transit` stay built in."
msgstr "`alicloudkms`, й `awskms`, й `azurekeyvault`, й `gcpckms`, й `kmip`, й `ocikms`, й `ovhcloud`, й `pkcs11`, й **`static`**й `tcloudpublic`, й `transit`. Від v2.7.0 багато стають зовнішніми плагінами; `static` і `transit` залишатися вбудованим."

# translated-by: libretranslate
msgid "`all.sh` covers every discovered application; `selection.sh` covers one or more apps passed via `apps` (or a positional argument)."
msgstr "`all.sh` охоплює кожен знайдений додаток; `selection.sh` охоплює один або кілька додатків, які пройшли через `apps` (або позиція)й."

# translated-by: libretranslate
msgid "`all.sh` discovers applications on the host via `scripts/meta/resolve/apps.sh` and runs against the full list."
msgstr "`all.sh` Відкриває програми на хост через `scripts/meta/resolve/apps.sh` і працює над повним переліком."

# translated-by: libretranslate
