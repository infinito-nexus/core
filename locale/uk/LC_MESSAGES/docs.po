# translated-by: libretranslate
msgid "``package.json`` and ``playwright.config.js`` are provided centrally by this role:"
msgstr "``package.json`` і ``playwright.config.js`` Надані центрально за цією роллю:"

# translated-by: libretranslate
msgid "``package_name`` (string) Name of the Python package to install (e.g., ``dockreap``, ``backup-docker-to-local``)."
msgstr "``package_name`` (Увійти) Назва пакету Python для установки (Наприклад, ``dockreap``, й ``backup-docker-to-local``)й."

# translated-by: libretranslate
msgid "``password`` (should come from vault/credentials)"
msgstr "``password`` (повинен вийти з сховища / облікових записів)"

