msgctxt "role:web-app-pgadmin:description"
msgid "Web-based administration and development platform for managing multiple PostgreSQL servers, with optional OAuth2 login"
msgstr "Веб-платформа адміністрування та розробки для управління декількома серверами PostgreSQL, з додатковим OAuth2 Логін"

# translated-by: libretranslate
msgctxt "role:web-app-phpmyadmin:description"
msgid "Web-based administration tool for MySQL and MariaDB with schema management, querying, and import/export"
msgstr "Інструмент для адміністрування веб-сайтів для MySQL та MariaDB з управлінням схеми, запиту та імпорту/експорту"

# translated-by: libretranslate
msgctxt "category:web.opt:title"
msgid "Webserver Optimation"
msgstr "Оптимізація вебсервера"

# translated-by: libretranslate
msgctxt "role:dsk-docker:description"
msgid "Workstation setup for Docker and Docker Compose with the local user in the docker group for rootless development use"
msgstr "Налаштування робочої станції для Docker та Docker Compose з локальним користувачем в групі докерів для використання безкореневого розвитку"

# translated-by: libretranslate
msgctxt "role:dev-arduino:description"
msgid "Workstation toolchain and serial-port permissions for Arduino board development on Linux"
msgstr "Робочі станції інструментів для розробки дошки Arduino на Linux"

# translated-by: libretranslate
msgctxt "role:pkgmgr-install:description"
msgid "Wrapper role for idempotent package installation and updates through the pkgmgr universal package manager"
msgstr "Роль обгортки для встановлення та оновлення пакетів idempotent через універсальний менеджер пакетів"

msgctxt "logout:may_close"
msgid "You can close this page now."
msgstr "Тепер ви можете закрити цю сторінку."

msgctxt "logout:st_failed"
msgid "failed"
msgstr "помилка"

# translated-by: libretranslate
msgctxt "role:svc-net-firewall:description"
msgid "nftables packet filter whose rules each role owns as its own table, replaced atomically and reloaded at boot"
msgstr "nftables packet filter правила кожної ролі власноруч, замінений на атомічно і перевантажений на завантаження"

msgctxt "logout:st_unconfirmed"
msgid "not confirmed"
msgstr "не підтверджено"

msgctxt "logout:manual"
msgid "sign out manually"
msgstr "вийти вручну"

msgctxt "logout:st_done"
msgid "signed out"
msgstr "вихід виконано"

msgctxt "logout:st_pending"
msgid "signing out"
msgstr "виконується вихід"

