# translated-by: libretranslate
msgctxt "role:web-app-navigator:description"
msgid "Containerized Reveal.js slide deck for presenting the platform to admins, developers, users, and investors"
msgstr "Контейнери Reveal.js слайд-ката для представлення платформи адміністраторам, розробникам, користувачам та інвесторам"

# translated-by: libretranslate
msgctxt "role:web-svc-simpleicons:description"
msgid "Containerized icon server for hosting the Simple Icons brand SVG and PNG collection for web and documentation use"
msgstr "Контейнерований сервер ікони для хостингу Simple Icons бренд SVG та PNG для використання веб- та документації"

# translated-by: libretranslate
msgctxt "role:svc-db-postgres:description"
msgid "Containerized relational database with automated database, user, and privilege provisioning"
msgstr "Контейнерована реляційна база даних з автоматизованою базою даних, користувачем та наданням привілеїв"

# translated-by: libretranslate
msgctxt "menu:Content Management:title"
msgid "Content Management"
msgstr "Управління контентом"

# translated-by: libretranslate
msgctxt "menu:Content Management:description"
msgid "Content Management Systems (CMS) and web publishing platforms"
msgstr "Системи управління контентом (Мапа) веб-платформи"

# translated-by: libretranslate
msgctxt "role:web-app-wordpress:description"
msgid "Content management system for building and managing websites, blogs, and multisite networks with themes and plugins"
msgstr "Система управління контентом для побудови та управління сайтами, блогами та багато сайтів з темами та плагінами"

# translated-by: libretranslate
msgctxt "category:sys.ctl:title"
msgid "Control"
msgstr "Контроль"

# translated-by: libretranslate
msgctxt "category:sys.ctl:description"
msgid "Control layer for system lifecycle management—handling cleanup, monitoring, backups, alerting, maintenance, and repair tasks."
msgstr "Контрольний шар для управління життєвим циклом системи, контроль, резервні копії, оповіщення, обслуговування та ремонт завдань."

# translated-by: libretranslate
msgctxt "category:svc.ai:description"
msgid "Core AI building blocks—model serving, OpenAI-compatible gateways, vector databases, orchestration, and chat UIs."
msgstr "Основні блоки побудови AI-моделі, OpenAI-сумісні ворота, векторні бази, оркестрування та чат UIs."

# translated-by: libretranslate
msgctxt "role:sys-svc-webserver-core:description"
msgid "Core NGINX webserver with HTTP and TCP/UDP stream support and performance-tuned defaults"
msgstr "Core NGINX веб-сервер з підтримкою потокового передавання HTTP та TCP/UDP та продуктивними за замовчуванням"

msgctxt "logout:no_check"
msgid "Could not check your other sessions."
msgstr "Не вдалося перевірити ваші інші сеанси."

msgctxt "logout:stalled"
msgid "Could not confirm every sign-out."
msgstr "Не вдалося підтвердити кожен вихід."

# translated-by: libretranslate
msgctxt "role:dev-nix:description"
msgid "Cross-distribution installer for the Nix package manager with checksum-verified, reproducible multi-user setup"
msgstr "Трансмісійний інсталятор для менеджера пакетів Nix з перевіркою"

# translated-by: libretranslate
msgctxt "role:sys-cleanup:description"
msgid "Cross-distribution maintenance routine for disk reclamation across CI, container, and build environments"
msgstr "Ведуться роботи з технічного обслуговування дисків для рекламації диска по ТПП, контейнеру та побудови середовищ"

# translated-by: libretranslate
msgctxt "menu:Customer Relationship:title"
msgid "Customer Relationship"
msgstr "Співпраця з клієнтами"

# translated-by: libretranslate
msgctxt "menu:Customer Relationship:description"
msgid "Customer Relationship Management (CRM) software for managing customer relationships, sales pipelines, marketing, and support activities."
msgstr "Управління відносинами з клієнтами (Про компанію) програмне забезпечення для управління взаємовідносинами, трубопроводами збуту, маркетингу та підтримки діяльності."

# translated-by: libretranslate
msgctxt "category:sys.dns:title"
msgid "DNS Automation"
msgstr "Автоматизація DNS"

# translated-by: libretranslate
msgctxt "category:svc.dns:title"
msgid "DNS Resolvers"
msgstr "DNS Розчинники"

# translated-by: libretranslate
msgctxt "category:sys.dns:description"
msgid "DNS providers, records, and rDNS management (Cloudflare, Hetzner, etc.)."
msgstr "DNS-провайдери, записи та управління RDNS (Хмарфляре, Хецнер та ін.)й"

# translated-by: libretranslate
msgctxt "role:sys-dns-cloudflare-records:description"
msgid "Data-driven role for managing Cloudflare DNS records (A/AAAA, CNAME, MX, TXT, SRV) across apps and environments"
msgstr "Роль даних для управління Cloudflare DNS записів (A/AAAA, CNAME, MX, TXT, SRV) через додатки та середовища"

