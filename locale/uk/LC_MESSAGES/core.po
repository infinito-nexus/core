# translated-by: libretranslate
msgctxt "role:drv-epson-multiprinter:description"
msgid "Arch Linux driver bundle for Epson multifunction printing and scanning via escpr and imagescan"
msgstr "Пакет драйверів Arch Linux для багатофункціонального друку і сканування через escpr і зображенняcan"

# translated-by: libretranslate
msgctxt "menu:Artificial Intelligence:title"
