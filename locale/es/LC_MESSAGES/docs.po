msgid "Reading it at call time keeps the module importable without the environment, which autodoc needs to reach the docstrings below."
msgstr "Leerlo a la hora de llamar mantiene el módulo importable sin el ambiente, que autodoc necesita para llegar a los puntos de abajo."

# libretranslate
msgid "Reading or mutating Actions environments."
msgstr "Leyendo o mutando ambientes de Acciones."

# libretranslate
msgid "Reading or mutating Actions permissions on a repo."
msgstr "Leyendo o mutando permisos de Acciones en un repo."

# libretranslate
msgid "Reading or mutating GitHub releases."
msgstr "Leyendo o mutando las liberaciones de GitHub."

