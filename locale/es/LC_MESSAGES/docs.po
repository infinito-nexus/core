msgstr "Mantenga un directorio de inventario por medio ambiente."

# libretranslate
msgid "Keep overrides minimal"
msgstr "Mantenga anulas mínimas"

# libretranslate
msgid "Keep plugin interfaces explicit and stable."
msgstr "Mantenga las interfaces plugin explícitas y estables."

# libretranslate
msgid "Keep plugin logic focused; move shared logic to `utils/`."
msgstr "Mantener la lógica plugin enfocada; mover la lógica compartida `utils/`."

# libretranslate
msgid "Keep self-hosted deployment blocked while the verified Atlassian path is Cloud-only; an external connector must be explicit and must not be represented as the self-hosted role's endpoint."
msgstr "Mantén bloqueado el despliegue autoanfitriono mientras el camino Atlassiano verificado es solo Cloud; un conector externo debe ser explícito y no debe ser representado como el punto final del rol autoanfitriono."

