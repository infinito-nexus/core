# libretranslate
msgid "**Fails gracefully** with an optional debug message if the Git repository is unreachable."
msgstr "**Fails Gracefully** con un mensaje de depuración opcional si el repositorio Git es inalcanzable."

# libretranslate
msgid "**Failure Notification**"
msgstr "**Notificación de fracaso**"

# libretranslate
msgid "**Failure Notification**   Triggers service on failure."
