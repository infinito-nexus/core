msgid "Educational institutions seeking an integrated platform for learning management, collaboration, and virtual classrooms."
msgstr "Instituciones educativas que buscan una plataforma integrada para la gestión del aprendizaje, colaboración y aulas virtuales."

# libretranslate
msgid "Effect"
msgstr "Efecto"

# libretranslate
msgid "Effect of disabling"
