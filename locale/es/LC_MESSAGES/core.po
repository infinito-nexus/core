msgstr "Cliente BitTorrent de código abierto para descargar y compartir archivos en el protocolo BitTorrent"

# libretranslate
msgctxt "role:web-app-discourse:description"
msgid "Open-source discussion and community forum platform with moderation, notifications, and plugin support"
msgstr "Debate de código abierto y plataforma de foro comunitario con moderación, notificaciones y soporte de plugin"

# libretranslate
msgctxt "role:web-app-shopware:description"
