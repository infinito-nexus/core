msgstr "Plataforma de mensajería de equipo de código abierto para la colaboración en tiempo real mediante canales, hilos e integraciones"

# libretranslate
msgctxt "role:svc-ai-litellm:description"
msgid "OpenAI-compatible LLM gateway routing a single /v1 endpoint to local and hosted model backends with per-consumer keys"
msgstr "OpenAI-compatible puerta de enlace LLM enrutando un solo /v1 endpoint to local and hosted model backends with per-consumer keys"

# libretranslate
msgctxt "role:dev-java:description"
msgid "OpenJDK 11 runtime and development kit for Java applications on Pacman-based systems"
msgstr "OpenJDK 11 kit de tiempo y desarrollo para aplicaciones Java en sistemas basados en Pacman"

# libretranslate
msgctxt "role:sys-svc-ssh:description"
msgid "OpenSSH client package for secure remote shell access and key-based authentication"
msgstr "Paquete cliente de OpenSSH para acceso seguro a la concha remota y autenticación basada en clave"

# libretranslate
msgctxt "category:svc.opt:description"
msgid "Optimation Services to improve your system"
msgstr "Optimation Services para mejorar su sistema"

# libretranslate
msgctxt "role:dev-gcc:description"
msgid "Optimizing compiler toolchain for building C, C++, and other native-language programs"
msgstr "Optimización de la cadena de herramientas del compilador para construir C, C++ y otros programas de lengua nativa"

# libretranslate
msgctxt "role:sys-stk-front-proxy:description"
msgid "Orchestration wrapper for per-domain NGINX provisioning with TLS certificates, vHost templates, and optional OAuth2"
msgstr "Envoltorio de orquestación para el suministro por dominio NGINX con certificados TLS, plantillas vHost, y OAuth opcional2"

