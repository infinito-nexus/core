msgid "Open-source community feedback platform for collecting, voting on, and prioritizing feature requests and ideas"
msgstr "Plataforma de retroalimentación comunitaria de código abierto para recopilar, votar y priorizar solicitudes e ideas de características"

# libretranslate
msgctxt "role:web-app-joomla:description"
msgid "Open-source content management system for building websites, intranets, and online applications without writing code"
msgstr "Sistema de gestión de contenidos de código abierto para la construcción de sitios web, intranets y aplicaciones en línea sin código de escritura"

# libretranslate
msgctxt "role:desk-qbittorrent:description"
