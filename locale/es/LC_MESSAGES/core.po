msgstr "Puños de liberación para las herramientas GitHub-release lint la cadena de herramientas instala"

# libretranslate
msgctxt "category:sys.ctl.rpr:title"
msgid "Repair"
msgstr "Reparación"

# libretranslate
msgctxt "category:sys.ctl.rpr:description"
msgid "Repair and recovery roles—handling hard/soft recovery of Docker, Btrfs balancers, and other low-level system fixes."
msgstr "Funciones de reparación y recuperación: gestión de la recuperación dura/blanda de los balanceadores de Docker, Btrfs y otras soluciones de sistema de bajo nivel."

# libretranslate
msgctxt "role:sys-util-git-pull:description"
msgid "Reusable Git pull primitive for shallow clones, detached-safe updates, tag pinning, and reliable change detection"
msgstr "Reutilizable Git tire primitivo para clones poco profundos, actualizaciones desprevenidas seguras, pinning de etiquetas y detección de cambio confiable"

# libretranslate
msgctxt "role:svc-ai-mcp-adapter:description"
msgid "Reusable per-provider MCP adapter exposing a narrow allowlisted read surface"
msgstr "Adaptador MCP reutilizable por proveedor que expone una superficie de lectura limitada"

# libretranslate
msgctxt "role:sys-svc-proxy:description"
msgid "Reverse proxy front-end for Docker-hosted services with automatic TLS, WebSocket support, and per-app vHost templating"
msgstr "Proxy frontal-end inverso para los servicios hospedados por Docker con TLS automático, soporte WebSocket y templating per-app vHost"

# libretranslate
msgctxt "role:sys-front-tls:description"
msgid "Reverse-proxy TLS orchestration layer selecting Let's Encrypt, self-signed, or disabled certificate providers for Nginx"
msgstr "Selección de capas de orquestación TLS de proxy inversa Let's Encrypt, autosigned, or disabled certificate providers for Nginx"

# libretranslate
msgctxt "category:svc.prx:description"
msgid "Reverse-proxy roles for routing and load-balancing traffic to backend services"
msgstr "Funciones indirectas inversas para el tráfico de enrutamiento y de carga a los servicios de backend"

# libretranslate
msgctxt "category:sys.ctl.cln:description"
msgid "Roles for cleaning up various system resources—old backups, unused certificates, temporary files, Docker volumes, disk caches, deprecated domains, and more."
msgstr "Funciones para limpiar diversos recursos del sistema: copias de seguridad antiguas, certificados no utilizados, archivos temporales, volúmenes de Docker, caches de disco, dominios deprecatados, y más."

# libretranslate
msgctxt "category:drv:description"
msgid "Roles for installing and configuring hardware drivers—covering printers, graphics, input devices, and other peripheral support."
msgstr "Funciones para la instalación y configuración de controladores de hardware — capturar impresoras, gráficos, dispositivos de entrada y otro soporte periférico."

# libretranslate
msgctxt "category:web:description"
msgid "Roles for managing web infrastructure—covering static content services and deployable web applications."
msgstr "Funciones para la gestión de la infraestructura web, la recuperación de los servicios de contenido estático y las aplicaciones web desplegadas."

# libretranslate
msgctxt "category:sys.ctl.hlth:description"
msgid "Roles for system monitoring and health checks—encompassing bot-style automated checks and core low-level monitors for logs, containers, disk usage, and more."
msgstr "Funciones para la vigilancia del sistema y los controles de salud: la incorporación de controles automatizados de estilo bot y monitores de bajo nivel básicos para registros, contenedores, uso de discos y más."

# libretranslate
msgctxt "role:sys-front-tls-selfsigned:description"
