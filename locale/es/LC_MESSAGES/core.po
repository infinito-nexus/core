msgstr "Función de provisión para la configuración del entorno por usuario, gestión de los ficheros de conchas y SSH authorized_keys"

# libretranslate
msgctxt "category:svc.prx:title"
msgid "Proxy Servers"
msgstr "Servidores Proxy"

# libretranslate
msgctxt "role:web-svc-api:description"
