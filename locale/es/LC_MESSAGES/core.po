msgstr "proveedor de certificados SAN-aware generando y almacenando certificados TLS auto-firmados para la capa TLS frontal-proxy"

# libretranslate
msgctxt "menu:Sales:title"
msgid "Sales"
msgstr "Ventas"

# libretranslate
msgctxt "category:svc.virt:title"
msgid "Sandboxed Runtimes"
msgstr "Sandboxed Runtimes"

# libretranslate
msgctxt "role:svc-bkp-nfs-2-local:description"
msgid "Scheduled backup job for hard-linked differential rsync snapshots of an NFS export into the local backup tree"
msgstr "Trabajo de copia de seguridad programado para instantáneas de rsync en línea dura de una exportación NFS en el árbol de copia de seguridad local"

# libretranslate
msgctxt "role:sys-ctl-cln-certs:description"
