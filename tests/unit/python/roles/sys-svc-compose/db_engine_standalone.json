  "svc-db-postgres": {
    "services": {
      "postgres": {
        "build": {
          "context": ".",
          "dockerfile": "Dockerfile"
        },
        "command": [
          "postgres",
          "-c",
          "max_connections=",
          "-c",
          "superuser_reserved_connections=",
          "-c",
          "shared_buffers=",
          "-c",
          "work_mem=",
          "-c",
          "maintenance_work_mem=",
          "-c",
          "max_locks_per_transaction="
        ],
        "deploy": {
          "placement": {
