{
  "svc-db-mariadb": {
    "services": {
      "mariadb": {
        "build": {
          "args": {
            "MARIADB_IMAGE": "",
            "MARIADB_VERSION": ""
          },
          "context": ".",
          "dockerfile": "Dockerfile"
        },
        "command": [
          "--transaction-isolation=READ-COMMITTED",
          "--binlog-format=ROW"
        ],
        "deploy": {
          "placement": {
            "constraints": [
              "node.role == manager"
            ]
          },
          "replicas": 1,
          "resources": {
            "limits": {
              "cpus": "1",
              "memory": "1g",
              "pids": 512
            },
            "reservations": {
              "memory": "512m"
            }
          },
          "restart_policy": {
            "condition": "any"
          },
          "update_config": {
            "delay": "0s",
            "failure_action": "continue",
            "parallelism": 1
          }
        },
        "logging": {
          "driver": "journald"
        },
        "x-compose_only": "[\"compose_only\", [\"container_name\", \"\"], {}]",
        "x-compose_restart": "[\"compose_restart\", [\"always\"], {}]",
        "x-container_healthcheck": "[\"container_healthcheck\", [\"mariadb\"], {}]",
        "x-container_image": "[\"container_image\", [\"svc-db-mariadb\", \"mariadb\"], {}]",
        "x-container_networks": "[\"container_networks\", [], {}]",
        "x-container_volumes": "[\"container_volumes\", [\"mariadb\"], {}]"
      }
    },
    "x-compose_networks": "[\"compose_networks\", [], {}]",
    "x-compose_volumes": "[\"compose_volumes\", [], {}]"
  },
