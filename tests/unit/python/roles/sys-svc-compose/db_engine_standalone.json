  "svc-db-redis": {
    "services": {
      "redis": {
        "command": [
          "sh",
          "-c",
          "exec redis-server --requirepass \"$$REDIS_PASSWORD\" --appendonly yes --maxmemory 820mb --maxmemory-policy allkeys-lru"
        ],
        "deploy": {
          "placement": {
            "constraints": [
              "node.role == manager"
            ]
          },
          "replicas": 1,
