[% if kind == "container" %]
{% include 'roles/sys-svc-container/templates/env.j2' %}

APP_BASE_URL={{ lookup('tls', application_id, 'url.base') | dotenv_quote }}
[% if database != "none" %]

DB_HOST={{ lookup('database', application_id, 'host') | dotenv_quote }}
DB_PORT={{ lookup('database', application_id, 'port') | string | dotenv_quote }}
DB_NAME={{ lookup('database', application_id, 'name') | dotenv_quote }}
DB_USER={{ lookup('database', application_id, 'username') | dotenv_quote }}
DB_PASSWORD={{ lookup('database', application_id, 'password') | dotenv_quote }}
[% endif %]
[% if login == "oidc" %]

LOGIN_SSO_ENABLED={{ lookup('config', application_id, 'services.[[ entity ]].login.method.sso.enabled') | bool | string | lower }}
LOGIN_NATIVE_ENABLED={{ lookup('config', application_id, 'services.[[ entity ]].login.method.native.enabled') | bool | string | lower }}
{% if lookup('config', application_id, 'services.sso.enabled') | bool %}
OIDC_CLIENT_ID={{ OIDC.CLIENT.ID | dotenv_quote }}
OIDC_CLIENT_SECRET={{ OIDC.CLIENT.SECRET | dotenv_quote }}
OIDC_ISSUER_URL={{ OIDC.CLIENT.ISSUER_URL | dotenv_quote }}
OIDC_DISCOVERY_URL={{ OIDC.CLIENT.DISCOVERY_DOCUMENT | dotenv_quote }}
OIDC_USERNAME_CLAIM={{ OIDC.ATTRIBUTES.USERNAME | dotenv_quote }}
OIDC_BUTTON_TEXT={{ OIDC.BUTTON_TEXT | dotenv_quote }}
{% endif %}
[% endif %]
[% if login == "ldap" %]

{% if lookup('config', application_id, 'services.ldap.enabled') | bool %}
LDAP_URI={{ LDAP.SERVER.URI | dotenv_quote }}
LDAP_BIND_DN={{ LDAP.DN.ADMINISTRATOR.DATA | dotenv_quote }}
LDAP_BIND_PASSWORD={{ LDAP.BIND_CREDENTIAL | dotenv_quote }}
LDAP_USERS_DN={{ LDAP.DN.OU.USERS | dotenv_quote }}
LDAP_USER_ID_ATTRIBUTE={{ LDAP.USER.ATTRIBUTES.ID | dotenv_quote }}
LDAP_USER_MAIL_ATTRIBUTE={{ LDAP.USER.ATTRIBUTES.MAIL | dotenv_quote }}
{% endif %}
[% endif %]
[% if "email" in features %]

{% set email = lookup('email', application_id) %}
{% if email.enabled | bool %}
SMTP_HOST={{ email.host | dotenv_quote }}
SMTP_PORT={{ email.port | string | dotenv_quote }}
SMTP_TLS={{ email.tls | bool | string | lower }}
SMTP_STARTTLS={{ email.start_tls | bool | string | lower }}
SMTP_USERNAME={{ email.username | dotenv_quote }}
SMTP_PASSWORD={{ email.password | dotenv_quote }}
SMTP_FROM={{ email['from'] | dotenv_quote }}
{% endif %}
[% endif %]
[% if "redis" in features %]

REDIS_HOST={{ lookup('engine', 'redis', application_id, 'host') | dotenv_quote }}
REDIS_PORT={{ lookup('engine', 'redis', application_id, 'port') | string | dotenv_quote }}
REDIS_PASSWORD={{ lookup('engine', 'redis', application_id, 'password') | dotenv_quote }}
[% endif %]
[% if environment %]

[% for key, literal in environment %]
[[ key ]]={{ [[ literal ]] | dotenv_quote }}
[% endfor %]
[% endif %]
[% endif %]
