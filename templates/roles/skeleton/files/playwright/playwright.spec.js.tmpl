const { test, expect } = require("@playwright/test");

[% if kind == "container" %]
const { assertDesignTokens } = require("./design");
[% endif %]
const {
  expectHstsWhenTls,
  ownResponseHeaders,
  gotoOnion,
  normalizeBaseUrl,
  requireDotenvValue,
  runAdminFlow,
  runBiberFlow,
  runGuestFlow,
} = require("./personas");
[% if kind == "container" %]
const { skipUnlessServiceEnabled } = require("./service-gating");
[% endif %]
const { resolveTimeout } = require("./timeouts");

test.use({ ignoreHTTPSErrors: true });

const appBaseUrl = normalizeBaseUrl(process.env.APP_BASE_URL || "");
const canonicalDomain = requireDotenvValue(process.env.CANONICAL_DOMAIN, "CANONICAL_DOMAIN");

test.beforeEach(async ({ page }) => {
  expect(appBaseUrl, "APP_BASE_URL must be set").toBeTruthy();
  expect(canonicalDomain, "CANONICAL_DOMAIN must be set").toBeTruthy();
  await page.context().clearCookies();
});

test("front page is served under canonical domain with TLS", async ({ page }) => {
  const response = await gotoOnion(page, `${appBaseUrl}/`);
  expect(response, "Expected [[ title ]] response").toBeTruthy();
  expect(response.status(), "Expected [[ title ]] front page status < 400").toBeLessThan(400);
  expect(
    response.url().includes(canonicalDomain),
    `Expected canonical domain "${canonicalDomain}" to back the [[ title ]] URL`
  ).toBe(true);
  expectHstsWhenTls(await ownResponseHeaders(response), appBaseUrl, "[[ title ]]");
});

test("front page returns HTML content under canonical domain", async ({ request }) => {
  const response = await request.get(`${appBaseUrl}/`, { timeout: resolveTimeout(30_000) });
  expect(response.status(), "Expected [[ title ]] front page status < 400").toBeLessThan(400);
  const contentType = response.headers()["content-type"] || "";
  expect(
    contentType.includes("text/html"),
    `Expected HTML content-type, got "${contentType}"`
  ).toBe(true);
});

[% if kind == "static" %]
test("brand: the page links the brand kit and renders its header and nav", async ({ page }) => {
  const kit = requireDotenvValue(process.env.BRAND_KIT_PATH, "BRAND_KIT_PATH");
  await gotoOnion(page, `${appBaseUrl}/`);
  for (const sheet of ["tokens.css", "brand.css"]) {
    await expect(page.locator(`link[rel="stylesheet"][href="${kit}/${sheet}"]`)).toHaveCount(1);
  }
  await expect(page.locator("header.brand-header")).toHaveCount(1);
  await expect(page.locator('.brand-nav a[aria-current="page"]')).toHaveCount(1);
  await expect(page.locator("footer.brand-footer")).toHaveCount(1);
});

test("cosmos: the sky is on exactly while a cosmos provider serves the site", async ({ page }) => {
  const provider = process.env.COSMOS_PROVIDER || "";
  await gotoOnion(page, `${appBaseUrl}/`);
  const expected = provider ? 1 : 0;
  await expect(page.locator('script[type="module"][src$="/cosmos.js"]')).toHaveCount(expected);
  await expect(page.locator("cosmos-sky")).toHaveCount(expected);
});
[% else %]
test("design: the corporate design tokens reach the front page", async ({ page }) => {
  skipUnlessServiceEnabled("design");
  await gotoOnion(page, `${appBaseUrl}/`);
  await assertDesignTokens(page, "[[ title ]]");
});
[% endif %]

test("guest: public-landing → auth chain → never authenticated", async ({ page }) => {
  await runGuestFlow(page);
});

test("biber: app → universal logout", async ({ page }) => {
  await runBiberFlow(page);
});

test("administrator: app → universal logout", async ({ page }) => {
  await runAdminFlow(page);
});
