.:53 {
  template IN A {
    match ^${DOMAIN_RE}\.$
    answer "{{ .Name }} 60 IN A ${INFINITO_IP4}"
    fallthrough
  }

  template IN A {
    match ^(.*)\.${DOMAIN_RE}\.$
    answer "{{ .Name }} 60 IN A ${INFINITO_IP4}"
    fallthrough
  }

  template IN AAAA {
    match ^${DOMAIN_RE}\.$
    fallthrough
  }

  template IN AAAA {
    match ^(.*)\.${DOMAIN_RE}\.$
    fallthrough
  }

  template IN ANY ${INFINITO_DOMAIN} {
    authority "${INFINITO_DOMAIN}. 60 IN SOA ns.${INFINITO_DOMAIN}. hostmaster.${INFINITO_DOMAIN}. 1 60 60 60 60"
  }

  forward . 1.1.1.1 8.8.8.8  # noqa: hardcoded-dns-resolver
  log
  errors
}
