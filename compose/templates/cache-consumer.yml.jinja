{#
  Rendered from the cache: declarations, which are the single point of truth
  for every cached host. Nothing here is written by hand; edit the
  declaration instead.

  The rendered file is never instantiated: every runner pulls it in through
  `extends`, which resolves the relative sources below against the rendered
  file's own directory, so it must stay at the repository root.
#}
---
services:
  cache-consumer:
    environment:
      INFINITO_CACHE_PACKAGE_FRONTEND_IP: ${INFINITO_CACHE_PACKAGE_FRONTEND_IP:?Run 'make dotenv' to generate the .env single source of truth}
    extra_hosts:
      - "infinito-registry-cache:${INFINITO_CACHE_REGISTRY_IP:?Run 'make dotenv' to generate the .env single source of truth}"
{% for hostname in CACHE_PACKAGE_HOSTNAMES %}
      - "{{ hostname }}:${INFINITO_CACHE_PACKAGE_FRONTEND_IP}"
{% endfor %}
    volumes:
      - type: bind
        source: ${INFINITO_CACHE_REGISTRY_CA_HOST_PATH:?Run 'make dotenv' to generate the .env single source of truth}
        target: /opt/registry-cache-ca
        read_only: true
        bind:
          create_host_path: true
      - ${INFINITO_CACHE_REGISTRY_PROXY_CONF:?Set by 'cli deploy development up'}:/etc/systemd/system/docker.service.d/registry-cache-proxy.conf:ro
      - ./scripts/docker/cache/registry-ca.sh:/usr/local/bin/registry-cache-ca.sh:ro
      - ${INFINITO_CACHE_PACKAGE_PIP_CONF:?Set by 'cli deploy development up'}:/etc/pip.conf:ro
      - ${INFINITO_CACHE_PACKAGE_NPMRC:?Set by 'cli deploy development up'}:/root/.npmrc:ro
      - ./compose/package-cache/apt/${INFINITO_DISTRO:?Run 'make dotenv' to generate the .env single source of truth}.list:/etc/apt/sources.list.d/package-cache.list:ro
      - ${INFINITO_CACHE_PACKAGE_FRONTEND_CA_FILE:?Set by 'cli deploy development up'}:/opt/package-frontend-ca.crt:ro
      - ./roles/svc-cache-package/files/shell/ca.sh:/usr/local/bin/package-frontend-ca.sh:ro
